      "gray": {
        "$type": "color",
        "gray-50": { "$value": "#F5F7FB" },
        "gray-100": { "$value": "#EEF2F7" },
        "gray-200": { "$value": "#E3E8F0" },
        "gray-300": { "$value": "#DDE3EC" },
        "gray-400": { "$value": "#CBD5E1" },
        "gray-500": { "$value": "#8A95A8" },
        "gray-600": { "$value": "#657187" },
        "gray-700": { "$value": "#566176" },
        "gray-800": { "$value": "#1F2937" },
        "gray-900": { "$value": "#111827" }
      },
      "status": {
        "$type": "color",
        "success": { "$value": "#137A43" },
        "success-soft": { "$value": "#E8F7EF" },
        "warning": { "$value": "#9A5B00" },
        "warning-soft": { "$value": "#FFF4D6" },
        "danger": { "$value": "#C93434" },
        "danger-soft": { "$value": "#FDECEC" }
