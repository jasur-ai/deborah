      "canvas": { "$value": "#F5F7FB", "$description": "Light canvas (S06.03)" },
      "sunken": { "$value": "#E8EDF5", "$description": "Light sunken — inset/well area (S06.03)" },
      "section-alt": { "$value": "#EEF2F7" },
      "card": { "$value": "#FFFFFF" },
      "nested-surface": { "$value": "#F7F9FC" },
      "control-border": { "$value": "#7C8A9E" },
      "divider": { "$value": "#E3E8F0" }
