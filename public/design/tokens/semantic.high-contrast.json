{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "edikit": {
    "semantic": {
      "$description": "Semantic tokens — high-contrast theme (WCAG AAA targets). Path'lar light/dark bilan BIR XIL (S04.05).",
      "color": {
        "action": {
          "primary": { "$type": "color", "$value": "#0033A6", "$description": "High-contrast primary action" },
          "primary-hover": { "$type": "color", "$value": "#00288C", "$description": "HC hover" },
          "primary-active": { "$type": "color", "$value": "#002075", "$description": "HC active" },
          "primary-soft": { "$type": "color", "$value": "#D6E4FF", "$description": "HC soft fill" },
          "primary-border": { "$type": "color", "$value": "#0033A6", "$description": "HC action outline" },
          "on-action": { "$type": "color", "$value": "#FFFFFF", "$description": "HC text on action" },
          "signal": { "$type": "color", "$value": "#005866", "$description": "HC Signal Cyan (AAA)" },
          "insight": { "$type": "color", "$value": "#6B3F00", "$description": "HC Insight Amber (AAA)" }
        },
        "surface": {
          "default": { "$type": "color", "$value": "#FFFFFF", "$description": "HC page bg" },
          "sunken": { "$type": "color", "$value": "#E0E0E0", "$description": "HC sunken/inset well" },
          "alternate": { "$type": "color", "$value": "#F0F0F0", "$description": "HC alternate bg" },
          "raised": { "$type": "color", "$value": "#FFFFFF", "$description": "HC card" },
