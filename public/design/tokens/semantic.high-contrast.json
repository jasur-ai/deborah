        },
        "divider": { "$type": "color", "$value": "#666666" },
        "focus": { "$type": "color", "$value": "#000000", "$description": "HC focus ring (solid)" },
        "selection": { "$type": "color", "$value": "#CCE0FF", "$description": "HC selection" },
        "status": {
          "success": { "$type": "color", "$value": "#006B36" },
          "success-soft": { "$type": "color", "$value": "#D9F0E3" },
          "warning": { "$type": "color", "$value": "#8A5200" },
          "warning-soft": { "$type": "color", "$value": "#FFEDCC" },
          "danger": { "$type": "color", "$value": "#B00020" },
          "danger-soft": { "$type": "color", "$value": "#FFD9D9" }
        },
        "brand": {
          "cobalt": { "$type": "color", "$value": "#0033A6", "$description": "HC Edikit Cobalt brand" },
          "signal": { "$type": "color", "$value": "#005866", "$description": "HC Edikit Signal brand" },
          "insight": { "$type": "color", "$value": "#6B3F00", "$description": "HC Edikit Insight brand" }
        }
