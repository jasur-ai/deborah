          "input": { "$type": "color", "$value": "#FFFFFF", "$description": "HC input bg" },
          "overlay": { "$type": "color", "$value": "rgba(0,0,0,0.6)", "$description": "HC overlay" },
          "scrim": { "$type": "color", "$value": "#000000", "$description": "Gradient ustidagi text uchun solid scrim HC (S06.07)" }
        },
        "text": {
          "primary": { "$type": "color", "$value": "#000000", "$description": "HC primary text" },
          "secondary": { "$type": "color", "$value": "#1A1A1A", "$description": "HC secondary text" },
          "muted": { "$type": "color", "$value": "#333333", "$description": "HC muted text (min 4.5:1)" },
          "disabled": { "$type": "color", "$value": "#555555", "$description": "HC disabled text" },
          "inverse": { "$type": "color", "$value": "#FFFFFF", "$description": "HC inverse text" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "#666666", "$description": "HC subtle border" },
