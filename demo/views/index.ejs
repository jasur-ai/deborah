<!DOCTYPE html>
<html lang="uz" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deborah — o'qituvchilar uchun AI yordamchi</title>
<style>
/* ═══════════════════════════════════════════════════════
   DEBORAH — O'QITUVCHILAR LANDING (index.html)
   Fokus: o'qituvchi ishini yengillashtirish. Real featurelar:
   AI savol generatsiyasi, AI slaydlar, AI baholash, maqola
   tavsiyalari, OCR/OMR, savollar banki, cast, hisobot,
   proctoring. Light/dark · UZ/RU/EN.
   ═══════════════════════════════════════════════════════ */
:root{
  --bg:#1c1813; --bg2:#241f18;
  --hdr-bg:rgba(28,24,19,.88);
  --line:rgba(242,237,227,.15); --line2:rgba(201,164,92,.42);
  --ivory:#f2ede3; --mut:#b3aa98; --dim:#857d6c;
  --gold:#c2a06a; --gold2:#d6bd8c; --on-gold:#141006;
  --crimson:#a8794f; --green:#7d9670;
  --card-bg:rgba(36,31,25,.5);
  --panel-a:rgba(36,31,25,.6); --panel-b:rgba(28,24,19,.2);
  --track-bg:rgba(255,255,255,.04);
  --bar-grey:rgba(242,237,227,.24);
  --cell-base:rgba(255,255,255,.06);
  --sel-bg:#c9a45c; --sel-text:#141006;
  --shadow:0 30px 80px rgba(0,0,0,.45);
}
[data-theme="light"]{
  --bg:#aaa596; --bg2:#9d9889;
  --hdr-bg:rgba(170,165,150,.95);
  --line:rgba(30,25,18,.45); --line2:rgba(74,54,20,.9);
  --ivory:#15120c; --mut:#221d13; --dim:#2a2316;
  --gold:#7a5a1e; --gold2:#543807; --on-gold:#efe9da;
  --crimson:#8a6442; --green:#5b7448;
  --card-bg:rgba(157,152,137,.55);
  --panel-a:rgba(157,152,137,.85); --panel-b:rgba(170,165,150,.5);
  --track-bg:rgba(35,30,24,.08);
  --bar-grey:rgba(35,30,24,.24);
  --cell-base:rgba(35,30,24,.11);
  --sel-bg:#7f6a3a; --sel-text:#efe9da;
  --shadow:0 24px 60px rgba(55,44,22,.26);
}
[data-theme="light"] body::after{content:'';position:fixed;inset:0;z-index:9996;pointer-events:none;
  background:radial-gradient(ellipse at 50% 18%,transparent 50%,rgba(50,42,25,.15) 100%)}
.modefx{position:fixed;inset:0;z-index:9999;pointer-events:none;background:#1c1813;opacity:0}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--ivory);line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .35s,color .35s}
::selection{background:var(--sel-bg);color:var(--sel-text)}
a{color:inherit;text-decoration:none}
body::before{content:'';position:fixed;inset:0;z-index:9997;pointer-events:none;opacity:.045;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
/* ── Header ── */
.hdr{position:fixed;top:0;left:0;right:0;z-index:900;display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:13px 30px;background:var(--hdr-bg);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);transition:background .35s,border-color .35s}
@font-face{font-family:'Cinzel';font-style:normal;font-weight:400 900;font-display:swap;src:url('/fonts/cinzel-latin-400.woff2') format('woff2')}
.logo{display:inline-flex;flex-direction:column;align-items:center;gap:2px;line-height:1;text-decoration:none}
.logo-mark{height:34px;width:auto;display:block;flex-shrink:0;filter:drop-shadow(0 2px 6px rgba(0,0,0,.5))}
.logo-word{font-family:'Cinzel',serif;font-weight:700;font-size:.72rem;letter-spacing:.34em;text-indent:.34em;text-transform:lowercase;color:var(--gold2);white-space:nowrap;text-shadow:0 1px 3px rgba(0,0,0,.6)}
[data-theme="light"] .logo-word{text-shadow:none}
.logo-mark{height:34px;width:auto;display:block;flex-shrink:0}
.nav{display:flex;gap:22px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;letter-spacing:.13em;text-transform:uppercase;color:var(--mut)}
.nav a{position:relative;padding:3px 0;transition:color .2s}
.nav a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold);transition:width .25s}
.nav a:hover{color:var(--ivory)}
.nav a:hover::after{width:100%}
@media(max-width:820px){.nav{display:none}}
.ctrls{display:flex;align-items:center;gap:9px;flex-shrink:0}
.lang{display:flex;border:1px solid var(--line);overflow:hidden}
.lang button{background:transparent;border:none;color:var(--mut);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.58rem;letter-spacing:.08em;padding:6px 8px;cursor:pointer;transition:all .15s}
.lang button+button{border-left:1px solid var(--line)}
.lang button:hover{color:var(--ivory)}
.lang button.on{background:var(--gold);color:var(--on-gold)}
.tbtn{width:30px;height:30px;border:1px solid var(--line);background:transparent;color:var(--mut);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:border-color .2s,color .2s}
.tbtn:hover{border-color:var(--gold);color:var(--gold2)}
.tbtn svg{width:14px;height:14px;display:block}
.tbtn .ico-sun{display:none}
[data-theme="light"] .tbtn .ico-sun{display:block}
[data-theme="light"] .tbtn .ico-moon{display:none}
.btn{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:.66rem;letter-spacing:.11em;text-transform:uppercase;font-weight:700;
  padding:9px 16px;border:1px solid var(--line);color:var(--ivory);cursor:pointer;transition:all .2s;background:transparent;display:inline-block;white-space:nowrap}
.btn:hover{border-color:var(--gold);color:var(--gold2);transform:translateY(-2px)}
.btn-gold{background:var(--gold);border-color:var(--gold);color:var(--on-gold)}
.btn-gold:hover{background:var(--gold2);border-color:var(--gold2);color:var(--on-gold);box-shadow:0 0 26px rgba(201,164,92,.3)}
.btn-sm{padding:7px 13px;font-size:.6rem}
.btn-lg{padding:13px 24px;font-size:.74rem}
/* ── Hero ── */
.hero{min-height:100vh;display:flex;align-items:center;position:relative;padding:120px 30px 70px}
.hero-in{max-width:1160px;margin:0 auto;width:100%;display:grid;grid-template-columns:1.05fr .95fr;gap:46px;align-items:center}
@media(max-width:960px){.hero-in{grid-template-columns:1fr;text-align:center}}
.kicker{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:14px;margin-bottom:26px}
.kicker::before{content:'';width:44px;height:1px;background:var(--gold)}
@media(max-width:960px){.kicker{justify-content:center}.kicker::before{display:none}}
h1{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:clamp(2rem,4.6vw,3.6rem);line-height:1.12;letter-spacing:-.01em;margin-bottom:22px}
h1 em{font-style:italic;color:var(--gold2);font-size:1.16em;letter-spacing:-.02em;text-decoration:underline;text-decoration-color:var(--gold);text-decoration-thickness:3px;text-underline-offset:10px}
.hero .lede{font-size:1rem;color:var(--mut);max-width:34em;margin-bottom:34px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
@media(max-width:960px){.hero-cta{justify-content:center}}
.scroll-hint{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;color:var(--dim);display:flex;align-items:center;gap:12px}
.scroll-hint::after{content:'';width:1px;height:30px;background:linear-gradient(180deg,var(--gold),transparent);display:inline-block;animation:drip 2s infinite}
@keyframes drip{0%{transform:scaleY(0);transform-origin:top}55%{transform:scaleY(1);transform-origin:top}56%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.ghost{position:fixed;right:-1%;top:3%;font-family:'Georgia','Times New Roman',serif;font-style:italic;font-weight:700;
  font-size:clamp(6rem,17vw,15rem);line-height:1;color:transparent;-webkit-text-stroke:1px var(--line2);
  opacity:.5;pointer-events:none;user-select:none;z-index:1;white-space:nowrap}
[data-theme="light"] .ghost{opacity:.45}
.site{position:relative;z-index:2}
/* ── Cast panel ── */
.screen{position:relative;border:1px solid var(--line);background:linear-gradient(180deg,var(--panel-a),var(--panel-b));box-shadow:var(--shadow);overflow:hidden;max-width:520px;margin:0 auto}
.corner{position:absolute;width:12px;height:12px;border:1px solid var(--line2)}
.corner.tl{top:-1px;left:-1px;border-right:none;border-bottom:none}
.corner.tr{top:-1px;right:-1px;border-left:none;border-bottom:none}
.corner.bl{bottom:-1px;left:-1px;border-right:none;border-top:none}
.corner.br{bottom:-1px;right:-1px;border-left:none;border-top:none}
.sc-top{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 18px;border-bottom:1px solid var(--line);
  font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--dim)}
.sc-code{color:var(--gold2)}
.sc-live{display:flex;align-items:center;gap:7px;color:var(--green)}
.sc-live i{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 1.3s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
.sc-body{padding:20px 22px 18px;min-height:270px;position:relative}
.beam{position:absolute;left:18px;right:18px;top:30px;height:26px;opacity:0;transition:opacity .4s}
.beam .ln{position:absolute;left:0;right:0;top:12px;height:1.5px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.beam .dot{position:absolute;top:5px;width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,var(--gold));
  box-shadow:0 0 14px var(--gold);left:0;animation:fly 1.6s ease-in-out infinite}
@keyframes fly{0%{left:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{left:calc(100% - 14px);opacity:0}}
.beam .tx{position:absolute;right:0;top:-16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold2)}
.step{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.step.in{opacity:1;transform:none}
.q{font-family:'Georgia','Times New Roman',serif;font-size:1rem;line-height:1.45;margin:2px 0 12px}
.opts{margin-bottom:14px}
.opt{display:flex;gap:11px;align-items:center;border:1px solid var(--line);background:var(--card-bg);padding:8px 12px;margin-bottom:6px;font-size:.88rem;position:relative;overflow:hidden}
.opt .k{width:24px;height:24px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;flex-shrink:0}
.opt.dom{border-color:var(--line2)}
.opt.dom .k{border-color:var(--gold);color:var(--gold2)}
.opt .pct{margin-left:auto;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.66rem;color:var(--dim)}
.opt.dom .pct{color:var(--gold2)}
.opt .track{position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--track-bg)}
.opt .track i{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,var(--gold),var(--gold2));transition:width 1.3s cubic-bezier(.22,.61,.36,1)}
.opt.dom .track i{background:linear-gradient(90deg,#7a5a3a,var(--crimson))}
.cap{margin-top:14px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.56rem;letter-spacing:.17em;text-transform:uppercase;color:var(--dim)}
.mini{display:grid;grid-template-columns:repeat(14,1fr);gap:3px;margin-top:9px}
.cell{aspect-ratio:1;background:var(--cell-base);transition:background .5s}
.cell.cr{background:rgba(168,121,79,.9)}
.cell.gd{background:rgba(194,160,106,.9)}
.cell.gr{background:rgba(127,154,107,.9)}
.cell.bl{background:rgba(110,122,142,.85)}
.devnote{margin-top:12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);opacity:0;transition:opacity .5s}
.devnote b{color:var(--green)}
.sc-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:12px 18px;border-top:1px solid var(--line);
  font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.56rem;letter-spacing:.13em;text-transform:uppercase;color:var(--dim)}
/* ── Stats ── */
.stats{max-width:1160px;margin:0 auto;padding:0 30px 76px}
.stats-in{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
@media(max-width:760px){.stats-in{grid-template-columns:1fr}}
.stat{padding:24px;border-right:1px solid var(--line)}
.stat:last-child{border-right:none}
@media(max-width:760px){.stat{border-right:none;border-bottom:1px solid var(--line)}.stat:last-child{border-bottom:none}}
.stat .num{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:1.7rem;color:var(--ivory);line-height:1}
.stat .lbl{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);margin-top:8px}
/* ── Sections ── */
.sec{padding:104px 30px;position:relative}
.sec-in{max-width:1160px;margin:0 auto}
.sec-h{margin-bottom:48px}
.sec-h .k{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--dim);margin-bottom:14px}
.sec-h h2{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:clamp(1.7rem,3.4vw,2.7rem);line-height:1.14}
.sec-h h2 em{font-style:italic;color:var(--gold2)}
.sec-h p{color:var(--mut);max-width:38em;margin-top:12px;font-size:.96rem}
.sec-h .cite{margin-top:14px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.62rem;letter-spacing:.1em;color:var(--dim)}
/* ── Features ── */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
@media(max-width:900px){.grid3{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.grid3{grid-template-columns:1fr}}
.f-card{border:1px solid var(--line);padding:22px;background:var(--card-bg);transition:all .45s cubic-bezier(.22,.61,.36,1);overflow:hidden;position:relative;cursor:pointer}
.f-card:hover{border-color:var(--line2);transform:scale(1.03);z-index:4}
.grid3:hover .f-card:not(.active):not(:hover){filter:blur(3px);opacity:.38;transform:scale(.95)}
.grid3.has-active .f-card.active{position:fixed;top:50%;left:50%;width:min(780px,92vw);z-index:60;margin:0;cursor:default;border-color:var(--line2);box-shadow:var(--shadow);max-height:86vh;overflow-y:auto;transform:translate(-50%,-50%)}
.grid3.has-active::before{content:'';position:fixed;inset:0;background:rgba(5,4,2,.55);backdrop-filter:blur(6px);z-index:55}
.grid3.has-active .f-card:not(.active){filter:blur(5px);opacity:.12;transform:scale(.92);pointer-events:none}
.f-card .sub{color:var(--mut);font-size:.88rem}
.f-card .more{max-height:0;opacity:0;overflow:hidden;color:var(--mut);font-size:.85rem;transition:max-height .55s cubic-bezier(.22,.61,.36,1),opacity .65s ease}
.f-card.active .more{max-height:190px;opacity:1}
.f-card .ln{width:28px;height:1px;background:var(--gold);margin:12px 0}
.f-card .n{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;color:var(--dim);letter-spacing:.2em}
.f-card .ln{width:28px;height:1px;background:var(--gold);margin:12px 0}
.f-card h3{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:1.08rem;margin-bottom:6px}
.f-card p{color:var(--mut);font-size:.87rem}
/* ── Qadamlar ── */
.cycle{background:linear-gradient(180deg,var(--bg) 0%,var(--bg2) 100%)}
.route-svg{width:100%;height:auto;margin:8px 0 0;overflow:visible}
.j-label{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.12em;fill:var(--dim)}
.j-check{fill:var(--bg);stroke:var(--line2);stroke-width:1.5;transition:all .35s}
.j-check.on{fill:var(--gold);stroke:var(--gold);filter:drop-shadow(0 0 7px var(--gold))}
[data-theme="light"] #runner circle:first-child{opacity:.3}
.j-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
@media(max-width:860px){.j-cards{grid-template-columns:1fr}}
.j-card{border:1px solid var(--line);padding:26px;background:var(--card-bg);transition:all .3s}
.j-card:hover{border-color:var(--line2);transform:translateY(-4px)}
.j-card .n{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;color:var(--dim);letter-spacing:.2em}
.j-card .ln{width:28px;height:1px;background:var(--gold);margin:12px 0}
.j-card h3{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:1.2rem;margin-bottom:6px}
.j-card p{color:var(--mut);font-size:.9rem}
/* ── Signal ── */
.panel{border:1px solid var(--line);background:linear-gradient(180deg,var(--panel-a),var(--panel-b));padding:40px 36px;position:relative}
@media(max-width:760px){.panel{padding:28px 20px}}
.p-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px}
@media(max-width:860px){.p-grid{grid-template-columns:1fr}}
.p-col h3{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:22px;display:flex;justify-content:space-between;align-items:baseline}
.p-col h3 b{font-size:1.3rem;color:var(--ivory);font-family:'Georgia','Times New Roman',serif;font-weight:400}
.p-col h3 b.rise{color:var(--green)}
.bar{margin-bottom:13px}
.bar .lab{display:flex;justify-content:space-between;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;color:var(--mut);margin-bottom:6px}
.bar .track{height:18px;border:1px solid var(--line);background:var(--track-bg);position:relative;overflow:hidden}
.bar i{position:absolute;inset:0 auto 0 0;width:0;transition:width 1.5s cubic-bezier(.22,.61,.36,1)}
.bar i.gold{background:linear-gradient(90deg,var(--gold),var(--gold2))}
.bar i.crimson{background:linear-gradient(90deg,#7a5a3a,var(--crimson))}
.bar i.green{background:linear-gradient(90deg,#3f5c40,var(--green))}
.bar i.grey{background:var(--bar-grey)}
.mosaic{margin-top:24px}
.mosaic .cap{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.17em;text-transform:uppercase;color:var(--dim);margin-bottom:9px}
.m-grid{display:grid;grid-template-columns:repeat(14,1fr);gap:4px}
.signal-foot{margin-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;border-top:1px solid var(--line);padding-top:18px}
.signal-foot .big{font-family:'Georgia','Times New Roman',serif;font-size:1.4rem}
.signal-foot .big b{color:var(--green)}
.signal-foot .note{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.13em;text-transform:uppercase;color:var(--dim);align-self:center}
/* ── Auth ── */
.auth{max-width:560px;margin:0 auto}
.auth-card{position:relative;border:1px solid var(--line);background:linear-gradient(180deg,var(--panel-a),var(--panel-b));padding:32px 32px 26px;box-shadow:var(--shadow)}
.auth-head{text-align:center;margin-bottom:22px}
.auth-head .k{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
.auth-head h2{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:1.35rem}
.auth-head h2 em{font-style:italic;color:var(--gold2)}
.tabs{display:flex;border:1px solid var(--line);margin-bottom:20px}
.tabs button{flex:1;background:transparent;border:none;color:var(--mut);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;padding:11px;cursor:pointer;transition:all .15s}
.tabs button+button{border-left:1px solid var(--line)}
.tabs button:hover{color:var(--ivory)}
.tabs button.on{background:var(--gold);color:var(--on-gold)}
.providers{display:grid;gap:10px;margin-bottom:16px}
.provider{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px 14px;border-radius:6px;font-family:inherit;font-size:.92rem;font-weight:600;cursor:pointer;transition:all .18s;background:transparent;border:1px solid var(--line);color:var(--ivory)}
.provider:hover{border-color:var(--line2);transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.12)}
.provider svg{width:18px;height:18px;flex-shrink:0}
.provider-g:hover{color:var(--gold2)}
.provider-o:hover{color:#9db4e8}
.sep{display:flex;align-items:center;gap:12px;color:var(--dim);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;margin:2px 0 16px}
.sep::before,.sep::after{content:'';flex:1;border-top:1px solid var(--line)}
.fld{margin-bottom:13px}
.fld label{display:block;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:6px}
.fld input{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--ivory);font-family:inherit;font-size:.92rem;padding:10px 13px;transition:border-color .2s}
.fld input:focus{outline:none;border-color:var(--gold)}
.auth-submit{width:100%;padding:12px}
.auth-msg{display:none;margin-top:14px;border:1px solid var(--green);color:var(--green);padding:11px 14px;font-size:.85rem;text-align:center}
.auth-msg.show{display:block}
.auth-msg.err{display:block;border-color:var(--crimson);color:var(--crimson)}
.demo-hint{margin-top:12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.56rem;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);text-align:center}
/* ── Cred / CTA / Footer ── */
.cred{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cred-in{max-width:1160px;margin:0 auto;padding:26px 30px;display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center}
.cred span{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);display:flex;align-items:center;gap:10px}
.cred span::before{content:'◆';color:var(--dim);font-size:.5rem}
.cta-stamp{margin-bottom:16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--dim)}
.cta{text-align:center;padding:110px 30px}
.cta h2{font-family:'Georgia','Times New Roman',serif;font-weight:400;font-size:clamp(1.8rem,4vw,3rem);line-height:1.14;margin-bottom:16px}
.cta h2 em{font-style:italic;color:var(--gold2)}
.cta p{color:var(--mut);margin-bottom:32px}
.cta .btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.ftr{border-top:1px solid var(--line);margin-top:20px;padding:44px 30px 30px}
.ftr-in{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:26px}
@media(max-width:640px){.ftr-in{grid-template-columns:1fr 1fr}}
.ftr h4{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);margin-bottom:12px}
.ftr a{display:block;color:var(--mut);font-size:.84rem;margin-bottom:7px;padding-left:0;transition:color .2s,padding-left .2s}
.ftr a:hover{color:var(--gold2);padding-left:6px}
.ftr-copy{max-width:1160px;margin:28px auto 0;border-top:1px solid var(--line);padding-top:16px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.54rem;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.beam .dot,.sc-live i,.scroll-hint::after{animation:none}}
</style>
</head>
