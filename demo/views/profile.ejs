<%- include('partials/app-head', { title: 'Deborah — Profil', curtain: curtain }) %>
<style>
/* ── Profil sahifasi ── */
.profile-head{display:flex;align-items:center;gap:20px;margin:28px 0 34px;padding-bottom:26px;border-bottom:1px solid var(--line2)}
.profile-ava{width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,var(--gold),#8a6a2e);color:var(--on-gold);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:1.6rem;font-weight:600;flex-shrink:0;box-shadow:0 0 0 4px var(--bg),0 0 0 5px var(--line2)}
.profile-name{font-family:var(--serif);font-size:1.8rem;font-weight:600;line-height:1.15}
.profile-role{font-size:.82rem;color:var(--gold);font-style:italic;margin-top:3px}
.profile-email{font-size:.84rem;color:var(--text3);margin-top:2px}

.row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 6px;border-bottom:1px solid var(--line)}
.row:last-of-type{border-bottom:none}
.row:hover{background:var(--panel)}
.row .k{font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text3)}
.row .v{font-size:.92rem;font-weight:600;text-align:right}
.row .v.info{color:var(--info2)}
.row .v.good{color:var(--good2)}
.row .v.warn{color:var(--warn2)}

.edit-btn{font-size:.8rem;font-weight:600;letter-spacing:.06em;border:1px solid var(--line2);color:var(--text2);padding:9px 18px;cursor:pointer;transition:all .15s}
.edit-btn:hover{border-color:var(--gold);color:var(--gold2)}
</style>

<%- include('partials/app-sidebar', { active: 'profile', user: user }) %>
<%- include('partials/app-topbar', { active: 'profile', tbTitle: 'Profil' }) %>

  <div class="content page-enter">

    <div class="page-kicker" data-i18n="pr.kicker">Shaxsiy ma'lumotlar</div>
    <h1 class="page-title" data-i18n="pr.title">Profil</h1>

    <div class="profile-head">
      <span class="profile-ava"><%= (user ? user.name : 'User1').slice(0,2).toUpperCase() %></span>
      <div>
        <div class="profile-name"><%= user ? user.name : 'user1' %></div>
        <div class="profile-role" data-i18n="pr.role">Talaba · oddiy reja</div>
        <div class="profile-email"><%= user ? user.email : 'user1@gmail.com' %></div>
      </div>
    </div>

    <div class="card">
      <div class="card-title" data-i18n="pr.details">Asosiy ma'lumotlar</div>
      <div class="row"><span class="k" data-i18n="pr.grp">Guruh</span><span class="v"><%= user ? user.group : "KIB-22-1" %></span></div>
      <div class="row"><span class="k" data-i18n="pr.uni">Universitet</span><span class="v"><%= user ? user.university : "TATU" %></span></div>
      <div class="row"><span class="k" data-i18n="pr.tests">Bajarilgan testlar</span><span class="v info">12</span></div>
      <div class="row"><span class="k" data-i18n="pr.rank">Reyting</span><span class="v warn">#34 / 240</span></div>
    </div>

    <div class="card">
      <div class="card-title" data-i18n="pr.settings">Sozlamalar</div>
      <div class="row">
        <span class="k" data-i18n="pr.lang">Til</span>
        <span class="v">O'zbekcha</span>
      </div>
      <div class="row">
        <span class="k" data-i18n="pr.theme">Tema</span>
        <span class="v" id="themeVal">Dark</span>
      </div>
      <div class="row">
        <span class="k" data-i18n="pr.pass">Parol</span>
        <button class="edit-btn" type="button" data-i18n="pr.change">O'zgartirish</button>
      </div>
    </div>

<%- include('partials/app-footer') %>
