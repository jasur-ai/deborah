<!-- TOPBAR -->
<div class="main">
  <header class="topbar">
    <span class="tb-title" data-i18n="tb.<%= active %>"><%= tbTitle %></span>
    <div class="tb-right">
      <div class="lang" role="group" aria-label="Til">
        <button data-lang="uz" class="on" type="button">UZ</button>
        <button data-lang="ru" type="button">RU</button>
        <button data-lang="en" type="button">EN</button>
      </div>
      <button class="tbtn" id="themeBtn" type="button" aria-label="Tema">
        <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
        <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/></svg>
      </button>
    </div>
  </header>
