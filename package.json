{
  "name": "edikit",
  "version": "2.0.0",
  "description": "Edikit — Real-time multiplayer quiz platform (Node.js Edition)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "node scripts/mock-up.js",
    "seed": "node scripts/seed-dev.js",
    "reset": "rm -f data/db.json && npm run seed",
    "build:og": "node scripts/build-og-image.js",
    "build:pwa": "node scripts/build-pwa-icons.js",
    "build": "npm run build:pwa && npm run build:og",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "pretest:vip": "rm -f data/db.json",
    "test:vip": "node scripts/test-vip-browser.js",
    "test:typecheck": "tsc --noEmit",
    "test:security": "node scripts/test-xss.js",
    "test:security:ci": "node scripts/security-ci.js",
    "test:security:fuzz": "node scripts/security-fuzz.js",
    "test:load": "node scripts/load-test.js --all",
    "test:chaos": "node scripts/chaos-inject.js --all",
    "test:drill": "node scripts/backup-restore-drill.js --all",
    "test:reliability": "vitest run tests/unit/reliability.test.js tests/integration/reliability.test.js tests/e2e/reliability-release.test.js && npm run test:load && npm run test:chaos && npm run test:drill",
    "test:gate0": "bash scripts/gate-0-verify.sh",
    "test:anskey": "node scripts/answer-key-scan.js",
    "test:security-guard": "vitest run tests/unit/security-guard.test.js tests/integration/security-guard.test.js tests/e2e/security-guard-redteam.test.js",
    "test": "npm run typecheck && npm run test:ci && npm run test:security && npm run test:vip",
    "verify:all": "npm run typecheck && npm run test:ci && npm run test:security && npm run test:reliability && node scripts/release-signoff.js --rehearsal && node scripts/final-migration.js --rehearsal"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "argon2": "^0.45.1",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.4",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
