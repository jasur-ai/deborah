<%
// ── Role-aware accessible sidebar (Prompt 68) ──
// Local'lar: active (string), role (string|null), user (obj|null)
// Fallback: role -> res.locals.role (setLocals orqali) -> session rol.
// VIEW TARTIBI: <body> → include(sidebar) → view o'z <main class="main"> qismi.
const _active = typeof active !== 'undefined' ? active : '';
const _role = typeof role !== 'undefined' && role
  ? role
  : (typeof res !== 'undefined' && res.locals && res.locals.role) || 'student';
const _user = typeof user !== 'undefined' ? user : (typeof res !== 'undefined' && res.locals && res.locals.user) || null;
const _uname = (_user && _user.username) || '';
const _roleLabel = (typeof roleLabel !== 'undefined' && roleLabel)
  ? roleLabel
  : ({ admin: 'Administrator', teacher: "O'qituvchi", student: 'Talaba', proctor: 'Proktor', marker: 'Baholovchi', board: "Hay'at" })[_role] || 'Talaba';
const _nav = (typeof navItems !== 'undefined' && navItems) ? navItems : null;
const _isActive = (href) => {
  if (!href || href === '/') return _active === href;
  return _active === href || _active.indexOf(href) === 0;
};
%>
<a href="#main-content" class="skip-link">Asosiy kontentga o'tish</a>

<button type="button" class="shell-burger" data-shell-open aria-label="Menyu ochish" aria-expanded="false" aria-controls="shell-sidebar"><%- icon('menu', 18) %></button>

<aside class="shell-sidebar" id="shell-sidebar" role="navigation" aria-label="Asosiy navigatsiya">
  <div class="shell-side-head">
    <a href="/" class="shell-brand" aria-label="Edikit bosh sahifa">
      <img src="/images/logo-icon.svg" alt="" class="logo-img" style="height:28px;width:auto">
      <span class="shell-brand-name">Edikit</span>
    </a>
    <button type="button" class="shell-close" data-shell-close aria-label="Yopish"><%- icon('close', 16) %></button>
  </div>

  <div class="shell-role-chip" role="status">
    <span class="shell-role-ico"><%- icon('user', 13) %></span>
    <span class="shell-role-label"><%= _roleLabel %></span>
    <% if (_uname) { %><span class="shell-role-user">@<%= _uname %></span><% } %>
  </div>

  <nav class="shell-nav" aria-label="Bo'limlar">
    <% if (_nav) { %>
      <% _nav.forEach(item => { %>
        <% if (item.section) { %>
          <div class="shell-nav-sec"><%= item.section %></div>
        <% } else { %>
          <a href="<%= item.href %>" class="shell-nav-link<%= _isActive(item.href) ? ' active' : '' %>" aria-current="<%= _isActive(item.href) ? 'page' : 'false' %>">
            <span class="shell-nav-ico"><%- icon(item.icon || 'chevronDown', 16) %></span>
            <span><%= item.label %></span>
          </a>
        <% } %>
      <% }); %>
    <% } else if (_role === 'admin') { %>
      <div class="shell-nav-sec">Boshqaruv</div>
      <a href="/admin/dashboard" class="shell-nav-link<%= _isActive('/admin/dashboard') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span>Dashboard</span></a>
      <a href="/admin/vip" class="shell-nav-link<%= _isActive('/admin/vip') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('shield', 16) %></span><span>VIP</span></a>
      <a href="/admin/contracts" class="shell-nav-link<%= _isActive('/admin/contracts') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('file', 16) %></span><span>API Contracts</span></a>
      <div class="shell-nav-sec">Rol workspace'lar</div>
      <a href="/teacher" class="shell-nav-link<%= _isActive('/teacher') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('bookOpen', 16) %></span><span>O'qituvchi</span></a>
      <a href="/proctor" class="shell-nav-link<%= _isActive('/proctor') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('monitor', 16) %></span><span>Proktor</span></a>
      <a href="/marker" class="shell-nav-link<%= _isActive('/marker') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span>Baholovchi</span></a>
      <a href="/board" class="shell-nav-link<%= _isActive('/board') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('award', 16) %></span><span>Hay'at</span></a>
      <a href="/student" class="shell-nav-link<%= _isActive('/student') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('user', 16) %></span><span>Talaba</span></a>
    <% } else if (_role === 'teacher') { %>
      <div class="shell-nav-sec">Ish maydoni</div>
      <a href="/teacher" class="shell-nav-link<%= _isActive('/teacher') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span>Overview</span></a>
      <a href="/teacher?tab=courses" class="shell-nav-link<%= _active === 'courses' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('bookOpen', 16) %></span><span>Kurslar</span></a>
      <a href="/teacher?tab=assessments" class="shell-nav-link<%= _active === 'assessments' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('target', 16) %></span><span>Baholashlar</span></a>
      <a href="/teacher?tab=grading" class="shell-nav-link<%= _active === 'grading' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span>Grading queue</span></a>
      <div class="shell-nav-sec">Asboblar</div>
      <a href="/user/panel" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('book', 16) %></span><span>Testlarim</span></a>
      <a href="/user/create-test" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('plus', 16) %></span><span>Yangi test</span></a>
    <% } else if (_role === 'student') { %>
      <div class="shell-nav-sec">Talaba</div>
      <a href="/user/panel" class="shell-nav-link<%= _active === 'panel' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span>Panelim</span></a>
      <a href="/student" class="shell-nav-link<%= _isActive('/student') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('calendar', 16) %></span><span>Kalendar</span></a>
      <a href="/user/portfolio" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('award', 16) %></span><span>Portfolio</span></a>
      <a href="/user/security-profile" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('shieldCheck', 16) %></span><span>Xavfsizlik</span></a>
    <% } else if (_role === 'proctor') { %>
      <div class="shell-nav-sec">Proktor</div>
      <a href="/proctor" class="shell-nav-link<%= _active === 'monitor' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('monitor', 16) %></span><span>Jonli monitoring</span></a>
      <a href="/admin/camera-review" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('camera', 16) %></span><span>Camera review</span></a>
      <a href="/admin/command-center" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('zap', 16) %></span><span>Command Center</span></a>
    <% } else if (_role === 'marker') { %>
      <div class="shell-nav-sec">Baholovchi</div>
      <a href="/marker" class="shell-nav-link<%= _active === 'queue' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span>Grading queue</span></a>
      <a href="/admin/marking" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('checkCircle', 16) %></span><span>Marking</span></a>
      <a href="/admin/consideration" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('alertTriangle', 16) %></span><span>Consideration</span></a>
    <% } else if (_role === 'board') { %>
      <div class="shell-nav-sec">Hay'at</div>
      <a href="/board" class="shell-nav-link<%= _active === 'ratify' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('award', 16) %></span><span>Ratifikatsiya</span></a>
      <a href="/admin/board" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('shield', 16) %></span><span>Board</span></a>
      <a href="/admin/grading" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('trendUp', 16) %></span><span>Grading</span></a>
    <% } %>
  </nav>

  <div class="shell-side-foot">
    <a href="/" class="shell-foot-link"><%- icon('home', 14) %> Bosh sahifa</a>
    <button type="button" class="shell-foot-link" data-theme-toggle title="Temani almashtirish"><%- icon('moon', 14) %></button>
  </div>
</aside>

<div class="shell-overlay" data-shell-close aria-hidden="true"></div>
