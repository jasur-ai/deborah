<%
// ── Role-aware accessible sidebar (Prompt 68) ──
// Local'lar: active (string), role (string|null), user (obj|null)
// Fallback: role -> res.locals.role (setLocals orqali) -> session rol.
// VIEW TARTIBI: <body> → include(sidebar) → view o'z <main class="main"> qismi.
const _active = typeof active !== 'undefined' ? active : '';
const _role = typeof role !== 'undefined' && role
  ? role
  : (typeof res !== 'undefined' && res.locals && res.locals.role) || 'student';
const _user = typeof user !== 'undefined' ? user : (typeof res !== 'undefined' && res.locals && res.locals.user) || null;
const _uname = (_user && _user.username) || '';
const _sb = ((typeof copy !== 'undefined' && copy.sidebar) ? copy.sidebar : ((typeof fullCopy !== 'undefined' && fullCopy && fullCopy.sidebar) ? fullCopy.sidebar : null));
const _tc = ((typeof copy !== 'undefined' && copy.header) ? copy.header : ((typeof fullCopy !== 'undefined' && fullCopy && fullCopy.header) ? fullCopy.header : null));
// S14 (BUG-087): sidebar 4 til — copy.sidebar (AUTH_COPY[l]); copy yo'qsa uz fallback
const _st = (k, fb) => (_sb && _sb[k]) ? _sb[k] : fb;
// Til bo'yicha tarjima ustuvor (AUTH sidebar dict); aks holda UZ default
const _roleKey = 'role' + String(_role || '').charAt(0).toUpperCase() + String(_role || '').slice(1);
const _roleLabel = (_sb && _sb[_roleKey])
  ? _sb[_roleKey]
  : ((typeof roleLabel !== 'undefined' && roleLabel) ? roleLabel : ({ admin: 'Administrator', teacher: "O'qituvchi", student: 'Talaba', proctor: 'Proktor', marker: 'Baholovchi', board: "Hay'at" })[_role] || 'Talaba');
const _nav = (typeof navItems !== 'undefined' && navItems) ? navItems : null;
const _isActive = (href) => {
  if (!href || href === '/') return _active === href;
  return _active === href || _active.indexOf(href) === 0;
};
// S34h: ROLE_NAV label/section'larini user tili bo'yicha tarjima qilish
// (navCopy routes/roles.js dan keladi; _sb — AUTH sidebar dict fallback)
const _navKeyMap = { 'Panelim': 'myPanel', 'Topshiriqlar': 'assignments', 'Portfolio': 'portfolio', 'Xavfsizlik': 'security', "Umumiy ko'rinish": 'overview', 'Kurslar': 'courses', 'Baholashlar': 'assessments', 'Baholash navbati': 'gradingQueue', 'Testlarim': 'myTests', 'Yangi test': 'newTest', 'AI Studiya': 'aiStudio', 'Jonli monitoring': 'liveMonitor', 'Kamera tekshiruvi': 'cameraReview', 'Boshqaruv markazi': 'commandCenter', 'Belgilash': 'marking', "Ko'rib chiqish": 'consider', 'Ratifikatsiya': 'ratification', 'Board': 'board', 'Grading': 'grading' };
const _navSecMap = { "Ish maydoni": 'secWork', 'Asboblar': 'secTools', 'Talaba': 'roleStudent', 'Proktor': 'roleProctor', 'Baholovchi': 'roleMarker', "Hay'at": 'roleBoard', 'Akkaunt': 'secAccount' };
const _nC = (typeof navCopy !== 'undefined' && navCopy) ? navCopy : null;
const _nT = (k, fb) => {
  if (_nC && k && _nC[k]) return _nC[k];
  if (_sb && k && _sb[k]) return _sb[k];
  return fb;
};
%>
<% if (_role === 'admin') { %>
  <%
    const _adminPath = (typeof path !== 'undefined' && path) ? String(path).split('?')[0] : String(_active || '').split('?')[0];
    const _adminTab = (typeof query !== 'undefined' && query && query.tab) ? query.tab : '';
  %>
  <a href="#main-content" class="skip-link">Asosiy kontentga o'tish</a>
  <button type="button" class="shell-burger admin-legacy-trigger" aria-label="Admin menyusini ochish" aria-expanded="false" aria-controls="admin-sidebar" data-admin-toggle><%- icon('menu', 18) %></button>
  <%- include('admin-sidebar', { activePath: _adminPath, activeTab: _adminTab, legacyShell: true }) %>
<% } else { %>
<a href="#main-content" class="skip-link">Asosiy kontentga o'tish</a>

<button type="button" class="shell-burger" data-shell-open aria-label="Menyu ochish" aria-expanded="false" aria-controls="shell-sidebar"><%- icon('menu', 18) %></button>

<aside class="shell-sidebar" id="shell-sidebar" role="navigation" aria-label="Asosiy navigatsiya">
  <div class="shell-side-head">
    <a href="/" class="shell-brand" aria-label="Deborah bosh sahifa">
      <img src="/images/logo-text.svg" alt="Deborah" class="logo-img shell-brand-logo">
    </a>
    <button type="button" class="shell-close" data-shell-close aria-label="Yopish"><%- icon('close', 16) %></button>
  </div>

  <div class="shell-role-chip" role="status">
    <span class="shell-role-ico"><%- icon('user', 13) %></span>
    <span class="shell-role-label"><%= _roleLabel %></span>
    <% if (_uname) { %><span class="shell-role-user">@<%= _uname %></span><% } %>
  </div>

  <nav class="shell-nav" aria-label="Bo'limlar">
    <% if (_nav) { %>
      <% _nav.forEach(item => { %>
        <% if (item.section) { %>
          <div class="shell-nav-sec"><%= _nT(_navSecMap[item.section] || '', item.section) %></div>
        <% } else { %>
          <a href="<%= item.href %>" class="shell-nav-link<%= _isActive(item.href) ? ' active' : '' %>" aria-current="<%= _isActive(item.href) ? 'page' : 'false' %>">
            <span class="shell-nav-ico"><%- icon(item.icon || 'chevronDown', 16) %></span>
            <span><%= _nT(_navKeyMap[item.label] || '', item.label) %></span>
          </a>
        <% } %>
      <% }); %>
    <% } else if (_role === 'teacher') { %>
      <div class="shell-nav-sec">Ish maydoni</div>
      <a href="/teacher" class="shell-nav-link<%= _isActive('/teacher') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span>Umumiy ko'rinish</span></a>
      <a href="/teacher?tab=courses" class="shell-nav-link<%= _active === 'courses' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('bookOpen', 16) %></span><span><%= _st('courses', 'Kurslar') %></span></a>
      <a href="/teacher?tab=assessments" class="shell-nav-link<%= _active === 'assessments' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('target', 16) %></span><span><%= _st('assessments', 'Baholashlar') %></span></a>
      <a href="/teacher?tab=grading" class="shell-nav-link<%= _active === 'grading' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span><%= _st('gradingQueue', 'Baholash navbati') %></span></a>
      <div class="shell-nav-sec"><%= _st('secTools', 'Asboblar') %></div>
      <a href="/user/tests" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('book', 16) %></span><span><%= _st('myTests', 'Testlarim') %></span></a>
      <a href="/user/create-test" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('plus', 16) %></span><span><%= _st('newTest', 'Yangi test') %></span></a>
      <a href="/user/presentations" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('monitor', 16) %></span><span><%= _st('presentations', 'Taqdimotlar') %></span></a>
      <a href="/user/ai-studio" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('sparkles', 16) %></span><span>AI Studiya</span></a>
    <% } else if (_role === 'student') { %>
      <% /* 09/2026: Portfolio bo'limi olib tashlandi (foydalanuvchi qarori).
             'Ish maydoni' bo'limi ichida workspace (Panelim) turadi; Xavfsizlik Akkaunt'ga o'tdi. */ %>
      <div class="shell-nav-sec">Ish maydoni</div>
      <a href="/user/panel" class="shell-nav-link<%= _active === 'panel' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span><%= _st('myPanel', 'Ish maydonim') %></span></a>
      <% /* C4-10: Testlar alohida bo'lim — Taqdimotlar kabi (panel = umumiy ko'rinish) */ %>
      <a href="/user/tests" class="shell-nav-link<%= _active === 'tests' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('fileText', 16) %></span><span><%= _st('myTests', 'Testlar') %></span></a>
      <% /* 09/2026: Taqdimotlar bo'limi — Google Slides/Canva uslubi, sayt ichida */ %>
      <a href="/user/presentations" class="shell-nav-link<%= _active === 'presentations' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('monitor', 16) %></span><span><%= _st('presentations', 'Taqdimotlar') %></span></a>
      <% /* 09/2026 user qarori: AI Studiya hamma userlarga (oddiy/VIP/teacher) */ %>
      <a href="/user/ai-studio" class="shell-nav-link<%= _active === 'ai-studio' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('sparkles', 16) %></span><span><%= _st('aiStudio', 'AI Studiya') %></span></a>
    <% } else if (_role === 'proctor') { %>
      <div class="shell-nav-sec"><%= _st('roleProctor', 'Proktor') %></div>
      <a href="/proctor" class="shell-nav-link<%= _active === 'monitor' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('monitor', 16) %></span><span><%= _st('liveMonitor', 'Jonli monitoring') %></span></a>
      <a href="/admin/camera-review" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('camera', 16) %></span><span>Camera review</span></a>
      <a href="/admin/command-center" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('zap', 16) %></span><span>Command Center</span></a>
    <% } else if (_role === 'marker') { %>
      <div class="shell-nav-sec"><%= _st('roleMarker', 'Baholovchi') %></div>
      <a href="/marker" class="shell-nav-link<%= _active === 'queue' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span><%= _st('gradingQueue', 'Baholash navbati') %></span></a>
      <a href="/admin/marking" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('checkCircle', 16) %></span><span>Marking</span></a>
      <a href="/admin/consideration" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('alertTriangle', 16) %></span><span>Consideration</span></a>
    <% } else if (_role === 'board') { %>
      <div class="shell-nav-sec"><%= _st('roleBoard', "Hay'at") %></div>
      <a href="/board" class="shell-nav-link<%= _active === 'ratify' ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('award', 16) %></span><span><%= _st('ratification', 'Ratifikatsiya') %></span></a>
      <a href="/admin/board" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('shield', 16) %></span><span>Board</span></a>
      <a href="/admin/grading" class="shell-nav-link"><span class="shell-nav-ico"><%- icon('trendUp', 16) %></span><span>Grading</span></a>
    <% } %>
    <% if (!['teacher_pending', 'teacher_rejected'].includes(_role)) { %>
      <div class="shell-nav-sec"><%= _st('practiceLibrary', 'Mashq kutubxonasi') %></div>
      <a href="/user/panel#mock-fanlar" class="shell-nav-link" data-practice-nav="mock">
        <span class="shell-nav-ico"><%- icon('bookOpen', 16) %></span><span><%= _st('mockFans', 'Mock fanlar') %></span>
      </a>
      <a href="/user/panel#subtestlar" class="shell-nav-link" data-practice-nav="subtests">
        <span class="shell-nav-ico"><%- icon('clipboard', 16) %></span><span><%= _st('subtests', 'Subtestlar') %></span>
      </a>
    <% } %>
    <div class="shell-nav-sec"><%= _st('secAccount', 'Akkaunt') %></div>
    <% const _profileHref = _role === 'admin' ? '/admin/profile' : '/user/profile'; %>
    <a href="<%= _profileHref %>" class="shell-nav-link<%= _isActive(_profileHref) ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('user', 16) %></span><span><%= _role === 'admin' ? 'Admin profili' : _st('myProfile', 'Profilim') %></span></a>
    <% if (_role === 'student') { %><a href="/user/security-profile" class="shell-nav-link<%= _isActive('/user/security-profile') ? ' active' : '' %>"><span class="shell-nav-ico"><%- icon('shieldCheck', 16) %></span><span><%= _st('security', 'Xavfsizlik') %></span></a><% } %>
    <% // Roldan kelib chiqib to'g'ri sessiyani tugatish. %>
    <form method="post" action="<%= _role === 'admin' ? '/admin/logout' : '/user/logout' %>" style="margin:0;display:block;width:100%">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="shell-nav-link shell-nav-btn">
        <span class="shell-nav-ico"><%- icon('logOut', 16) %></span><span><%= _st('logout', 'Chiqish') %></span>
      </button>
    </form>
  </nav>

  <!-- S17.11: Account menu — theme + home + logout grouped (logout primary emas) -->
  <div class="shell-account" data-shell-account>
    <button type="button" class="shell-account-btn" aria-haspopup="true" aria-expanded="false" aria-controls="shell-account-menu">
      <span class="shell-nav-ico"><%- icon('user', 15) %></span>
      <span>
        <span class="shell-account-name"><%= _uname || _roleLabel %></span>
        <span class="shell-account-sub"><%= _roleLabel %></span>
      </span>
      <span class="shell-nav-ico" style="margin-left:auto;opacity:.6"><%- icon('chevronDown', 12) %></span>
    </button>
    <div class="shell-account-menu" id="shell-account-menu">
      <a href="<%= _role === 'admin' ? '/admin/dashboard' : '/' %>" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('home', 14) %></span> <%= _role === 'admin' ? 'Boshqaruv paneli' : _st('home', 'Bosh sahifa') %></a>
      <a href="<%= _role === 'admin' ? '/admin/index' : '/user/panel' %>" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('grid', 14) %></span> <%= _role === 'admin' ? 'Barcha funksiyalar' : _st('panel', 'Panel') %></a>
      <% /* 09/2026 (user qarori): Profilim akkaunt-menyusidan olib tashlandi —
             profil faqat sidebar navigatsiyasida bitta joyda turadi (dublikat yo'q). */ %>
      <%- include('theme-control', { headerCopy: _tc }) %>
      <a href="<%= _role === 'admin' ? '/admin/logout' : '/user/logout' %>" class="shell-account-menu-item shell-account-menu-item--logout"><span class="shell-nav-ico"><%- icon('logOut', 14) %></span> <%= _st('logout', 'Chiqish') %></a>
    </div>
  </div>
</aside>

<div class="shell-overlay" data-shell-close aria-hidden="true"></div>
<% } %>
