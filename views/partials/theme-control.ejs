<%
  // Deborah Theme Control — icon-only System / Light / Dark controls.
  // Labels remain available to screen readers and as hover tooltips.
  const _h = (typeof headerCopy !== 'undefined' && headerCopy) ? headerCopy
    : ((typeof copy !== 'undefined' && copy.header) ? copy.header : null);
  const tcCopy = {
    label: (_h && _h.themeLabel) ? _h.themeLabel : 'Mavzu',
    system: (_h && _h.themeSystem) ? _h.themeSystem : 'Tizim',
    light: (_h && _h.themeLight) ? _h.themeLight : 'Yorugʻ',
    dark: (_h && _h.themeDark) ? _h.themeDark : 'Qorongʻi',
  };
%>
<div class="theme-segmented" role="group" aria-label="<%= tcCopy.label %>">
  <button type="button" data-theme-state-btn="system" aria-pressed="false" aria-label="<%= tcCopy.system %>" title="<%= tcCopy.system %>"><%- icon('monitor', 17).replace('<svg', '<svg aria-hidden="true" focusable="false"') %></button>
  <button type="button" data-theme-state-btn="light" aria-pressed="false" aria-label="<%= tcCopy.light %>" title="<%= tcCopy.light %>"><%- icon('sun', 17).replace('<svg', '<svg aria-hidden="true" focusable="false"') %></button>
  <button type="button" data-theme-state-btn="dark" aria-pressed="false" aria-label="<%= tcCopy.dark %>" title="<%= tcCopy.dark %>"><%- icon('moon', 17).replace('<svg', '<svg aria-hidden="true" focusable="false"') %></button>
</div>
