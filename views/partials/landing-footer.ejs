<!-- Landing footer (plan_index §3.9, STEP 21 S21.06/09) — kolonnalar, admin utility'da -->
<footer class="ld-footer">
  <div class="ld-container">
    <div class="ld-footer-grid">
      <div class="ld-footer-col">
        <div class="ld-footer-head"><%= copy.footer.colProduct %></div>
        <ul class="ld-footer-list">
          <li><a href="#features"><%= copy.footer.productFeatures %></a></li>
          <li><a href="#demo"><%= copy.footer.productDemo %></a></li>
          <li><a href="#how"><%= copy.footer.productHow %></a></li>
          <li><a href="#roles"><%= copy.footer.productRoles %></a></li>
        </ul>
      </div>
      <div class="ld-footer-col">
        <div class="ld-footer-head"><%= copy.footer.colCast %></div>
        <ul class="ld-footer-list">
          <li><a href="/play"><%= copy.footer.castJoin %></a></li>
        </ul>
      </div>
      <div class="ld-footer-col">
        <div class="ld-footer-head"><%= copy.footer.colLegal %></div>
        <ul class="ld-footer-list">
          <li><a href="/shartlar"><%= copy.footer.terms %></a></li>
          <li><a href="/privacy"><%= copy.footer.privacy %></a></li>
          <li><a href="/security"><%= copy.footer.security %></a></li>
          <li><a href="/accessibility"><%= copy.footer.accessibility %></a></li>
        </ul>
      </div>
      <div class="ld-footer-col">
        <div class="ld-footer-head"><%= copy.footer.colUtility %></div>
        <ul class="ld-footer-list">
          <li><a href="/admin/login"><%= copy.footer.admin %></a></li>
          <li><a href="https://t.me/edikit" rel="noopener"><%= copy.footer.telegram %></a></li>
          <li><a href="/"><%= copy.footer.langs %></a></li>
        </ul>
      </div>
    </div>
    <div class="ld-footer-bottom">
      <span class="ld-footer-copy"><%= copy.footer.rights %></span>
      <nav class="ld-footer-links" aria-label="Footer">
        <a href="/shartlar"><%= copy.footer.terms %></a>
        <a href="/privacy"><%= copy.footer.privacy %></a>
      </nav>
    </div>
  </div>
</footer>
