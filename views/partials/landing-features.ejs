<!-- Landing features (STEP 21/22) — asymmetric bento: product crop + outcome heading (S22.10/11) -->
<section class="ld-features" aria-labelledby="ld-features-title" id="features">
  <div class="ld-container">
    <h2 class="ld-section-title" id="ld-features-title"><%= copy.features.title %></h2>
    <p class="ld-section-desc"><%= copy.features.desc %></p>
    <div class="ld-features-grid">
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="0">
        <div class="ld-crop ld-crop--wide" aria-hidden="true">
          <div class="ld-crop-rows">
            <div class="ld-crop-row"><span class="ld-check">✓</span> Brief · preflight · secure submit</div>
            <div class="ld-crop-row"><span class="ld-check">✓</span> 30/30 submitted — on time</div>
          </div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[0].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[0].desc %></p>
      </article>
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="1">
        <div class="ld-crop" aria-hidden="true">
          <div class="ld-crop-rail">
            <i style="width:43%;background:#22c55e"></i><i style="width:20%;background:#3b82f6"></i><i style="width:27%;background:#f59e0b"></i><i style="width:10%;background:#94a3b8"></i>
          </div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[1].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[1].desc %></p>
      </article>
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="2">
        <div class="ld-crop" aria-hidden="true">
          <div class="ld-crop-score"><b>92</b><span class="ld-crop-rail"><i style="width:92%;background:#22c55e"></i></span></div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[2].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[2].desc %></p>
      </article>
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="3">
        <div class="ld-crop" aria-hidden="true">
          <div class="ld-crop-pills"><span class="ld-crop-pill ld-crop-pill--ok">85%</span><span class="ld-crop-pill ld-crop-pill--ok">91%</span><span class="ld-crop-pill ld-crop-pill--ok">78%</span><span class="ld-crop-pill">64%</span></div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[3].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[3].desc %></p>
      </article>
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="4">
        <div class="ld-crop" aria-hidden="true">
          <div class="ld-crop-map"><i></i><i></i><i class="ld-map--weak"></i><i></i><i></i><i></i><i class="ld-map--weak"></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[4].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[4].desc %></p>
      </article>
      <article class="ld-feature-card" data-analytics="feature_view" data-feature="5">
        <div class="ld-crop ld-crop--wide" aria-hidden="true">
          <div class="ld-crop-chat">
            <span class="ld-crop-bubble ld-crop-bubble--ai">Mavzuni tushuntirib beraman — misol bilan:</span>
            <span class="ld-crop-bubble ld-crop-bubble--user">Rahmat, endi tushunarli</span>
          </div>
        </div>
        <h3 class="ld-feature-title"><%= copy.features.cards[5].title %></h3>
        <p class="ld-feature-desc"><%= copy.features.cards[5].desc %></p>
      </article>
    </div>
  </div>
</section>
