<!DOCTYPE html>
<html lang="<%= pageLang || 'uz' %>" dir="ltr">
<head>
  <%- include('partials/head', { title, description }) %>
  <style>
    .info-page { max-width: 760px; margin: 0 auto; padding: 48px 20px 80px; }
    .info-back { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 28px; color: var(--ld-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .info-back:hover { color: var(--ld-text); }
    .info-h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 700; margin: 0 0 10px; }
    .info-meta { color: var(--ld-muted); font-size: 0.9rem; margin: 0 0 8px; }
    .info-h2 { font-size: 1.2rem; font-weight: 700; margin: 34px 0 10px; }
    .info-p { color: var(--ld-muted); line-height: 1.7; margin: 0 0 12px; }
    .info-updated { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--ld-border); color: var(--ld-muted); font-size: 0.8rem; }
  </style>
</head>
<body class="ld-body">
  <a class="ld-skip-link" href="#info-main">Skip to content</a>
  <main id="info-main" class="ld-container info-page">
    <a class="info-back" href="/">← <%= backLabel || 'Bosh sahifa' %></a>
    <h1 class="info-h1"><%= pageTitle %></h1>
    <p class="info-meta"><%= pageMeta %></p>
    <% sections.forEach((s) => { %>
      <h2 class="info-h2"><%= s.h2 %></h2>
      <% s.body.forEach((p) => { %>
        <p class="info-p"><%= p %></p>
      <% }) %>
    <% }) %>
    <p class="info-updated">Oxirgi yangilanish: <%= updatedAt %></p>
  </main>
</body>
</html>
