<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('partials/head') %>
  <style>
    /* ═══════════════════════════════════════════════════════════════
       EDIKIT LANDING — MllyCore-inspired Premium Design
       ═══════════════════════════════════════════════════════════════ */

    /* ── Keyframes ── */
    @keyframes float3d {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      33% { transform: translateY(-12px) rotate(.5deg); }
      66% { transform: translateY(6px) rotate(-.3deg); }
    }
    @keyframes orbitL {
      0% { transform: rotate(0) translateX(180px) rotate(0); }
      100% { transform: rotate(360deg) translateX(180px) rotate(-360deg); }
    }
    @keyframes orbitS {
      0% { transform: rotate(45deg) translateX(120px) rotate(-45deg); }
      100% { transform: rotate(405deg) translateX(120px) rotate(-405deg); }
    }
    @keyframes drift {
      0%, 100% { transform: translate(0, 0); opacity: .15; }
      25% { transform: translate(40px, -30px); opacity: .25; }
      50% { transform: translate(-20px, -60px); opacity: .1; }
      75% { transform: translate(30px, -20px); opacity: .2; }
    }
    @keyframes pulseAura {
      0%, 100% { box-shadow: 0 0 30px rgba(59,130,246,.1); }
      50% { box-shadow: 0 0 60px rgba(56,189,248,.25), 0 0 120px rgba(37,99,235,.08); }
    }
    @keyframes shimmerBtn {
      0% { background-position: 200% center; }
      100% { background-position: -200% center; }
    }
    @keyframes countUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes revealCard {
      from { opacity: 0; transform: translateY(30px) scale(.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes badgePulse {
      0%, 100% { border-color: rgba(56,189,248,.3); }
      50% { border-color: rgba(56,189,248,.7); }
    }

    /* ── Base Landing ── */
    .landing {
      min-height: 100vh;
      background: var(--bg-primary);
      position: relative;
      overflow: hidden;
      transition: background-color .7s var(--ease-smooth);
    }

    /* ── Ambient gradient overlay ── */
    .landing-ambient {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(ellipse 65% 40% at 12% 18%, rgba(59,130,246,.15) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 88% 75%, rgba(56,189,248,.1) 0%, transparent 60%),
        radial-gradient(ellipse 40% 25% at 50% 10%, rgba(99,102,241,.06) 0%, transparent 60%),
        radial-gradient(ellipse 30% 20% at 25% 70%, rgba(6,182,212,.04) 0%, transparent 60%);
      transition: background .7s var(--ease-smooth);
    }
    [data-theme="light"] .landing-ambient {
      background:
        radial-gradient(ellipse 65% 40% at 12% 18%, rgba(37,99,235,.06) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 88% 75%, rgba(59,130,246,.04) 0%, transparent 60%);
    }

    /* ── Floating particles ── */
    .particle {
      position: fixed;
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
    }
    .p1 { width: 8px; height: 8px; background: rgba(56,189,248,.3); top: 15%; left: 10%; animation: drift 18s ease-in-out infinite; }
    .p2 { width: 5px; height: 5px; background: rgba(99,102,241,.25); top: 65%; left: 85%; animation: drift 22s ease-in-out infinite 4s; }
    .p3 { width: 4px; height: 4px; background: rgba(59,130,246,.35); top: 35%; left: 78%; animation: drift 14s ease-in-out infinite 8s; }
    .p4 { width: 6px; height: 6px; background: rgba(6,182,212,.25); top: 80%; left: 22%; animation: drift 20s ease-in-out infinite 2s; }
    .p5 { width: 3px; height: 3px; background: rgba(56,189,248,.3); top: 50%; left: 50%; animation: drift 16s ease-in-out infinite 6s; }
    .p6 { width: 7px; height: 7px; background: rgba(99,102,241,.2); top: 25%; left: 60%; animation: drift 24s ease-in-out infinite 10s; }

    /* ── Orbit rings ── */
    .orbit-ring {
      position: fixed;
      border-radius: 50%;
      border: 1px solid rgba(56,189,248,.05);
      top: 50%; left: 50%;
      pointer-events: none;
      z-index: 0;
      transition: border-color .6s var(--ease-smooth);
    }
    .orbit-1 { width: 360px; height: 360px; margin: -180px 0 0 -180px; animation: orbitL 40s linear infinite; }
    .orbit-1::before {
      content: ''; position: absolute;
      width: 5px; height: 5px; border-radius: 50%;
      background: rgba(56,189,248,.3); top: -2.5px; left: 50%; margin-left: -2.5px;
    }
    .orbit-2 { width: 240px; height: 240px; margin: -120px 0 0 -120px; animation: orbitS 30s linear infinite reverse; border-color: rgba(99,102,241,.04); }
    .orbit-2::before {
      content: ''; position: absolute;
      width: 4px; height: 4px; border-radius: 50%;
      background: rgba(99,102,241,.25); bottom: -2px; right: 50%; margin-right: -2px;
    }

    /* ═══════════════════════════════════════════════════════════════
       HERO SECTION
       ═══════════════════════════════════════════════════════════════ */
    .hero {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 100px 20px 60px;
      text-align: center;
    }
    .hero-inner { max-width: 600px; width: 100%; }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      border-radius: 50px;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .5px;
      text-transform: uppercase;
      background: rgba(56,189,248,.08);
      border: 1px solid rgba(56,189,248,.2);
      color: var(--accent-glow);
      margin-bottom: 24px;
      animation: badgePulse 3s ease-in-out infinite;
      transition: all .4s var(--ease-out);
    }

    .hero-logo-wrap {
      margin-bottom: 16px;
      animation: revealCard 1s var(--ease-out) .1s both;
    }
    .hero-logo {
      display: inline-block;
      max-width: 100%;
      height: auto;
      filter: drop-shadow(0 0 30px rgba(56,189,248,.12));
      transition: filter .6s var(--ease-out);
    }
    .hero-logo:hover {
      filter: drop-shadow(0 0 50px rgba(56,189,248,.3));
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: var(--text-hero);
      line-height: 1.1;
      margin-bottom: 10px;
      background: linear-gradient(135deg, var(--accent-glow), var(--accent), var(--accent-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: revealCard 1s var(--ease-out) .2s both;
    }
    .hero-sub {
      color: var(--text-secondary);
      font-size: var(--text-md);
      font-weight: 600;
      line-height: 1.7;
      max-width: 480px;
      margin: 0 auto 32px;
      animation: revealCard 1s var(--ease-out) .35s both;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      animation: revealCard 1s var(--ease-out) .5s both;
    }
    .hero-btn {
      position: relative;
      overflow: hidden;
      padding: 16px 36px;
      border-radius: 14px;
      font-family: var(--font-body);
      font-size: .95rem;
      font-weight: 900;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all .45s var(--ease-spring);
    }
    .hero-btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-dark));
      color: #fff;
      box-shadow: 0 8px 32px rgba(59,130,246,.3);
    }
    .hero-btn-primary:hover {
      transform: translateY(-5px) scale(1.03);
      box-shadow: 0 16px 48px rgba(59,130,246,.5);
    }
    .hero-btn-secondary {
      background: rgba(255,255,255,.06);
      border: 1px solid var(--border-medium);
      color: var(--text-primary);
      backdrop-filter: blur(6px);
    }
    .hero-btn-secondary:hover {
      transform: translateY(-5px) scale(1.03);
      background: rgba(255,255,255,.12);
      box-shadow: 0 12px 36px rgba(0,0,0,.3);
    }
    .hero-btn-ghost {
      background: rgba(56,189,248,.08);
      border: 1px solid rgba(56,189,248,.2);
      color: var(--accent-glow);
    }
    .hero-btn-ghost:hover {
      transform: translateY(-5px) scale(1.03);
      background: rgba(56,189,248,.18);
      box-shadow: 0 12px 36px rgba(56,189,248,.2);
    }

    /* ═══════════════════════════════════════════════════════════════
       FEATURES SECTION
       ═══════════════════════════════════════════════════════════════ */
    .section {
      position: relative;
      z-index: 1;
      padding: 80px 20px;
    }
    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
    }
    .section-label {
      font-size: .7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--accent-glow);
      margin-bottom: 8px;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      margin-bottom: 12px;
    }
    .section-desc {
      color: var(--text-secondary);
      font-size: var(--text-md);
      font-weight: 600;
      line-height: 1.7;
      max-width: 600px;
      margin-bottom: 40px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
    }
    .feature-card {
      background: var(--bg-card);
      border-radius: 18px;
      padding: 28px 24px;
      border: 1px solid var(--border-light);
      transition: all .4s var(--ease-out);
      position: relative;
      overflow: hidden;
    }
    .feature-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--gradient-primary);
      opacity: 0;
      transition: opacity .4s var(--ease-out);
    }
    .feature-card:hover {
      transform: translateY(-6px);
      border-color: rgba(59,130,246,.25);
      box-shadow: var(--shadow-md);
    }
    .feature-card:hover::before { opacity: 1; }

    .feature-icon {
      width: 52px; height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      background: rgba(59,130,246,.12);
      transition: all .4s var(--ease-out);
    }
    .feature-card:hover .feature-icon {
      background: rgba(59,130,246,.2);
      transform: scale(1.05);
    }
    .feature-name {
      font-family: var(--font-display);
      font-size: 1.15rem;
      margin-bottom: 8px;
    }
    .feature-desc {
      color: var(--text-muted);
      font-size: .85rem;
      font-weight: 600;
      line-height: 1.7;
    }

    /* ═══════════════════════════════════════════════════════════════
       HOW IT WORKS — GUIDE SECTION
       ═══════════════════════════════════════════════════════════════ */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      counter-reset: step;
    }
    .step-card {
      background: var(--bg-card);
      border-radius: 18px;
      padding: 28px 24px;
      border: 1px solid var(--border-light);
      text-align: center;
      transition: all .4s var(--ease-out);
      position: relative;
    }
    .step-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-sm);
    }
    .step-num {
      width: 48px; height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 1.4rem;
      margin: 0 auto 16px;
      background: linear-gradient(135deg, rgba(59,130,246,.15), rgba(56,189,248,.1));
      border: 1px solid rgba(59,130,246,.2);
      color: var(--accent-glow);
      transition: all .4s var(--ease-out);
    }
    .step-card:hover .step-num {
      transform: scale(1.1);
      box-shadow: 0 0 30px rgba(56,189,248,.2);
    }
    .step-title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      margin-bottom: 8px;
    }
    .step-desc {
      color: var(--text-muted);
      font-size: .82rem;
      font-weight: 600;
      line-height: 1.6;
    }

    /* ═══════════════════════════════════════════════════════════════
       STATS / OFFICIAL SECTION
       ═══════════════════════════════════════════════════════════════ */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-block {
      background: var(--bg-card);
      border-radius: 16px;
      padding: 24px 20px;
      text-align: center;
      border: 1px solid var(--border-light);
      transition: all .4s var(--ease-out);
    }
    .stat-block:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-sm);
    }
    .stat-value {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1;
      margin-bottom: 4px;
      background: linear-gradient(135deg, var(--accent-glow), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-label {
      font-size: .78rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    /* ═══════════════════════════════════════════════════════════════
       CTA SECTION
       ═══════════════════════════════════════════════════════════════ */
    .cta-box {
      background: var(--gradient-card);
      border-radius: 24px;
      padding: 50px 40px;
      text-align: center;
      border: 1px solid rgba(59,130,246,.15);
      position: relative;
      overflow: hidden;
    }
    .cta-box::before {
      content: '';
      position: absolute;
      width: 300px; height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56,189,248,.08), transparent 70%);
      top: -100px; right: -80px;
      pointer-events: none;
    }
    .cta-title {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      margin-bottom: 12px;
    }
    .cta-desc {
      color: var(--text-secondary);
      font-size: var(--text-md);
      font-weight: 600;
      margin-bottom: 28px;
    }
    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 44px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-dark));
      color: #fff;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 900;
      border: none;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 8px 32px rgba(59,130,246,.3);
      transition: all .45s var(--ease-spring);
    }
    .cta-btn:hover {
      transform: translateY(-5px) scale(1.03);
      box-shadow: 0 16px 48px rgba(59,130,246,.5);
    }

    /* ═══════════════════════════════════════════════════════════════
       FOOTER
       ═══════════════════════════════════════════════════════════════ */
    .footer {
      position: relative;
      z-index: 1;
      padding: 30px 20px;
      text-align: center;
      border-top: 1px solid var(--border-light);
      transition: border-color .5s var(--ease-out);
    }
    .footer-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .footer-links {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }
    .footer-link {
      font-size: .78rem;
      font-weight: 700;
      color: var(--text-muted);
      text-decoration: none;
      transition: color .3s var(--ease-out);
    }
    .footer-link:hover { color: var(--accent-glow); }
    .footer-copy {
      font-size: .75rem;
      font-weight: 700;
      color: var(--text-disabled);
    }
    .footer-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: .65rem;
      font-weight: 800;
      background: rgba(56,189,248,.08);
      border: 1px solid rgba(56,189,248,.15);
      color: var(--accent-glow);
    }

    /* ═══════════════════════════════════════════════════════════════
       LIGHT THEME OVERRIDES
       ═══════════════════════════════════════════════════════════════ */
    [data-theme="light"] .particle { opacity: .08 !important; }
    [data-theme="light"] .orbit-ring { opacity: .15; border-color: rgba(37,99,235,.06); }
    [data-theme="light"] .landing-ambient {
      background:
        radial-gradient(ellipse 65% 40% at 12% 18%, rgba(37,99,235,.04) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 88% 75%, rgba(59,130,246,.03) 0%, transparent 60%);
    }
    [data-theme="light"] .hero-btn-secondary {
      background: rgba(0,0,0,.04);
      border-color: rgba(0,0,0,.1);
      color: var(--text-primary);
    }
    [data-theme="light"] .hero-btn-secondary:hover {
      background: rgba(0,0,0,.08);
    }
    [data-theme="light"] .hero-btn-ghost {
      background: rgba(37,99,235,.06);
      border-color: rgba(37,99,235,.15);
    }
    [data-theme="light"] .hero-btn-ghost:hover {
      background: rgba(37,99,235,.12);
    }

    /* ═══════════════════════════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════════════════════════ */
    @media (max-width: 768px) {
      .hero { padding: 80px 16px 40px; }
      .hero-title { font-size: var(--text-2xl); }
      .hero-actions { flex-direction: column; align-items: center; }
      .hero-btn { width: 100%; justify-content: center; padding: 14px 24px; }
      .section { padding: 50px 16px; }
      .features-grid { grid-template-columns: 1fr; }
      .steps-grid { grid-template-columns: 1fr; }
      .stats-row { grid-template-columns: repeat(2, 1fr); }
      .cta-box { padding: 36px 24px; }
      .footer-inner { flex-direction: column; text-align: center; }
      .footer-links { justify-content: center; }
      .orbit-1, .orbit-2 { display: none; }
    }
    .theme-floating{position:fixed;bottom:20px;right:20px;z-index:999;width:40px;height:40px;border-radius:50%;background:var(--bg-card);border:1px solid var(--border-light);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-lg);transition:all .3s ease;color:var(--text-muted);}
    .theme-floating:hover{transform:scale(1.1);color:var(--text-primary);box-shadow:var(--shadow-lg),0 0 0 3px rgba(59,130,246,.15);}

    @media (max-width: 450px) {
      .stats-row { grid-template-columns: 1fr 1fr; }
      .stat-value { font-size: var(--text-xl); }
    }
  </style>
</head>
<body>
  <div class="landing">
    <div class="landing-ambient"></div>
    
    <!-- Floating particles -->
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>
    <div class="particle p6"></div>

    <!-- Orbit rings -->
    <div class="orbit-ring orbit-1"></div>
    <div class="orbit-ring orbit-2"></div>

    <!-- ═══════════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-badge"><%- icon('shield', 12) %> Official Platform v2.0</div>
        
        <div class="hero-logo-wrap">
          <img src="/images/logo-text.svg" alt="Edikit" class="hero-logo" style="height:80px;width:auto">
        </div>

        <h1 class="hero-title">Interaktiv Platforma</h1>
        
        <p class="hero-sub">
          Zamonaviy ta'lim platformasi. O'qituvchilar va o'quvchilar uchun 
          interaktiv test tizimi, jonli viktorinalar va batafsil statistika.
        </p>

        <div class="hero-actions">
          <a href="/user/login" class="hero-btn hero-btn-primary">
            <%- icon('logIn', 16) %> Boshlash
          </a>
          <a href="/play" class="hero-btn hero-btn-ghost">
            <%- icon('gamepad', 16) %> O'yinga kirish
          </a>
          <a href="/admin/login" class="hero-btn hero-btn-secondary">
            <%- icon('shield', 14) %> Admin
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
       FEATURES
       ═══════════════════════════════════════════════════════════════ -->
    <section class="section">
      <div class="section-inner">
        <div class="section-label">Imkoniyatlar</div>
        <h2 class="section-title">Nima uchun Edikit?</h2>
        <p class="section-desc">
          Zamonaviy o'qitish vositalari bilan interaktiv test va viktorinalar yarating.
        </p>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon"><%- icon('zap', 22) %></div>
            <h3 class="feature-name">Real-time Multiplayer</h3>
            <p class="feature-desc">O'yinchilar real vaqtda test yechishadi, natijalar jonli ko'rinadi. 5-xonali kod orqali tezkor ulanish.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><%- icon('edit', 22) %></div>
            <h3 class="feature-name">Test yaratish</h3>
            <p class="feature-desc">Oddiy va tez test yaratish. Excel orqali ko'p savollarni bir vaqtda yuklash imkoniyati.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><%- icon('barChart', 22) %></div>
            <h3 class="feature-name">Statistika & Tahlil</h3>
            <p class="feature-desc">Foydalanuvchilar, testlar va o'yinlar bo'yicha batafsil statistika. Natijalarni kuzatish va tahlil qilish.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><%- icon('layers', 22) %></div>
            <h3 class="feature-name">PRE Test tizimi</h3>
            <p class="feature-desc">Subtestlar bilan murakkab test topshiriqlari. Har bir fan bo'yicha alohida test bloklari.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><%- icon('book', 22) %></div>
            <h3 class="feature-name">Mock Fanlar</h3>
            <p class="feature-desc">Har xil fanlardan tayyor testlar. Random 25 ta savol bilan tezkor sinov.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon"><%- icon('users', 22) %></div>
            <h3 class="feature-name">Foydalanuvchi paneli</h3>
            <p class="feature-desc">Shaxsiy kabinet: testlarni boshqarish, natijalarni ko'rish va o'yin yaratish.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
       HOW IT WORKS
       ═══════════════════════════════════════════════════════════════ -->
    <section class="section" style="padding-top:20px">
      <div class="section-inner">
        <div class="section-label">Qo'llanma</div>
        <h2 class="section-title">Qanday ishlaydi?</h2>
        <p class="section-desc">
          4 oddiy qadamda o'z testingizni yarating va o'yin o'tkazing.
        </p>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-num">1</div>
            <h3 class="step-title">Ro'yxatdan o'ting</h3>
            <p class="step-desc">Foydalanuvchi paneliga kiring va shaxsiy testingizni yarating.</p>
          </div>

          <div class="step-card">
            <div class="step-num">2</div>
            <h3 class="step-title">Test yarating</h3>
            <p class="step-desc">Savollar qo'shing, variantlarni belgilang va to'g'ri javobni tanlang.</p>
          </div>

          <div class="step-card">
            <div class="step-num">3</div>
            <h3 class="step-title">O'yin boshlang</h3>
            <p class="step-desc">Cast tugmasi orqali o'yin yarating, 5-xonali kodni o'yinchilarga ulashing.</p>
          </div>

          <div class="step-card">
            <div class="step-num">4</div>
            <h3 class="step-title">Natijalarni kuzating</h3>
            <p class="step-desc">Real vaqtda o'yinchilarning javoblarini va yakuniy natijalarni ko'ring.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
       STATISTICS
       ═══════════════════════════════════════════════════════════════ -->
    <section class="section" style="padding-top:20px">
      <div class="section-inner">
        <div class="section-label">Rasmiy</div>
        <h2 class="section-title">Edikit statistikasi</h2>
        <p class="section-desc">
          Platformamiz real ma'lumotlar bilan ishlaydi. Quyida demo statistik ko'rsatkichlar.
        </p>

        <div class="stats-row">
          <div class="stat-block">
            <div class="stat-value">15+</div>
            <div class="stat-label">Fan yo'nalishlari</div>
          </div>
          <div class="stat-block">
            <div class="stat-value">100+</div>
            <div class="stat-label">Savollar</div>
          </div>
          <div class="stat-block">
            <div class="stat-value">5-xim</div>
            <div class="stat-label">O'yin kodi</div>
          </div>
          <div class="stat-block">
            <div class="stat-value">24/7</div>
            <div class="stat-label">Mavjud</div>
          </div>
        </div>

        <div style="display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;margin-top:8px">
          <span class="footer-badge"><%- icon('zap', 10) %> Node.js</span>
          <span class="footer-badge"><%- icon('zap', 10) %> Socket.io</span>
          <span class="footer-badge"><%- icon('zap', 10) %> Express</span>
          <span class="footer-badge"><%- icon('zap', 10) %> Local DB</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
       CTA
       ═══════════════════════════════════════════════════════════════ -->
    <section class="section" style="padding-top:20px">
      <div class="section-inner">
        <div class="cta-box">
          <h2 class="cta-title">Bugunoq boshlang!</h2>
          <p class="cta-desc">
            Test yaratish, o'yin o'tkazish va natijalarni kuzatish — hammasi bir joyda.
          </p>
          <a href="/user/login" class="cta-btn">
            <%- icon('logIn', 18) %> Bepul boshlash
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
       FOOTER
       ═══════════════════════════════════════════════════════════════ -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-copy">
          &copy; 2026 Edikit v2.0 &mdash; Node.js Edition
        </div>
        <div class="footer-links">
          <a href="/play" class="footer-link"><%- icon('gamepad', 12) %> O'yinga kirish</a>
          <a href="/admin/login" class="footer-link"><%- icon('shield', 12) %> Admin panel</a>
        </div>
      </div>
    </footer>
  </div>
  <button type="button" class="theme-floating" data-theme-toggle aria-label="Switch theme"><%- icon('moon', 16) %></button>
</body>
</html>
