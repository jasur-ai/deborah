<!DOCTYPE html>
<!--
  ═══════════════════════════════════════════════════════════
  DEBORAH LANDING — S33: foydalanuvchi namunasi (uploads/index.html) 1:1
  Struktura: hero → stats → imkoniyatlar → qadamlar → signal → auth → cred → CTA
  REAL farqlar (no-fake qoidasi):
   · auth formalar REAL serverga ulangan (POST /user/login, CSRF, rol, rozilik)
   · OneID/HEMIS tugmasi YO'Q (loyihada yo'q — namunada bor edi)
   · demo-hint (soxta kredensial) YO'Q
   · join overlay REAL (/play?code=), hmenu — S31 kontrakti (admin faqat ichida)
  ═══════════════════════════════════════════════════════════
-->
<html lang="<%= lang === 'ru' ? 'ru' : lang === 'en' ? 'en' : lang === 'uz-cyrl' ? 'uz-Cyrl' : 'uz' %>" data-theme="dark" dir="ltr">
<head>
  <%- include('partials/landing-head', { title: 'Deborah — o\'qituvchilar uchun AI yordamchi', description: copy.meta.description, siteUrl: (typeof siteUrl !== 'undefined' ? siteUrl : ''), path: path, lang: lang }) %>
</head>
<body>
<script>
  window.__CSRF_TOKEN = '<%= csrfToken %>';
  window.__AUTH_PROVIDERS = { google: <%- oidcEnabled ? 'true' : 'false' %> };
</script>

<a class="skip-link" href="#main" data-i18n-skip>Asosiy kontentga o‘tish</a>
<div class="modefx" id="modeFx" aria-hidden="true"></div>
<div class="ghost" aria-hidden="true">Deborah</div>
<div class="site">
<!-- HEADER (S31 kontrakti: UZ/RU/EN → tema → Kirish → ⋮; admin FAQAT menyu ichida) -->
<header class="hdr">
  <a class="logo" href="#top">
    <img class="logo-mark" src="data:image/png;base64," alt="Deborah">
    <span class="logo-word" aria-hidden="true">deborah</span>
  </a>
  <nav class="nav">
    <a href="#feat" data-i18n="nav.feat">Imkoniyatlar</a>
    <a href="#qadam" data-i18n="nav.qadam">Qadamlar</a>
    <a href="#signal" data-i18n="nav.signal">Signal</a>
    <a href="#auth" data-i18n="nav.kirish">Kirish</a>
  </nav>
  <div class="ctrls">
    <div class="lang" role="group" aria-label="Til">
      <button data-lang="uz" class="on" type="button">UZ</button>
      <button data-lang="ru" type="button">RU</button>
      <button data-lang="en" type="button">EN</button>
    </div>
    <button class="tbtn" id="themeBtn" type="button" aria-label="Tema">
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/></svg>
    </button>
    <!-- S31: Kirish — oltin; S33 (namuna): #auth karta tomon siljitadi. /ustoz hmenu ichida. -->
    <a class="kbtn" href="#auth" data-i18n="hdr.kirish">Kirish</a>
    <button class="hbtn" id="hbtn" type="button" aria-label="Menyu" aria-haspopup="menu" aria-expanded="false" aria-controls="hmenu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
    </button>
  </div>
</header>
<!-- O'YINGA KIRISH (REAL: /play?code=) -->
<div class="join-overlay" id="joinOverlay" role="dialog" aria-modal="true" aria-label="Castga kirish">
  <div class="join-card">
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <button class="close" id="joinClose" type="button" aria-label="Yopish">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="join-head">
      <div class="k" data-i18n="join.k">Tayyor cast</div>
      <h3 data-i18n="join.h3">O'yinga <em>kirish</em></h3>
      <p data-i18n="join.p">Host tomonidan berilgan kodni kiriting (cast: 6 belgi, o'yin: 5 raqam).</p>
    </div>
    <% // BUG-049: cast join-kodlari 6 belgi HARF+raqam (A-Z, 2-9) — faqat-raqam
       // input bu kodlarni butunlay bloklab qo'ygan edi (harflar o'chib ketardi) %>
    <div class="jcode-wrap"><input class="jcode" id="jcode" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="7" placeholder="AB12CD" style="text-transform:uppercase"></div>
    <div class="join-err" id="joinErr" data-i18n="join.err">Kod 5–6 belgidan iborat bo'lishi kerak (cast kodi: 6 belgi harf/raqam).</div>
    <button class="btn btn-gold auth-submit" id="joinGo" type="button" data-i18n="join.go">Kirish</button>
    <div class="join-msg" id="joinMsg">
      <div class="load" data-i18n="join.load">Ulanmoqda… <i></i></div>
      <div class="ok" data-i18n="join.ok">Siz castga ulandingiz. Savol kutilmoqda.</div>
    </div>
  </div>
</div>
<!-- S31: menyu — O'NG TEPADA (⋮). Admin FAQAT shu yerda. -->
<div class="hmenu" id="hmenu" role="menu">
  <a href="/ustoz" role="menuitem" data-i18n="hm.kirish">Kirish</a>
  <a href="/admin/login" role="menuitem" data-i18n="admin.btn">Admin</a>
  <a href="#cast" role="menuitem" data-i18n="hm.cast">Cast</a>
  <a href="#kontakt" role="menuitem" data-i18n="hm.documents">Hujjatlar</a>
</div>
<!-- SAHIFA -->
<main class="page" id="main">
  <!-- HERO (namuna: chap matn + o'ng jonli cast ekrani) -->
  <section class="hero" id="top">
    <div class="hero-in">
      <div>
        <div class="kicker reveal" data-i18n="hero.kicker">O'qituvchilar uchun · AI yordamchi bilan</div>
        <h1 class="reveal" style="transition-delay:.05s" data-i18n="hero.h1">O'qituvchi ishi — <em>yengil</em>.<br>Dars — samarali.</h1>
        <p class="lede reveal" style="transition-delay:.1s" data-i18n="hero.lede">Savol tuzish, slaydlar, baholash, qog'oz tekshirish — AI yordamchi bularni soniyalarda bajaradi. Siz darsga va talabalarga vaqt ajratasiz.</p>
        <div class="hero-cta reveal" style="transition-delay:.15s">
          <a class="btn btn-gold btn-lg" href="#auth" data-i18n="hero.cta1">Bepul boshlash</a>
          <a class="btn btn-lg" href="#feat" data-i18n="hero.cta2">Imkoniyatlar</a>
        </div>
      </div>
      <div class="screen reveal" style="transition-delay:.2s" id="cast">
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <div class="sc-top">
          <span class="sc-code">EDK-4821</span>
          <span class="sc-live"><i></i><span data-i18n="live.live">jonli</span></span>
          <span id="scTime">01:24</span>
        </div>
        <div class="sc-body">
          <div class="beam" id="beam">
            <span class="tx" data-i18n="beam.tx">uzatilmoqda…</span>
            <span class="ln"></span><span class="dot"></span>
          </div>
          <div class="step q" id="q" data-i18n="live.q">SQL'da jadvaldan takroriy yozuvlarni olib tashlab, faqat unikallarini qaytaruvchi operator qaysi?</div>
          <div class="opts">
            <div class="opt step" data-opt><span class="k">A</span><span>SELECT DISTINCT</span><span class="pct">20%</span><span class="track"><i data-w="20"></i></span></div>
            <div class="opt step dom" data-opt><span class="k">B</span><span>SELECT UNIQUE ALL</span><span class="pct">43%</span><span class="track"><i data-w="43"></i></span></div>
            <div class="opt step" data-opt><span class="k">C</span><span>SELECT FILTER</span><span class="pct">27%</span><span class="track"><i data-w="27"></i></span></div>
            <div class="opt step" data-opt><span class="k">D</span><span>SELECT REMOVE</span><span class="pct">10%</span><span class="track"><i data-w="10"></i></span></div>
          </div>
          <div class="cap step" data-i18n="live.cap">Response mosaic · 42 javob</div>
          <div class="mini" id="mini"></div>
          <div class="devnote" id="devnote"><b data-i18n="live.dev">Dominant xato: B · 43%</b></div>
        </div>
        <div class="sc-foot">
          <span data-i18n="live.f1">Savol cast qilindi</span>
          <span data-i18n="live.f2">javoblar yig'ilmoqda</span>
        </div>
      </div>
    </div>
    <div class="scroll-hint" data-i18n="hero.scroll">Scroll · imkoniyatlar</div>
  </section>
  <!-- STATS -->
  <div class="stats">
    <div class="stats-in">
      <div class="stat reveal"><div class="num" id="st1">0 s</div><div class="lbl" data-i18n="stats.s1">Savol tayyorlash — AI bilan</div></div>
      <div class="stat reveal" style="transition-delay:.08s"><div class="num" id="st2">0+</div><div class="lbl" data-i18n="stats.s2">AI yordamchi funksiyalar</div></div>
      <div class="stat reveal" style="transition-delay:.16s"><div class="num" id="st3">0% → 0%</div><div class="lbl" data-i18n="stats.s3">Tushunish o'sishi</div></div>
    </div>
  </div>
  <!-- IMKONIYATLAR -->
  <section class="sec" id="feat">
    <div class="sec-in">
      <div class="sec-h">
        <div class="k reveal" data-i18n="feat.k">Imkoniyatlar</div>
        <h2 class="reveal" data-i18n="feat.h2">O'qituvchi ishini <em>yengillashtiradigan</em> imkoniyatlar.</h2>
        <p class="reveal" data-i18n="feat.p">AI yordamchi rutin ishlarni o'z zimmasiga oladi — siz o'qitishga e'tibor berasiz.</p>
        <div class="cite reveal" data-i18n="feat.hint">Imkoniyatni tanlang — tafsilot ochiladi</div>
      </div>
      <div class="grid3">
        <div class="f-card reveal"><div class="n">01</div><div class="ln"></div><h3 data-i18n="feat.c1t">AI savol generatsiyasi</h3><p class="sub" data-i18n="feat.c1s">Mavzudan test savollari soniyalarda.</p><div class="more" data-i18n="feat.c1m">50/30/20 taqsimot va validatorlar bilan; tayyor bankdan ham tanlash mumkin.</div></div>
        <div class="f-card reveal"><div class="n">02</div><div class="ln"></div><h3 data-i18n="feat.c2t">AI slaydlar</h3><p class="sub" data-i18n="feat.c2s">Dars taqdimoti avtomatik tayyorlanadi.</p><div class="more" data-i18n="feat.c2m">Canva, Google Slides va Gamma'ga bir tugma bilan eksport qilinadi.</div></div>
        <div class="f-card reveal"><div class="n">03</div><div class="ln"></div><h3 data-i18n="feat.c3t">AI baholash</h3><p class="sub" data-i18n="feat.c3s">Erkin javoblar avtomatik baholanadi.</p><div class="more" data-i18n="feat.c3m">Rubric va mezonlar asosida; natija serverda tasdiqlanadi.</div></div>
        <div class="f-card reveal"><div class="n">04</div><div class="ln"></div><h3 data-i18n="feat.c4t">Maqola tavsiyalari</h3><p class="sub" data-i18n="feat.c4s">Har bir mavzu uchun o'qish materiallari.</p><div class="more" data-i18n="feat.c4m">Maqolalar va manbalar avtomatik tavsiya etiladi.</div></div>
        <div class="f-card reveal"><div class="n">05</div><div class="ln"></div><h3 data-i18n="feat.c5t">Qog'oz + OCR</h3><p class="sub" data-i18n="feat.c5s">Qog'oz javob varaqlari skanerlanadi.</p><div class="more" data-i18n="feat.c5m">OMR belgilash, qo'lyozma va matn OCR — barchasi bitta joyda.</div></div>
        <div class="f-card reveal"><div class="n">06</div><div class="ln"></div><h3 data-i18n="feat.c6t">Savollar banki</h3><p class="sub" data-i18n="feat.c6s">QTI import/eksport va rubric.</p><div class="more" data-i18n="feat.c6m">Savollar, rubric va competency — bitta bankda.</div></div>
        <div class="f-card reveal"><div class="n">07</div><div class="ln"></div><h3 data-i18n="feat.c7t">Jonli viktorina</h3><p class="sub" data-i18n="feat.c7s">Savol sinf ekraniga uzatiladi.</p><div class="more" data-i18n="feat.c7m">Javoblar jonli yig'iladi; signal va mosaic ko'rsatiladi.</div></div>
        <div class="f-card reveal"><div class="n">08</div><div class="ln"></div><h3 data-i18n="feat.c8t">Hisobot</h3><p class="sub" data-i18n="feat.c8s">Dars yakunida avtomatik hisobot.</p><div class="more" data-i18n="feat.c8m">Sinf darajasidagi tahlil va natijalar.</div></div>
        <div class="f-card reveal"><div class="n">09</div><div class="ln"></div><h3 data-i18n="feat.c9t">Imtihon nazorati</h3><p class="sub" data-i18n="feat.c9s">Kamera evidence bilan nazorat.</p><div class="more" data-i18n="feat.c9m">Xavfsizlik profillari va proctor hodisalari.</div></div>
      </div>
    </div>
  </section>
  <!-- QADAMLAR -->
  <section class="sec cycle" id="qadam">
    <div class="sec-in">
      <div class="sec-h">
        <div class="k reveal" data-i18n="qadam.k">Qanday ishlaydi</div>
        <h2 class="reveal" data-i18n="qadam.h2">Uch oddiy <em>qadam</em>.</h2>
        <p class="reveal" data-i18n="qadam.p">Tayyorlang, uzating, tahlil qiling — qolganini tizim bajaradi.</p>
        <div class="cite reveal" data-i18n="qadam.cite">Yarat → Uzat → Tahlil</div>
      </div>
      <svg class="route-svg reveal" viewBox="0 0 1000 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path id="route" d="M60 250 C220 250, 260 80, 470 90 C680 100, 640 240, 850 230 C950 226, 970 120, 950 90" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="1 7" stroke-linecap="round"/>
        <path id="routeGold" d="M60 250 C220 250, 260 80, 470 90 C680 100, 640 240, 850 230 C950 226, 970 120, 950 90" stroke="var(--ld-gold)" stroke-width="2.5" stroke-linecap="round" style="stroke-dasharray:2000;stroke-dashoffset:2000"/>
        <g><circle class="j-check" cx="60" cy="250" r="9"/><text class="j-label" x="60" y="285" text-anchor="middle" data-i18n="qadam.l1">01 · YARAT</text></g>
        <g><circle class="j-check" cx="470" cy="90" r="9"/><text class="j-label" x="470" y="66" text-anchor="middle" data-i18n="qadam.l2">02 · UZAT</text></g>
        <g><circle class="j-check" cx="950" cy="90" r="9"/><text class="j-label" x="950" y="66" text-anchor="middle" data-i18n="qadam.l3">03 · TAHLIL</text></g>
        <g id="runner" style="opacity:0">
          <circle r="17" fill="url(#auraGrad)" opacity=".85"/>
          <circle r="5" fill="var(--gold)" stroke="var(--ld-bg)" stroke-width="1.5"/>
        </g>
      </svg>
      <div class="j-cards">
        <div class="j-card reveal"><div class="n">01</div><div class="ln"></div><h3 data-i18n="qadam.c1t">Yarat</h3><p data-i18n="qadam.c1p">Savol AI yordamida yoki bankdan tanlanadi — bir necha soniya.</p></div>
        <div class="j-card reveal" style="transition-delay:.1s"><div class="n">02</div><div class="ln"></div><h3 data-i18n="qadam.c2t">Uzat</h3><p data-i18n="qadam.c2p">Savol sinf ekraniga uzatiladi; javoblar telefonda ochiladi.</p></div>
        <div class="j-card reveal" style="transition-delay:.2s"><div class="n">03</div><div class="ln"></div><h3 data-i18n="qadam.c3t">Tahlil</h3><p data-i18n="qadam.c3p">Signal va hisobot: sinf holati bir qarashda.</p></div>
      </div>
    </div>
  </section>
  <!-- SIGNAL -->
  <section class="sec" id="signal">
    <div class="sec-in">
      <div class="sec-h">
        <div class="k reveal" data-i18n="signal.k">Sinf signali</div>
        <h2 class="reveal" data-i18n="signal.h2">Tushunish — <em>dalil bilan</em> o'lchanadi.</h2>
        <p class="reveal" data-i18n="signal.p">Bitta savol, bitta muhokama: tushunish 43% dan 82% ga — o'lchangan va tasdiqlangan.</p>
      </div>
      <div class="panel reveal">
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <div class="p-grid">
          <div class="p-col">
            <h3><span data-i18n="signal.col1">Birinchi o'lchov</span> <b id="n1">43%</b></h3>
            <div class="bar"><div class="lab"><span>A · 20%</span><span>B · 43%</span></div><div class="track"><i class="crimson" style="width:0%"></i><i class="grey" style="width:20%"></i></div></div>
            <div class="bar"><div class="lab"><span>C · 27%</span><span>D · 10%</span></div><div class="track"><i class="gold" style="width:27%"></i><i class="grey" style="width:10%"></i></div></div>
            <div class="mosaic"><div class="cap" data-i18n="signal.mos1">Response mosaic · 42 javob</div><div class="m-grid" id="mgrid1"></div></div>
          </div>
          <div class="p-col">
            <h3><span data-i18n="signal.col2">Muhokamadan keyin</span> <b class="rise" id="n2">82%</b></h3>
            <div class="bar"><div class="lab"><span>A · 82%</span><span>B · 10%</span></div><div class="track"><i class="green" style="width:0%"></i><i class="grey" style="width:10%"></i></div></div>
            <div class="bar"><div class="lab"><span>C · 5%</span><span>D · 3%</span></div><div class="track"><i class="gold" style="width:5%"></i><i class="grey" style="width:3%"></i></div></div>
            <div class="mosaic"><div class="cap" data-i18n="signal.mos2">Muhokamadan keyin</div><div class="m-grid" id="mgrid2"></div></div>
          </div>
        </div>
        <div class="signal-foot">
          <div class="big" data-i18n="signal.foot">Bitta savol · tushunish <b>43% → 82%</b></div>
          <div class="note" data-i18n="signal.note">Server-confirmed · shaxsiy reyting maxfiy</div>
        </div>
      </div>
    </div>
  </section>
  <!-- AUTH (REAL: POST /user/login · CSRF · rol · rozilik) -->
  <section class="sec" id="auth">
    <div class="sec-in">
      <div class="auth">
        <div class="auth-card reveal">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="auth-head">
            <div class="k" data-i18n="auth.k">Deborah hisobi</div>
            <h2 data-i18n="auth.h2">Hisobingizga kiring</h2>
          </div>
          <div class="tabs">
            <button type="button" class="on" data-tab="login" data-i18n="auth.t1">Kirish</button>
            <button type="button" data-tab="reg" data-i18n="auth.t2">Ro'yxatdan o'tish</button>
          </div>
          <form id="fLogin" action="/user/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="mode" value="login">
            <input type="hidden" name="lang" value="<%= lang %>" id="loginLang">
            <div class="providers">
              <button class="provider provider-g" type="button" data-prov="google">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z"/></svg>
                <span data-i18n="auth.google">Google bilan kirish</span>
              </button>
            </div>
            <div class="sep"><span data-i18n="auth.or">yoki email bilan</span></div>
            <div class="fld"><label for="lEmail" data-i18n="auth.loginId">Email yoki username</label><input id="lEmail" name="username" type="text" autocomplete="username" required></div>
            <div class="fld"><label for="lPass" data-i18n="auth.pass">Parol</label><input id="lPass" name="password" type="password" autocomplete="current-password" required></div>
            <button class="btn btn-gold auth-submit" type="submit" data-i18n="auth.login">Kirish</button>
            <div class="auth-msg" id="doneLogin"></div>
          </form>
          <form id="fReg" action="/user/login" method="POST" style="display:none">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="mode" value="reg">
            <input type="hidden" name="consent" value="on">
            <input type="hidden" name="lang" value="<%= lang %>" id="regLang">
            <div class="providers">
              <button class="provider provider-g" type="button" data-prov="google">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z"/></svg>
                <span data-i18n="auth.google">Google bilan kirish</span>
              </button>
            </div>
            <div class="sep"><span data-i18n="auth.or">yoki email bilan</span></div>
            <div class="fld"><label for="rName" data-i18n="auth.name">Ism va familiya</label><input id="rName" name="name" type="text" autocomplete="name" required></div>
            <div class="fld"><label for="rEmail" data-i18n="auth.email">Email</label><input id="rEmail" name="email" type="email" autocomplete="email" required></div>
            <div class="fld"><label for="rUser" data-i18n="auth.username">Username</label><input id="rUser" name="username" type="text" autocomplete="username" spellcheck="false" minlength="2" maxlength="50" required><div class="fld-hint" id="rUserHint" aria-live="polite"></div></div>
            <div class="fld"><label for="rPass" data-i18n="auth.pass">Parol</label><input id="rPass" name="password" type="password" autocomplete="new-password" minlength="8" required><div class="fld-hint dim" data-i18n="auth.passHint">Kamida 8 belgi — harf va raqam</div></div>
            <% // BUG-035: rol tanlash (server role=teacher'ni qabul qiladi; university/subject
               // bo'lmasa to'liq /user/register formaga prefilled o'tadi — mavjud mantiq) %>
            <div class="fld">
              <label data-i18n="auth.role">Rolingiz</label>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                <label style="flex:1;display:flex;align-items:center;gap:8px;border:1px solid rgba(0,0,0,.18);border-radius:10px;padding:10px 12px;cursor:pointer;font-size:.85rem;font-weight:600"><input type="radio" name="role" value="" checked><span data-i18n="auth.roleStudent">Talaba</span></label>
                <label style="flex:1;display:flex;align-items:center;gap:8px;border:1px solid rgba(0,0,0,.18);border-radius:10px;padding:10px 12px;cursor:pointer;font-size:.85rem;font-weight:600"><input type="radio" name="role" value="teacher"><span data-i18n="auth.roleTeacher">O'qituvchi</span></label>
              </div>
            </div>
            <% // BUG-036: faol rozilik %>
            <div class="fld" style="display:flex;gap:8px;align-items:flex-start">
              <input type="checkbox" name="consent" id="rConsent" required style="margin-top:3px;width:16px;height:16px;accent-color:#b8860b">
              <label for="rConsent" style="font-size:.78rem;font-weight:400;line-height:1.45">Men <a href="/privacy" target="_blank" rel="noopener">maxfiylik siyosati</a> va <a href="/terms" target="_blank" rel="noopener">foydalanish shartlariga</a> roziman</label>
            </div>
            <button class="btn btn-gold auth-submit" type="submit" data-i18n="auth.register">Ro'yxatdan o'tish</button>
            <% // BUG-040: to'liq teacher arizasiga yo'l %>
            <div style="text-align:center;margin-top:10px;font-size:.8rem"><a href="/user/register" data-i18n="auth.teacherLink">O'qituvchi uchun to'liq ariza →</a></div>
            <div class="auth-msg" id="doneReg"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
  <!-- CRED (no-fake: OneID/HEMIS yo'q — real imkoniyatlar) -->
  <div class="cred">
    <div class="cred-in">
      <span data-i18n="cred.c1">Google bilan kirish</span>
      <span data-i18n="cred.c2">Server-confirmed</span>
      <span data-i18n="cred.c3">WCAG 2.2 AA</span>
      <span data-i18n="cred.c4">QTI import</span>
    </div>
  </div>
  <!-- CTA -->
  <section class="cta">
    <h2 class="reveal" data-i18n="cta.h2">Ishni <em>osonlashtiring</em>.</h2>
    <div class="cta-stamp reveal" data-i18n="cta.stamp">AI · CAST · SIGNAL · HISOBOT</div>
    <p class="reveal" data-i18n="cta.p">Ruxsat OTM ma'muriyati tomonidan beriladi. Tasdiqlash kutilayotganda ham imkoniyatlarni ko'rib chiqing.</p>
    <div class="btns reveal">
      <a class="btn btn-gold btn-lg" href="#auth" data-i18n="cta.b1">Kirish</a>
      <a class="btn btn-lg" href="#feat" data-i18n="cta.b2">Imkoniyatlar</a>
    </div>
  </section>
</main>
