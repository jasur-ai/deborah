<!DOCTYPE html>
<html lang="<%= lang === 'uz-cyrl' ? 'uz-Cyrl' : lang === 'ru' ? 'ru' : lang === 'en' ? 'en' : 'uz' %>" dir="ltr">
<head>
  <%- include('partials/landing-head', { title: copy.meta.title, description: copy.meta.description, siteUrl: siteUrl, path: path, lang: lang }) %>
</head>
<body class="ld-body">
  <a class="ld-skip-link" href="#ld-main">Skip to content</a>

  <!-- Sticky header: faqat logo (sayt tepasida turadigan joy — 'deborah' yozuvi yo'q) -->
  <header class="ld-header">
    <div class="ld-container ld-header-inner">
      <a class="ld-logo" href="<%= path %>" aria-label="Deborah">
        <img src="/images/logo-vintage.png" alt="Deborah" class="ld-logo-img" width="44" height="48">
      </a>
      <div class="ld-header-right">
        <div class="ld-lang-switcher" aria-label="<%= copy.header.switcherLabel %>">
          <% ['uz', 'ru', 'en', 'uz-cyrl'].forEach((l) => { %>
            <a class="ld-lang <%= l === lang ? 'is-active' : '' %>" href="/<%= l === 'uz' ? '' : l %>" hreflang="<%= l === 'uz-cyrl' ? 'uz-Cyrl' : l %>" data-analytics="lang_switch" data-lang="<%= l %>"><%= l === 'uz' ? "O'zbekcha" : l === 'uz-cyrl' ? 'Ўзбекча' : l === 'ru' ? 'Русский' : 'English' %></a>
          <% }) %>
        </div>
        <%- include('partials/theme-control') %>
        <a class="ld-btn ld-btn-primary ld-btn-sm" href="<%= path + '?role=student' %>" data-analytics="hero_cta_click" data-cta="header">
          <%= copy.header.cta %>
        </a>
      </div>
    </div>
  </header>

  <main id="ld-main" class="ld-main">
    <% /* STEP 21 S21.05 IA: Promise → Product Proof → Ask/See/Adapt → Three Views → Features → Safety/Real Proof → CTA */ %>
    <%- include('partials/landing-hero') %>
    <%- include('partials/landing-demo') %>
    <%- include('partials/landing-how') %>
    <%- include('partials/landing-roles') %>
    <%- include('partials/landing-features') %>
    <%- include('partials/landing-trust') %>
    <%- include('partials/landing-stats') %>
    <%- include('partials/landing-cta') %>
  </main>

  <%- include('partials/landing-footer') %>

  <script src="/js/landing-demo.js" defer></script>
  <script src="/js/landing.js" defer></script>
</body>
</html>
