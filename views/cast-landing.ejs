<!DOCTYPE html>
<!--
  ═══════════════════════════════════════════════════════════
  DEBORAH CAST LANDING — foydalanuvchi namunasi (uploads/cast.html) 1:1
  Bu sahifa HAMMAGA ko'rinadigan bosh sahifa: cast demo + join + kirish.
  O'qituvchi landing'i esa /ustoz'da (ochiq ko'rinmaydi).
  Struktura: head → cast demo → under → auth → footer
  REAL farqlar (no-fake qoidasi — S33 index.ejs bilan bir xil):
   · ommaviy ro'yxatdan o'tish faqat talaba uchun; o'qituvchi maydoni top-right yashirin menyuda
   · OneID/HEMIS tugmasi YO'Q (loyihada yo'q — namunada bor edi)
   · join overlay REAL (/play?code=)
   · O'qituvchilar havolasi → /ustoz (yashirin o'qituvchi maydoni)
  ═══════════════════════════════════════════════════════════
-->
<html lang="uz" data-theme="dark" dir="ltr">
<head>
  <%- include('partials/landing-head', {
    title: 'Deborah — savolni sinf ekraniga uzatish',
    description: "Bir tugma bilan savol sinf ekraniga uzatiladi. Javoblar real vaqtda yig'iladi.",
    siteUrl: (typeof siteUrl !== 'undefined' ? siteUrl : ''),
    path: '/',
    lang: 'uz',
  }) %>
<style>
/* Parol ko'rsatish tugmasi (universal pw-toggle) */
.pw-wrap{position:relative}
.pw-wrap>input{padding-right:52px !important;box-sizing:border-box;width:100%}
.pw-toggle{position:absolute;right:4px;top:50%;transform:translateY(-50%);min-width:44px;min-height:44px;border:0;background:transparent;cursor:pointer;font-size:1.05rem;line-height:1;color:inherit;opacity:.7;border-radius:10px}
.pw-toggle:hover{opacity:1}
</style>
</head>
<body>
<script>
  window.__CSRF_TOKEN = '<%= csrfToken %>';
  window.__AUTH_PROVIDERS = { google: <%- oidcEnabled ? 'true' : 'false' %> };
</script>

<a class="skip-link" href="#main" data-i18n-skip>Asosiy kontentga o‘tish</a>
<div class="site">
<!-- HEADER -->
<header class="hdr">
  <a class="logo" href="#top">
    <img class="logo-mark" src="/images/logo-vintage.png" alt="Deborah">
  </a>
  <nav class="nav">
    <a href="#cast" data-i18n="nav.cast">Cast</a>
    <a href="#auth" data-i18n="nav.kirish">Kirish</a>
  </nav>
  <div class="ctrls">
    <div class="lang" role="group" aria-label="Til">
      <button data-lang="uz" class="on" type="button">UZ</button>
      <button data-lang="ru" type="button">RU</button>
      <button data-lang="en" type="button">EN</button>
    </div>
    <button class="tbtn" id="themeBtn" type="button" aria-label="Tema" aria-pressed="false">
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/></svg>
    </button>
    <button class="hbtn" id="hbtn" type="button" aria-label="Menyu" aria-haspopup="menu" aria-expanded="false" aria-controls="hmenu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>
<!-- O'YINGA KIRISH (REAL: /play?code=) -->
<div class="join-overlay" id="joinOverlay" role="dialog" aria-modal="true" aria-label="Castga kirish">
  <div class="join-card">
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <button class="close" id="joinClose" type="button" aria-label="Yopish">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="join-head">
      <div class="k" data-i18n="join.k">Tayyor cast</div>
      <h3 data-i18n="join.h3">O'yinga <em>kirish</em></h3>
      <p data-i18n="join.p">Host tomonidan berilgan kodni kiriting (cast: 6 belgi, o'yin: 5 raqam).</p>
    </div>
    <div class="jcode-wrap"><input class="jcode" id="jcode" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="7" placeholder="AB12CD" style="text-transform:uppercase"></div>
    <div class="join-err" id="joinErr" data-i18n="join.err">Kod 5–6 belgidan iborat bo'lishi kerak (cast kodi: 6 belgi harf/raqam).</div>
    <button class="btn btn-gold auth-submit" id="joinGo" type="button" data-i18n="join.go">Kirish</button>
    <div class="join-msg" id="joinMsg">
      <div class="load" data-i18n="join.load">Ulanmoqda… <i></i></div>
      <div class="ok" data-i18n="join.ok">Siz castga ulandingiz. Savol kutilmoqda.</div>
    </div>
  </div>
</div>
<!-- MENYU (Kirish = yashirin o'qituvchi maydoni) -->
<div class="hmenu" id="hmenu" role="menu">
  <a href="/ustoz" role="menuitem" data-i18n="hm.kirish">O'qituvchilar</a>
  <a href="#cast" role="menuitem" data-i18n="hm.cast">Cast</a>
  <a href="#kontakt" role="menuitem" data-i18n="hm.documents">Hujjatlar</a>
</div>
<!-- SAHIFA -->
<main class="page" id="main">
  <div class="head">
    <div class="kicker" data-i18n="head.kicker">Savolni sinf ekraniga uzatish</div>
    <h1 data-i18n="head.h1">Savol — <em>ekranda</em>. Javob — telefonda.</h1>
    <p data-i18n="head.p">Bir tugma bilan savol sinf ekraniga uzatiladi. Javoblar real vaqtda yig'iladi.</p>
  </div>
  <!-- CAST DEMO -->
  <div class="screen" id="cast">
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <div class="sc-top">
      <span class="sc-code">EDK-4821</span>
      <span class="sc-live"><i></i><span data-i18n="live.live">jonli</span></span>
      <span id="scTime">01:24</span>
    </div>
    <div class="sc-body">
      <div class="beam" id="beam">
        <span class="tx" data-i18n="beam.tx">uzatilmoqda…</span>
        <span class="ln"></span><span class="dot"></span>
      </div>
      <div class="step q" id="q" data-i18n="live.q">SQL'da jadvaldan takroriy yozuvlarni olib tashlab, faqat unikallarini qaytaruvchi operator qaysi?</div>
      <div class="opts">
        <div class="opt step" data-opt><span class="k">A</span><span>SELECT DISTINCT</span><span class="pct">20%</span><span class="track"><i data-w="20"></i></span></div>
        <div class="opt step dom" data-opt><span class="k">B</span><span>SELECT UNIQUE ALL</span><span class="pct">43%</span><span class="track"><i data-w="43"></i></span></div>
        <div class="opt step" data-opt><span class="k">C</span><span>SELECT FILTER</span><span class="pct">27%</span><span class="track"><i data-w="27"></i></span></div>
        <div class="opt step" data-opt><span class="k">D</span><span>SELECT REMOVE</span><span class="pct">10%</span><span class="track"><i data-w="10"></i></span></div>
      </div>
      <div class="cap step" data-i18n="live.cap">Response mosaic · 42 javob</div>
      <div class="mini" id="mini"></div>
      <div class="devnote" id="devnote"><b data-i18n="live.dev">Dominant xato: B · 43%</b></div>
    </div>
    <div class="sc-foot">
      <span data-i18n="live.f1">Savol cast qilindi</span>
      <span data-i18n="live.f2">javoblar yig'ilmoqda</span>
    </div>
  </div>
  <p class="under" data-i18n="under">Bu — <b>cast</b>: savol ekranda, javoblar telefonda. Har bir savol shu tarzda uzatiladi.</p>
  <!-- AUTH (REAL: POST /user/login · CSRF · rol · rozilik) -->
  <section class="auth" id="auth">
    <div class="auth-card">
      <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
      <div class="auth-head">
        <div class="k" data-i18n="auth.k">Kirish va ro'yxatdan o'tish</div>
        <h2 data-i18n="auth.h2">Tizimga kirish</h2>
      </div>
      <div class="tabs">
        <button type="button" class="on" data-tab="login" data-i18n="auth.t1">Kirish</button>
        <button type="button" data-tab="reg" data-i18n="auth.t2">Ro'yxatdan o'tish</button>
      </div>
      <form id="fLogin" action="/user/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="mode" value="login">
        <input type="hidden" name="lang" value="uz" id="loginLang">
        <div class="providers">
          <button class="provider provider-g" type="button" data-prov="google">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z"/></svg>
            <span data-i18n="auth.google">Google bilan kirish</span>
          </button>
        </div>
        <div class="sep"><span data-i18n="auth.or">yoki email bilan</span></div>
        <div class="fld"><label for="lEmail" data-i18n="auth.loginId">Email yoki username</label><input id="lEmail" name="username" type="text" autocomplete="username" required></div>
        <div class="fld"><label for="lPass" data-i18n="auth.pass">Parol</label><span class="pw-wrap" style="display:block;position:relative"><input id="lPass" name="password" type="password" autocomplete="current-password" required><button type="button" class="pw-toggle" data-pw-toggle="lPass" aria-label="Parolni ko'rsatish" aria-pressed="false"><span data-pw-toggle-label>👁</span></button></span></div>
        <button class="btn btn-gold auth-submit" type="submit" data-i18n="auth.login">Kirish</button>
        <div style="text-align:right;margin-top:9px;font-size:.8rem"><a href="/user/forgot?lang=uz" data-forgot-link data-i18n="auth.forgot" style="color:var(--ld-gold);text-underline-offset:3px">Parolni unutdingizmi?</a></div>
        <div class="auth-msg" id="doneLogin"></div>
      </form>
      <form id="fReg" action="/user/login" method="POST" style="display:none">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="mode" value="reg">
        <!-- S34i FIX: hidden consent OLIB TASHLANDI — checkbox bilan 2x consent=on
             express'da massiv qilardi → zod union rad → "Ism va parolni kiriting." -->
        <input type="hidden" name="lang" value="uz" id="regLang">
        <div class="providers">
          <button class="provider provider-g" type="button" data-prov="google">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z"/></svg>
            <span data-i18n="auth.google">Google bilan kirish</span>
          </button>
        </div>
        <div class="sep"><span data-i18n="auth.or">yoki email bilan</span></div>
        <div class="fld"><label for="rName" data-i18n="auth.name">Ism va familiya</label><input id="rName" name="name" type="text" autocomplete="name" required></div>
        <div class="fld"><label for="rEmail" data-i18n="auth.email">Email</label><input id="rEmail" name="email" type="email" autocomplete="email" required></div>
        <div class="fld"><label for="rUser" data-i18n="auth.username">Username</label><input id="rUser" name="username" type="text" autocomplete="username" spellcheck="false" minlength="2" maxlength="50" required><div class="fld-hint" id="rUserHint" aria-live="polite"></div></div>
        <div class="fld"><label for="rPass" data-i18n="auth.pass">Parol</label><span class="pw-wrap" style="display:block;position:relative"><input id="rPass" name="password" type="password" autocomplete="new-password" minlength="8" required><button type="button" class="pw-toggle" data-pw-toggle="rPass" aria-label="Parolni ko'rsatish" aria-pressed="false"><span data-pw-toggle-label>👁</span></button></span><div class="fld-hint dim" data-i18n="auth.passHint">Kamida 8 belgi — harf va raqam</div></div>
        <div class="fld" style="display:flex;gap:8px;align-items:flex-start">
          <input type="checkbox" name="consent" id="rConsent" required style="margin-top:3px;width:16px;height:16px;accent-color:#b8860b">
          <label for="rConsent" style="font-size:.78rem;font-weight:400;line-height:1.45">Men <a href="/privacy" target="_blank" rel="noopener">maxfiylik siyosati</a> va <a href="/terms" target="_blank" rel="noopener">foydalanish shartlariga</a> roziman</label>
        </div>
        <button class="btn btn-gold auth-submit" type="submit" data-i18n="auth.register">Ro'yxatdan o'tish</button>
        <div style="text-align:right;margin-top:9px;font-size:.8rem"><a href="/user/forgot?lang=uz" data-forgot-link data-i18n="auth.forgot" style="color:var(--ld-gold);text-underline-offset:3px">Parolni unutdingizmi?</a></div>
        <div class="auth-msg" id="doneReg"></div>
      </form>
    </div>
  </section>
</main>
<!-- FOOTER -->
<footer class="ftr" id="kontakt">
  <div class="ftr-in">
    <div>
      <h4 data-i18n="ftr.col1t">Sahifalar</h4>
      <a href="#top" data-i18n="ftr.l1">Bosh sahifa</a>
      <a href="#cast" data-i18n="ftr.l2">Cast</a>
      <a href="#auth" data-i18n="ftr.l3">Kirish</a>
      <a href="#auth" data-i18n="ftr.l4">Ro'yxatdan o'tish</a>
    </div>
    <div>
      <h4 data-i18n="ftr.col2t">Hujjatlar</h4>
      <a href="/privacy" data-i18n="ftr.l5">Maxfiylik siyosati</a>
      <a href="/terms" data-i18n="ftr.l6">Foydalanish shartlari</a>
      <a href="/cookies" data-i18n="ftr.l7">Cookie siyosati</a>
      <a href="/legal" data-i18n="ftr.l8">Qonuniy ma'lumot</a>
    </div>
    <div id="kontakt">
      <h4 data-i18n="ftr.col3t">Aloqa</h4>
      <a href="mailto:hello@deborah.uz">hello@deborah.uz</a>
    </div>
    <div>
      <h4 data-i18n="ftr.col4t">Til</h4>
      <a href="#" data-lang2="uz">O'zbekcha</a>
      <a href="#" data-lang2="ru">Русский</a>
      <a href="#" data-lang2="en">English</a>
    </div>
  </div>
  <div class="ftr-copy">
    <span data-i18n="ftr.legal">© 2026 Deborah · Savolni sinf ekraniga uzatish tizimi</span>
    <span>UZ / RU / EN</span>
  </div>
</footer>
</div><!-- /.site -->

<script src="/js/landing.js" defer></script>
<script>
/* Universal parol ko'rsatish/yashirish (auth.js yuklanmagan sahifalar uchun) */
(function(){
  if (window.__pwToggleInit) return; window.__pwToggleInit = true;
  function bind(scope){
    (scope || document).querySelectorAll('[data-pw-toggle]').forEach(function(btn){
      if (btn.__pwBound) return;
      var input = document.getElementById(btn.getAttribute('data-pw-toggle'));
      if (!input) return;
      btn.__pwBound = true;
      btn.addEventListener('click', function(){
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        var l = btn.querySelector('[data-pw-toggle-label]');
        if (l) l.textContent = show ? '\uD83D\uDE48' : '\uD83D\uDC41';
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ bind(); });
  else bind();
})();
</script>

</body>
</html>
