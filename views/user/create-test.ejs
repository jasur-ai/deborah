<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--bg);min-height:100vh;}
    .ct-wrap{max-width:820px;margin:0 auto;padding:20px 16px 80px;}
    .ct-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
    .ct-title{font-family:'Righteous',cursive;font-size:1.3rem;display:flex;align-items:center;gap:8px;}
    .ct-back{padding:8px 16px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--muted);font-family:'Nunito',sans-serif;font-size:.8rem;font-weight:800;cursor:pointer;text-decoration:none;transition:all .2s;}
    .ct-back:hover{color:var(--text);background:rgba(255,255,255,.1);}
    .inp{width:100%;background:rgba(255,255,255,.05);border:2px solid var(--border);border-radius:11px;padding:12px 14px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.95rem;font-weight:700;outline:none;transition:border-color .25s;margin-bottom:14px;}
    .inp:focus{border-color:var(--accent);}
    .inp::placeholder{color:var(--muted);font-weight:600;}
    .help-text{font-size:.78rem;color:var(--muted);font-weight:600;margin-bottom:14px;line-height:1.6;}
    .upload-zone{border:2px dashed rgba(37,99,235,.3);border-radius:12px;padding:20px;text-align:center;cursor:pointer;background:rgba(37,99,235,.04);margin-bottom:14px;transition:all .2s;}
    .upload-zone:hover{border-color:var(--accent);background:rgba(37,99,235,.08);}
    .upload-zone.has-file{border-color:var(--green);border-style:solid;background:rgba(56,189,248,.08);}
    .upload-zone p{color:var(--muted);font-size:.85rem;font-weight:700;}
    .upload-zone.has-file p{color:var(--green);}
    .tmpl-btn{width:100%;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:9px;padding:9px;color:var(--muted);font-family:'Nunito',sans-serif;font-size:.8rem;font-weight:800;cursor:pointer;transition:all .2s;text-align:center;margin-bottom:14px;}
    .tmpl-btn:hover{background:rgba(255,255,255,.1);color:var(--text);}

    .q-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:10px;transition:border-color .2s;}
    .q-card:hover{border-color:rgba(37,99,235,.2);}
    .q-num{font-size:.72rem;font-weight:800;color:var(--muted);margin-bottom:6px;}
    .q-row{display:flex;gap:8px;margin-bottom:8px;align-items:flex-start;}
    .q-row .inp{margin-bottom:0;flex:1;}
    .del-q-btn{background:rgba(37,99,235,.1);border:1px solid rgba(37,99,235,.2);border-radius:9px;padding:12px 14px;color:var(--accent);font-size:.9rem;cursor:pointer;flex-shrink:0;transition:all .18s;}
    .del-q-btn:hover{background:rgba(37,99,235,.2);}
    .opt-row{display:flex;gap:6px;margin-bottom:6px;align-items:center;}
    .opt-letter{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.75rem;flex-shrink:0;border:1.5px solid var(--border);color:var(--muted);}
    .opt-row .inp{margin-bottom:0;flex:1;}
    .opt-correct{cursor:pointer;border:2px solid var(--border);border-radius:9px;padding:10px 12px;background:rgba(255,255,255,.04);color:var(--muted);font-size:.7rem;font-weight:800;transition:all .18s;flex-shrink:0;white-space:nowrap;}
    .opt-correct.on{border-color:var(--green);background:rgba(56,189,248,.1);color:var(--green);}
    .ct-actions{display:flex;gap:10px;margin-top:20px;}
    .btn{padding:13px 24px;border:none;border-radius:11px;font-family:'Nunito',sans-serif;font-size:.93rem;font-weight:900;cursor:pointer;transition:all .22s;text-decoration:none;text-align:center;display:flex;align-items:center;justify-content:center;gap:7px;}
    .btn-primary{background:linear-gradient(135deg,var(--green),#1d9bcf);color:#000;flex:2;}
    .btn-primary:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 24px rgba(56,189,248,.3);}
    .btn-primary:disabled{opacity:.45;cursor:not-allowed;}
    .btn-secondary{background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--muted);flex:1;}
    .btn-secondary:hover{background:rgba(255,255,255,.1);color:var(--text);}
    .empty{text-align:center;padding:28px;color:var(--muted);font-size:.82rem;font-weight:700;background:rgba(255,255,255,.02);border-radius:12px;border:1px dashed rgba(255,255,255,.08);}
    .msg{border-radius:9px;padding:9px 12px;font-size:.8rem;font-weight:700;margin-bottom:11px;display:none;}
    .msg.on{display:block;}
    .msg.err{background:rgba(37,99,235,.1);border:1px solid rgba(37,99,235,.3);color:var(--accent);}
    .msg.ok{background:rgba(56,189,248,.1);border:1px solid rgba(56,189,248,.25);color:var(--green);}
  </style>
</head>
<body>
  <div class="ct-wrap">
    <div class="ct-header">
      <div class="ct-title"><%= isEdit ? '✏️' : '➕' %> <%= isEdit ? 'Testni tahrirlash' : 'Yangi test' %></div>
      <a href="/user/panel" class="ct-back">← Panel</a>
    </div>

    <div class="help-text">
      Test nomini kiriting, savollarni qo'shing (kamida 1 ta savol va har bir savolga kamida 2 ta variant).
    </div>

    <div id="msg" class="msg"></div>

    <input class="inp" id="test-name" placeholder="Test nomi (masalan: Matematika 2024)" maxlength="60">
    
    <div class="upload-zone" id="excel-zone" onclick="document.getElementById('excel-input').click()">
      <p>📂 Excel fayl yuklash (ixtiyoriy)</p>
    </div>
    <input type="file" id="excel-input" accept=".xlsx,.xls" style="display:none">
    <button type="button" class="tmpl-btn" onclick="downloadExcelTemplate()">⬇️ Excel shablon yuklab olish</button>

    <div id="questions-wrap">
      <div class="empty" id="empty-state">Hali savol yo'q. Quyidagi tugma orqali qo'shing.</div>
    </div>

    <button type="button" class="btn btn-secondary" onclick="addQuestion()" style="width:100%;margin-bottom:14px;">➕ Savol qo'shish</button>

    <div class="ct-actions">
      <a href="/user/panel" class="btn btn-secondary">← Bekor</a>
      <button type="button" class="btn btn-primary" id="save-test-btn" onclick="saveTest()">💾 Testni saqlash</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script>
    let questions = [];
    let questionCount = 0;
    const OPT_LETTERS = ['A', 'B', 'C', 'D', 'E'];
    const isEdit = <%= isEdit ? 'true' : 'false' %>;
    const editKey = '<%= typeof editKey !== 'undefined' && editKey ? editKey : '' %>';

    // ── Load existing test data ──
    <% if (testData) { %>
      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('test-name').value = '<%= testData.name ? testData.name.replace(/'/g, "\\'") : '' %>';
        <% if (testData.questions) { %>
          <% testData.questions.forEach((q, idx) => { %>
            addQuestion();
            const cards = document.querySelectorAll('.q-card');
            const card = cards[cards.length - 1];
            card.querySelector('.q-text-inp').value = '<%= q.text ? q.text.replace(/'/g, "\\'") : '' %>';
            <% if (q.options) { %>
              <% q.options.forEach((o, oi) => { %>
                const opts = card.querySelectorAll('.opt-row .inp');
                if (opts[<%= oi %>]) opts[<%= oi %>].value = '<%= String(o).replace(/'/g, "\\'") %>';
              <% }); %>
            <% } %>
            card.querySelector('.opt-correct[data-idx="<%= q.correct || 0 %>"]')?.classList.add('on');
          <% }); %>
        <% } %>
      });
    <% } %>

    function addQuestion(data) {
      const idx = questionCount++;
      const wrap = document.getElementById('questions-wrap');
      const empty = document.getElementById('empty-state');
      if (empty) empty.style.display = 'none';

      const div = document.createElement('div');
      div.className = 'q-card';
      div.dataset.idx = idx;
      div.innerHTML = `
        <div class="q-num">Savol ${questions.length + 1}</div>
        <div class="q-row">
          <input class="inp q-text-inp" placeholder="Savol matnini kiriting..." style="margin-bottom:0">
          <button type="button" class="del-q-btn" onclick="deleteQuestion(this)">✕</button>
        </div>
        <div class="opts-wrap">
          ${[0,1,2,3].map(oi => `
            <div class="opt-row">
              <div class="opt-letter" style="border-color:${['#ff4466','#38bdf8','#ffd60a','#00ffaa'][oi]}">${OPT_LETTERS[oi]}</div>
              <input class="inp" placeholder="${OPT_LETTERS[oi]}) variant matni..." style="margin-bottom:0">
              <button type="button" class="opt-correct ${oi === 0 ? 'on' : ''}" data-idx="${oi}" onclick="toggleCorrect(this)">✓ To'g'ri</button>
            </div>
          `).join('')}
        </div>
      `;
      wrap.appendChild(div);
      updateNumbers();
    }

    function deleteQuestion(btn) {
      const card = btn.closest('.q-card');
      card.remove();
      updateNumbers();
      checkEmpty();
    }

    function toggleCorrect(btn) {
      const card = btn.closest('.q-card');
      card.querySelectorAll('.opt-correct').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
    }

    function updateNumbers() {
      const cards = document.querySelectorAll('.q-card');
      cards.forEach((c, i) => {
        c.querySelector('.q-num').textContent = `Savol ${i + 1}`;
      });
      questions = [];
      document.querySelectorAll('.q-card').forEach(c => questions.push(c));
    }

    function checkEmpty() {
      const empty = document.getElementById('empty-state');
      const cards = document.querySelectorAll('.q-card');
      if (empty) empty.style.display = cards.length ? 'none' : 'block';
    }

    // ── Save ──
    async function saveTest() {
      const name = document.getElementById('test-name').value.trim();
      if (!name) { showMsg('Test nomini kiriting!', 'err'); return; }

      const cards = document.querySelectorAll('.q-card');
      if (!cards.length) { showMsg('Kamida 1 ta savol qo\'shing!', 'err'); return; }

      const questions = [];
      let valid = true;

      cards.forEach(card => {
        const text = card.querySelector('.q-text-inp').value.trim();
        if (!text) { valid = false; return; }

        const opts = [];
        let correct = 0;
        card.querySelectorAll('.opt-row').forEach((row, i) => {
          const val = row.querySelector('.inp').value.trim();
          opts.push(val || '');
          if (row.querySelector('.opt-correct.on')) correct = i;
        });

        if (!opts.some(o => o)) { valid = false; return; }
        questions.push({ text, options: opts, correct });
      });

      if (!valid) { showMsg('Barcha maydonlarni to\'ldiring!', 'err'); return; }

      const btn = document.getElementById('save-test-btn');
      btn.disabled = true;
      btn.textContent = 'Saqlanmoqda...';

      try {
        const res = await fetch('/api/tests/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, questions, editKey })
        });
        const data = await res.json();
        if (data.success) {
          showMsg('✅ Test saqlandi! Panelga qaytarilmoqda...', 'ok');
          setTimeout(() => window.location.href = '/user/panel', 1000);
        } else {
          showMsg('Xato: ' + (data.error || 'Server xatosi'), 'err');
        }
      } catch (e) {
        showMsg('Xato: ' + e.message, 'err');
      }
      btn.disabled = false;
      btn.textContent = '💾 Testni saqlash';
    }

    function showMsg(text, type) {
      const el = document.getElementById('msg');
      el.textContent = text;
      el.className = 'msg on ' + type;
    }

    // ── Excel import ──
    document.getElementById('excel-input').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'binary' });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
          if (data.length < 2) { showMsg('Faylda savollar topilmadi', 'err'); return; }
          
          // Clear existing
          document.querySelectorAll('.q-card').forEach(c => c.remove());
          questionCount = 0;
          
          for (let i = 1; i < data.length; i++) {
            const row = data[i];
            if (!row[0]) continue;
            const text = String(row[0] || '').trim();
            const opts = [String(row[1] || ''), String(row[2] || ''), String(row[3] || ''), String(row[4] || '')];
            const correctIdx = parseInt(row[5]) || 0;
            if (!text) continue;
            
            addQuestion();
            const cards = document.querySelectorAll('.q-card');
            const card = cards[cards.length - 1];
            card.querySelector('.q-text-inp').value = text;
            card.querySelectorAll('.opt-row .inp').forEach((inp, i) => {
              if (opts[i]) inp.value = opts[i];
            });
            card.querySelectorAll('.opt-correct').forEach(b => b.classList.remove('on'));
            const correctBtn = card.querySelector(`.opt-correct[data-idx="${correctIdx}"]`);
            if (correctBtn) correctBtn.classList.add('on');
          }
          document.getElementById('excel-zone').classList.add('has-file');
          document.getElementById('excel-zone').querySelector('p').textContent = `✅ ${data.length - 1} ta savol yuklandi`;
          showMsg(`✅ ${data.length - 1} ta savol import qilindi!`, 'ok');
        } catch (err) {
          showMsg('Excel xatosi: ' + err.message, 'err');
        }
      };
      reader.readAsBinaryString(file);
    });

    function downloadExcelTemplate() {
      const wb = XLSX.utils.book_new();
      const data = [
        ['Savol', 'Variant A', 'Variant B', 'Variant C', 'Variant D', 'To\'g\'ri javob (0-3)'],
        ['1+1 nechiga teng?', '1', '2', '3', '4', 1],
        ['Eng katta sayyora?', 'Mars', 'Yupiter', 'Saturn', 'Neptun', 1],
        ['O\'zbekiston poytaxti?', 'Samarqand', 'Toshkent', 'Buxoro', 'Namangan', 1],
      ];
      const ws = XLSX.utils.aoa_to_sheet(data);
      XLSX.utils.book_append_sheet(wb, ws, 'Savollar');
      XLSX.writeFile(wb, 'edikit-template.xlsx');
    }
  </script>
</body>
</html>
