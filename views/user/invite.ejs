<!DOCTYPE html>
<html lang="<%= lang === 'uz-cyrl' ? 'uz-Cyrl' : lang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/design/contexts/auth.css">
  <style>
    /* AUTH B-12 — invite sahifasiga xos override'lar */
    .auth-page{margin-top:0;}
    .invite-sum{display:flex;flex-direction:column;gap:8px;margin:14px 0 4px;padding:14px 16px;background:var(--surface-raised,#f8fafc);border:1px solid var(--border-subtle,#e2e8f0);border-radius:12px}
    .invite-row{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-primary,#0f172a)}
    .invite-row svg{flex:none;color:var(--text-muted,#64748b)}
    .invite-check{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:#15803d;margin:0 0 4px}
    .invite-note{font-size:13px;color:var(--text-muted,#64748b);line-height:1.5;margin:6px 0 0}
    .btn-google{width:100%;justify-content:center}
    .invite-accept-label{margin:6px 0 2px}
  </style>
</head>
<body>
  <a href="#main" class="skip-link"><%= copy.invite.title %> →</a>
  <%- include('../partials/nav') %>
  <main id="main" class="auth-page" style="min-height:calc(100dvh - 64px)">
    <div class="auth-shell">
      <!-- ── Product proof — desktop ── -->
      <div class="auth-proof" aria-hidden="true">
        <div class="auth-proof-brand">
          <img src="/images/logo-icon.svg" alt="Deborah" class="auth-proof-logo">
          <span class="auth-proof-badge"><%- icon('shield', 12) %> Deborah</span>
        </div>
        <h1><%= copy.invite.title %></h1>
        <p class="auth-proof-sub"><%= copy.invite.sub %></p>
        <ul class="auth-proof-list">
          <li><span class="auth-proof-ico"><%- icon('users', 13) %></span><span><%= copy.invite.proofGroup %></span></li>
          <li><span class="auth-proof-ico"><%- icon('lock', 13) %></span><span><%= copy.invite.proofSecure %></span></li>
          <li><span class="auth-proof-ico"><%- icon('zap', 13) %></span><span><%= copy.invite.proofFast %></span></li>
        </ul>
      </div>

      <!-- ── Invite card ── -->
      <div class="auth-box">
        <div class="auth-header auth-header--split">
          <img src="/images/logo-text.svg" alt="Deborah" class="auth-proof-logo">
          <div class="auth-title"><%= copy.invite.title %></div>
          <div class="auth-sub"><%= copy.invite.sub %></div>
        </div>

        <nav class="lang-row" aria-label="Language">
          <% AUTH_LANGS.forEach(function(l){ %>
            <a class="lang-link <%= l === lang ? 'on' : '' %>" href="?lang=<%= l %>&token=<%= encodeURIComponent(tokenHash) %>" hreflang="<%= l === 'uz-cyrl' ? 'uz-Cyrl' : l %>"><%= l === 'uz' ? 'O\'zbek' : (l === 'uz-cyrl' ? 'Ўзбекча' : (l === 'ru' ? 'Русский' : 'English')) %></a>
          <% }); %>
        </nav>

        <!-- B-12 §06: "Siz taklif qilindingiz ✓" -->
        <p class="invite-check"><%- icon('checkCircle', 15) %> <%= copy.invite.welcome %></p>

        <!-- Kurs / guruh / o'qituvchi ma'lumoti (token validatsiyadan o'tgan) -->
        <div class="invite-sum" role="list" aria-label="<%= copy.invite.detailsLabel %>">
          <% if (inviteInfo.courseCode) { %>
            <div class="invite-row" role="listitem"><%- icon('book', 14) %><span><strong><%= copy.invite.course %>:</strong> <%= inviteInfo.courseCode %></span></div>
          <% } %>
          <% if (inviteInfo.groupCode) { %>
            <div class="invite-row" role="listitem"><%- icon('users', 14) %><span><strong><%= copy.invite.group %>:</strong> <%= inviteInfo.groupCode %></span></div>
          <% } %>
          <% if (inviteInfo.email) { %>
            <div class="invite-row" role="listitem"><%- icon('mail', 14) %><span><strong><%= copy.invite.emailLabel %>:</strong> <%= inviteInfo.email %></span></div>
          <% } %>
        </div>

        <p class="invite-note"><%- icon('info', 13) %> <span><%= copy.invite.note %></span></p>

        <!-- B-12 §06: xato UX — noto'g'ri/muddati o'tgan/ishlatilgan -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div id="auth-alert" class="msg err" role="alert" aria-live="assertive"><%= error %></div>
        <% } else { %>
          <div id="auth-alert" class="msg" role="alert" aria-live="assertive"></div>
        <% } %>

        <% if (!(typeof error !== 'undefined' && error)) { %>
          <!-- Google bilan tasdiqlash — B-13'da accept bog'lanadi; token URL'da o'tadi -->
          <% if (oidcEnabled) { %>
            <a href="/auth/google?invite=<%= encodeURIComponent(tokenHash) %>" class="btn-google" data-google-btn>
              <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C8.87 7.48 11.26 5.38 12 5.38z"/></svg>
              <span><%= copy.login.google %></span>
            </a>
            <div class="oidc-divider"><span><%= copy.login.or %></span></div>
          <% } %>

          <!-- Username + parol forma — POST /api/roster/invites/accept (CSRF exempt, B-11) -->
          <p class="invite-accept-label"><%= copy.invite.createAccount %></p>
          <form id="form-invite" class="auth-form is-active" method="POST" action="/api/roster/invites/accept" data-analytics-form="invite">
            <input type="hidden" name="token" value="<%= tokenHash %>">
            <input type="hidden" name="lang" value="<%= lang %>">

            <label class="lbl" for="inv-name"><%= copy.invite.name %></label>
            <input class="inp" id="inv-name" name="name" type="text" placeholder="<%= copy.invite.namePh %>" autocomplete="name" autocapitalize="words" spellcheck="false" maxlength="100" aria-required="false" value="<%= typeof prevName !== 'undefined' && prevName ? prevName : '' %>">

            <label class="lbl" for="inv-username"><%= copy.invite.username %></label>
            <input class="inp" id="inv-username" name="username" type="text" placeholder="<%= copy.invite.usernamePh %>" autocomplete="username" autocapitalize="off" spellcheck="false" inputmode="text" pattern="[a-zA-Z0-9_]{2,50}" required aria-required="true" aria-invalid="false" value="<%= typeof prevUsername !== 'undefined' && prevUsername ? prevUsername : '' %>" data-inline-error="err-inv-username">

            <label class="lbl" for="inv-email"><%= copy.invite.email %></label>
            <input class="inp" id="inv-email" name="email" type="email" placeholder="<%= copy.invite.emailPh %>" autocomplete="email" autocapitalize="off" spellcheck="false" inputmode="email" <%= inviteInfo.email ? 'disabled' : 'required aria-required="true"' %> value="<%= inviteInfo.email || (typeof prevEmail !== 'undefined' && prevEmail ? prevEmail : '') %>">

            <label class="lbl" for="inv-password"><%= copy.invite.password %></label>
            <input class="inp" id="inv-password" name="password" type="password" placeholder="<%= copy.invite.passwordPh %>" autocomplete="new-password" inputmode="text" minlength="8" required aria-required="true" aria-invalid="false" style="padding-right:52px" data-inline-error="err-inv-password">

            <div id="inv-alert" class="msg err" role="alert" aria-live="assertive" style="display:none"></div>

            <button type="submit" class="btn btn-primary btn-block" style="width:100%"><%- icon('check', 15) %> <%= copy.invite.btn %></button>
          </form>
        <% } else { %>
          <!-- Xato holatda: teacher'ga yangi taklif so'rash imkoniyati -->
          <p class="invite-note"><%- icon('mail', 13) %> <span><%= copy.invite.requestNew %></span></p>
        <% } %>
      </div>
    </div>
  </main>
  <script src="/js/auth.js"></script>
</body>
</html>
