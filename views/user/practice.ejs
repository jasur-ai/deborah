<!DOCTYPE html>
<html lang="<%= htmlLang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/question-stage.css">
  <link rel="stylesheet" href="/css/ai-assist.css?v=ai1">
  <style>
    /* Yakka mashq (Sinov) — jonli sahna (C4-10 rev.2: reklama uslubi yo'q):
       katta maydon, iliq 2×2 javob plitalari, darhol natija, vaqt/vaqtsiz.
       Rasm: qora-jigarrang sahna + krem karta — Deborah vintage palitrasi. */
    *{box-sizing:border-box;}
    html,body{min-height:100%;}
    body{
      margin:0;padding:0;
      font-family:'Source Sans 3',system-ui,-apple-system,'Segoe UI',sans-serif;
      color:#f6ecd9;
      background:
        radial-gradient(1100px 520px at 50% -10%, rgba(201,165,101,.18), transparent 60%),
        linear-gradient(160deg,#2b2013 0%, #1c140a 55%, #150e07 100%);
      background-attachment:fixed;
    }
    button{font-family:inherit;}

    .pr-top{
      display:flex;align-items:center;gap:14px;flex-wrap:wrap;
      padding:14px 22px;
      background:rgba(20,13,6,.55);
      border-bottom:1px solid rgba(201,165,101,.28);
      backdrop-filter:blur(8px);
    }
    .pr-top-l{display:flex;align-items:center;gap:12px;min-width:0;}
    .pr-badge{
      font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.14em;
      color:#1a1305;background:linear-gradient(135deg,#d9b465,#c9a565 55%,#a37f3a);
      border-radius:50px;padding:4px 12px;flex-shrink:0;white-space:nowrap;
    }
    .pr-title{
      font-size:1.05rem;font-weight:800;margin:0;color:#f6ecd9;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:60vw;
    }
    .pr-top-r{margin-left:auto;display:flex;align-items:center;gap:10px;}
    .pr-chip{
      display:inline-flex;align-items:center;gap:6px;
      font-size:.8rem;font-weight:800;font-variant-numeric:tabular-nums;
      color:#f6ecd9;background:rgba(201,165,101,.14);
      border:1px solid rgba(201,165,101,.45);border-radius:50px;padding:6px 13px;
    }
    .pr-chip .ico-untimed{color:#d9b465;}
    .pr-back{
      text-decoration:none;font-size:.8rem;font-weight:700;color:#e9d9b8;
      padding:8px 14px;border-radius:50px;
      border:1px solid rgba(201,165,101,.35);background:rgba(201,165,101,.1);
    }
    .pr-back:hover{background:rgba(201,165,101,.22);color:#fff;}
    @media (max-width:640px){ .pr-title{max-width:44vw;font-size:.92rem;} }

    .pr-stage{max-width:1040px;margin:0 auto;padding:22px 18px 60px;}
    .pr-hud{
      display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
      margin-bottom:14px;
    }
    .pr-qpos{font-size:.86rem;font-weight:800;color:#c9a565;letter-spacing:.08em;text-transform:uppercase;}
    .pr-timer{min-height:1.4rem;font-size:.9rem;font-weight:800;color:#f6ecd9;}
    .pr-timer:empty{display:none;}
    .pr-hint{
      margin:0 0 12px;padding:0;opacity:0;transform:translateY(-4px);
      transition:opacity .15s ease, transform .15s ease;
      color:#e2a464;font-weight:700;font-size:.88rem;text-align:center;
    }
    .pr-hint.show{opacity:1;transform:none;}

    /* ── Savol kartasi: kirish dashboard'dagi SQL namunaning aynan o'zi
       (.qstage — /css/question-stage.css). Faqat kenglik moslanadi. ── */
    #quiz .qstage{max-width:860px;}
    #quiz .qstage .q{font-size:clamp(1.05rem,2.2vw,1.35rem);}
    #quiz .qstage .opt{font-size:clamp(.92rem,1.6vw,1.02rem);padding:11px 14px;cursor:pointer;}
    #quiz .qstage .opt.is-locked{pointer-events:none;}
    @keyframes qpop{0%{transform:scale(1)}55%{transform:scale(1.02)}100%{transform:scale(1)}}
    #quiz .qstage .opt.is-right{animation:qpop .28s ease;}
    #quiz .qstage .opt .qt-mark{margin-left:8px;font-weight:900;}

    .pr-fb{
      margin:14px auto 2px;padding:11px 16px;
      display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;
      font-weight:700;font-size:clamp(.85rem,1.5vw,.98rem);text-align:center;
      max-width:640px;border:1px solid;
      font-family:'IBM Plex Mono',Consolas,monospace;letter-spacing:.02em;
    }
    .pr-fb.is-ok{color:#9fd3a5;background:rgba(125,150,112,.12);border-color:rgba(125,150,112,.5);}
    .pr-fb.is-bad{color:#e0a98c;background:rgba(168,121,79,.12);border-color:rgba(168,121,79,.5);}
    .pr-fb-correct{font-size:.78rem;font-weight:400;opacity:.9;}
    .pr-fb-correct b{color:inherit;}

    /* HUD: taymer yonidagi "Keyingisi" (09/2026 user qarori) */
    .pr-hud-r{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    #hud-next{
      border:1px solid rgba(201,165,101,.55);border-radius:50px;cursor:pointer;
      background:linear-gradient(135deg,#d9b465,#a37f3a);color:#1a1305;
      font-weight:800;font-size:.82rem;padding:8px 18px;min-height:44px;white-space:nowrap;
    }
    #hud-next:hover:not(:disabled){filter:brightness(1.07);}
    #hud-next:disabled{opacity:.45;cursor:not-allowed;}

    .pr-nav{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:18px;}
    .pr-nav button{
      font-family:'IBM Plex Mono',Consolas,monospace;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;
      border:1px solid rgba(242,237,227,.2);background:transparent;color:#f2ede3;
      border-radius:0;padding:12px 20px;cursor:pointer;min-height:48px;
    }
    .pr-nav button:hover:not(:disabled){border-color:#c2a06a;color:#d6bd8c;}
    #next,#finish{margin-left:auto;background:#c2a06a;border-color:#c2a06a;color:#141006;}
    #next:hover:not(:disabled),#finish:hover:not(:disabled){background:#d6bd8c;border-color:#d6bd8c;color:#141006;}
    .btn[disabled]{opacity:.4;cursor:not-allowed;}

    /* progress segmentlar */
    .pr-dots{display:flex;gap:6px;justify-content:center;margin-top:22px;flex-wrap:wrap;}
    .pr-dot{
      width:26px;height:6px;border-radius:4px;border:0;cursor:pointer;padding:0;
      background:rgba(201,165,101,.28);transition:background .15s ease, transform .15s ease;
    }
    .pr-dot.done{background:rgba(201,165,101,.75);}
    .pr-dot.miss{background:#b45309;}
    .pr-dot.cur{transform:scaleY(2);background:#d9b465;}
    .pr-dot.locked{cursor:default;}

    /* ── Natija ── */
    .res-card{
      background:#f7eeda;color:#241a0c;border-radius:26px;padding:30px 26px;
      box-shadow:0 24px 60px rgba(0,0,0,.45);
    }
    .pr-res-wrap{text-align:center;}
    .pr-res-score{
      font-size:clamp(2.6rem,6vw,3.6rem);font-weight:900;line-height:1;
      background:linear-gradient(135deg,#8a5a1e,#c9a565);-webkit-background-clip:text;background-clip:text;
      -webkit-text-fill-color:transparent;
    }
    .pr-res-sub{font-size:1rem;color:#6b4a1e;font-weight:700;margin:8px 0 4px;}
    .pr-res-done{font-size:.85rem;color:#8a6a3a;font-weight:600;margin-bottom:20px;}
    .pr-res-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:6px;}
    .pr-res-actions .btn{border:0;border-radius:14px;padding:12px 22px;font-weight:800;font-size:.92rem;cursor:pointer;min-height:48px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;}
    .btn-quiet{background:#efe2c4;color:#5b4317;}
    .btn-primary{background:linear-gradient(135deg,#d9b465,#a37f3a);color:#1a1305;}
    .pr-review{border:1px solid #d9c49a;border-radius:14px;padding:12px 16px;margin-bottom:10px;background:#fff8e8;}
    .pr-review.right{border-color:#7cc98a;background:#f1fae9;}
    .pr-review.wrong{border-color:#d99c7c;background:#fdf1ea;}
    .pr-rv-q{font-weight:800;font-size:.95rem;margin-bottom:6px;}
    .pr-rv-o{font-size:.86rem;margin-left:12px;color:#5b4317;font-weight:600;}
    .pr-rv-o.ok{color:#1e8a3c;font-weight:800;}
    .pr-rv-o.no{color:#b13a2e;}
    .pr-rv-e{font-size:.8rem;color:#8a6a3a;margin-top:8px;border-top:1px dashed #d9c49a;padding-top:8px;}
    @media (max-width:600px){ .pr-stage{padding:16px 12px 50px;} }
    @media (prefers-reduced-motion: reduce){
      .pr-fb,.pr-dot{transition:none;animation:none;}
    }
    @media print {
      .pr-top,.pr-hud,.pr-nav,.pr-dots,.pr-res-actions{display:none !important;}
      body{background:#fff;color:#000;}
      #quiz .qstage,.res-card,.pr-review{box-shadow:none;background:#fff;color:#000;border:1px solid #bbb;}
    }

    /* rev.4 mobil: savol nuqtalari telefonda qulay */
    @media (max-width: 640px){
      .pr-dot{min-width:44px;min-height:44px;}
      .pr-dot.cur{transform:scaleY(1.15);}
      .pr-dots{gap:8px;}
      .pr-badge{font-size:.78rem;}
      .pr-back{min-height:44px;display:inline-flex;align-items:center;}
      #hud-next{padding:8px 14px;font-size:.78rem;}
    }

    /* 09/2026 (Faza 1): multi/short/fokus/review uslublari */
    #quiz .qstage .opt.sel{border-color:#d9b465;background:rgba(201,165,101,.16);}
    #quiz .qstage .opt.sel .k{background:#d9b465;color:#1a1305;}
    .pr-confirm-wrap{display:flex;justify-content:center;margin-top:14px;}
    .pr-confirm{
      font-family:'IBM Plex Mono',Consolas,monospace;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;
      border:1px solid #c2a06a;background:#c2a06a;color:#141006;border-radius:0;
      padding:12px 26px;cursor:pointer;min-height:48px;
    }
    .pr-confirm:hover:not(:disabled){background:#d6bd8c;}
    .pr-confirm:disabled{opacity:.45;cursor:not-allowed;}
    .pr-short-wrap{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:6px;}
    .pr-short-input{
      flex:1;min-width:200px;max-width:440px;min-height:48px;
      background:rgba(20,13,6,.6);border:1px solid rgba(201,165,101,.55);color:#f6ecd9;
      border-radius:0;padding:12px 16px;font-size:1rem;font-family:inherit;
    }
    .pr-short-input:focus{outline:2px solid #d9b465;outline-offset:1px;}
    .pr-short-given{
      max-width:640px;margin:6px auto 0;padding:11px 16px;text-align:center;
      background:rgba(201,165,101,.1);border:1px solid rgba(201,165,101,.4);
      font-size:1rem;font-weight:700;
    }
    .pr-focus-btn{
      border:1px solid rgba(201,165,101,.4);border-radius:50px;cursor:pointer;
      background:rgba(201,165,101,.1);color:#e9d9b8;
      font-weight:800;font-size:.78rem;padding:8px 14px;min-height:44px;white-space:nowrap;
    }
    .pr-focus-btn.on{background:linear-gradient(135deg,#d9b465,#a37f3a);color:#1a1305;border-color:#d9b465;}
    .pr-rv-sec{font-size:.72rem;color:#8a6a3a;font-weight:600;}
    .pr-res-meta{font-size:.82rem;color:#8a6a3a;font-weight:700;margin:4px 0 2px;}
    /* Review & Submit oynasi */
    .pr-review-ov{
      position:fixed;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;
      background:rgba(10,6,2,.72);padding:16px;
    }
    .pr-review-box{
      background:#f7eeda;color:#241a0c;border-radius:20px;padding:24px;width:100%;max-width:560px;
      max-height:86vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.5);
    }
    .pr-review-box h2{margin:0 0 4px;font-size:1.1rem;}
    .pr-review-sub{font-size:.82rem;color:#8a6a3a;margin-bottom:12px;}
    .pr-review-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:8px;margin-bottom:16px;}
    .pr-review-item{
      border:2px solid #d9c49a;border-radius:12px;background:#fff8e8;cursor:pointer;
      padding:8px 4px;font-weight:800;font-size:.85rem;min-height:48px;color:#241a0c;
    }
    .pr-review-item small{display:block;font-weight:600;font-size:.68rem;color:#8a6a3a;}
    .pr-review-item.is-ok{border-color:#7cc98a;background:#f1fae9;}
    .pr-review-item.is-miss{border-color:#d99c7c;background:#fdf1ea;}
    .pr-review-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;}
    .pr-review-actions .btn{border:0;border-radius:14px;padding:12px 22px;font-weight:800;font-size:.9rem;cursor:pointer;min-height:48px;}
    @media (max-width:640px){ .pr-short-wrap{flex-direction:column;} .pr-short-input{max-width:none;} }
    /* 09/2026 (Faza 1b): reorder ↑↓ ro'yxati + match qatorlari */
    .pr-ro-list{display:flex;flex-direction:column;gap:8px;max-width:640px;margin:6px auto 0;}
    .pr-ro-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:rgba(20,13,6,.55);border:1px solid rgba(201,165,101,.5);}
    .pr-ro-item .pr-ro-n{flex:0 0 30px;height:30px;display:flex;align-items:center;justify-content:center;border:1px solid #d9b465;color:#d9b465;font-weight:800;font-size:.9rem;border-radius:50%;}
    .pr-ro-item .pr-ro-t{flex:1;font-size:1rem;}
    .pr-ro-item .pr-ro-btns{display:flex;gap:6px;}
    .pr-ro-item .pr-ro-btns button{width:44px;height:44px;border:1px solid rgba(201,165,101,.55);border-radius:10px;cursor:pointer;background:rgba(201,165,101,.12);color:#f6ecd9;font-size:1.1rem;font-weight:800;}
    .pr-ro-item .pr-ro-btns button:disabled{opacity:.3;cursor:default;}
    .pr-ro-item.is-ok{border-color:#7cc98a;}
    .pr-ro-item.is-ok .pr-ro-n{border-color:#7cc98a;color:#7cc98a;}
    .pr-ro-item.is-bad{border-color:#e2795b;}
    .pr-ro-item.is-locked .pr-ro-btns{display:none;}
    .pr-m-list{display:flex;flex-direction:column;gap:8px;max-width:640px;margin:6px auto 0;}
    .pr-m-row{display:grid;grid-template-columns:1fr 34px 1fr;gap:8px;align-items:center;padding:10px 12px;background:rgba(20,13,6,.55);border:1px solid rgba(201,165,101,.5);}
    .pr-m-row .pr-m-l{font-weight:700;font-size:.95rem;}
    .pr-m-row .pr-m-arrow{text-align:center;color:#d9b465;font-weight:800;}
    .pr-m-sel{min-height:48px;background:rgba(20,13,6,.6);border:1px solid rgba(201,165,101,.55);color:#f6ecd9;border-radius:0;padding:10px 12px;font-size:.95rem;font-family:inherit;width:100%;}
    .pr-m-sel:focus{outline:2px solid #d9b465;outline-offset:1px;}
    .pr-m-val{font-size:.95rem;}
    .pr-m-row.is-ok{border-color:#7cc98a;}
    .pr-m-row.is-bad{border-color:#e2795b;}
    @media (max-width:640px){ .pr-m-row{grid-template-columns:1fr;gap:6px;} .pr-m-row .pr-m-arrow{transform:rotate(90deg);} }
</style>
</head>
<body>
  <header class="pr-top">
    <div class="pr-top-l">
      <span class="pr-badge"><%= pCopy.topBadge %></span>
      <h1 class="pr-title"><%= practiceTitle %></h1>
    </div>
    <div class="pr-top-r">
      <span class="pr-chip" id="mode-chip" hidden></span>
      <a class="pr-back" href="/user/practice-history"><%= pCopy.histOpen || 'Natijalarim' %></a>
      <a class="pr-back" href="/user/panel"><%= pCopy.back %></a>
    </div>
  </header>

  <main class="pr-stage">
    <div class="pr-hud">
      <div class="pr-qpos" id="qpos"></div>
      <div class="pr-hud-r">
        <div class="pr-timer" id="qtimer" aria-live="polite"></div>
        <!-- 09/2026 (user qarori): sanalayotgan vaqt yonida "Keyingisi" + ENTER -->
        <!-- 09/2026 (Faza 1): Fokus rejimi — fullscreen + chetga chiqishni sanash -->
        <button type="button" id="pr-focus" class="pr-focus-btn" aria-pressed="false">🎯 Fokus</button>
        <button type="button" id="hud-next" disabled>Keyingisi →</button>
      </div>
    </div>
    <div class="pr-hint" id="pr-hint" role="status" aria-live="polite"></div>
    <div id="quiz"></div>
    <div id="result" hidden></div>
    <div class="pr-dots" id="dots"></div>
  </main>

  <script>
    const QUESTIONS = <%- JSON.stringify(questions).replace(/</g, '\\u003c') %>;
    const CSRF = <%- JSON.stringify(csrfToken || '') %>;
    window.__CSRF_TOKEN = CSRF; // AI Assist (ai-assist.js) API chaqiruvlari uchun
    const SOURCE = <%- JSON.stringify(source) %>;
    const KEY = <%- JSON.stringify(key) %>;
    const CHUNK = <%- JSON.stringify(chunk) %>;
    const PC = <%- JSON.stringify(pCopy || {}) %>;
    const t = (k, fb) => (PC[k] !== undefined ? PC[k] : fb);
    const fill = (k, fb, map) => t(k, fb).split('{n}').join(map.n != null ? map.n : '').split('{m}').join(map.m != null ? map.m : '').split('{total}').join(map.total != null ? map.total : '').split('{correct}').join(map.correct != null ? map.correct : '').split('{title}').join(map.title != null ? map.title : '');

    /* 09/2026 (user qarori):
       — javobsiz savoldan oldinga o'tib bo'lmaydi (Next/Finish/dots bloklanadi);
       — javob tanlansa DARHOL to'g'ri/noto'g'ri natija chiqadi;
       — vaqt tugasa savol "o'tkazib yuborilgan" sifatida yopiladi;
       — ?time=0 yoki time yo'q = VAQTSIZ rejim (timer yo'q, shoshilish yo'q). */
    const PER_Q_TIME = Math.max(0, parseInt(new URLSearchParams(location.search).get('time'), 10) || 0);
    const UNTIMED = !(PER_Q_TIME > 0);
    const answers = new Array(QUESTIONS.length).fill(-1);
    const revealed = new Array(QUESTIONS.length).fill(false);
    const missed = new Array(QUESTIONS.length).fill(false);
    // 09/2026 (Faza 1): har savolga sarflangan vaqt + multi vaqtinchalik tanlov +
    // short darhol tekshirish + fokus rejimi
    const spent = new Array(QUESTIONS.length).fill(0);
    const shortOk = new Array(QUESTIONS.length).fill(false);
    const shortPending = new Array(QUESTIONS.length).fill(false);
    // 09/2026 (Faza 1b): reorder/match darhol tekshirish + vaqtinchalik holat
    const stagedOk = new Array(QUESTIONS.length).fill(false);
    const stagedPending = new Array(QUESTIONS.length).fill(false);
    let multiStage = [];
    let orderStage = [];
    let matchStage = {};
    let qStart = Date.now();
    let focusOn = false;
    let focusViol = 0;
    function recordSpent() {
      spent[cur] = Math.max(0, Math.min(3600, Math.round((Date.now() - qStart) / 1000)));
    }
    let cur = 0;
    let timeLeft = PER_Q_TIME;
    let timerIv = null;
    // C4-10 rev.4: nav tartibi — yakunda «faqat xatolarni qayta yechish» uchun
    // flow'ni xato savollar indekslariga toraytiramiz (retryMode).
    let flow = QUESTIONS.map((_, i) => i);
    let retryMode = false;
    let finished = false; // natija ekrani ochiqmi (orqaga-confirm uchun)
    const flowPos = (i) => flow.indexOf(i);

    // Sahna plitalari uchun iliq ranglar (C4-10 rev.2: reklama uslubi olib
    // tashlandi) — terrakota/oltin/zaytun/g'isht, index bo'yicha tsikl
    const TILE_COLORS = ['#a4572a', '#a8892a', '#567a33', '#96423a'];

    function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function correctOf(i) {
      const c = QUESTIONS[i] && QUESTIONS[i].correct;
      const n = QUESTIONS[i] && QUESTIONS[i].options ? QUESTIONS[i].options.length : 0;
      return Number.isInteger(c) && c >= 0 && c < n ? c : -1;
    }
    // 09/2026 (Faza 1): multi to'plami; short normalizatsiya (SERVER bilan bir xil!)
    function correctMultiOf(i) {
      const q = QUESTIONS[i] || {};
      if (Array.isArray(q.correctMulti) && q.correctMulti.length) return q.correctMulti;
      const c = correctOf(i);
      return c >= 0 ? [c] : [];
    }
    function normShort(s) {
      return String(s || '').replace(/[‘’ʼʻ`´]/g, "'").toLowerCase().trim().replace(/\s+/g, ' ');
    }
    // 09/2026 (Faza 1b): salt parametrli xesh — short/order/match bir xil mexanizm
    async function sha256hex(s, salt) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode((salt || 'deborah-short-v1|') + s));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    }
    function isAnswered(i) {
      const a = answers[i];
      if (Array.isArray(a)) return a.length > 0;
      if (typeof a === 'string') return a.trim().length > 0;
      return Number.isInteger(a) && a >= 0;
    }
    function hint(msg) {
      const h = document.getElementById('pr-hint');
      if (!h) return;
      h.textContent = '⚠ ' + msg;
      h.classList.add('show');
      clearTimeout(hint._iv);
      hint._iv = setTimeout(() => h.classList.remove('show'), 2600);
    }
    function clearTimer() { clearInterval(timerIv); timerIv = null; }
    function paintModeChip() {
      const el = document.getElementById('mode-chip');
      if (!el) return;
      el.hidden = false;
      el.innerHTML = UNTIMED
        ? '<span class="ico-untimed">∞</span> ' + t('untimed', 'Vaqtsiz')
        : '⏱ ' + String(PER_Q_TIME).padStart(2, '0') + ':00';
    }
    function startTimer() {
      clearTimer();
      const el = document.getElementById('qtimer');
      if (UNTIMED) { if (el) el.textContent = ''; return; }
      if (revealed[cur]) { if (el) el.textContent = ''; return; }
      timeLeft = PER_Q_TIME;
      if (!el) return;
      const fmt = () => '⏱ ' + String(Math.floor(timeLeft / 60)).padStart(2, '0') + ':' + String(timeLeft % 60).padStart(2, '0');
      el.textContent = fmt();
      timerIv = setInterval(() => {
        timeLeft--;
        el.textContent = fmt();
        if (timeLeft <= 0) {
          clearTimer();
          el.textContent = '';
          if (!revealed[cur]) {
            missed[cur] = true;
            // 09/2026 (Faza 1): turga mos bo'sh javob
            const qt = (QUESTIONS[cur] && QUESTIONS[cur].type) || 'single_choice';
            answers[cur] = qt === 'multiple_select' ? [] : (qt === 'short_answer' ? '' : -1);
            revealed[cur] = true;
            recordSpent();
            renderQ();
            renderDots();
          }
        }
      }, 1000);
    }

    const dots = document.getElementById('dots');
    function renderDots() {
      dots.innerHTML = flow.map((i) => {
        let cls = 'pr-dot';
        if (revealed[i]) cls += ' done' + (missed[i] ? ' miss' : '');
        if (i === cur) cls += ' cur';
        const nextUnlocked = i === flow[flowPos(cur) + 1] && revealed[cur];
        const unlock = i === cur || revealed[i] || nextUnlocked;
        if (!unlock) cls += ' locked';
        return `<button type="button" class="${cls}" data-i="${i}" ${unlock ? '' : 'tabindex="-1" aria-disabled="true"'} aria-label="${fill('dotAria', 'Savol {n}', { n: i + 1 })}"></button>`;
      }).join('');
      dots.querySelectorAll('.pr-dot').forEach((d) => d.addEventListener('click', () => {
        const i = +d.dataset.i;
        const unlocked = i === cur || revealed[i] || (i === flow[flowPos(cur) + 1] && revealed[cur]);
        if (unlocked) { cur = i; renderQ(); renderDots(); }
        else hint(t('answerFirst', 'Avval savolga javob bering'));
      }));
    }

    const quiz = document.getElementById('quiz');
    const qpos = document.getElementById('qpos');
    function goNext() {
      const p = flowPos(cur);
      const nxt = flow[p + 1];
      if (revealed[cur] && nxt != null) { cur = nxt; renderQ(); renderDots(); }
      else if (!revealed[cur]) hint(t('answerFirst', 'Avval savolga javob bering'));
    }
    // Qisqa javobni tasdiqlash: xesh orqali darhol tekshirish (javob matni serverda)
    async function confirmShort(inp) {
      if (revealed[cur]) return;
      const val = inp ? inp.value.trim() : '';
      if (!val) { hint(t('shortEmpty', 'Avval javobingizni yozing')); if (inp) inp.focus(); return; }
      answers[cur] = val.slice(0, 300);
      missed[cur] = false;
      const q = QUESTIONS[cur];
      const hashes = Array.isArray(q.answerHashes) ? q.answerHashes : [];
      if (hashes.length && window.crypto && crypto.subtle) {
        try {
          const h = await sha256hex(normShort(val));
          shortOk[cur] = hashes.includes(h);
        } catch (_) { shortPending[cur] = true; }
      } else {
        shortPending[cur] = true;
      }
      revealed[cur] = true;
      clearTimer();
      recordSpent();
      const qEl = document.getElementById('qtimer');
      if (qEl) qEl.textContent = '';
      renderQ();
      renderDots();
    }
    // 09/2026 (Faza 1b): reorder/match tasdiqlash — ketma-ketlik xeshi
    // solishtiriladi (to'g'ri tartib/xarita serverda, clientga yuborilmaydi)
    async function confirmStaged() {
      if (revealed[cur]) return;
      const q = QUESTIONS[cur];
      const qType = (q && q.type) || '';
      let seq = [];
      let want = '';
      let salt = '';
      if (qType === 'reorder') {
        const items = Array.isArray(q.items) ? q.items : [];
        seq = orderStage.filter((ix) => ix >= 0 && ix < items.length).map((ix) => items[ix]);
        if (seq.length !== items.length || items.length < 2) { hint(t('reorderEmpty', 'Tartibni belgilang')); return; }
        want = q.orderHash || '';
        salt = 'deborah-order-v1|';
      } else if (qType === 'match') {
        const lefts = Array.isArray(q.lefts) ? q.lefts : [];
        const rights = Array.isArray(q.rights) ? q.rights : [];
        if (lefts.length < 2) return;
        seq = lefts.map((_, li) => {
          const ri = matchStage[li];
          return (Number.isInteger(ri) && ri >= 0 && ri < rights.length) ? rights[ri] : '';
        });
        if (seq.some((s) => !s)) { hint(t('matchEmpty', 'Har bir qatorga mos javob tanlang')); return; }
        want = q.matchHash || '';
        salt = 'deborah-match-v1|';
      } else {
        return;
      }
      answers[cur] = seq.slice();
      missed[cur] = false;
      if (want && window.crypto && crypto.subtle) {
        try {
          // SERVER bilan bir xil: JSON.stringify (V8 ikkala tomonda bir xil)
          const h = await sha256hex(JSON.stringify(seq), salt);
          stagedOk[cur] = (h === want);
        } catch (_) { stagedPending[cur] = true; }
      } else {
        stagedPending[cur] = true;
      }
      revealed[cur] = true;
      clearTimer();
      recordSpent();
      const qEl = document.getElementById('qtimer');
      if (qEl) qEl.textContent = '';
      renderQ();
      renderDots();
    }
    function renderQ() {
      startTimer();
      // 09/2026 (Faza 1): turga mos sahna (single/multi/short)
      const q = QUESTIONS[cur];
      const qType = (q && q.type) || 'single_choice';
      const isMulti = qType === 'multiple_select';
      const isShort = qType === 'short_answer';
      const isMatch = qType === 'match';
      const isReorder = qType === 'reorder';
      if (!revealed[cur]) { qStart = Date.now(); multiStage = []; orderStage = []; matchStage = {}; }
      const posLabel = (retryMode ? t('retryTag', 'Qayta: ') : '') + (flowPos(cur) + 1) + ' / ' + flow.length;
      if (qpos) qpos.textContent = posLabel;
      const qc = correctOf(cur);
      const qcm = correctMultiOf(cur);
      const isRev = revealed[cur];
      const chosen = answers[cur];
      const isLast = flowPos(cur) === flow.length - 1;
      const typeLabel = qType === 'true_false' ? 'To\u2018g\u2018ri / Noto\u2018g\u2018ri'
        : (isShort ? t('typeShort', 'Qisqa javob') : (isMulti ? t('typeMulti', 'Bir nechta javob: hammasini belgilang') : (isMatch ? t('typeMatch', 'Moslashtiring: har bir chap elementga mos o‘ngni tanlang') : (isReorder ? t('typeReorder', 'Tartiblang: to‘g‘ri ketma-ketlikni toping') : ''))));
      // Variantlar — kirish dashboard'dagi .opt (kalit doira + matn + belgi + oltin track)
      // 09/2026 (Faza 1): multi — toggle + tasdiqlash; short — input + tasdiqlash
      let opts = '';
      let answerZone = '';
      if (isShort) {
        answerZone = isRev
          ? `<div class="pr-short-given">✍️ ${esc(typeof chosen === 'string' && chosen ? chosen : '—')}</div>`
          : `<div class="pr-short-wrap">
              <input class="pr-short-input" id="pr-short" type="text" maxlength="300" autocomplete="off"
                placeholder="${esc(t('shortPh', 'Javobingizni yozing…'))}" aria-label="${esc(t('typeShort', 'Qisqa javob'))}">
              <button type="button" class="pr-confirm" id="pr-confirm">✓ ${esc(t('confirm', 'Tasdiqlash'))}</button>
            </div>`;
      // 09/2026 (Faza 1b): reorder ↑↓ ro'yxati
      } else if (isReorder) {
        const items = Array.isArray(q.items) ? q.items : [];
        if (!isRev && !orderStage.length) orderStage = items.map((_, ix) => ix);
        const seq = (isRev && Array.isArray(chosen) && chosen.length) ? chosen : orderStage.map((ix) => items[ix]);
        const roCls = isRev ? (stagedPending[cur] ? '' : (stagedOk[cur] ? ' is-ok' : ' is-bad')) : '';
        const rows = seq.map((txt, pos) => `
          <div class="pr-ro-item${isRev ? ' is-locked' : ''}${roCls}" data-ro-pos="${pos}">
            <span class="pr-ro-n">${pos + 1}</span>
            <span class="pr-ro-t">${esc(txt)}</span>
            ${isRev ? '' : `<span class="pr-ro-btns">
              <button type="button" data-ro-up="${pos}" ${pos === 0 ? 'disabled' : ''} aria-label="${esc(t('moveUp', 'Yuqoriga'))}">↑</button>
              <button type="button" data-ro-down="${pos}" ${pos === seq.length - 1 ? 'disabled' : ''} aria-label="${esc(t('moveDown', 'Pastga'))}">↓</button>
            </span>`}
          </div>`).join('');
        answerZone = `<div class="pr-ro-list" id="pr-ro-list">${rows}</div>`
          + (isRev ? '' : `<div class="pr-confirm-wrap"><button type="button" class="pr-confirm" id="pr-confirm">✓ ${esc(t('confirm', 'Tasdiqlash'))}</button></div>`);
      // 09/2026 (Faza 1b): match chap ustun + o'ng tanlov
      } else if (isMatch) {
        const lefts = Array.isArray(q.lefts) ? q.lefts : [];
        const rights = Array.isArray(q.rights) ? q.rights : [];
        const mCls = isRev ? (stagedPending[cur] ? '' : (stagedOk[cur] ? ' is-ok' : ' is-bad')) : '';
        const mrows = lefts.map((l, li) => {
          const sel = isRev
            ? `<span class="pr-m-val">${esc(Array.isArray(chosen) && chosen[li] ? chosen[li] : '—')}</span>`
            : `<select class="pr-m-sel" data-m="${li}" aria-label="${esc(l)}">
                <option value="">${esc(t('matchPick', 'Tanlang…'))}</option>
                ${rights.map((r, ri) => `<option value="${ri}"${matchStage[li] === ri ? ' selected' : ''}>${esc(r)}</option>`).join('')}
              </select>`;
          return `<div class="pr-m-row${mCls}"><span class="pr-m-l">${esc(l)}</span><span class="pr-m-arrow">→</span>${sel}</div>`;
        }).join('');
        answerZone = `<div class="pr-m-list">${mrows}</div>`
          + (isRev ? '' : `<div class="pr-confirm-wrap"><button type="button" class="pr-confirm" id="pr-confirm">✓ ${esc(t('confirm', 'Tasdiqlash'))}</button></div>`);
      } else {
        opts = q.options.map((o, j) => {
          let st = '';
          let mark = '';
          if (isRev) {
            if (isMulti) {
              const inC = qcm.includes(j);
              const inG = Array.isArray(chosen) && chosen.includes(j);
              if (inC && inG) { st = 'ok is-right'; mark = '✓'; }
              else if (inC) { st = 'ok'; mark = '✓'; }
              else if (inG) { st = 'bad'; mark = '✗'; }
              else st = 'dim';
            } else {
              if (j === qc) st = 'ok is-right';
              else if (j === chosen) st = 'bad';
              else st = 'dim';
              mark = j === qc ? '✓' : (j === chosen && j !== qc ? '✗' : '');
            }
          } else if (isMulti && multiStage.includes(j)) {
            st = 'sel';
          }
          return `<button type="button" class="opt step ${st}${isRev ? ' is-locked' : ''}" data-j="${j}" ${isRev ? 'disabled tabindex="-1"' : ''}>
            <span class="k">${String.fromCharCode(65 + j)}</span>
            <span>${esc(o)}</span>
            <span class="pct">${mark}</span>
            <span class="track"><i style="width:0%"></i></span>
          </button>`;
        }).join('');
        if (isMulti && !isRev) {
          answerZone = `<div class="pr-confirm-wrap"><button type="button" class="pr-confirm" id="pr-confirm">✓ ${esc(t('confirm', 'Tasdiqlash'))} (<span id="pr-sel-n">0</span>)</button></div>`;
        }
      }

      let fb = '';
      if (isRev) {
        let head = '';
        let okTxt = '';
        let who = 'bad';
        if (missed[cur]) {
          head = '⏱ ' + t('timedOut', 'Vaqt tugadi');
        } else if (isMulti) {
          const g = Array.isArray(chosen) ? chosen : [];
          const ok = g.length === qcm.length && g.every((v) => qcm.includes(v));
          who = ok ? 'ok' : 'bad';
          head = ok ? '✅ ' + t('ok', 'To\u2018g\u2018ri!') : '❌ ' + t('notOk', 'Noto\u2018g\u2018ri');
          okTxt = `${t('correctIs', 'To\u2018g\u2018ri javob')}: <b>${qcm.map((v) => String.fromCharCode(65 + v)).join(', ')}</b>`;
        } else if (isShort) {
          if (shortPending[cur]) {
            who = 'ok';
            head = '📩 ' + t('shortAccepted', 'Qabul qilindi — aniq natija yakunda');
          } else {
            who = shortOk[cur] ? 'ok' : 'bad';
            head = shortOk[cur] ? '✅ ' + t('ok', 'To\u2018g\u2018ri!') : '❌ ' + t('notOk', 'Noto\u2018g\u2018ri');
          }
        } else if (isMatch || isReorder) {
          if (stagedPending[cur]) {
            who = 'ok';
            head = '📩 ' + t('shortAccepted', 'Qabul qilindi — aniq natija yakunda');
          } else {
            who = stagedOk[cur] ? 'ok' : 'bad';
            head = stagedOk[cur] ? '✅ ' + t('ok', 'To‘g‘ri!') : '❌ ' + t('notOk', 'Noto‘g‘ri');
          }
        } else {
          const ok = chosen === qc;
          who = ok ? 'ok' : 'bad';
          head = ok ? '✅ ' + t('ok', 'To\u2018g\u2018ri!') : '❌ ' + t('notOk', 'Noto\u2018g\u2018ri');
          okTxt = qc >= 0 ? `${t('correctIs', 'To\u2018g\u2018ri javob')}: <b>${String.fromCharCode(65 + qc)}) ${esc(q.options[qc])}</b>` : '';
        }
        fb = `<div class="pr-fb is-${who}" role="status" aria-live="polite">
          <span>${head}</span>
          ${okTxt ? `<span class="pr-fb-correct">${okTxt}</span>` : ''}
        </div>`;
      }

      const navBtn = isLast
        ? `<button type="button" class="btn" id="finish" ${isRev ? '' : 'disabled'}>${t('finish', '✅ Yakunlash')}</button>`
        : `<button type="button" class="btn" id="next" ${isRev ? '' : 'disabled'}>${t('next', 'Keyingi →')}</button>`;

      quiz.innerHTML = `
        <section class="qstage" aria-label="${esc(posLabel)}" data-qidx="${cur}">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="sc-top"><span class="sc-code">Savol ${flowPos(cur) + 1} / ${flow.length}</span><span class="sc-live"><i></i>mashq</span><span>${UNTIMED ? '∞ vaqtsiz' : '⏱ savol vaqti'}</span></div>
          <div class="sc-body">
            <div class="beam" id="pr-beam"><span class="tx">${esc(t('beamTx', 'ko‘rsatilmoqda…'))}</span><span class="ln"></span><span class="dot"></span></div>
            <h2 class="step q" id="pr-q">${esc(q.text)}</h2>
            ${typeLabel ? `<div class="cap" style="margin:0 0 10px">${esc(typeLabel)}</div>` : ''}
            ${opts ? `<div class="opts">${opts}</div>` : ''}
            ${answerZone}
            ${fb}
            <div class="pr-nav">
              <button type="button" class="btn" id="prev" ${flowPos(cur) === 0 ? 'disabled' : ''}>${t('prev', '← Oldingi')}</button>
              ${navBtn}
            </div>
          </div>
          <div class="sc-foot"><span>sinov</span><span>${retryMode ? esc(t('retryTag', 'Qayta')) : 'yakka mashq'}</span></div>
        </section>`;
      // Kirish animatsiyasi (landing.js bilan bir xil tartib: beam → savol → variantlar → chiziqlar)
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const beam = quiz.querySelector('#pr-beam');
      const qStep = quiz.querySelector('#pr-q');
      const optSteps = [...quiz.querySelectorAll('.opts .opt')];
      const paintBars = () => optSteps.forEach((o) => {
        const bar = o.querySelector('.track i');
        if (bar) bar.style.width = (o.classList.contains('ok') || o.classList.contains('bad')) ? '100%' : '0%';
      });
      if (reduceMotion) {
        if (beam) beam.remove();
        if (qStep) qStep.classList.add('in');
        optSteps.forEach((o) => o.classList.add('in'));
        paintBars();
      } else {
        if (beam) beam.style.opacity = 1;
        setTimeout(() => { if (beam) beam.style.opacity = 0; if (qStep) qStep.classList.add('in'); }, 320);
        optSteps.forEach((o, ix) => setTimeout(() => o.classList.add('in'), 460 + ix * 130));
        setTimeout(paintBars, 460 + optSteps.length * 130 + 120);
      }
      // 09/2026 (Faza 1b): reorder/match javob olish (↑↓ almashtirish + tanlov)
      if (isMatch || isReorder) {
        if (isReorder && !revealed[cur]) {
          const list = quiz.querySelector('#pr-ro-list');
          const paintOrder = () => {
            const items = Array.isArray(q.items) ? q.items : [];
            if (!list) return;
            list.querySelectorAll('.pr-ro-item').forEach((row) => {
              const pos = +row.dataset.roPos;
              const n = row.querySelector('.pr-ro-n');
              const tx = row.querySelector('.pr-ro-t');
              const up = row.querySelector('[data-ro-up]');
              const dn = row.querySelector('[data-ro-down]');
              if (n) n.textContent = pos + 1;
              if (tx) tx.textContent = items[orderStage[pos]] || '';
              if (up) up.disabled = pos === 0;
              if (dn) dn.disabled = pos === orderStage.length - 1;
            });
          };
          if (list) list.addEventListener('click', (ev) => {
            const up = ev.target.closest('[data-ro-up]');
            const dn = ev.target.closest('[data-ro-down]');
            if (!up && !dn) return;
            const pos = +(up ? up.dataset.roUp : dn.dataset.roDown);
            const sw = up ? pos - 1 : pos + 1;
            if (sw < 0 || sw >= orderStage.length) return;
            const tmp = orderStage[pos];
            orderStage[pos] = orderStage[sw];
            orderStage[sw] = tmp;
            paintOrder();
          });
        }
        if (isMatch && !revealed[cur]) {
          quiz.querySelectorAll('.pr-m-sel').forEach((sel) => sel.addEventListener('change', () => {
            const li = +sel.dataset.m;
            if (sel.value === '') delete matchStage[li];
            else matchStage[li] = +sel.value;
          }));
        }
        const cf = quiz.querySelector('#pr-confirm');
        if (cf) cf.addEventListener('click', confirmStaged);
      // 09/2026 (Faza 1): turga mos javob olish
      } else if (isShort) {
        const inp = quiz.querySelector('#pr-short');
        const cf = quiz.querySelector('#pr-confirm');
        if (cf) cf.addEventListener('click', () => confirmShort(inp));
        if (inp) setTimeout(() => { try { inp.focus({ preventScroll: true }); } catch (_) { inp.focus(); } }, 60);
      } else if (isMulti) {
        quiz.querySelectorAll('.opt[data-j]').forEach((b) => b.addEventListener('click', () => {
          if (revealed[cur]) return;
          const j = +b.dataset.j;
          const at = multiStage.indexOf(j);
          if (at >= 0) multiStage.splice(at, 1); else multiStage.push(j);
          b.classList.toggle('sel', at < 0);
          const n = quiz.querySelector('#pr-sel-n');
          if (n) n.textContent = multiStage.length;
        }));
        const cf = quiz.querySelector('#pr-confirm');
        if (cf) cf.addEventListener('click', () => {
          if (revealed[cur]) return;
          if (!multiStage.length) { hint(t('multiPick', 'Kamida 1 ta variant belgilang')); return; }
          answers[cur] = multiStage.slice().sort((a, b) => a - b);
          missed[cur] = false;
          revealed[cur] = true;
          clearTimer();
          recordSpent();
          const qEl = document.getElementById('qtimer');
          if (qEl) qEl.textContent = '';
          renderQ();
          renderDots();
        });
      } else {
        quiz.querySelectorAll('.opt[data-j]').forEach((b) => b.addEventListener('click', () => {
          if (revealed[cur]) return;
          answers[cur] = +b.dataset.j;
          missed[cur] = false;
          revealed[cur] = true;
          clearTimer();
          recordSpent();
          const qEl = document.getElementById('qtimer');
          if (qEl) qEl.textContent = '';
          renderQ(); // darhol natija
          renderDots();
        }));
      }
      const prev = quiz.querySelector('#prev');
      if (prev) prev.addEventListener('click', () => {
        const p = flowPos(cur);
        if (p > 0) { cur = flow[p - 1]; renderQ(); renderDots(); }
      });
      const next = quiz.querySelector('#next');
      if (next) next.addEventListener('click', goNext);
      const fin = quiz.querySelector('#finish');
      if (fin) fin.addEventListener('click', () => { if (revealed[cur]) finish(); });
      // HUD: taymer yonidagi "Keyingisi" (oxirgi savolda — "Yakunlash")
      const hn = document.getElementById('hud-next');
      if (hn) {
        hn.textContent = isLast ? t('finish', '✅ Yakunlash') : t('next', 'Keyingi →');
        hn.disabled = !isRev;
        hn.onclick = () => {
          if (!revealed[cur]) { hint(t('answerFirst', 'Avval savolga javob bering')); return; }
          if (isLast) finish(); else goNext();
        };
      }
    }

    // 09/2026 (Faza 1): Review & Submit — yakunlashdan oldin ko'rib chiqish
    function finish() {
      openReview();
    }
    function openReview() {
      const old = document.querySelector('.pr-review-ov');
      if (old) old.remove();
      const ov = document.createElement('div');
      ov.className = 'pr-review-ov';
      ov.setAttribute('role', 'dialog');
      ov.setAttribute('aria-modal', 'true');
      ov.setAttribute('aria-label', t('reviewTitle', 'Yakuniy ko‘rik'));
      const items = flow.map((i) => {
        const st = missed[i] ? 'miss' : (isAnswered(i) ? 'ok' : 'todo');
        const ico = st === 'ok' ? '✓' : (st === 'miss' ? '⏱' : '·');
        const cls = st === 'ok' ? ' is-ok' : (st === 'miss' ? ' is-miss' : '');
        return `<button type="button" class="pr-review-item${cls}" data-rv="${i}">${flowPos(i) + 1} ${ico}<small>${spent[i] ? spent[i] + 's' : ''}</small></button>`;
      }).join('');
      const unanswered = flow.filter((i) => !isAnswered(i)).length;
      ov.innerHTML = `
        <div class="pr-review-box">
          <h2>${esc(t('reviewTitle', 'Yakuniy ko‘rik'))}</h2>
          <div class="pr-review-sub">${unanswered ? esc(fill('finishAsk', '{n} ta savol javobsiz qoldi. Yakunlaymizmi?', { n: unanswered })) : esc(t('reviewSub', 'Javoblaringizni ko‘rib chiqing — savolni bossangiz o‘sha yerga qaytasiz.'))}</div>
          <div class="pr-review-list">${items}</div>
          <div class="pr-review-actions">
            <button type="button" class="btn btn-quiet" data-rv-close>${esc(t('reviewBack', 'Davom etish'))}</button>
            <button type="button" class="btn btn-primary" data-rv-done>${esc(t('finish', '✅ Yakunlash'))}</button>
          </div>
        </div>`;
      document.body.appendChild(ov);
      const doneBtn = ov.querySelector('[data-rv-done]');
      if (doneBtn) setTimeout(() => { try { doneBtn.focus({ preventScroll: true }); } catch (_) { doneBtn.focus(); } }, 60);
      const close = () => ov.remove();
      ov.addEventListener('click', (e) => { if (e.target === ov) close(); });
      ov.querySelector('[data-rv-close]').addEventListener('click', close);
      ov.querySelector('[data-rv-done]').addEventListener('click', () => { close(); doGrade(); });
      ov.querySelectorAll('[data-rv]').forEach((b) => b.addEventListener('click', () => {
        const i = +b.dataset.rv;
        close();
        cur = i;
        renderQ();
        renderDots();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }));
      const esc2 = (e) => {
        if (e.key === 'Escape') { close(); document.removeEventListener('keydown', esc2); }
      };
      document.addEventListener('keydown', esc2);
    }
    async function doGrade() {
      try {
        const res = await fetch('/user/api/practice/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify({
            answers, source: SOURCE, key: KEY, chunk: CHUNK,
            // C4-10 rev.4: retry — faqat xato savollar baholanadi va «retry» sifatida saqlanadi
            subset: retryMode ? flow : undefined,
            kind: retryMode ? 'retry' : 'full',
            times: spent, // 09/2026 (Faza 1): savol tahlili (har savolga vaqt)
            focusViolations: focusViol, // 09/2026 (Faza 1): fokus rejimi
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) { alert(t('errPrefix', 'Xato: ') + (data.error || res.status)); return; }
        showResult(data);
      } catch (e) { alert(t('netErr', 'Tarmoq xatosi')); }
    }

    function showResult(data) {
      finished = true;
      clearTimer();
      // 09/2026 (Faza 1): fokus rejimidan chiqish
      try { if (document.fullscreenElement) document.exitFullscreen(); } catch (_) {}
      document.getElementById('quiz').hidden = true;
      dots.hidden = true;
      const el = document.getElementById('result');
      el.hidden = false;
      const correct = data.correct, total = data.total;
      const wrongList = (data.results || []).filter((r) => !r.isCorrect).map((r) => r.id);
      // AI Assist v1: tahlil paneli uchun natija ma'lumoti (faqat o'qish)
      // 09/2026: AI izoh uchun variantlar + indekslar (multi/short bilan)
      try {
        window.__PR_RESULT__ = {
          percent: data.percent, correct, total,
          wrong: (data.results || []).filter((r) => !r.isCorrect).map((r) => ({
            text: (QUESTIONS[r.id] && QUESTIONS[r.id].text) || ('Savol ' + (r.id + 1)),
            type: r.type || 'single_choice',
            options: (QUESTIONS[r.id] && QUESTIONS[r.id].options) || [],
            correctIndex: (typeof r.correctIndex === 'number') ? r.correctIndex : -1,
            givenIndex: (typeof r.given === 'number') ? r.given : -1,
          })),
        };
      } catch (_) {}
      const hasWrong = wrongList.length > 0;
      // 09/2026 (Faza 1): savol tahlili xulosasi (vaqt + fokus)
      const metaParts = [];
      if (data.totalSec != null) metaParts.push('⏱ ' + data.totalSec + 's');
      if (data.focusViolations > 0) metaParts.push('🎯 ' + t('focusMeta', 'chetga chiqish: ') + data.focusViolations);
      const timed = (data.results || []).filter((r) => r.sec > 0);
      if (timed.length > 1) {
        const slow = timed.reduce((a, b) => (a.sec >= b.sec ? a : b));
        metaParts.push(fill('slowNote', 'Eng ko‘p vaqt: {n}-savol ({m}s)', { n: slow.id + 1, m: slow.sec }));
      }
      const metaHtml = metaParts.length ? `<div class="pr-res-meta">${metaParts.map(esc).join(' · ')}</div>` : '';
      // C4-10 rev.4: yakun — natija saqlangani tasdig'i + qayta yechish + tarix
      const savedNote = hasWrong
        ? t('retryNote', 'Avvalgi xatolaringiz aynan shu savollardan qayta beriladi.')
        : t('emptyNote', 'Xatolarsiz yakunladingiz — zo‘r natija! 🎉');
      el.innerHTML = `
        <div class="res-card">
          <div class="pr-res-wrap">
            <div class="pr-res-score">${data.percent}%</div>
            <div class="pr-res-sub">${fill('resSub', '{correct} / {total} to\u2018g\u2018ri javob', { correct, total })}</div>
            ${data.saved === false
              ? `<div class="pr-res-saved">↻ ${t('notSaved', 'Mashq rejimi — natija saqlanmadi')}</div>`
              : `<div class="pr-res-saved">✓ ${t('savedOk', 'Natija saqlandi')}</div>`}
            <div class="pr-res-note">${esc(savedNote)}</div>
            ${metaHtml}
            <div class="pr-res-actions no-print">
              <button type="button" class="btn btn-quiet" data-print>${t('print', '🖨️ Chop etish')}</button>
              ${hasWrong ? `<button type="button" class="btn act-sinov" id="retry-wrong" style="margin:0">${fill('retryWrong', 'Qayta yechish — faqat xatolar ({n})', { n: wrongList.length })}</button>` : ''}
              <button type="button" class="btn btn-quiet" id="retry-all">${t('retryAll', 'Boshidan qayta yechish')}</button>
              <button type="button" class="ai-trigger" id="pr-ai-analysis"><span class="ai-spark">✨</span> ${t('aiAnalysis', 'AI tahlil')}</button>
              <a class="btn btn-primary" href="/user/practice-history">${t('histOpen', 'Natijalarim')}</a>
              <a class="btn btn-quiet" href="/user/panel">${t('backPanel', '← Panelga qaytish')}</a>
            </div>
          </div>
          ${data.results.map((r) => {
            const q = QUESTIONS[r.id];
            if (!q) return '';
            // 09/2026 (Faza 1): turga mos ko'rinish + sarflangan vaqt
            const secTag = r.sec > 0 ? ` <span class="pr-rv-sec">⏱ ${r.sec}s</span>` : '';
            let body = '';
            // 09/2026 (Faza 1b): reorder/match yakuniy ko'rinishi (to'g'ri ketma-ketlik serverdan)
            if (r.type === 'reorder') {
              const g = Array.isArray(r.given) ? r.given : [];
              const exp = Array.isArray(r.correctOrder) ? r.correctOrder : [];
              body = exp.map((txt, ix) => {
                const mine = g[ix] || '';
                const same = mine === txt;
                return `<div class="pr-rv-o${same ? ' ok' : ' no'}">${ix + 1}. ${esc(txt)}${same ? ' ✓' : ''}</div>`
                  + (same ? '' : `<div class="pr-rv-o no">↳ ${esc(mine || '—')} ${t('yourAnswer', '← sizning javobingiz')}</div>`);
              }).join('') || `<div class="pr-rv-o">—</div>`;
            } else if (r.type === 'match') {
              const g = Array.isArray(r.given) ? r.given : [];
              const exp = Array.isArray(r.correctMap) ? r.correctMap : [];
              const lefts = Array.isArray(r.lefts) ? r.lefts : [];
              body = exp.map((txt, ix) => {
                const mine = g[ix] || '';
                const same = mine === txt;
                return `<div class="pr-rv-o${same ? ' ok' : ' no'}">${esc(lefts[ix] || (ix + 1))} → <b>${esc(txt)}</b>${same ? ' ✓' : ''}</div>`
                  + (same ? '' : `<div class="pr-rv-o no">↳ ${esc(mine || '—')} ${t('yourAnswer', '← sizning javobingiz')}</div>`);
              }).join('') || `<div class="pr-rv-o">—</div>`;
            } else if (r.type === 'short_answer') {
              body = `<div class="pr-rv-o${r.isCorrect ? ' ok' : ' no'}">✍️ ${esc(r.given || '—')}${r.isCorrect ? ' ✓' : ' ' + t('yourAnswer', '← sizning javobingiz')}</div>`
                + (r.isCorrect ? '' : `<div class="pr-rv-o ok">✓ ${esc(r.correctText || '')}</div>`);
            } else if (r.type === 'multiple_select') {
              const g = Array.isArray(r.given) ? r.given : [];
              const cm = Array.isArray(r.correctMulti) ? r.correctMulti : [r.correctIndex];
              body = q.options.map((o, j) => {
                const inC = cm.includes(j);
                const inG = g.includes(j);
                return `<div class="pr-rv-o${inC ? ' ok' : (inG ? ' no' : '')}">${String.fromCharCode(65 + j)}) ${esc(o)}${inC ? ' ✓' : (inG ? ' ' + t('yourAnswer', '← sizning javobingiz') : '')}</div>`;
              }).join('');
            } else {
              body = q.options.map((o, j) => `<div class="pr-rv-o${j === r.correctIndex ? ' ok' : j === r.given ? ' no' : ''}">${String.fromCharCode(65 + j)}) ${esc(o)}${j === r.correctIndex ? ' ✓' : (j === r.given ? ' ' + t('yourAnswer', '← sizning javobingiz') : '')}</div>`).join('');
            }
            return `<div class="pr-review ${r.isCorrect ? 'right' : 'wrong'}">
              <div class="pr-rv-q">${r.id + 1}. ${esc(q.text)}${secTag} ${r.isCorrect ? '✅' : '❌'}</div>
              ${body}
              ${r.explanation ? `<div class="pr-rv-e">💡 ${esc(r.explanation)}</div>` : ''}
            </div>`;
          }).join('')}
        </div>`;
      const prBtn = el.querySelector('[data-print]');
      if (prBtn) prBtn.addEventListener('click', () => window.print());
      const rw = el.querySelector('#retry-wrong');
      if (rw) rw.addEventListener('click', () => beginRetry(wrongList));
      const ra = el.querySelector('#retry-all');
      if (ra) ra.addEventListener('click', () => { location.href = location.pathname + location.search; });
    }

    // C4-10 rev.4: faqat xato savollardan qayta mashq (majburiy emas — istalgan
    // payt chiqib ketish mumkin; nav qismi flow'da torayadi).
    function beginRetry(wrongIdx) {
      if (!wrongIdx.length) return;
      retryMode = true;
      finished = false;
      flow = wrongIdx.slice().sort((a, b) => a - b);
      answers.fill(-1);
      revealed.fill(false);
      missed.fill(false);
      spent.fill(0);
      shortOk.fill(false);
      shortPending.fill(false);
      stagedOk.fill(false);
      stagedPending.fill(false);
      multiStage = [];
      orderStage = [];
      matchStage = {};
      cur = flow[0];
      document.getElementById('result').hidden = true;
      const quizEl = document.getElementById('quiz');
      quizEl.hidden = false;
      dots.hidden = false;
      const h = document.getElementById('pr-hint');
      if (h) { h.textContent = '↻ ' + t('retryNote', 'Avvalgi xatolaringiz aynan shu savollardan qayta beriladi.'); h.classList.add('show'); }
      clearTimeout(hint._iv);
      hint._iv = setTimeout(() => { if (h) h.classList.remove('show'); }, 4200);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      renderDots();
      renderQ();
    }

    // 09/2026 (user qarori): ENTER — keyingi savolga o'tish (savolni
    // "tugatish" emas; oxirgi savolda yakunlamaydi — hint beradi).
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      // 09/2026 (Faza 1 fix): review oynasi ochiq bo'lsa ENTER orqa fonda ishlamasin
      if (document.querySelector('.pr-review-ov')) return;
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (/INPUT|TEXTAREA|SELECT/.test(tag)) {
        // 09/2026 (Faza 1): short input'da ENTER = tasdiqlash
        if (document.activeElement && document.activeElement.id === 'pr-short') {
          e.preventDefault();
          const cf = document.getElementById('pr-confirm');
          if (cf && !cf.disabled) cf.click();
        }
        return;
      }
      const ae = document.activeElement;
      if (ae && (ae.id === 'next' || ae.id === 'finish' || ae.id === 'hud-next' || ae.id === 'prev')) return; // native click
      if (!document.getElementById('result').hidden) return;
      if (document.getElementById('quiz').hidden) return;
      e.preventDefault();
      // 09/2026 (Faza 1): multi'da ENTER = tasdiqlash
      if (!revealed[cur]) {
        const cf = document.getElementById('pr-confirm');
        if (cf && !cf.disabled) { cf.click(); return; }
        hint(t('answerFirst', 'Avval savolga javob bering'));
        return;
      }
      if (flowPos(cur) === flow.length - 1) { hint(t('enterLastHint', 'Oxirgi savol — yakunlash uchun «Yakunlash» tugmasini bosing')); return; }
      goNext();
    });

    // 09/2026 (user qarori): test jarayonida orqaga chiqishda ogohlantirish;
    // "Ha" — saqlamasdan chiqish (finish chaqirilmaydi → chinakam discard).
    function leaveMsg() { return t('leaveAsk', 'Rostdan ham orqaga qaytmoqchimisiz? O‘zgarishlar saqlanmasligi mumkin'); }
    function quizStarted() { return !finished && revealed.some(Boolean); }
    let prLeaving = false;
    window.addEventListener('beforeunload', (e) => {
      if (prLeaving || !quizStarted()) return;
      e.preventDefault();
      e.returnValue = leaveMsg();
    });
    document.querySelectorAll('.pr-back').forEach((a) => a.addEventListener('click', (e) => {
      if (quizStarted() && !confirm(leaveMsg())) e.preventDefault();
      else prLeaving = true;
    }));

    // 09/2026 (Faza 1): Fokus rejimi — fullscreen + chetga chiqishni sanash
    const focusBtn = document.getElementById('pr-focus');
    function paintFocus() {
      if (!focusBtn) return;
      focusBtn.classList.toggle('on', focusOn);
      focusBtn.setAttribute('aria-pressed', focusOn ? 'true' : 'false');
      focusBtn.textContent = focusOn ? ('🎯 ' + t('focusOnLbl', 'Fokus') + ': ' + focusViol) : '🎯 ' + t('focusOnLbl', 'Fokus');
    }
    function focusWarn() {
      focusViol++;
      paintFocus();
      hint(t('focusWarn', 'Diqqat: sahifadan chetga chiqdingiz! (') + focusViol + ')');
    }
    if (focusBtn) focusBtn.addEventListener('click', async () => {
      focusOn = !focusOn;
      if (focusOn) {
        try { await document.documentElement.requestFullscreen(); } catch (_) {}
        hint(t('focusOn', 'Fokus rejimi: sahifadan chiqish qayd etiladi'));
      } else {
        try { if (document.fullscreenElement) await document.exitFullscreen(); } catch (_) {}
      }
      paintFocus();
    });
    document.addEventListener('visibilitychange', () => {
      if (focusOn && !finished && document.hidden) focusWarn();
    });
    document.addEventListener('fullscreenchange', () => {
      if (focusOn && !finished && !document.fullscreenElement) focusWarn();
    });

    paintModeChip();
    paintFocus();
    renderDots();
    renderQ();
  </script>
  <script src="/js/icon-kit.js"></script>
  <script src="/js/ai-assist.js?v=ai2" defer></script>
</body>
</html>
