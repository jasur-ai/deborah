<!DOCTYPE html>
<html lang="<%= htmlLang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/question-stage.css">
  <style>
    /* Yakka mashq (Sinov) — jonli sahna (C4-10 rev.2: reklama uslubi yo'q):
       katta maydon, iliq 2×2 javob plitalari, darhol natija, vaqt/vaqtsiz.
       Rasm: qora-jigarrang sahna + krem karta — Deborah vintage palitrasi. */
    *{box-sizing:border-box;}
    html,body{min-height:100%;}
    body{
      margin:0;padding:0;
      font-family:'Source Sans 3',system-ui,-apple-system,'Segoe UI',sans-serif;
      color:#f6ecd9;
      background:
        radial-gradient(1100px 520px at 50% -10%, rgba(201,165,101,.18), transparent 60%),
        linear-gradient(160deg,#2b2013 0%, #1c140a 55%, #150e07 100%);
      background-attachment:fixed;
    }
    button{font-family:inherit;}

    .pr-top{
      display:flex;align-items:center;gap:14px;flex-wrap:wrap;
      padding:14px 22px;
      background:rgba(20,13,6,.55);
      border-bottom:1px solid rgba(201,165,101,.28);
      backdrop-filter:blur(8px);
    }
    .pr-top-l{display:flex;align-items:center;gap:12px;min-width:0;}
    .pr-badge{
      font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.14em;
      color:#1a1305;background:linear-gradient(135deg,#d9b465,#c9a565 55%,#a37f3a);
      border-radius:50px;padding:4px 12px;flex-shrink:0;white-space:nowrap;
    }
    .pr-title{
      font-size:1.05rem;font-weight:800;margin:0;color:#f6ecd9;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:60vw;
    }
    .pr-top-r{margin-left:auto;display:flex;align-items:center;gap:10px;}
    .pr-chip{
      display:inline-flex;align-items:center;gap:6px;
      font-size:.8rem;font-weight:800;font-variant-numeric:tabular-nums;
      color:#f6ecd9;background:rgba(201,165,101,.14);
      border:1px solid rgba(201,165,101,.45);border-radius:50px;padding:6px 13px;
    }
    .pr-chip .ico-untimed{color:#d9b465;}
    .pr-back{
      text-decoration:none;font-size:.8rem;font-weight:700;color:#e9d9b8;
      padding:8px 14px;border-radius:50px;
      border:1px solid rgba(201,165,101,.35);background:rgba(201,165,101,.1);
    }
    .pr-back:hover{background:rgba(201,165,101,.22);color:#fff;}
    @media (max-width:640px){ .pr-title{max-width:44vw;font-size:.92rem;} }

    .pr-stage{max-width:1040px;margin:0 auto;padding:22px 18px 60px;}
    .pr-hud{
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      margin-bottom:14px;
    }
    .pr-qpos{font-size:.86rem;font-weight:800;color:#c9a565;letter-spacing:.08em;text-transform:uppercase;}
    .pr-timer{min-height:1.4rem;font-size:.9rem;font-weight:800;color:#f6ecd9;}
    .pr-timer:empty{display:none;}
    .pr-hint{
      margin:0 0 12px;padding:0;opacity:0;transform:translateY(-4px);
      transition:opacity .15s ease, transform .15s ease;
      color:#e2a464;font-weight:700;font-size:.88rem;text-align:center;
    }
    .pr-hint.show{opacity:1;transform:none;}

    /* ── Savol kartasi: kirish dashboard'dagi SQL namunaning aynan o'zi
       (.qstage — /css/question-stage.css). Faqat kenglik moslanadi. ── */
    #quiz .qstage{max-width:860px;}
    #quiz .qstage .q{font-size:clamp(1.05rem,2.2vw,1.35rem);}
    #quiz .qstage .opt{font-size:clamp(.92rem,1.6vw,1.02rem);padding:11px 14px;cursor:pointer;}
    #quiz .qstage .opt.is-locked{pointer-events:none;}
    @keyframes qpop{0%{transform:scale(1)}55%{transform:scale(1.02)}100%{transform:scale(1)}}
    #quiz .qstage .opt.is-right{animation:qpop .28s ease;}
    #quiz .qstage .opt .qt-mark{margin-left:8px;font-weight:900;}

    .pr-fb{
      margin:14px auto 2px;padding:11px 16px;
      display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;
      font-weight:700;font-size:clamp(.85rem,1.5vw,.98rem);text-align:center;
      max-width:640px;border:1px solid;
      font-family:'IBM Plex Mono',Consolas,monospace;letter-spacing:.02em;
    }
    .pr-fb.is-ok{color:#9fd3a5;background:rgba(125,150,112,.12);border-color:rgba(125,150,112,.5);}
    .pr-fb.is-bad{color:#e0a98c;background:rgba(168,121,79,.12);border-color:rgba(168,121,79,.5);}
    .pr-fb-correct{font-size:.78rem;font-weight:400;opacity:.9;}
    .pr-fb-correct b{color:inherit;}

    /* HUD: taymer yonidagi "Keyingisi" (09/2026 user qarori) */
    .pr-hud-r{display:flex;align-items:center;gap:10px;}
    #hud-next{
      border:1px solid rgba(201,165,101,.55);border-radius:50px;cursor:pointer;
      background:linear-gradient(135deg,#d9b465,#a37f3a);color:#1a1305;
      font-weight:800;font-size:.82rem;padding:8px 18px;min-height:44px;white-space:nowrap;
    }
    #hud-next:hover:not(:disabled){filter:brightness(1.07);}
    #hud-next:disabled{opacity:.45;cursor:not-allowed;}

    .pr-nav{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-top:18px;}
    .pr-nav button{
      font-family:'IBM Plex Mono',Consolas,monospace;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;
      border:1px solid rgba(242,237,227,.2);background:transparent;color:#f2ede3;
      border-radius:0;padding:12px 20px;cursor:pointer;min-height:48px;
    }
    .pr-nav button:hover:not(:disabled){border-color:#c2a06a;color:#d6bd8c;}
    #next,#finish{margin-left:auto;background:#c2a06a;border-color:#c2a06a;color:#141006;}
    #next:hover:not(:disabled),#finish:hover:not(:disabled){background:#d6bd8c;border-color:#d6bd8c;color:#141006;}
    .btn[disabled]{opacity:.4;cursor:not-allowed;}

    /* progress segmentlar */
    .pr-dots{display:flex;gap:6px;justify-content:center;margin-top:22px;flex-wrap:wrap;}
    .pr-dot{
      width:26px;height:6px;border-radius:4px;border:0;cursor:pointer;padding:0;
      background:rgba(201,165,101,.28);transition:background .15s ease, transform .15s ease;
    }
    .pr-dot.done{background:rgba(201,165,101,.75);}
    .pr-dot.miss{background:#b45309;}
    .pr-dot.cur{transform:scaleY(2);background:#d9b465;}
    .pr-dot.locked{cursor:default;}

    /* ── Natija ── */
    .res-card{
      background:#f7eeda;color:#241a0c;border-radius:26px;padding:30px 26px;
      box-shadow:0 24px 60px rgba(0,0,0,.45);
    }
    .pr-res-wrap{text-align:center;}
    .pr-res-score{
      font-size:clamp(2.6rem,6vw,3.6rem);font-weight:900;line-height:1;
      background:linear-gradient(135deg,#8a5a1e,#c9a565);-webkit-background-clip:text;background-clip:text;
      -webkit-text-fill-color:transparent;
    }
    .pr-res-sub{font-size:1rem;color:#6b4a1e;font-weight:700;margin:8px 0 4px;}
    .pr-res-done{font-size:.85rem;color:#8a6a3a;font-weight:600;margin-bottom:20px;}
    .pr-res-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:6px;}
    .pr-res-actions .btn{border:0;border-radius:14px;padding:12px 22px;font-weight:800;font-size:.92rem;cursor:pointer;min-height:48px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;}
    .btn-quiet{background:#efe2c4;color:#5b4317;}
    .btn-primary{background:linear-gradient(135deg,#d9b465,#a37f3a);color:#1a1305;}
    .pr-review{border:1px solid #d9c49a;border-radius:14px;padding:12px 16px;margin-bottom:10px;background:#fff8e8;}
    .pr-review.right{border-color:#7cc98a;background:#f1fae9;}
    .pr-review.wrong{border-color:#d99c7c;background:#fdf1ea;}
    .pr-rv-q{font-weight:800;font-size:.95rem;margin-bottom:6px;}
    .pr-rv-o{font-size:.86rem;margin-left:12px;color:#5b4317;font-weight:600;}
    .pr-rv-o.ok{color:#1e8a3c;font-weight:800;}
    .pr-rv-o.no{color:#b13a2e;}
    .pr-rv-e{font-size:.8rem;color:#8a6a3a;margin-top:8px;border-top:1px dashed #d9c49a;padding-top:8px;}
    @media (max-width:600px){ .pr-stage{padding:16px 12px 50px;} }
    @media (prefers-reduced-motion: reduce){
      .pr-fb,.pr-dot{transition:none;animation:none;}
    }
    @media print {
      .pr-top,.pr-hud,.pr-nav,.pr-dots,.pr-res-actions{display:none !important;}
      body{background:#fff;color:#000;}
      #quiz .qstage,.res-card,.pr-review{box-shadow:none;background:#fff;color:#000;border:1px solid #bbb;}
    }

    /* rev.4 mobil: savol nuqtalari telefonda qulay */
    @media (max-width: 640px){
      .pr-dot{min-width:44px;min-height:44px;}
      .pr-dot.cur{transform:scaleY(1.15);}
      .pr-dots{gap:8px;}
      .pr-badge{font-size:.78rem;}
      .pr-back{min-height:44px;display:inline-flex;align-items:center;}
      #hud-next{padding:8px 14px;font-size:.78rem;}
    }
</style>
</head>
<body>
  <header class="pr-top">
    <div class="pr-top-l">
      <span class="pr-badge"><%= pCopy.topBadge %></span>
      <h1 class="pr-title"><%= practiceTitle %></h1>
    </div>
    <div class="pr-top-r">
      <span class="pr-chip" id="mode-chip" hidden></span>
      <a class="pr-back" href="/user/practice-history"><%= pCopy.histOpen || 'Natijalarim' %></a>
      <a class="pr-back" href="/user/panel"><%= pCopy.back %></a>
    </div>
  </header>

  <main class="pr-stage">
    <div class="pr-hud">
      <div class="pr-qpos" id="qpos"></div>
      <div class="pr-hud-r">
        <div class="pr-timer" id="qtimer" aria-live="polite"></div>
        <!-- 09/2026 (user qarori): sanalayotgan vaqt yonida "Keyingisi" + ENTER -->
        <button type="button" id="hud-next" disabled>Keyingisi →</button>
      </div>
    </div>
    <div class="pr-hint" id="pr-hint" role="status" aria-live="polite"></div>
    <div id="quiz"></div>
    <div id="result" hidden></div>
    <div class="pr-dots" id="dots"></div>
  </main>

  <script>
    const QUESTIONS = <%- JSON.stringify(questions).replace(/</g, '\\u003c') %>;
    const CSRF = <%- JSON.stringify(csrfToken || '') %>;
    const SOURCE = <%- JSON.stringify(source) %>;
    const KEY = <%- JSON.stringify(key) %>;
    const CHUNK = <%- JSON.stringify(chunk) %>;
    const PC = <%- JSON.stringify(pCopy || {}) %>;
    const t = (k, fb) => (PC[k] !== undefined ? PC[k] : fb);
    const fill = (k, fb, map) => t(k, fb).split('{n}').join(map.n != null ? map.n : '').split('{m}').join(map.m != null ? map.m : '').split('{total}').join(map.total != null ? map.total : '').split('{correct}').join(map.correct != null ? map.correct : '').split('{title}').join(map.title != null ? map.title : '');

    /* 09/2026 (user qarori):
       — javobsiz savoldan oldinga o'tib bo'lmaydi (Next/Finish/dots bloklanadi);
       — javob tanlansa DARHOL to'g'ri/noto'g'ri natija chiqadi;
       — vaqt tugasa savol "o'tkazib yuborilgan" sifatida yopiladi;
       — ?time=0 yoki time yo'q = VAQTSIZ rejim (timer yo'q, shoshilish yo'q). */
    const PER_Q_TIME = Math.max(0, parseInt(new URLSearchParams(location.search).get('time'), 10) || 0);
    const UNTIMED = !(PER_Q_TIME > 0);
    const answers = new Array(QUESTIONS.length).fill(-1);
    const revealed = new Array(QUESTIONS.length).fill(false);
    const missed = new Array(QUESTIONS.length).fill(false);
    let cur = 0;
    let timeLeft = PER_Q_TIME;
    let timerIv = null;
    // C4-10 rev.4: nav tartibi — yakunda «faqat xatolarni qayta yechish» uchun
    // flow'ni xato savollar indekslariga toraytiramiz (retryMode).
    let flow = QUESTIONS.map((_, i) => i);
    let retryMode = false;
    let finished = false; // natija ekrani ochiqmi (orqaga-confirm uchun)
    const flowPos = (i) => flow.indexOf(i);

    // Sahna plitalari uchun iliq ranglar (C4-10 rev.2: reklama uslubi olib
    // tashlandi) — terrakota/oltin/zaytun/g'isht, index bo'yicha tsikl
    const TILE_COLORS = ['#a4572a', '#a8892a', '#567a33', '#96423a'];

    function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function correctOf(i) {
      const c = QUESTIONS[i] && QUESTIONS[i].correct;
      const n = QUESTIONS[i] && QUESTIONS[i].options ? QUESTIONS[i].options.length : 0;
      return Number.isInteger(c) && c >= 0 && c < n ? c : -1;
    }
    function hint(msg) {
      const h = document.getElementById('pr-hint');
      if (!h) return;
      h.textContent = '⚠ ' + msg;
      h.classList.add('show');
      clearTimeout(hint._iv);
      hint._iv = setTimeout(() => h.classList.remove('show'), 2600);
    }
    function clearTimer() { clearInterval(timerIv); timerIv = null; }
    function paintModeChip() {
      const el = document.getElementById('mode-chip');
      if (!el) return;
      el.hidden = false;
      el.innerHTML = UNTIMED
        ? '<span class="ico-untimed">∞</span> ' + t('untimed', 'Vaqtsiz')
        : '⏱ ' + String(PER_Q_TIME).padStart(2, '0') + ':00';
    }
    function startTimer() {
      clearTimer();
      const el = document.getElementById('qtimer');
      if (UNTIMED) { if (el) el.textContent = ''; return; }
      if (revealed[cur]) { if (el) el.textContent = ''; return; }
      timeLeft = PER_Q_TIME;
      if (!el) return;
      const fmt = () => '⏱ ' + String(Math.floor(timeLeft / 60)).padStart(2, '0') + ':' + String(timeLeft % 60).padStart(2, '0');
      el.textContent = fmt();
      timerIv = setInterval(() => {
        timeLeft--;
        el.textContent = fmt();
        if (timeLeft <= 0) {
          clearTimer();
          el.textContent = '';
          if (!revealed[cur]) {
            missed[cur] = true;
            answers[cur] = -1;
            revealed[cur] = true;
            renderQ();
            renderDots();
          }
        }
      }, 1000);
    }

    const dots = document.getElementById('dots');
    function renderDots() {
      dots.innerHTML = flow.map((i) => {
        let cls = 'pr-dot';
        if (revealed[i]) cls += ' done' + (missed[i] ? ' miss' : '');
        if (i === cur) cls += ' cur';
        const nextUnlocked = i === flow[flowPos(cur) + 1] && revealed[cur];
        const unlock = i === cur || revealed[i] || nextUnlocked;
        if (!unlock) cls += ' locked';
        return `<button type="button" class="${cls}" data-i="${i}" ${unlock ? '' : 'tabindex="-1" aria-disabled="true"'} aria-label="${fill('dotAria', 'Savol {n}', { n: i + 1 })}"></button>`;
      }).join('');
      dots.querySelectorAll('.pr-dot').forEach((d) => d.addEventListener('click', () => {
        const i = +d.dataset.i;
        const unlocked = i === cur || revealed[i] || (i === flow[flowPos(cur) + 1] && revealed[cur]);
        if (unlocked) { cur = i; renderQ(); renderDots(); }
        else hint(t('answerFirst', 'Avval savolga javob bering'));
      }));
    }

    const quiz = document.getElementById('quiz');
    const qpos = document.getElementById('qpos');
    function goNext() {
      const p = flowPos(cur);
      const nxt = flow[p + 1];
      if (revealed[cur] && nxt != null) { cur = nxt; renderQ(); renderDots(); }
      else if (!revealed[cur]) hint(t('answerFirst', 'Avval savolga javob bering'));
    }
    function renderQ() {
      startTimer();
      const posLabel = (retryMode ? t('retryTag', 'Qayta: ') : '') + (flowPos(cur) + 1) + ' / ' + flow.length;
      if (qpos) qpos.textContent = posLabel;
      const q = QUESTIONS[cur];
      const qc = correctOf(cur);
      const isRev = revealed[cur];
      const chosen = answers[cur];
      const isLast = flowPos(cur) === flow.length - 1;
      const typeLabel = q.type === 'true_false' ? 'To\u2018g\u2018ri / Noto\u2018g\u2018ri'
        : (q.type === 'short_answer' ? 'Qisqa javob' : '');
      // Variantlar — kirish dashboard'dagi .opt (kalit doira + matn + belgi + oltin track)
      const opts = q.options.map((o, j) => {
        let st = '';
        if (isRev) {
          if (j === qc) st = 'ok is-right';
          else if (j === chosen) st = 'bad';
          else st = 'dim';
        }
        const mark = isRev && j === qc ? '✓' : (isRev && j === chosen && j !== qc ? '✗' : '');
        return `<button type="button" class="opt step ${st}${isRev ? ' is-locked' : ''}" data-j="${j}" ${isRev ? 'disabled tabindex="-1"' : ''}>
          <span class="k">${String.fromCharCode(65 + j)}</span>
          <span>${esc(o)}</span>
          <span class="pct">${mark}</span>
          <span class="track"><i style="width:0%"></i></span>
        </button>`;
      }).join('');

      let fb = '';
      if (isRev) {
        const okTxt = qc >= 0 ? `${t('correctIs', 'To\u2018g\u2018ri javob')}: <b>${String.fromCharCode(65 + qc)}) ${esc(q.options[qc])}</b>` : '';
        const who = missed[cur] ? 'miss' : (chosen === qc ? 'ok' : 'bad');
        const head = missed[cur] ? '⏱ ' + t('timedOut', 'Vaqt tugadi')
          : (chosen === qc ? '✅ ' + t('ok', 'To\u2018g\u2018ri!') : '❌ ' + t('notOk', 'Noto\u2018g\u2018ri'));
        fb = `<div class="pr-fb is-${who === 'ok' ? 'ok' : 'bad'}" role="status" aria-live="polite">
          <span>${head}</span>
          ${okTxt ? `<span class="pr-fb-correct">${okTxt}</span>` : ''}
        </div>`;
      }

      const navBtn = isLast
        ? `<button type="button" class="btn" id="finish" ${isRev ? '' : 'disabled'}>${t('finish', '✅ Yakunlash')}</button>`
        : `<button type="button" class="btn" id="next" ${isRev ? '' : 'disabled'}>${t('next', 'Keyingi →')}</button>`;

      quiz.innerHTML = `
        <section class="qstage" aria-label="${esc(posLabel)}">
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
          <div class="sc-top"><span class="sc-code">Savol ${flowPos(cur) + 1} / ${flow.length}</span><span class="sc-live"><i></i>mashq</span><span>${UNTIMED ? '∞ vaqtsiz' : '⏱ savol vaqti'}</span></div>
          <div class="sc-body">
            <div class="beam" id="pr-beam"><span class="tx">${esc(t('beamTx', 'ko‘rsatilmoqda…'))}</span><span class="ln"></span><span class="dot"></span></div>
            <h2 class="step q" id="pr-q">${esc(q.text)}</h2>
            ${typeLabel ? `<div class="cap" style="margin:0 0 10px">${esc(typeLabel)}</div>` : ''}
            <div class="opts">${opts}</div>
            ${fb}
            <div class="pr-nav">
              <button type="button" class="btn" id="prev" ${flowPos(cur) === 0 ? 'disabled' : ''}>${t('prev', '← Oldingi')}</button>
              ${navBtn}
            </div>
          </div>
          <div class="sc-foot"><span>sinov</span><span>${retryMode ? esc(t('retryTag', 'Qayta')) : 'yakka mashq'}</span></div>
        </section>`;
      // Kirish animatsiyasi (landing.js bilan bir xil tartib: beam → savol → variantlar → chiziqlar)
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const beam = quiz.querySelector('#pr-beam');
      const qStep = quiz.querySelector('#pr-q');
      const optSteps = [...quiz.querySelectorAll('.opts .opt')];
      const paintBars = () => optSteps.forEach((o) => {
        const bar = o.querySelector('.track i');
        if (bar) bar.style.width = (o.classList.contains('ok') || o.classList.contains('bad')) ? '100%' : '0%';
      });
      if (reduceMotion) {
        if (beam) beam.remove();
        if (qStep) qStep.classList.add('in');
        optSteps.forEach((o) => o.classList.add('in'));
        paintBars();
      } else {
        if (beam) beam.style.opacity = 1;
        setTimeout(() => { if (beam) beam.style.opacity = 0; if (qStep) qStep.classList.add('in'); }, 320);
        optSteps.forEach((o, ix) => setTimeout(() => o.classList.add('in'), 460 + ix * 130));
        setTimeout(paintBars, 460 + optSteps.length * 130 + 120);
      }
      quiz.querySelectorAll('.opt[data-j]').forEach((b) => b.addEventListener('click', () => {
        if (revealed[cur]) return;
        answers[cur] = +b.dataset.j;
        missed[cur] = false;
        revealed[cur] = true;
        clearTimer();
        const qEl = document.getElementById('qtimer');
        if (qEl) qEl.textContent = '';
        renderQ(); // darhol natija
        renderDots();
      }));
      const prev = quiz.querySelector('#prev');
      if (prev) prev.addEventListener('click', () => {
        const p = flowPos(cur);
        if (p > 0) { cur = flow[p - 1]; renderQ(); renderDots(); }
      });
      const next = quiz.querySelector('#next');
      if (next) next.addEventListener('click', goNext);
      const fin = quiz.querySelector('#finish');
      if (fin) fin.addEventListener('click', () => { if (revealed[cur]) finish(); });
      // HUD: taymer yonidagi "Keyingisi" (oxirgi savolda — "Yakunlash")
      const hn = document.getElementById('hud-next');
      if (hn) {
        hn.textContent = isLast ? t('finish', '✅ Yakunlash') : t('next', 'Keyingi →');
        hn.disabled = !isRev;
        hn.onclick = () => {
          if (!revealed[cur]) { hint(t('answerFirst', 'Avval savolga javob bering')); return; }
          if (isLast) finish(); else goNext();
        };
      }
    }

    async function finish() {
      const unanswered = flow.filter((i) => answers[i] < 0).length;
      if (unanswered > 0 && !confirm(fill('finishAsk', '{n} ta savol javobsiz qoldi. Yakunlaymizmi?', { n: unanswered }))) return;
      try {
        const res = await fetch('/user/api/practice/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify({
            answers, source: SOURCE, key: KEY, chunk: CHUNK,
            // C4-10 rev.4: retry — faqat xato savollar baholanadi va «retry» sifatida saqlanadi
            subset: retryMode ? flow : undefined,
            kind: retryMode ? 'retry' : 'full',
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) { alert(t('errPrefix', 'Xato: ') + (data.error || res.status)); return; }
        showResult(data);
      } catch (e) { alert(t('netErr', 'Tarmoq xatosi')); }
    }

    function showResult(data) {
      finished = true;
      clearTimer();
      document.getElementById('quiz').hidden = true;
      dots.hidden = true;
      const el = document.getElementById('result');
      el.hidden = false;
      const correct = data.correct, total = data.total;
      const wrongList = (data.results || []).filter((r) => !r.isCorrect).map((r) => r.id);
      const hasWrong = wrongList.length > 0;
      // C4-10 rev.4: yakun — natija saqlangani tasdig'i + qayta yechish + tarix
      const savedNote = hasWrong
        ? t('retryNote', 'Avvalgi xatolaringiz aynan shu savollardan qayta beriladi.')
        : t('emptyNote', 'Xatolarsiz yakunladingiz — zo‘r natija! 🎉');
      el.innerHTML = `
        <div class="res-card">
          <div class="pr-res-wrap">
            <div class="pr-res-score">${data.percent}%</div>
            <div class="pr-res-sub">${fill('resSub', '{correct} / {total} to\u2018g\u2018ri javob', { correct, total })}</div>
            ${data.saved === false
              ? `<div class="pr-res-saved">↻ ${t('notSaved', 'Mashq rejimi — natija saqlanmadi')}</div>`
              : `<div class="pr-res-saved">✓ ${t('savedOk', 'Natija saqlandi')}</div>`}
            <div class="pr-res-note">${esc(savedNote)}</div>
            <div class="pr-res-actions no-print">
              <button type="button" class="btn btn-quiet" data-print>${t('print', '🖨️ Chop etish')}</button>
              ${hasWrong ? `<button type="button" class="btn act-sinov" id="retry-wrong" style="margin:0">${fill('retryWrong', 'Qayta yechish — faqat xatolar ({n})', { n: wrongList.length })}</button>` : ''}
              <button type="button" class="btn btn-quiet" id="retry-all">${t('retryAll', 'Boshidan qayta yechish')}</button>
              <a class="btn btn-primary" href="/user/practice-history">${t('histOpen', 'Natijalarim')}</a>
              <a class="btn btn-quiet" href="/user/panel">${t('backPanel', '← Panelga qaytish')}</a>
            </div>
          </div>
          ${data.results.map((r) => {
            const q = QUESTIONS[r.id];
            if (!q) return '';
            return `<div class="pr-review ${r.isCorrect ? 'right' : 'wrong'}">
              <div class="pr-rv-q">${r.id + 1}. ${esc(q.text)} ${r.isCorrect ? '✅' : '❌'}</div>
              ${q.options.map((o, j) => `<div class="pr-rv-o${j === r.correctIndex ? ' ok' : j === r.given ? ' no' : ''}">${String.fromCharCode(65 + j)}) ${esc(o)}${j === r.correctIndex ? ' ✓' : (j === r.given ? ' ' + t('yourAnswer', '← sizning javobingiz') : '')}</div>`).join('')}
              ${r.explanation ? `<div class="pr-rv-e">💡 ${esc(r.explanation)}</div>` : ''}
            </div>`;
          }).join('')}
        </div>`;
      const prBtn = el.querySelector('[data-print]');
      if (prBtn) prBtn.addEventListener('click', () => window.print());
      const rw = el.querySelector('#retry-wrong');
      if (rw) rw.addEventListener('click', () => beginRetry(wrongList));
      const ra = el.querySelector('#retry-all');
      if (ra) ra.addEventListener('click', () => { location.href = location.pathname + location.search; });
    }

    // C4-10 rev.4: faqat xato savollardan qayta mashq (majburiy emas — istalgan
    // payt chiqib ketish mumkin; nav qismi flow'da torayadi).
    function beginRetry(wrongIdx) {
      if (!wrongIdx.length) return;
      retryMode = true;
      finished = false;
      flow = wrongIdx.slice().sort((a, b) => a - b);
      answers.fill(-1);
      revealed.fill(false);
      missed.fill(false);
      cur = flow[0];
      document.getElementById('result').hidden = true;
      const quizEl = document.getElementById('quiz');
      quizEl.hidden = false;
      dots.hidden = false;
      const h = document.getElementById('pr-hint');
      if (h) { h.textContent = '↻ ' + t('retryNote', 'Avvalgi xatolaringiz aynan shu savollardan qayta beriladi.'); h.classList.add('show'); }
      clearTimeout(hint._iv);
      hint._iv = setTimeout(() => { if (h) h.classList.remove('show'); }, 4200);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      renderDots();
      renderQ();
    }

    // 09/2026 (user qarori): ENTER — keyingi savolga o'tish (savolni
    // "tugatish" emas; oxirgi savolda yakunlamaydi — hint beradi).
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (/INPUT|TEXTAREA|SELECT/.test(tag)) return;
      const ae = document.activeElement;
      if (ae && (ae.id === 'next' || ae.id === 'finish' || ae.id === 'hud-next' || ae.id === 'prev')) return; // native click
      if (!document.getElementById('result').hidden) return;
      if (document.getElementById('quiz').hidden) return;
      e.preventDefault();
      if (!revealed[cur]) { hint(t('answerFirst', 'Avval savolga javob bering')); return; }
      if (flowPos(cur) === flow.length - 1) { hint(t('enterLastHint', 'Oxirgi savol — yakunlash uchun «Yakunlash» tugmasini bosing')); return; }
      goNext();
    });

    // 09/2026 (user qarori): test jarayonida orqaga chiqishda ogohlantirish;
    // "Ha" — saqlamasdan chiqish (finish chaqirilmaydi → chinakam discard).
    function leaveMsg() { return t('leaveAsk', 'Rostdan ham orqaga qaytmoqchimisiz? O‘zgarishlar saqlanmasligi mumkin'); }
    function quizStarted() { return !finished && revealed.some(Boolean); }
    let prLeaving = false;
    window.addEventListener('beforeunload', (e) => {
      if (prLeaving || !quizStarted()) return;
      e.preventDefault();
      e.returnValue = leaveMsg();
    });
    document.querySelectorAll('.pr-back').forEach((a) => a.addEventListener('click', (e) => {
      if (quizStarted() && !confirm(leaveMsg())) e.preventDefault();
      else prLeaving = true;
    }));

    paintModeChip();
    renderDots();
    renderQ();
  </script>
  <script src="/js/icon-kit.js"></script>
</body>
</html>
