<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--bg-primary);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:'Righteous',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--border);background:var(--bg-surface);color:var(--muted);font-family:'Nunito',sans-serif;font-size:.78rem;font-weight:800;cursor:pointer;text-decoration:none;transition:all .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--text);}
    .panel{max-width:720px;margin:0 auto;padding:24px 20px 80px;position:relative;z-index:1;}
    .greeting{font-family:'Righteous',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--muted);font-weight:700;margin-bottom:20px;}
    .badge-card{background:var(--card);border-radius:18px;padding:20px;border:1px solid var(--border);display:flex;gap:16px;align-items:flex-start;margin-bottom:14px;animation:slideDown .35s ease;}
    .badge-icon{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--purple));display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;box-shadow:var(--shadow-md);}
    .badge-code{font-family:'Righteous',cursive;font-size:1.6rem;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;}
    .badge-label{font-weight:900;font-size:.95rem;margin:2px 0 4px;}
    .badge-desc{font-size:.8rem;color:var(--muted);font-weight:700;line-height:1.5;}
    .clamp-note{margin-top:8px;font-size:.72rem;font-weight:800;color:var(--gold);background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.25);border-radius:8px;padding:6px 10px;display:inline-flex;gap:6px;align-items:center;}
    .sec-title{font-family:'Righteous',cursive;font-size:1.05rem;display:flex;align-items:center;gap:8px;margin:18px 0 10px;}
    .req-list{display:flex;flex-direction:column;gap:8px;}
    .req-row{display:flex;align-items:center;gap:10px;background:var(--bg-surface);border:1px solid var(--border);border-radius:11px;padding:11px 14px;transition:border-color .3s;}
    .req-row.fail{border-color:rgba(248,113,113,.4);background:rgba(248,113,113,.05);}
    .req-row.ok{border-color:rgba(0,229,160,.3);}
    .req-ico{flex-shrink:0;width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:900;}
    .req-ico.fail{background:rgba(248,113,113,.15);color:var(--accent);}
    .req-ico.ok{background:rgba(0,229,160,.12);color:var(--green);}
    .req-ico.na{background:rgba(255,255,255,.06);color:var(--muted);}
    .req-name{font-size:.82rem;font-weight:900;}
    .req-detail{font-size:.72rem;color:var(--muted);font-weight:700;margin-top:1px;}
    .unsup-box{margin-top:12px;border-radius:12px;border:1px solid rgba(248,113,113,.3);background:rgba(248,113,113,.06);padding:13px 16px;}
    .unsup-h{font-size:.78rem;font-weight:900;color:var(--accent);display:flex;align-items:center;gap:6px;margin-bottom:8px;}
    .unsup-item{display:flex;align-items:center;gap:8px;font-size:.76rem;font-weight:800;color:var(--muted);padding:4px 0;}
    .verify-row{display:flex;gap:8px;align-items:center;margin-top:14px;flex-wrap:wrap;}
    .verify-inp{flex:1;min-width:180px;background:var(--bg-surface);border:2px solid var(--border);border-radius:10px;padding:10px 13px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.8rem;font-weight:700;outline:none;transition:border-color .3s;}
    .verify-inp:focus{border-color:var(--accent);}
    .verify-btn{border-radius:10px;border:none;padding:11px 16px;cursor:pointer;transition:all .3s ease;font-family:'Nunito',sans-serif;font-weight:900;font-size:.8rem;background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;display:flex;align-items:center;gap:6px;}
    .verify-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .verify-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .verdict{margin-top:10px;border-radius:10px;padding:10px 13px;font-size:.78rem;font-weight:800;border:1px solid var(--border);}
    .verdict.ok{color:var(--green);border-color:rgba(0,229,160,.3);background:rgba(0,229,160,.07);}
    .verdict.fail{color:var(--accent);border-color:rgba(248,113,113,.3);background:rgba(248,113,113,.07);}
    .spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes slideDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
    .assign-pick{width:100%;background:var(--bg-surface);border:2px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.84rem;font-weight:800;outline:none;transition:border-color .3s;}
    .assign-pick:focus{border-color:var(--accent);}
    .loading{text-align:center;padding:30px;color:var(--muted);font-weight:800;font-size:.84rem;}
    .empty{text-align:center;padding:26px;color:var(--muted);font-weight:700;font-size:.8rem;background:var(--bg-surface);border-radius:14px;border:1px dashed var(--border);}
    @media(max-width:600px){.badge-card{flex-direction:column;}.verify-row{flex-direction:column;}.verify-btn{width:100%;justify-content:center;}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo"><img src="/images/logo-icon.svg" alt="Edikit" class="logo-img" style="height:28px;width:auto"></a>
    <div class="nav-right">
      <a href="/user/panel" class="nav-btn" style="text-decoration:none"><%- icon('book', 14) %> Panel</a>
      <button type="button" class="nav-btn" data-theme-toggle title="Light mode"><%- icon('moon', 16) %></button>
      <a href="/user/logout" class="nav-btn" style="text-decoration:none"><%- icon('logOut', 14) %> Chiqish</a>
    </div>
  </nav>

  <div class="panel">
    <div class="greeting"><img src="/images/logo-icon.svg" alt="Edikit" class="logo-img" style="height:26px;width:auto"> Xavfsizlik profili</div>
    <div class="greeting-sub">Assessment uchun talab qilinadigan xavfsizlik darajasi — preflightdan oldin tayyorgarlikni tekshiring.</div>

    <div class="sec-title" style="margin-top:0"><%- icon('layers', 16) %> Assessment</div>
    <select class="assign-pick" id="assign-pick">
      <option value="">Assessment tanlang...</option>
    </select>

    <div id="content"><div class="loading"><span class="spinner" style="border-color:var(--muted);border-top-color:var(--accent)"></span> Yuklanmoqda...</div></div>
  </div>

  <script src="/js/security-profile.js"></script>
</body>
</html>
