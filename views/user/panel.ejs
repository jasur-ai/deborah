  <script>
    // AUTH D-25 §12: re-consent banner — grant → banner yopiladi
    (function () {
      var banner = document.querySelector('[data-testid="consent-banner"]');
      if (!banner) return;
      var grantBtn = document.getElementById('btn-consent-grant');
      var dismissBtn = document.getElementById('btn-consent-dismiss');
      function hide() { banner.style.display = 'none'; }
      if (dismissBtn) dismissBtn.addEventListener('click', hide);
      if (grantBtn) grantBtn.addEventListener('click', async function () {
        grantBtn.disabled = true;
        try {
          var r = await fetch('/api/consent/grant', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ purpose: 'privacy_policy_v1' }),
          });
          var j = await r.json();
          if (j.ok) { hide(); return; }
        } catch (_) {}
        grantBtn.disabled = false;
      });
    })();
  </script>
  <script>
    // ── Search (S25.07: skeleton + inline retry + contextual empty) ──
    // S35.05: apostrophe normalizatsiya — o' / o‘ / oʼ bir xil topiladi
    async function doSearch() {
      const raw = document.getElementById('search-inp').value;
      const q = (window.DeborahTerms ? window.DeborahTerms.searchNormalize(raw) : String(raw).trim());
      const wrap = document.getElementById('search-results');
      const live = document.getElementById('ws-live');
      if (!q) { wrap.innerHTML = ''; return; }
      // Skeleton
      wrap.innerHTML = '<div class="ws-skeleton-card skeleton" aria-hidden="true"></div>';
      try {
        const res = await fetch('/user/api/tests/search?q=' + encodeURIComponent(q));
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
        if (!data.results || !data.results.length) {
          wrap.innerHTML = '<div class="ws-state"><div class="ws-state-title">Hech narsa topilmadi</div><div class="ws-state-sub">Boshqa kalit so\'z bilan urinib ko\'ring.</div><button class="ws-state-action" onclick="doSearch()">Qayta urinish</button></div>';
          return;
        }
        wrap.innerHTML = data.results.map(r => `
          <div class="search-result-card">
            <div style="flex:1;min-width:0">
              <div class="sr-name">${svgIcon('edit', 14)} ${esc(r.testName)}</div>
              <div class="sr-meta">${esc(r.userName)} &bull; ${r.count} ta savol</div>
            </div>
            <button class="sr-start" onclick="location.href='/host?source=user&key=${encodeURIComponent(esc(r.testKey))}&testName=${encodeURIComponent(esc(r.testName))}'">${svgIcon('zap', 12)} Sinov</button>
          </div>
        `).join('');
        if (live) live.textContent = data.results.length + ' ta natija topildi';
      } catch(e) {
        wrap.innerHTML = '<div class="ws-state ws-state--error"><div class="ws-state-title">Yuklab bo\'lmadi</div><div class="ws-state-sub">' + esc(e.message) + '</div><button class="ws-state-action" onclick="doSearch()">Qayta urinish</button></div>';
      }
    }

    // ── Start Modal ──
    let startModalData = null;
    const TIME_OPTS = [5, 10, 15, 30, 45, 60, 90, 120];

    function renderTimeGrid(containerId, selected) {
      const el = document.getElementById(containerId);
      if (!el) return;
      el.innerHTML = TIME_OPTS.map(t =>
        '<button type="button" class="modal-time-opt' + (t === selected ? ' selected' : '') + '" onclick="selTime(\'' + containerId + '\',' + t + ')">' +
        '<div class="tv">' + t + '</div><div class="tl">soniya</div></button>'
      ).join('');
    }

    let selectedTimes = {};
    function selTime(containerId, val) {
      selectedTimes[containerId] = val;
      document.querySelectorAll('#' + containerId + ' .modal-time-opt').forEach(el => {
        const tv = parseInt(el.querySelector('.tv').textContent);
        el.classList.toggle('selected', tv === val);
      });
    }

    function openStartModal(name, count, url) {
      startModalData = { url };
      document.getElementById('start-modal-title').textContent = name;
      document.getElementById('start-modal-sub').textContent = count + ' ta savol &bull; Sinov rejimi';
      if (!selectedTimes['start-time-grid']) selectedTimes['start-time-grid'] = 15;
      renderTimeGrid('start-time-grid', selectedTimes['start-time-grid']);
      document.getElementById('start-modal').classList.add('open');
    }

    function closeStartModal() {
      document.getElementById('start-modal').classList.remove('open');
      startModalData = null;
    }

    function confirmStartQuiz() {
      if (startModalData && startModalData.url) {
        // S34o: tanlangan vaqt URL'ga — practice sahifada ko'rinadi
        const sep = startModalData.url.includes('?') ? '&' : '?';
        window.location.href = startModalData.url + sep + 'time=' + (selectedTimes['start-time-grid'] || 15);
      }
      closeStartModal();
    }

    // ── Cast Setup Studio ──
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-source]');
      if (!btn || !btn.dataset.source) return;
      const reference = {
        source: btn.dataset.source,
        key: btn.dataset.key,
        chunk: btn.dataset.chunk || null,
      };
      const nameEl = btn.closest('.ws-test-card, .ws-resume, .fan-btn, .pre-sub-btn');
      const meta = document.getElementById('cast-studio-desc');
      if (meta && nameEl) {
        const name = nameEl.querySelector('.ws-test-name, .ws-resume-title, .fan-btn-name, .pre-sub-name');
        if (name) meta.textContent = 'Test: ' + name.textContent.trim();
      }
      if (window.CastStudio) {
        window.CastStudio.open(reference);
      }
    });

    document.getElementById('search-inp')?.addEventListener('keydown', e => {
      if (e.key === 'Enter') doSearch();
    });
  </script>

  <% if (typeof emailVerified !== 'undefined' && !emailVerified) { %>
  <!-- AUTH A-18/B-06: Email verify modal -->
  <div class="modal-overlay" id="email-verify-modal" role="dialog" aria-modal="true" aria-labelledby="evm-title">
    <div class="modal-box">
      <div class="modal-title" id="evm-title"><%- icon('mail', 18) %> <%= verifyCopy.modalTitle || 'Emailni tasdiqlash' %></div>
      <div class="modal-sub"><%= userEmail ? (verifyCopy.modalSub || 'Kod ' + userEmail + ' manziliga yuborildi').replace('{email}', userEmail) : (verifyCopy.modalSubNoEmail || 'Emailingizga yuborilgan kodni kiriting') %></div>
      <div class="evm-err" id="evm-err" style="display:none" role="alert"></div>
      <label class="lbl" for="evm-code"><%= verifyCopy.codeLabel || 'Tasdiqlash kodi' %></label>
      <input class="inp" id="evm-code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" required aria-required="true">
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-btn-secondary" id="evm-cancel"><%= verifyCopy.cancel || 'Yopish' %></button>
        <button type="button" class="modal-btn modal-btn-primary" id="evm-submit"><%= verifyCopy.submit || 'Tasdiqlash' %></button>
      </div>
      <button type="button" class="resend-btn evm-resend" id="evm-resend" disabled data-count="60"><%= verifyCopy.resend || 'Qayta yuborish' %> (60s)</button>
      <!-- B-06 §12: email noto'g'ri — yangilash (B-39 email change bilan bog'lanadi) -->
      <div class="evm-foot"><a href="/user/security-profile" class="evm-update-email"><%= verifyCopy.emailWrong || 'Email noto\'g\'ri? Yangilash' %></a></div>
    </div>
  </div>
  <script>
  (function () {
    'use strict';
    var overlay = document.getElementById('email-verify-modal');
    if (!overlay) return;
    var btnOpen = document.getElementById('btn-verify-email');
    var btnCancel = document.getElementById('evm-cancel');
    var btnSubmit = document.getElementById('evm-submit');
    var btnResend = document.getElementById('evm-resend');
    var input = document.getElementById('evm-code');
    var err = document.getElementById('evm-err');
    var csrf = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    var timer = 0;
    // B-06 §17: i18n stringlar — JSON.stringify + raw EJS — apostroflar
    // HTML-escape'ga tushmaydi (buzilmagan); script breakout yo'q.
    var t = <%- JSON.stringify({
      resend: verifyCopy.resend || 'Qayta yuborish',
      resendCountdown: verifyCopy.resendCountdown || 'Qayta yuborish ({s}s)',
      errInvalidFormat: verifyCopy.errInvalidFormat || '6 xonali kod kiriting',
      errNetwork: verifyCopy.errNetwork || "Ulanishda muammo — qayta urinib ko'ring",
      errInvalidCode: verifyCopy.errInvalidCode || "Kod noto'g'ri yoki eskirgan",
      errAlreadyUsed: verifyCopy.errInvalidCode || "Kod noto'g'ri yoki eskirgan",
      errExpired: verifyCopy.errExpired || "Kod muddati o'tgan",
      errTooManyAttempts: verifyCopy.errTooManyAttempts || "Juda ko'p urinish — birozdan keyin qayta urining",
      errResend: verifyCopy.errResend || "Qayta yuborishda xatolik — birozdan keyin urining",
      errGeneric: 'Xatolik yuz berdi',
      success: verifyCopy.success || 'Email tasdiqlandi',
      // B-28 §08/§10: expiry UX + resend limit UX
      expiredCta: verifyCopy.expiredCta || 'Yangi kod yuborish',
      limitReached: verifyCopy.limitReached || "Kunlik limit tugadi — keyinroq urinib ko'ring",
    }) %>;

    function startResendTimer() {
      var left = 60;
      btnResend.disabled = true;
      btnResend.textContent = t.resendCountdown.replace('{s}', left);
      clearInterval(timer);
      timer = setInterval(function () {
        left -= 1;
        btnResend.textContent = t.resendCountdown.replace('{s}', left);
        if (left <= 0) { clearInterval(timer); btnResend.disabled = false; btnResend.textContent = t.resend; }
      }, 1000);
    }

    function showErr(msg) {
      err.textContent = msg;
      err.style.display = 'block';
    }

    if (btnOpen) btnOpen.addEventListener('click', function () {
      overlay.classList.add('open');
      startResendTimer();
      input.focus();
    });
    if (btnCancel) btnCancel.addEventListener('click', function () { overlay.classList.remove('open'); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.classList.remove('open'); });

    function postVerify(path, body, cb) {
      fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
        body: JSON.stringify(body),
      })
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, j: j }; }); })
        .then(cb)
        .catch(function () { showErr(t.errNetwork); });
    }

    btnSubmit.addEventListener('click', function () {
      var code = input.value.trim();
      if (!/^\d{6}$/.test(code)) { showErr(t.errInvalidFormat); return; }
      err.style.display = 'none';
      postVerify('/api/auth/verify/complete', { code: code }, function (r) {
        if (r.status === 200 && r.j.ok) {
          overlay.classList.remove('open');
          var banner = document.querySelector('.email-verify-banner');
          if (banner) banner.remove();
          // B-07 §11: success UX — "Email tasdiqlandi ✓" toast
          var toast = document.createElement('div');
          toast.className = 'evm-toast';
          toast.setAttribute('role', 'status');
          toast.setAttribute('aria-live', 'polite');
          toast.textContent = t.success + ' \u2713';
          document.body.appendChild(toast);
          setTimeout(function () { toast.classList.add('show'); }, 10);
          // B-07 §11: toast o'qilishi uchun yetarli vaqt (1500ms) — keyin reload
          setTimeout(function () { window.location.reload(); }, 1500);
        } else {
          // B-07 §08: barcha yomon kod holatlari → otp_invalid (422) yagona xabar;
          // B-28 §08: expired → alohida xabar + "Yangi kod yuborish" CTA (resend).
          // B-28 §10: resend limiti (429 too_many_requests) → limit banner (takrorlanmaydi).
          var m = { otp_invalid: t.errInvalidCode, invalid_code: t.errInvalidCode, already_used: t.errAlreadyUsed, expired: t.errExpired, too_many_attempts: t.errTooManyAttempts };
          var e = r.j && r.j.error;
          if (e === 'expired') {
            showErr(t.errExpired + ' — ' + t.expiredCta);
            btnResend.disabled = false;
            btnResend.textContent = t.expiredCta;
          } else if (e === 'too_many_requests' || e === 'too_many_attempts') {
            showErr(t.limitReached);
            btnResend.disabled = true;
          } else {
            showErr(m[e] || t.errGeneric);
          }
        }
      });
    });

    btnResend.addEventListener('click', function () {
      err.style.display = 'none';
      postVerify('/api/auth/verify/send', {}, function (r) {
        if (r.status === 200 && r.j.ok) { startResendTimer(); }
        else if (r.status === 429) showErr(t.limitReached); // B-28 §10
        else showErr(t.errResend);
      });
    });

    // Native OTP autofill (A-18 §19)
    if (input) input.addEventListener('input', function () {
      if (/^\d{6}$/.test(input.value.trim())) btnSubmit.click();
    });
  })();
  </script>
  <% } %>
</body>
</html>
