<% const current = user || {}; %>
<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css?v=nv4">
  <link rel="stylesheet" href="/design/admin-command.css">
</head>
<body class="adm-body">
  <div class="adm-shell">
    <aside class="adm-sidebar">
      <div class="adm-brand">
        <img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto">
        <span>Deborah</span>
      </div>
      <nav class="adm-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/provider">Provider Adapters</a>
        <a href="/admin/canva">Canva</a>
        <a href="/admin/google-slides">Google Slides</a>
        <a href="/admin/deck-export" class="active">Deck Export</a>
        <a href="/admin/quiz-deck">Quiz from Deck</a>
        <a href="/admin/claude">Claude Adapter</a>
        <a href="/admin/vip">VIP</a>
      </nav>
      <div class="adm-side-foot">
        <a href="/admin/logout">Chiqish</a>
      </div>
    </aside>

    <main class="adm-main">
      <header class="adm-topbar">
        <h1>Deck Export</h1>
        <span class="adm-chip" id="exportStatus">Tayyor</span>
      </header>

      <section class="adm-card">
        <h2>Export Formats</h2>
        <p class="adm-hint">PPTX / PDF / Handout — attribution sahifasi va accessibility (ALT text, WCAG contrast) bilan (research §13).</p>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Deck ID</label><input class="input" id="fDeckId" placeholder="1"></div>
            <div class="field"><label>Format</label>
              <select class="input" id="fFormat">
                <option value="pptx">PPTX</option>
                <option value="pdf">PDF</option>
                <option value="handout">Handout</option>
              </select>
            </div>
            <button class="btn btn-primary" id="btnExport">Export</button>
          </div>
          <span class="adm-hint" id="opStatus"></span>
        </div>
      </section>

      <section class="adm-card">
        <h2>Exports</h2>
        <button class="btn" id="btnRefresh">Refresh</button>
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead><tr><th>ID</th><th>Deck</th><th>Format</th><th>Status</th><th>Storage</th><th>Accessible</th><th>Created</th></tr></thead>
            <tbody id="exportsBody"><tr><td colspan="7" class="adm-muted">Yuklanmoqda…</td></tr></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

<script>
(function () {
  const CSRF = '<%= csrfToken || "" %>';
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // Demo canonical deck — admin panel'dan export tugmasini sinash uchun
  const DEMO_DECK = {
    title: 'Fotosintez',
    learningOutcomes: ['Fotosintez jarayonini tushuntirish'],
    slides: [
      { id: 's1', title: 'Kirish', speakerNotes: 'Fotosintez — yorug\'lik energiyasini kimyoviy energiyaga aylantiradi.', blocks: [{ type: 'heading', content: { heading: 'Fotosintez' } }, { type: 'bullets', content: { items: ['Xlorofill', 'Quyosh nuri'] } }, { type: 'image', content: { url: 'x', alt: 'Fotosintez diagrammasi' } }], citations: ['source:1'] },
      { id: 's2', title: 'Xulosa', speakerNotes: 'Yakuniy xulosa.', blocks: [{ type: 'text', content: { text: 'Short summary.' } }], citations: [] },
    ],
  };

  async function api(path, opts = {}) {
    const res = await fetch(path, {
      method: opts.method || 'GET',
      headers: { 'content-type': 'application/json', 'X-CSRF-Token': CSRF },
      body: opts.body ? JSON.stringify(opts.body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
    return data;
  }

  async function loadExports() {
    try {
      const { exports: list } = await api('/api/admin/deck-exports?limit=20');
      $('exportsBody').innerHTML = list.map((e) => `
        <tr>
          <td>#${e.id}</td>
          <td>#${e.deck_id}</td>
          <td>${esc(e.format)}</td>
          <td><span class="chip chip-${e.status === 'completed' ? 'ok' : e.status === 'failed' ? 'err' : 'warn'}">${esc(e.status)}</span></td>
          <td>${esc(e.storage_key || '-')}</td>
          <td>${e.accessibility_ok ? '✓' : '—'}</td>
          <td>${esc((e.created_at || '').slice(0, 19))}</td>
        </tr>`).join('') || '<tr><td colspan="7" class="adm-muted">Hozircha export yo\u2018q</td></tr>';
    } catch (e) { $('exportsBody').innerHTML = `<tr><td colspan="7" class="adm-muted">${esc(e.message)}</td></tr>`; }
  }

  $('btnExport').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/deck-exports', { method: 'POST', body: { presentationId: Number($('fDeckId').value) || 1, versionId: 1, format: $('fFormat').value, document: DEMO_DECK } });
      $('opStatus').textContent = r.queued ? 'Export queued ✓' : ('Status: ' + esc(r.status));
      loadExports();
    } catch (e) { $('opStatus').textContent = '✗ ' + e.message; }
  });

  $('btnRefresh').addEventListener('click', loadExports);
  loadExports();
})();
</script>
</body>
</html>
