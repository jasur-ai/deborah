<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css?v=nv6">
  <link rel="stylesheet" href="/design/admin-command.css?v=admin-shell-20261101-r2">
  <style>
    .modal-overlay{position:fixed;inset:0;z-index:1600;display:flex;align-items:center;justify-content:center;padding:18px;overflow-y:auto;background:rgba(15,12,8,.62);backdrop-filter:blur(5px)}
    .modal-overlay[hidden]{display:none!important}
    .modal{width:min(100%,520px);max-height:calc(100dvh - 36px);overflow:auto;border:1px solid var(--deborah-semantic-color-border-strong);border-radius:16px;background:var(--deborah-semantic-color-surface-raised);color:var(--deborah-semantic-color-text-primary);box-shadow:0 24px 64px rgba(0,0,0,.34)}
    .modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 20px;border-bottom:1px solid var(--deborah-semantic-color-border-default)}
    .modal-body{padding:16px 20px}
    .modal-foot{border-top:1px solid var(--deborah-semantic-color-border-default)}
    .modal-close{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--deborah-semantic-color-border-default);border-radius:10px;background:var(--deborah-semantic-color-surface-nested);color:var(--deborah-semantic-color-text-primary);font-size:1.4rem;cursor:pointer}
    .modal-close:hover{border-color:var(--deborah-semantic-color-action-primary-border);background:var(--deborah-semantic-color-action-primary-soft)}
    .users-actions{display:inline-flex;align-items:center;gap:6px;flex-wrap:nowrap}
    .users-actions .user-primary-action,.user-actions-trigger{min-height:44px}
    .user-actions-trigger{display:inline-flex;align-items:center;justify-content:center;width:44px;padding:0;border:1px solid var(--deborah-semantic-color-action-primary-border);border-radius:10px;background:var(--deborah-semantic-color-action-primary-soft);color:var(--deborah-semantic-color-text-primary);cursor:pointer;transition:background .16s,border-color .16s,transform .16s}
    .user-actions-trigger:hover,.user-actions-trigger[aria-expanded="true"]{background:var(--deborah-semantic-color-action-primary);border-color:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#21180b)}
    .user-actions-trigger:focus-visible,.user-actions-menu button:focus-visible{outline:3px solid var(--deborah-semantic-color-action-primary);outline-offset:2px}
    .user-actions-menu{position:fixed;z-index:1500;display:grid;gap:4px;min-width:190px;max-width:calc(100vw - 16px);padding:6px;border:1px solid var(--deborah-semantic-color-border-default);border-radius:12px;background:var(--deborah-semantic-color-surface-raised);box-shadow:0 12px 32px rgba(0,0,0,.22)}
    .user-actions-menu[hidden]{display:none!important}
    .user-actions-menu button{display:flex;align-items:center;width:100%;min-height:44px;padding:9px 12px;border:0;border-radius:8px;background:transparent;color:var(--deborah-semantic-color-text-primary);font:inherit;text-align:left;cursor:pointer}
    .user-actions-menu button:hover{background:var(--deborah-semantic-color-action-primary-soft)}
    .user-actions-menu button[data-user-action="delete"]{color:var(--deborah-semantic-color-danger,#b42318)}
    #delete-modal .modal{width:min(100%,480px)}
    #delete-confirm-input{width:100%;min-height:46px;margin-top:8px}
    #delete-confirm-error{margin-top:8px;color:var(--deborah-semantic-color-danger,#b42318);font-size:.82rem;font-weight:700}
    #delete-confirm-error[hidden]{display:none}
    #delete-confirm:disabled{opacity:.55;cursor:not-allowed}
    #users-page{white-space:nowrap;font-variant-numeric:tabular-nums}
    @media(max-width:640px){
      .users-actions .user-primary-action{min-width:84px;padding-inline:10px}
      .admin-filters #users-q{min-width:100%!important}
      .user-actions-menu{min-width:185px}
    }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content →</a>
  <nav class="admin-navbar">
    <div class="admin-nav-left">
      <button type="button" class="admin-nav-hamburger" aria-label="Menyu" aria-expanded="false" aria-controls="admin-sidebar"><span></span><span></span><span></span></button>
      <a href="/" class="admin-nav-brand">
        <span class="admin-nav-logo"><img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto"></span>
        <span class="admin-nav-badge">ADMIN</span>
      </a>
    </div>
    <div class="flex items-center gap-8">
      <a href="/admin/dashboard" class="admin-nav-btn"><%- icon('arrowLeft', 14) %> Dashboard</a>
      <%- include('../partials/theme-control') %>
      <a href="/admin/logout" class="admin-nav-btn"><%- icon('logOut', 14) %> Chiqish</a>
    </div>
  </nav>

  <div class="admin-layout">
    <%- include('../partials/admin-sidebar', { activePath: '/admin/users', activeTab: '' }) %>
    <main class="admin-main" id="main">
      <div class="admin-page-head">
        <div>
          <h1 class="admin-page-title"><%- icon('users', 20) %> Foydalanuvchilar</h1>
          <p class="admin-page-sub">Ro'yxat, qidiruv, bloklash va rol boshqaruvi</p>
        </div>
      </div>

      <div id="admin-alert" class="msg" role="alert" aria-live="assertive" style="display:none"></div>

      <!-- Filter + qidiruv -->
      <div class="admin-filters" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px">
        <label class="admin-filter-label" for="users-q" style="display:flex;align-items:center;gap:6px">
          <%- icon('search', 14) %>
          <span class="sr-only">Qidiruv</span>
        </label>
        <input type="search" id="users-q" class="inp" placeholder="Username yoki email..." autocomplete="off" style="min-width:220px" aria-label="Foydalanuvchi qidirish">
        <select id="users-role" class="inp" aria-label="Rol filtri" style="min-width:150px">
          <option value="">Barcha rollar</option>
          <option value="student">Student</option>
          <option value="teacher">Teacher</option>
          <option value="proctor">Proctor</option>
          <option value="marker">Marker</option>
          <option value="board">Board</option>
        </select>
        <select id="users-status" class="inp" aria-label="Status filtri" style="min-width:150px">
          <option value="">Barcha statuslar</option>
          <option value="active">Active</option>
          <option value="blocked">Bloklangan</option>
        </select>
        <select id="users-vip" class="inp" aria-label="VIP filtri" style="min-width:130px">
          <option value="">VIP: hammasi</option>
          <option value="true">Faqat VIP</option>
          <option value="false">Faqat oddiy</option>
        </select>
        <button type="button" class="btn" data-users-action="quick-all" style="min-height:44px">Barchasi</button>
        <button type="button" class="btn" data-users-action="quick-vip" style="min-height:44px">VIP userlar</button>
        <button type="button" class="btn" data-users-action="quick-teacher" style="min-height:44px">O'qituvchilar</button>
        <button type="button" class="btn btn-primary" data-users-action="filter" style="min-height:44px"><%- icon('filter', 14) %> Filtrlash</button>
        <button type="button" class="btn" data-users-action="reset" style="min-height:44px">Tozalash</button>
      </div>

      <div class="table-wrap dt-wrap is-reflow"><table class="dt" data-density="default">
        <thead><tr>
          <th scope="col">#</th>
          <th scope="col">Foydalanuvchi</th>
          <th scope="col">Email</th>
          <th scope="col">Rol</th>
          <th scope="col">Status</th>
          <th scope="col">VIP</th>
          <th scope="col">Ro'yxatdan o'tgan</th>
          <th scope="col" class="dt-actions">Amallar</th>
        </tr></thead>
        <tbody id="users-tbody">
          <tr><td colspan="8"><div class="admin-empty">Yuklanmoqda...</div></td></tr>
        </tbody>
      </table></div>

      <!-- Pagination -->
      <div class="admin-pagination" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;flex-wrap:wrap">
        <div class="text-muted" id="users-total" style="font-size:.8rem" aria-live="polite">—</div>
        <div style="display:flex;gap:8px;align-items:center">
          <button type="button" class="btn" id="users-prev" data-users-action="previous-page" style="min-height:44px" aria-label="Oldingi sahifa"><%- icon('chevronLeft', 14) %> Oldingi</button>
          <span id="users-page" class="badge badge-accent" style="font-size:.78rem" aria-live="polite" tabindex="-1">1 / 1</span>
          <button type="button" class="btn" id="users-next" data-users-action="next-page" style="min-height:44px" aria-label="Keyingi sahifa">Keyingi <%- icon('chevronRight', 14) %></button>
        </div>
      </div>
    </main>
  </div>

  <!-- Bloklash modali — sabab majburiy (C-08 §29) -->
  <div class="modal-overlay" id="block-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="block-modal-title">
      <div class="modal-head">
        <h2 id="block-modal-title" style="font-size:1rem;margin:0">Foydalanuvchini bloklash</h2>
        <button type="button" class="modal-close" data-users-action="close-block" aria-label="Yopish">&times;</button>
      </div>
      <div class="modal-body" style="padding:16px 20px">
        <p id="block-user-label" class="text-muted" style="margin:0 0 12px;font-size:.85rem"></p>
        <label class="lbl" for="block-reason">Sabab <span class="required-mark">*</span></label>
        <textarea id="block-reason" class="inp" rows="3" maxlength="500" placeholder="Bloklash sababi (majburiy)" aria-required="true" required></textarea>
        <div class="err-text" id="block-reason-err" style="display:none" role="alert">Bloklash sababi majburiy</div>
      </div>
      <div class="modal-foot" style="display:flex;justify-content:flex-end;gap:10px;padding:14px 20px">
        <button type="button" class="btn" data-users-action="close-block" style="min-height:44px">Bekor qilish</button>
        <button type="button" class="btn btn-danger" id="block-confirm" data-users-action="confirm-block" style="min-height:44px"><%- icon('ban', 14) %> Bloklash</button>
      </div>
    </div>
  </div>

  <!-- O'chirish tasdig'i: username qayta kiritiladi, MFA serverda saqlanadi. -->
  <div class="modal-overlay" id="delete-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" aria-describedby="delete-modal-description">
      <div class="modal-head">
        <h2 id="delete-modal-title" style="font-size:1rem;margin:0">Foydalanuvchini o'chirish</h2>
        <button type="button" class="modal-close" data-users-action="close-delete" aria-label="Yopish">&times;</button>
      </div>
      <div class="modal-body" style="padding:16px 20px">
        <p id="delete-modal-description" class="text-muted" style="margin:0 0 12px;font-size:.86rem;line-height:1.55">
          <strong id="delete-user-label"></strong> akkaunti o'chiriladi va uning faol sessiyalari bekor qilinadi. Bu amalni ortga qaytarib bo'lmaydi.
        </p>
        <label class="lbl" for="delete-confirm-input">Tasdiqlash uchun username'ni kiriting</label>
        <input type="text" id="delete-confirm-input" class="inp" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="delete-confirm-error" required>
        <div id="delete-confirm-error" role="alert" hidden>Username to'liq mos kelmadi.</div>
      </div>
      <div class="modal-foot" style="display:flex;justify-content:flex-end;gap:10px;padding:14px 20px">
        <button type="button" class="btn" data-users-action="close-delete" style="min-height:44px">Bekor qilish</button>
        <button type="button" class="btn btn-danger" id="delete-confirm" data-users-action="confirm-delete" style="min-height:44px" disabled>O'chirish</button>
      </div>
    </div>
  </div>

  <input type="hidden" id="csrf-token" value="<%= csrfToken %>">
  <script>
    // AUTH D-10 §13: 4 til admin copy — users.js shu yerдан o'qiydi (fallback bilan)
    window.__ADMIN_COPY__ = <%- JSON.stringify(adminCopy || {}) %>;
  </script>
  <script src="/js/admin/common.js" defer></script>
  <script src="/js/admin/users.js" defer></script>
</body>
</html>
