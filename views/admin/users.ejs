<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <a href="#main" class="skip-link">Skip to content →</a>
  <nav class="admin-navbar">
    <div class="admin-nav-left">
      <button type="button" class="admin-nav-hamburger" aria-label="Menyu" aria-expanded="false" aria-controls="admin-sidebar" onclick="toggleAdminDrawer()"><span></span><span></span><span></span></button>
      <a href="/" class="admin-nav-brand">
        <span class="admin-nav-logo"><img src="/images/logo-icon.svg" alt="Deborah" class="logo-img" style="height:28px;width:auto"></span>
        <span class="admin-nav-badge">ADMIN</span>
      </a>
    </div>
    <div class="flex items-center gap-8">
      <a href="/admin/dashboard" class="admin-nav-btn"><%- icon('arrowLeft', 14) %> Dashboard</a>
      <%- include('../partials/theme-control') %>
      <a href="/admin/logout" class="admin-nav-btn"><%- icon('logOut', 14) %> Chiqish</a>
    </div>
  </nav>

  <div class="admin-layout">
    <div class="admin-drawer-overlay" id="admin-drawer-overlay" onclick="toggleAdminDrawer()"></div>
    <div class="admin-sidebar" id="admin-sidebar">
      <div class="admin-side-label">Bo'limlar</div>
      <a href="/admin/users" class="admin-side-btn active" style="--c:var(--deborah-semantic-color-action-primary);--cbg:rgba(37,99,235,.14)"><span class="admin-side-ico"><%- icon('users', 16) %></span>Foydalanuvchilar</a>
      <a href="/admin/dashboard#pane-fans" class="admin-side-btn"><span class="admin-side-ico"><%- icon('book', 16) %></span>Mock Fanlar</a>
      <a href="/admin/dashboard#pane-pre" class="admin-side-btn" style="--c:var(--accent-glow);--cbg:rgba(100,116,139,.14)"><span class="admin-side-ico"><%- icon('layers', 16) %></span>PRE Testlar</a>
      <a href="/admin/dashboard#pane-results" class="admin-side-btn"><span class="admin-side-ico"><%- icon('trophy', 16) %></span>Natijalar</a>
      <a href="/admin/vip" class="admin-side-btn" style="--c:#f59e0b;--cbg:rgba(245,158,11,.14)"><span class="admin-side-ico"><%- icon('shield', 16) %></span>VIP</a>
      <div class="admin-side-label" style="margin-top:8px">Asboblar</div>
      <a href="/arena" target="_blank" class="admin-side-btn" style="--c:var(--green);--cbg:rgba(0,229,160,.1)"><span class="admin-side-ico"><%- icon('monitor', 16) %></span>Test Arena</a>
    </div>

    <main class="admin-main" id="main">
      <div class="admin-page-head">
        <div>
          <h1 class="admin-page-title"><%- icon('users', 20) %> Foydalanuvchilar</h1>
          <p class="admin-page-sub">Ro'yxat, qidiruv, bloklash va rol boshqaruvi</p>
        </div>
      </div>

      <div id="admin-alert" class="msg" role="alert" aria-live="assertive" style="display:none"></div>

      <!-- Filter + qidiruv -->
      <div class="admin-filters" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px">
        <label class="admin-filter-label" for="users-q" style="display:flex;align-items:center;gap:6px">
          <%- icon('search', 14) %>
          <span class="sr-only">Qidiruv</span>
        </label>
        <input type="search" id="users-q" class="inp" placeholder="Username yoki email..." autocomplete="off" style="min-width:220px" aria-label="Foydalanuvchi qidirish">
        <select id="users-role" class="inp" aria-label="Rol filtri" style="min-width:150px">
          <option value="">Barcha rollar</option>
          <option value="student">Student</option>
          <option value="teacher">Teacher</option>
          <option value="proctor">Proctor</option>
          <option value="marker">Marker</option>
          <option value="board">Board</option>
        </select>
        <select id="users-status" class="inp" aria-label="Status filtri" style="min-width:150px">
          <option value="">Barcha statuslar</option>
          <option value="active">Active</option>
          <option value="blocked">Bloklangan</option>
        </select>
        <button type="button" class="btn btn-primary" onclick="loadUsers(1)" style="min-height:44px"><%- icon('filter', 14) %> Filtrlash</button>
        <button type="button" class="btn" onclick="resetFilters()" style="min-height:44px">Tozalash</button>
      </div>

      <div class="table-wrap dt-wrap is-reflow"><table class="dt" data-density="default">
        <thead><tr>
          <th scope="col">#</th>
          <th scope="col">Foydalanuvchi</th>
          <th scope="col">Email</th>
          <th scope="col">Rol</th>
          <th scope="col">Status</th>
          <th scope="col">Ro'yxatdan o'tgan</th>
          <th scope="col" class="dt-actions">Amallar</th>
        </tr></thead>
        <tbody id="users-tbody">
          <tr><td colspan="7"><div class="admin-empty">Yuklanmoqda...</div></td></tr>
        </tbody>
      </table></div>

      <!-- Pagination -->
      <div class="admin-pagination" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;flex-wrap:wrap">
        <div class="text-muted" id="users-total" style="font-size:.8rem">—</div>
        <div style="display:flex;gap:8px;align-items:center">
          <button type="button" class="btn" id="users-prev" onclick="loadUsers(currentPage - 1)" style="min-height:44px" aria-label="Oldingi sahifa"><%- icon('chevronLeft', 14) %> Oldingi</button>
          <span id="users-page" class="badge badge-accent" style="font-size:.78rem">1</span>
          <button type="button" class="btn" id="users-next" onclick="loadUsers(currentPage + 1)" style="min-height:44px" aria-label="Keyingi sahifa">Keyingi <%- icon('chevronRight', 14) %></button>
        </div>
      </div>
    </main>
  </div>

  <!-- Bloklash modali — sabab majburiy (C-08 §29) -->
  <div class="modal-overlay" id="block-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="block-modal-title">
      <div class="modal-head">
        <h2 id="block-modal-title" style="font-size:1rem;margin:0">Foydalanuvchini bloklash</h2>
        <button type="button" class="modal-close" onclick="closeBlockModal()" aria-label="Yopish">&times;</button>
      </div>
      <div class="modal-body" style="padding:16px 20px">
        <p id="block-user-label" class="text-muted" style="margin:0 0 12px;font-size:.85rem"></p>
        <label class="lbl" for="block-reason">Sabab <span class="required-mark">*</span></label>
        <textarea id="block-reason" class="inp" rows="3" maxlength="500" placeholder="Bloklash sababi (majburiy)" aria-required="true" required></textarea>
        <div class="err-text" id="block-reason-err" style="display:none" role="alert">Bloklash sababi majburiy</div>
      </div>
      <div class="modal-foot" style="display:flex;justify-content:flex-end;gap:10px;padding:14px 20px">
        <button type="button" class="btn" onclick="closeBlockModal()" style="min-height:44px">Bekor qilish</button>
        <button type="button" class="btn btn-danger" id="block-confirm" onclick="confirmBlock()" style="min-height:44px"><%- icon('ban', 14) %> Bloklash</button>
      </div>
    </div>
  </div>

  <input type="hidden" id="csrf-token" value="<%= csrfToken %>">
  <script>
    // AUTH D-10 §13: 4 til admin copy — users.js shu yerдан o'qiydi (fallback bilan)
    window.__ADMIN_COPY__ = <%- JSON.stringify(adminCopy || {}) %>;
  </script>
  <script src="/js/admin/users.js" defer></script>
</body>
</html>
