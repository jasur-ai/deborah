<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--edikit-semantic-color-surface-default);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--edikit-semantic-color-border-default);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:''Manrope'',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--edikit-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--edikit-semantic-color-border-default);background:var(--edikit-semantic-color-surface-input);color:var(--edikit-semantic-color-text-muted);font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--edikit-semantic-color-text-primary);}
    .panel{max-width:1180px;margin:0 auto;padding:24px 20px 90px;position:relative;z-index:1;}
    .greeting{font-family:''Manrope'',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--edikit-semantic-color-text-muted);font-weight:700;margin-bottom:20px;}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
    @media(max-width:900px){.grid{grid-template-columns:1fr;}}
    .card{background:var(--edikit-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--edikit-semantic-color-border-default);margin-bottom:14px;animation:slideDown .3s ease;transition:background .3s,border-color .3s;}
    .card-h{font-family:''Manrope'',cursive;font-size:.95rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .card-h small{font-family:'Source Sans 3',sans-serif;font-size:.66rem;color:var(--edikit-semantic-color-text-muted);font-weight:600;margin-left:auto;}
    .field{margin-bottom:11px;}
    .field label{display:block;font-size:.72rem;font-weight:700;color:var(--edikit-semantic-color-text-muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
    .inp{width:100%;background:var(--edikit-semantic-color-surface-input);border:2px solid var(--edikit-semantic-color-border-default);border-radius:10px;padding:9px 12px;color:var(--edikit-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.82rem;font-weight:600;outline:none;transition:border-color .3s;}
    .inp:focus{border-color:var(--edikit-semantic-color-action-primary);}
    textarea.inp{min-height:60px;resize:vertical;}
    .btn{border-radius:10px;border:none;padding:10px 16px;cursor:pointer;transition:color .3s ease,background-color .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s ease,opacity .3s ease;font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:.8rem;background:linear-gradient(135deg,var(--edikit-semantic-color-action-primary),#1d4ed8);color:#fff;display:inline-flex;align-items:center;gap:6px;}
    .btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .btn.ghost{background:var(--edikit-semantic-color-surface-input);color:var(--edikit-semantic-color-text-muted);border:1px solid var(--edikit-semantic-color-border-default);}
    .btn.ghost:hover{color:var(--edikit-semantic-color-text-primary);background:var(--bg-elevated);}
    .btn.green{background:linear-gradient(135deg,#00e5a0,#00b37e);color:#04120c;}
    .btn.red{background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;}
    .badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:99px;font-size:.66rem;font-weight:700;letter-spacing:.3px;}
    .badge.blue{background:rgba(37,99,235,.15);color:var(--edikit-semantic-color-action-primary);}
    .badge.green{background:rgba(0,229,160,.14);color:var(--green);}
    .badge.red{background:rgba(239,68,68,.14);color:#f87171;}
    .badge.amber{background:rgba(251,191,36,.14);color:var(--gold);}
    .badge.gray{background:var(--bg-elevated);color:var(--edikit-semantic-color-text-muted);}
    .badge.violet{background:rgba(139,92,246,.14);color:#a78bfa;}
    table{width:100%;border-collapse:collapse;font-size:.78rem;}
    th{text-align:left;font-size:.64rem;text-transform:uppercase;letter-spacing:.5px;color:var(--edikit-semantic-color-text-muted);padding:7px 8px;border-bottom:1px solid var(--edikit-semantic-color-border-default);font-weight:700;}
    td{padding:7px 8px;border-bottom:1px solid var(--edikit-semantic-color-border-default);font-weight:700;}
    tr:last-child td{border-bottom:none;}
    .msg{padding:10px 14px;border-radius:10px;font-size:.78rem;font-weight:600;margin-bottom:12px;display:none;}
    .msg.ok{display:block;background:rgba(0,229,160,.12);color:var(--green);border:1px solid rgba(0,229,160,.25);}
    .msg.err{display:block;background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25);}
    .mono{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--edikit-semantic-color-text-muted);}
    .row-btn{background:none;border:1px solid var(--edikit-semantic-color-border-default);color:var(--edikit-semantic-color-text-muted);border-radius:8px;padding:4px 9px;font-size:.68rem;font-weight:600;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;margin-right:5px;}
    .row-btn:hover{color:var(--edikit-semantic-color-text-primary);border-color:var(--edikit-semantic-color-action-primary);}
    .empty{text-align:center;color:var(--edikit-semantic-color-text-muted);padding:22px 0;font-size:.8rem;font-weight:700;}
    .pre{background:var(--edikit-semantic-color-surface-input);border:1px solid var(--edikit-semantic-color-border-default);border-radius:10px;padding:10px 12px;font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--edikit-semantic-color-text-muted);white-space:pre-wrap;margin-top:8px;}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/admin" class="nav-logo">Edikit Admin</a>
    <div class="nav-right">
      <a href="/admin/dashboard" class="nav-btn">Dashboard</a>
      <a href="/admin/board" class="nav-btn">Board</a>
      <a href="/admin/logout" class="nav-btn">Chiqish</a>
    </div>
  </nav>

  <div class="panel">
    <h1 class="greeting">Special Consideration</h1>
    <p class="greeting-sub">Case lifecycle, encrypted evidence, remedy lineage va scoring incident</p>

    <div id="msg" class="msg"></div>

    <div class="grid">
      <!-- LEFT: create case + incident -->
      <div>
        <div class="card">
          <div class="card-h">Yangi case <small>DRAFT → CLOSED</small></div>
          <div class="field">
            <label>Case type</label>
            <select id="cType" class="inp">
              <option value="extension">extension</option>
              <option value="special_consideration">special_consideration</option>
              <option value="deferral">deferral</option>
              <option value="resit">resit</option>
              <option value="recheck">recheck</option>
              <option value="regrade">regrade</option>
              <option value="appeal">appeal</option>
              <option value="technical_incident">technical_incident</option>
            </select>
          </div>
          <div class="field">
            <label>Student user ID</label>
            <input type="number" id="cUserId" class="inp" />
          </div>
          <div class="field">
            <label>Attempt ID</label>
            <input type="number" id="cAttemptId" class="inp" />
          </div>
          <div class="field">
            <label>Grounds</label>
            <textarea id="cGrounds" class="inp" placeholder="Masalan: tibbiy sabab bilan kechikkan topshirish"></textarea>
          </div>
          <div class="field">
            <label>SLA (kun)</label>
            <input type="number" id="cSla" class="inp" value="10" />
          </div>
          <button class="btn" onclick="createCase()">Case yaratish</button>
        </div>

        <div class="card">
          <div class="card-h">Case evidence <small>encrypted</small></div>
          <div class="field">
            <label>Case ID</label>
            <input type="number" id="eCaseId" class="inp" />
          </div>
          <div class="field">
            <label>Evidence text (shifrlanadi — marker ko'rmaydi)</label>
            <textarea id="ePlain" class="inp" placeholder="Sensitive medical/care evidence"></textarea>
          </div>
          <button class="btn green" onclick="addEvidence()">Shifrlangan evidence qo'shish</button>
        </div>

        <div class="card">
          <div class="card-h">Scoring incident <small>wrong-key freeze/rescore</small></div>
          <div class="field">
            <label>Title</label>
            <input type="text" id="iTitle" class="inp" placeholder="Masalan: 7-savol noto'g'ri kalit" />
          </div>
          <div class="field">
            <label>Kind</label>
            <select id="iKind" class="inp">
              <option value="wrong_key">wrong_key</option>
              <option value="scoring_defect">scoring_defect</option>
              <option value="policy_change">policy_change</option>
              <option value="other">other</option>
            </select>
          </div>
          <button class="btn" onclick="createIncident()">Incident yaratish</button>
        </div>
      </div>

      <!-- RIGHT: lists -->
      <div>
        <div class="card">
          <div class="card-h">Cases <small><span class="badge blue" id="caseCount">0</span></small></div>
          <div id="caseList"><div class="empty">Yuklanmoqda…</div></div>
        </div>

        <div class="card">
          <div class="card-h">Incidents <small><span class="badge violet" id="incidentCount">0</span></small></div>
          <div id="incidentList"><div class="empty">Yuklanmoqda…</div></div>
        </div>
      </div>
    </div>
  </div>

<script>
  window.__CSRF_TOKEN = '<%= csrfToken %>';

  async function api(url, method, body) {
    const opts = { method: method || 'GET', headers: { 'Content-Type': 'application/json' } };
    if (method && method !== 'GET') opts.headers['x-csrf-token'] = window.__CSRF_TOKEN || '';
    if (body !== undefined) opts.body = JSON.stringify(body);
    const r = await fetch(url, opts);
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || j.reason || ('HTTP ' + r.status));
    return j;
  }

  function showMsg(text, isErr) {
    const m = document.getElementById('msg');
    m.className = 'msg ' + (isErr ? 'err' : 'ok');
    m.textContent = text;
    setTimeout(() => { m.style.opacity = '0'; }, 4000);
    setTimeout(() => { m.className = 'msg'; m.style.opacity = ''; }, 4400);
  }

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  async function createCase() {
    try {
      const r = await api('/api/admin/cases', 'POST', {
        caseType: document.getElementById('cType').value,
        userId: Number(document.getElementById('cUserId').value),
        attemptId: Number(document.getElementById('cAttemptId').value) || null,
        grounds: document.getElementById('cGrounds').value,
        slaDays: Number(document.getElementById('cSla').value) || 10,
      });
      showMsg('Case ' + r.case.case_reference + ' yaratildi (' + r.case.status + ')');
      loadCases();
    } catch (e) { showMsg(e.message, true); }
  }

  async function addEvidence() {
    try {
      const r = await api('/api/admin/cases/' + document.getElementById('eCaseId').value + '/evidence', 'POST', {
        evidenceType: 'certificate',
        plaintext: document.getElementById('ePlain').value,
      });
      showMsg('Evidence #' + r.evidence.id + ' shifrlangan holda saqlandi');
    } catch (e) { showMsg(e.message, true); }
  }

  async function createIncident() {
    try {
      const r = await api('/api/admin/scoring-incidents', 'POST', {
        title: document.getElementById('iTitle').value,
        kind: document.getElementById('iKind').value,
      });
      showMsg('Incident #' + r.incident.id + ' yaratildi (' + r.incident.status + ')');
      loadIncidents();
    } catch (e) { showMsg(e.message, true); }
  }

  async function loadCases() {
    try {
      const r = await api('/api/admin/cases');
      document.getElementById('caseCount').textContent = r.rows.length;
      const el = document.getElementById('caseList');
      if (!r.rows.length) { el.innerHTML = '<div class="empty">Hozircha case yo\'q</div>'; return; }
      el.innerHTML = '<table><tr><th>Ref</th><th>Type</th><th>Status</th><th>SLA</th></tr>' +
        r.rows.map(c => '<tr><td class="mono">' + esc(c.case_reference) + '</td><td>' + esc(c.case_type) + '</td><td><span class="badge ' + (c.status === 'approved' ? 'green' : c.status === 'rejected' ? 'red' : c.status === 'closed' || c.status === 'appealed' ? 'gray' : 'amber') + '">' + esc(c.status) + (c.overdue ? ' ⏰' : '') + '</span></td><td>' + (c.sla_deadline ? new Date(c.sla_deadline).toLocaleDateString() : '–') + '</td></tr>').join('') + '</table>';
    } catch (e) { document.getElementById('caseList').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
  }

  async function loadIncidents() {
    try {
      const r = await api('/api/admin/scoring-incidents');
      document.getElementById('incidentCount').textContent = r.rows.length;
      const el = document.getElementById('incidentList');
      if (!r.rows.length) { el.innerHTML = '<div class="empty">Hozircha incident yo\'q</div>'; return; }
      el.innerHTML = '<table><tr><th>ID</th><th>Title</th><th>Kind</th><th>Status</th><th></th></tr>' +
        r.rows.map(i => '<tr><td>' + i.id + '</td><td>' + esc(i.title) + '</td><td>' + esc(i.kind) + '</td><td><span class="badge ' + (i.status === 'resolved' ? 'green' : i.status === 'frozen' ? 'red' : 'amber') + '">' + esc(i.status) + '</span></td><td>' +
          (i.status === 'open' ? '<button class="row-btn" onclick="freezeInc(' + i.id + ')">Freeze</button>' : '') +
        '</td></tr>').join('') + '</table>';
    } catch (e) { document.getElementById('incidentList').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
  }

  async function freezeInc(id) {
    try {
      const r = await api('/api/admin/scoring-incidents/' + id + '/freeze', 'POST', {});
      showMsg('Incident #' + id + ' → ' + r.incident.status + ' (release bloklandi)');
      loadIncidents();
    } catch (e) { showMsg(e.message, true); }
  }

  loadCases();
  loadIncidents();
</script>
</body>
</html>
