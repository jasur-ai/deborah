<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--deborah-semantic-color-border-default);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:''Manrope'',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--deborah-semantic-color-text-primary);}
    .panel{max-width:900px;margin:0 auto;padding:24px 20px 80px;position:relative;z-index:1;}
    .greeting{font-family:''Manrope'',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;margin-bottom:20px;}
    .toolbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:16px;align-items:center;}
    .attempt-inp{flex:1;min-width:200px;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:10px 13px;color:var(--deborah-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.84rem;font-weight:600;outline:none;transition:border-color .3s;}
    .attempt-inp:focus{border-color:var(--deborah-semantic-color-action-primary);}
    .btn{border-radius:10px;border:none;padding:10px 16px;cursor:pointer;transition:color .3s ease,background-color .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s ease,opacity .3s ease;font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:.8rem;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),#1d4ed8);color:#fff;display:inline-flex;align-items:center;gap:6px;}
    .btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .btn.ghost{background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);border:1px solid var(--deborah-semantic-color-border-default);}
    .btn.ghost:hover{color:var(--deborah-semantic-color-text-primary);background:var(--bg-elevated);}
    .card{background:var(--deborah-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--deborah-semantic-color-border-default);margin-bottom:12px;animation:slideDown .3s ease;transition:background .3s,border-color .3s;}
    .card-h{font-family:''Manrope'',cursive;font-size:.95rem;display:flex;align-items:center;gap:8px;margin-bottom:10px;}
    .meta-row{display:flex;gap:14px;flex-wrap:wrap;font-size:.72rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);margin-bottom:8px;}
    .ev-time{font-family:'Source Sans 3',sans-serif;font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;}
    .flag-tags{display:flex;gap:5px;flex-wrap:wrap;margin:7px 0;}
    .flag{font-size:.66rem;font-weight:700;border-radius:6px;padding:3px 8px;background:var(--deborah-semantic-color-surface-input);border:1px solid var(--deborah-semantic-color-border-default);color:var(--deborah-semantic-color-text-muted);}
    .flag.warn{color:#fff;background:rgba(248,113,113,.8);border-color:transparent;}
    .flag.ok{color:var(--green);border-color:rgba(0,229,160,.3);}
    .dispo{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;border-radius:6px;padding:3px 9px;display:inline-flex;align-items:center;gap:5px;}
    .dispo.pending{background:rgba(251,191,36,.12);color:var(--gold);border:1px solid rgba(251,191,36,.3);}
    .dispo.cleared{background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);}
    .dispo.reviewed{background:rgba(248,113,113,.1);color:var(--deborah-semantic-color-action-primary);border:1px solid rgba(248,113,113,.3);}
    .dispo.discarded{background:rgba(255,255,255,.05);color:var(--deborah-semantic-color-text-muted);border:1px solid var(--deborah-semantic-color-border-default);}
    .actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px;}
    .act-btn{font-size:.7rem;font-weight:700;border-radius:8px;padding:6px 11px;border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;font-family:'Source Sans 3',sans-serif;}
    .act-btn:hover{transform:translateY(-1px);}
    .act-btn.clear:hover{color:var(--green);border-color:rgba(0,229,160,.4);}
    .act-btn.flag:hover{color:var(--deborah-semantic-color-action-primary);border-color:rgba(248,113,113,.4);}
    .act-btn.discard:hover{color:var(--deborah-semantic-color-text-muted);}
    .note-inp{width:100%;margin-top:8px;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:9px;padding:8px 11px;color:var(--deborah-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.76rem;font-weight:700;outline:none;transition:border-color .3s;resize:vertical;min-height:38px;}
    .note-inp:focus{border-color:var(--deborah-semantic-color-action-primary);}
    .loading{text-align:center;padding:30px;color:var(--deborah-semantic-color-text-muted);font-weight:600;font-size:.84rem;}
    .empty{text-align:center;padding:26px;color:var(--deborah-semantic-color-text-muted);font-weight:700;font-size:.8rem;background:var(--deborah-semantic-color-surface-input);border-radius:14px;border:1px dashed var(--deborah-semantic-color-border-default);}
    .summary{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
    .sum-chip{background:var(--deborah-semantic-color-surface-input);border:1px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:8px 14px;font-size:.74rem;font-weight:700;display:flex;align-items:center;gap:7px;}
    .sum-chip b{font-family:''Manrope'',cursive;font-size:1rem;}
    .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:12px;padding:11px 18px;font-size:.8rem;font-weight:600;z-index:999;opacity:0;pointer-events:none;transition:color .35s ease,background-color .35s ease,border-color .35s ease,box-shadow .35s ease,transform .35s ease,opacity .35s ease;box-shadow:var(--shadow-lg);}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .toast.ok{border-color:rgba(0,229,160,.4);color:var(--green);}
    .toast.err{border-color:rgba(248,113,113,.4);color:var(--deborah-semantic-color-action-primary);}
    .spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes slideDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
    @media(max-width:600px){.panel{padding:16px 12px 60px;}.toolbar{flex-direction:column;align-items:stretch;}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo"><img src="/images/logo-icon.svg" alt="Deborah" class="logo-img" style="height:28px;width:auto"></a>
    <div class="nav-right">
      <a href="/admin/dashboard" class="nav-btn" style="text-decoration:none"><%- icon('shield', 14) %> Dashboard</a>
      <button type="button" class="nav-btn" data-theme-toggle title="Light mode"><%- icon('moon', 16) %></button>
    </div>
  </nav>

  <div class="panel">
    <div class="greeting"><%- icon('eye', 22) %> Kamera evidence review</div>
    <div class="greeting-sub">Human review — qarorlar faqat inson tomonidan qabul qilinadi, avtomatik misconduct yo‘q</div>

    <div class="toolbar">
      <input type="number" id="attemptInp" class="attempt-inp" placeholder="Attempt ID">
      <button class="btn" id="loadBtn"><%- icon('search', 14) %> Yuklash</button>
      <button class="btn ghost" id="retentionBtn"><%- icon('trash', 14) %> Retention tozalash</button>
    </div>

    <div id="summary" class="summary hidden"></div>
    <div id="list"></div>
  </div>

  <div class="toast" id="toast"></div>
  <script>
    window.__ADMIN = <%- JSON.stringify(admin || null).replace(/</g, '\\u003c') %>;
  </script>
  <script type="module" src="/js/camera-review.js"></script>
  <%- include('../partials/footer-scripts') %>
</body>
</html>
