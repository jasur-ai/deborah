<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;font-family:'Source Sans 3',sans-serif;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(2,132,199,.08) 0%,transparent 65%);}
    .mfa-card{position:relative;z-index:1;width:100%;max-width:420px;background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:20px;padding:32px;box-shadow:var(--shadow-lg);animation:slideUp .4s ease;}
    .mfa-flag{display:inline-flex;align-items:center;gap:6px;font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:var(--deborah-semantic-color-brand-cobalt);padding:5px 12px;border-radius:999px;margin-bottom:18px;}
    .mfa-icon{width:56px;height:56px;border-radius:16px;background:var(--deborah-semantic-color-action-primary);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:var(--deborah-semantic-color-action-on-action,#041018);box-shadow:var(--shadow-md);}
    .mfa-title{font-family:'Manrope',cursive;font-size:1.4rem;text-align:center;margin-bottom:6px;}
    .mfa-sub{text-align:center;font-size:.84rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-bottom:24px;}
    .code-inp{width:100%;text-align:center;font-size:1.5rem;letter-spacing:.5em;font-family:'Manrope',cursive;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:12px;padding:14px;color:var(--deborah-semantic-color-text-primary);outline:none;transition:border-color .3s;font-variant-numeric:tabular-nums;}
    .code-inp:focus{border-color:var(--deborah-semantic-color-action-primary);}
    .verify-btn{width:100%;margin-top:16px;border:none;border-radius:12px;padding:14px;background:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#041018);font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:transform .2s,box-shadow .2s,opacity .2s;}
    .verify-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .verify-btn:disabled{opacity:.55;cursor:not-allowed;transform:none;}
    .err{display:none;margin-top:14px;border-radius:10px;padding:11px 14px;font-size:.78rem;font-weight:700;color:var(--deborah-semantic-color-danger);background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.3);}
    .err.show{display:block;}
    /* S35: passkey varianti — separator + ikkinchi darajali tugma */
    .pk-sep{display:none;align-items:center;gap:12px;margin:20px 0 2px;color:var(--deborah-semantic-color-text-muted);font-size:.72rem;font-weight:700;letter-spacing:.02em;}
    .pk-sep .pk-line{flex:1;height:1px;background:var(--deborah-semantic-color-border-default);}
    .pk-btn{background:transparent!important;color:var(--deborah-semantic-color-action-primary)!important;border:2px solid var(--deborah-semantic-color-action-primary)!important;margin-top:10px;font-weight:800;}
    .pk-btn:hover{background:rgba(2,132,199,.06)!important;box-shadow:none!important;color:var(--deborah-semantic-color-action-primary)!important;}
    .pk-btn:disabled{opacity:.55;cursor:not-allowed;transform:none;}
    .pk-btn svg{width:17px;height:17px;flex-shrink:0;}
    .hint{margin-top:18px;font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;text-align:center;line-height:1.6;}
    .back{margin-top:10px;text-align:center;}
    .back a{font-size:.78rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;text-decoration:none;}
    .back a:hover{color:var(--deborah-semantic-color-text-primary);}
    .spinner{width:15px;height:15px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;display:none;animation:spin .7s linear infinite;}
    .spinner.show{display:inline-block;}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes slideUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  </style>
  <link rel="stylesheet" href="/design/admin-command.css">
</head>
<body>
  <div class="mfa-card">
    <span class="mfa-flag">Admin 2FA</span>
    <div class="mfa-icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <div class="mfa-title">Ikki bosqichli tekshiruv</div>
    <div class="mfa-sub">Autentifikator ilovasidagi 6 xonali kodni yoki backup code kiriting</div>
    <input class="code-inp" id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="10" placeholder="••••••" autofocus aria-label="6 xonali kod">
    <button class="verify-btn" id="btn">
      <span class="spinner" id="spinner"></span>
      <span id="btn-label">Tasdiqlash</span>
    </button>
    <div class="pk-sep" id="pkSep"><span class="pk-line"></span><span>yoki</span><span class="pk-line"></span></div>
    <button class="verify-btn pk-btn" id="pkBtn" type="button">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
      <span>Passkey bilan tasdiqlash</span>
    </button>
    <div class="err" id="err" role="alert"></div>
    <div class="hint">Kod 90 soniya davomida amal qiladi. 5 marta xato kiritilsa, 15 daqiqa bloklanasiz.</div>
    <div class="back"><a href="/admin/login">← Orqaga</a></div>
  </div>

  <script>
    (function () {
      /* S35 FIX: __CSRF_TOKEN hech qayerda o'rnatilmagan edi → barcha POST'lar
         (TOTP verify + passkey verify) 403 "CSRF token validation failed" qaytarardi.
         Token serverdan beriladi (res.locals.csrfToken — global middleware). */
      window.__CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
      var challengeId = '<%= typeof challengeId !== "undefined" ? challengeId : "" %>';
      var btn = document.getElementById('btn');
      var codeInp = document.getElementById('code');
      var err = document.getElementById('err');
      var spinner = document.getElementById('spinner');
      var btnLabel = document.getElementById('btn-label');

      btn.addEventListener('click', submit);
      codeInp.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });

      /* ── S34g: PASSKEY VARIANTI — passkey mavjud bo'lsa ko'rsatiladi ── */
      var pkBtn = document.getElementById('pkBtn');
      var pkSep = document.getElementById('pkSep');
      function b64ToBuf(s){var b=s.replace(/-/g,'+').replace(/_/g,'/');while(b.length%4)b+='=';var bin=atob(b);var u=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return u.buffer;}
      function bufToB64(buf){var u=new Uint8Array(buf),s='';for(var i=0;i<u.length;i++)s+=String.fromCharCode(u[i]);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
      function pkShowErr(m){err.textContent=m;err.classList.add('show');}
      fetch('/api/admin/mfa/passkey/status',{credentials:'same-origin'})
        .then(function(r){return r.json();})
        .then(function(d){
          if (d && d.ok && d.available && window.PublicKeyCredential) {
            pkSep.style.display='flex';
            pkBtn.style.display='flex';
          }
        }).catch(function(){});
      pkBtn.addEventListener('click', async function(){
        pkBtn.disabled = true;
        err.classList.remove('show');
        try {
          var o = await fetch('/api/admin/mfa/passkey/options',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRF-Token':window.__CSRF_TOKEN||''},body:'{}'});
          var od = await o.json();
          if (!od.ok || !od.options) { pkShowErr('Passkey boshlashda xatolik: ' + (od.error || o.status)); pkBtn.disabled=false; return; }
          var opts = od.options;
          opts.challenge = b64ToBuf(opts.challenge);
          if (opts.allowCredentials) opts.allowCredentials.forEach(function(c){c.id=b64ToBuf(c.id);});
          opts.userVerification = opts.userVerification || 'required';
          var cred = await navigator.credentials.get({ publicKey: opts });
          if (!cred) { pkBtn.disabled=false; return; }
          var transports = [];
          try { transports = cred.response.getTransports ? cred.response.getTransports() : []; } catch(_){}
          var v = await fetch('/api/admin/mfa/passkey/verify',{
            method:'POST',credentials:'same-origin',
            headers:{'Content-Type':'application/json','X-CSRF-Token':window.__CSRF_TOKEN||''},
            body: JSON.stringify({
              id: cred.id, rawId: bufToB64(cred.rawId), type: cred.type,
              response: { clientDataJSON: bufToB64(cred.response.clientDataJSON), authenticatorData: bufToB64(cred.response.authenticatorData), signature: bufToB64(cred.response.signature), userHandle: cred.response.userHandle ? bufToB64(cred.response.userHandle) : null },
              clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {}
            })
          });
          var vd = await v.json();
          if (v.ok && vd.ok) { window.location.href = '/admin/dashboard'; return; }
          pkShowErr(vd.message || vd.error || 'Tasdiqlash rad etildi');
          pkBtn.disabled = false;
        } catch (e) {
          if (!(e && (e.name === 'NotAllowedError' || e.name === 'AbortError'))) pkShowErr('Xatolik: ' + (e.message || e.name));
          pkBtn.disabled = false;
        }
      });

      async function submit() {
        var code = codeInp.value.trim();
        if (code.length < 6) { showErr('Kodni to\u2019liq kiriting'); return; }
        btn.disabled = true;
        spinner.classList.add('show');
        btnLabel.textContent = 'Tekshirilmoqda...';
        err.classList.remove('show');
        try {
          var res = await fetch('/api/admin/mfa/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.__CSRF_TOKEN || '' },
            body: JSON.stringify({ code: code, challengeId: challengeId }),
          });
          var data = await res.json();
          if (res.ok && data.ok) {
            window.location.href = data.redirect || '/admin/dashboard';
            return;
          }
          var msg = data.error === 'locked'
            ? 'Juda ko\u2019p urinish. ' + Math.ceil((data.retryAfterSeconds || 0) / 60) + ' daqiqadan so\u2019ng qayta urinib ko\u2019ring.'
            : 'Kod noto\u2019g\u2019ri. Qayta urinib ko\u2019ring.';
          showErr(msg);
        } catch (e) {
          showErr('Server bilan bog\u2019lanishda xatolik. Qayta urinib ko\u2019ring.');
        } finally {
          btn.disabled = false;
          spinner.classList.remove('show');
          btnLabel.textContent = 'Tasdiqlash';
        }
      }

      function showErr(msg) {
        err.textContent = msg;
        err.classList.add('show');
      }
    })();
  </script>
</body>
</html>
