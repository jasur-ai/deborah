<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--bg-primary);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:'Righteous',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--border);background:var(--bg-surface);color:var(--muted);font-family:'Nunito',sans-serif;font-size:.78rem;font-weight:800;cursor:pointer;text-decoration:none;transition:all .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--text);}
    .panel{max-width:1180px;margin:0 auto;padding:24px 20px 90px;position:relative;z-index:1;}
    .greeting{font-family:'Righteous',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--muted);font-weight:700;margin-bottom:20px;}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
    @media(max-width:900px){.grid{grid-template-columns:1fr;}}
    .card{background:var(--card);border-radius:16px;padding:18px;border:1px solid var(--border);margin-bottom:14px;animation:slideDown .3s ease;transition:background .3s,border-color .3s;}
    .card-h{font-family:'Righteous',cursive;font-size:.95rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .card-h small{font-family:'Nunito',sans-serif;font-size:.66rem;color:var(--muted);font-weight:800;margin-left:auto;}
    .field{margin-bottom:11px;}
    .field label{display:block;font-size:.72rem;font-weight:900;color:var(--muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
    .inp{width:100%;background:var(--bg-surface);border:2px solid var(--border);border-radius:10px;padding:9px 12px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.82rem;font-weight:800;outline:none;transition:border-color .3s;}
    .inp:focus{border-color:var(--accent);}
    textarea.inp{min-height:70px;resize:vertical;}
    .btn{border-radius:10px;border:none;padding:10px 16px;cursor:pointer;transition:all .3s ease;font-family:'Nunito',sans-serif;font-weight:900;font-size:.8rem;background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;display:inline-flex;align-items:center;gap:6px;}
    .btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .btn.ghost{background:var(--bg-surface);color:var(--muted);border:1px solid var(--border);}
    .btn.ghost:hover{color:var(--text);background:var(--bg-elevated);}
    .btn.green{background:linear-gradient(135deg,#00e5a0,#00b37e);color:#04120c;}
    .btn.red{background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;}
    .badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:99px;font-size:.66rem;font-weight:900;letter-spacing:.3px;}
    .badge.blue{background:rgba(37,99,235,.15);color:var(--accent);}
    .badge.green{background:rgba(0,229,160,.14);color:var(--green);}
    .badge.red{background:rgba(239,68,68,.14);color:#f87171;}
    .badge.amber{background:rgba(251,191,36,.14);color:var(--gold);}
    .badge.gray{background:var(--bg-elevated);color:var(--muted);}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:14px;}
    .stat{background:var(--bg-surface);border:1px solid var(--border);border-radius:12px;padding:12px;}
    .stat b{font-size:1.3rem;display:block;font-family:'Righteous',cursive;}
    .stat span{font-size:.66rem;font-weight:900;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;}
    table{width:100%;border-collapse:collapse;font-size:.78rem;}
    th{text-align:left;font-size:.64rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);padding:7px 8px;border-bottom:1px solid var(--border);font-weight:900;}
    td{padding:7px 8px;border-bottom:1px solid var(--border);font-weight:700;}
    tr:last-child td{border-bottom:none;}
    .msg{padding:10px 14px;border-radius:10px;font-size:.78rem;font-weight:800;margin-bottom:12px;display:none;}
    .msg.ok{display:block;background:rgba(0,229,160,.12);color:var(--green);border:1px solid rgba(0,229,160,.25);}
    .msg.err{display:block;background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25);}
    .mono{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);}
    .chip-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
    .empty{text-align:center;color:var(--muted);padding:22px 0;font-size:.8rem;font-weight:700;}
    .row-btn{background:none;border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:4px 9px;font-size:.68rem;font-weight:800;cursor:pointer;transition:all .2s;margin-right:5px;}
    .row-btn:hover{color:var(--text);border-color:var(--accent);}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:200;padding:20px;}
    .modal.show{display:flex;}
    .modal-box{background:var(--bg-primary);border:1px solid var(--border);border-radius:18px;max-width:640px;width:100%;max-height:84vh;overflow:auto;padding:20px;animation:slideDown .25s ease;}
    .modal-box h3{margin:0 0 12px;font-family:'Righteous',cursive;font-size:1rem;}
    .modal-close{float:right;background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/admin" class="nav-logo">Edikit Admin</a>
    <div class="nav-right">
      <a href="/admin/dashboard" class="nav-btn">Dashboard</a>
      <a href="/admin/scan" class="nav-btn">Scan</a>
      <a href="/admin/paper" class="nav-btn">Paper</a>
      <a href="/admin/logout" class="nav-btn">Chiqish</a>
    </div>
  </nav>

  <main class="panel">
    <h1 class="greeting">Safe Submission</h1>
    <p class="greeting-sub">Xavfsiz fayl/kod/oral topshiriqlar — upload sessionlar, karantin va manual listen navbati (research §16.3, §51)</p>

    <div id="msgBox" class="msg"></div>

    <div class="grid">
      <div class="card">
        <div class="card-h">Upload Sessionlar <small>karantin fail-closed</small></div>
        <div id="sessionsWrap"><p class="empty">Yuklanmoqda...</p></div>
      </div>

      <div class="card">
        <div class="card-h">Manual Listen Navbati <small>past confidence transcriptlar</small></div>
        <div id="listenWrap"><p class="empty">Yuklanmoqda...</p></div>
      </div>
    </div>
  </main>

  <div id="modal" class="modal">
    <div class="modal-box">
      <button class="modal-close" onclick="closeModal()">&times;</button>
      <h3 id="modalTitle">Session tafsiloti</h3>
      <div id="modalBody"></div>
    </div>
  </div>

<script>
  const $ = (id) => document.getElementById(id);
  const CSRF = window.__CSRF_TOKEN || '';

  async function api(path, method = 'GET', body = null) {
    const opts = { method, headers: {} };
    if (body) { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
    if (method !== 'GET' && CSRF) opts.headers['x-csrf-token'] = CSRF;
    const r = await fetch(path, opts);
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
    return data;
  }

  function showMsg(text, ok = true) {
    const el = $('msgBox');
    el.textContent = text;
    el.className = 'msg ' + (ok ? 'ok' : 'err');
    setTimeout(() => { el.className = 'msg'; }, 4000);
  }

  function badge(status) {
    const map = { accepted: 'green', clean: 'green', verified: 'green', approved: 'green', uploading: 'amber', quarantined: 'amber', pending: 'amber', draft: 'amber', infected: 'red', rejected: 'red', unscannable: 'red', suspicious: 'red' };
    return `<span class="badge ${map[status] || 'gray'}">${status}</span>`;
  }

  function fmtSize(b) {
    if (!b) return '0 B';
    if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
    return Math.round(b / 1024) + ' KB';
  }

  async function loadSessions() {
    try {
      const d = await api('/api/admin/safe-submit/sessions');
      const list = d.sessions || [];
      if (list.length === 0) { $('sessionsWrap').innerHTML = '<p class="empty">Hozircha upload session yo\'q</p>'; return; }
      $('sessionsWrap').innerHTML = '<table><thead><tr><th>Fayl</th><th>Tur</th><th>Hajm</th><th>Status</th><th></th></tr></thead><tbody>' +
        list.map((s) => `<tr>
          <td>${s.original_name || s.session_key}</td>
          <td>${s.kind}</td>
          <td>${fmtSize(s.received_size)}/${fmtSize(s.expected_size)}</td>
          <td>${badge(s.status)} ${badge(s.quarantine_status)}</td>
          <td><button class="row-btn" onclick="openSession(${s.id})">Ko\'rish</button></td>
        </tr>`).join('') + '</tbody></table>';
    } catch (e) { showMsg(e.message, false); }
  }

  async function openSession(id) {
    try {
      const d = await api('/api/admin/safe-submit/sessions/' + id);
      const s = d.session;
      const scans = (d.scans || []).map((x) => `<tr><td>${x.scanner}</td><td>${badge(x.verdict)}</td><td>${x.scanned_at ? new Date(x.scanned_at).toLocaleString() : ''}</td></tr>`).join('');
      $('modalTitle').textContent = 'Session #' + id;
      $('modalBody').innerHTML = `
        <p><strong>${s.original_name || s.session_key}</strong> &middot; ${s.kind}</p>
        <p class="mono">sha256: ${(s.sha256 || '—').slice(0, 24)}…</p>
        <p class="mono">MIME: ${s.declared_mime || '—'} / magic: ${s.magic_mime || '—'}</p>
        <p>Karantin: ${badge(s.quarantine_status)} ${s.quarantine_reason ? '<span class="mono">' + s.quarantine_reason + '</span>' : ''}</p>
        <h4 style="margin:12px 0 6px;font-size:.8rem;">Scan natijalari (immutable)</h4>
        <table>${scans || '<tr><td class="empty">Scan yo\'q</td></tr>'}</table>
        ${s.status === 'quarantined' ? `
        <div class="field" style="margin-top:12px;">
          <label>Izoh (ixtiyoriy)</label>
          <input id="qNote" class="inp" />
        </div>
        <button class="btn green" onclick="reviewQuarantine(${s.id}, 'accept')">Qabul qilish</button>
        <button class="btn red" onclick="reviewQuarantine(${s.id}, 'reject')">Rad etish</button>` : ''}`;
      $('modal').classList.add('show');
    } catch (e) { showMsg(e.message, false); }
  }

  function closeModal() { $('modal').classList.remove('show'); }

  async function reviewQuarantine(id, action) {
    try {
      await api('/api/admin/safe-submit/sessions/' + id + '/quarantine', 'POST', { action, note: $('qNote')?.value || '' });
      showMsg('Session #' + id + ' ' + action + ' qilindi');
      closeModal(); loadSessions();
    } catch (e) { showMsg(e.message, false); }
  }

  async function loadListenQueue() {
    try {
      const d = await api('/api/admin/safe-submit/listen-queue');
      const list = d.transcripts || [];
      if (list.length === 0) { $('listenWrap').innerHTML = '<p class="empty">Navbat bo\'sh</p>'; return; }
      $('listenWrap').innerHTML = '<table><thead><tr><th>Tur</th><th>Confidence</th><th>Transkript</th><th>Status</th><th></th></tr></thead><tbody>' +
        list.map((t) => `<tr>
          <td>${t.kind}</td>
          <td>${Number(t.confidence).toFixed(2)}</td>
          <td class="mono">${String(t.transcript_text || '').slice(0, 60)}…</td>
          <td>${badge(t.status)}</td>
          <td>
            <button class="row-btn" style="color:var(--green);" onclick="reviewTranscript(${t.id}, 'approved')">OK</button>
            <button class="row-btn" style="color:#f87171;" onclick="reviewTranscript(${t.id}, 'rejected')">Rad</button>
          </td>
        </tr>`).join('') + '</tbody></table>';
    } catch (e) { showMsg(e.message, false); }
  }

  async function reviewTranscript(id, status) {
    try {
      await api('/api/admin/safe-submit/transcripts/' + id + '/status', 'POST', { status });
      showMsg('Transcript #' + id + ': ' + status);
      loadListenQueue();
    } catch (e) { showMsg(e.message, false); }
  }

  loadSessions();
  loadListenQueue();
</script>
</body>
</html>
