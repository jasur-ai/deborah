<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/design/admin-command.css">
<style>
</style>
</head>
<body>
  <nav class="admin-navbar">
    <div class="admin-nav-left">
      <button type="button" class="admin-nav-hamburger" aria-label="Menyu" aria-expanded="false" aria-controls="admin-sidebar" onclick="toggleAdminDrawer()"><span></span><span></span><span></span></button>
      <a href="/" class="admin-nav-brand">
        <span class="admin-nav-logo"><img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto"></span>
        <span class="admin-nav-badge">ADMIN</span>
      </a>
    </div>
    <div class="flex items-center gap-8">
      <a href="/admin/dashboard" class="admin-nav-btn"><%- icon('arrowLeft', 14) %> Dashboard</a>
      <a href="/admin/logout" class="admin-nav-btn"><%- icon('logOut', 14) %> Chiqish</a>
    </div>
  </nav>

  <div class="admin-layout">
    <div class="admin-drawer-overlay" id="admin-drawer-overlay" onclick="toggleAdminDrawer()"></div>
    <div class="admin-sidebar" id="admin-sidebar">
      <div class="admin-side-label">Bo'limlar</div>
      <a href="/admin/dashboard#pane-danger" class="admin-side-btn" style="--c:var(--deborah-semantic-color-action-primary);--cbg:rgba(37,99,235,.14)"><span class="admin-side-ico"><%- icon('alertTriangle', 16) %></span>Foydalanuvchilar</a>
      <a href="/admin/dashboard#pane-fans" class="admin-side-btn"><span class="admin-side-ico"><%- icon('book', 16) %></span>Mock Fanlar</a>
      <a href="/admin/dashboard#pane-pre" class="admin-side-btn" style="--c:var(--accent-glow);--cbg:rgba(100,116,139,.14)"><span class="admin-side-ico"><%- icon('layers', 16) %></span>PRE Testlar</a>
      <a href="/admin/dashboard#pane-results" class="admin-side-btn"><span class="admin-side-ico"><%- icon('trophy', 16) %></span>Natijalar</a>
      <div class="admin-side-label" style="margin-top:8px">Asboblar</div>
      <a href="/arena" target="_blank" class="admin-side-btn" style="--c:var(--green);--cbg:rgba(0,229,160,.1)"><span class="admin-side-ico"><%- icon('monitor', 16) %></span>Test Arena</a>
    </div>

    <div class="admin-panel">
      <div class="admin-sec-hd">
        <div class="admin-sec-title"><%- icon('shield', 18) %> VIP Foydalanuvchilar <span class="badge badge-gold">MAXFIY</span></div>
      </div>

      <div style="background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-subtle);border-radius:14px;padding:16px;margin-bottom:14px">
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
          <div style="flex:1;min-width:200px">
            <label class="lbl">Foydalanuvchi nomi</label>
            <input class="inp" id="vip-username" placeholder="username" style="margin-bottom:0">
          </div>
          <button type="button" onclick="grantVip()" style="background:linear-gradient(135deg,var(--accent-glow),var(--deborah-semantic-color-action-primary));border:none;border-radius:9px;padding:11px 22px;color:#000;font-family:var(--font-body);font-size:.85rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px"><%- icon('shield', 14) %> VIP qilish</button>
        </div>
        <div class="admin-msg" id="vip-msg"></div>
        <div id="vip-result" style="display:none;margin-top:10px;background:rgba(0,229,160,.08);border:1px solid rgba(0,229,160,.25);border-radius:10px;padding:12px 15px">
          <div style="font-size:.82rem;font-weight:600;color:var(--green);margin-bottom:4px">VIP berildi!</div>
          <div id="vip-result-detail" style="font-size:.78rem;color:var(--deborah-semantic-color-text-secondary)"></div>
        </div>
      </div>

      <input class="inp" id="vip-search" placeholder="Qidirish..." oninput="filterVip()" style="margin-bottom:12px">

      <!-- S25: o'qituvchilar VIP emas — alohida bo'lim -->
      <div class="vip-staff-note">
        ℹ️ O'qituvchilar VIP user emas — ular <a href="/admin/teachers?filter=approved">O'qituvchilar bo'limida</a> alohida ko'rinadi<% if (typeof staffExcluded !== 'undefined' && staffExcluded > 0) { %> (<%= staffExcluded %> ta xodim bu ro'yxatdan chiqarildi)<% } %>.
      </div>

      <!-- S33.05: STEP 18 table (dt-wrap / dt / dt-row + density) -->
      <div class="table-wrap dt-wrap is-reflow"><table class="dt" data-density="default"><thead><tr>
        <th scope="col">#</th><th scope="col" data-sort="name">Username</th><th scope="col">VIP</th><th scope="col" class="dt-ts">Ro'yxatdan o'tgan</th><th scope="col" class="dt-ts">VIP berilgan</th><th scope="col">Admin</th><th scope="col" class="dt-actions">Amallar</th>
      </tr></thead><tbody id="vip-tbody">
        <% if (users.length === 0) { %>
          <tr><td colspan="7"><div class="admin-empty">Foydalanuvchilar yo'q</div></td></tr>
        <% } else { %>
          <% users.forEach(function(u, i) { %>
            <tr class="vip-row dt-row" data-name="<%= String(u.username||'').toLowerCase() %>">
              <td><%= i + 1 %></td>
              <td><span class="font-bold"><%= u.username %></span></td>
              <td>
                <span class="badge <%= u.isVip ? 'badge-success' : 'badge-accent' %>">
                  <%= u.isVip ? 'VIP' : 'Oddiy' %>
                </span>
              </td>
              <td class="text-muted" style="font-size:.76rem"><%= u.created_at ? new Date(u.created_at).toLocaleString('uz-UZ') : '---' %></td>
              <td style="font-size:.76rem"><%= u.vipGrantedAt ? new Date(u.vipGrantedAt).toLocaleString('uz-UZ') : '---' %></td>
              <td style="font-size:.76rem"><%= u.vipGrantedBy || '---' %></td>
              <td>
                <div class="admin-fan-btns" style="gap:4px">
                  <% if (u.isVip) { %>
                    <button class="admin-del-btn" onclick="revokeVip('<%- u.username.replace(/'/g, "\\'") %>')"><%- icon('shield', 12) %> Olib tashlash</button>
                  <% } else { %>
                    <button class="admin-edit-btn" onclick="quickGrant('<%- u.username.replace(/'/g, "\\'") %>')" style="background:rgba(56,189,248,.1);border:1px solid rgba(56,189,248,.2);border-radius:7px;padding:5px 10px;color:var(--blue);font-size:.72rem;font-weight:600;cursor:pointer"><%- icon('shield', 12) %> VIP qilish</button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody></table></div>
    </div>
  </div>

  <script>
    // S33.02: mobile drawer toggle
    function toggleAdminDrawer() {
      const open = document.body.classList.toggle('admin-nav-open');
      const btn = document.querySelector('.admin-nav-hamburger');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function setMsg(text, type) {
      var el = document.getElementById('vip-msg');
      el.textContent = text;
      el.className = 'admin-msg active ' + (type || 'err');
    }

    function filterVip() {
      var q = document.getElementById('vip-search').value.toLowerCase();
      var rows = document.querySelectorAll('.vip-row');
      for (var i = 0; i < rows.length; i++) {
        var name = (rows[i].querySelector('.font-bold') || {}).textContent || '';
        rows[i].style.display = name.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
      }
    }

    async function grantVip() {
      var username = document.getElementById('vip-username').value.trim();
      if (!username) { setMsg('Username kiriting!', 'err'); return; }
      setMsg('VIP berilmoqda...', 'ok');
      document.getElementById('vip-result').style.display = 'none';
      try {
        var res = await fetch('/admin/api/vip/grant', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username })
        });
        var data = await res.json();
        if (data.success) {
          setMsg('', '');
          document.getElementById('vip-result').style.display = 'block';
          // STYLE S33.03: plain password UI'da ko'rsatilmaydi
          document.getElementById('vip-result-detail').innerHTML =
            'Foydalanuvchi: <strong>' + esc(data.username) + '</strong> — VIP huquqi berildi';
          document.getElementById('vip-username').value = '';
          setTimeout(function() { location.reload(); }, 3000);
        } else {
          setMsg('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        setMsg('Xato: ' + e.message, 'err');
      }
    }

    async function quickGrant(username) {
      if (!(await showConfirm('VIP berish', username + ' foydalanuvchisiga VIP berilsinmi?'))) return;
      try {
        var res = await fetch('/admin/api/vip/grant', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username })
        });
        var data = await res.json();
        if (data.success) {
          // STYLE S33.03: parol toast'da ko'rsatilmaydi
          showToast('VIP berildi!', 'ok', 3000);
          setTimeout(function() { location.reload(); }, 1000);
        } else {
          showToast('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        showToast('Xato: ' + e.message, 'err');
      }
    }

    async function revokeVip(username) {
      if (!(await showConfirm('VIP olib tashlash', username + ' foydalanuvchisidan VIP huquqini olib tashlashni tasdiqlaysizmi?'))) return;
      try {
        var res = await fetch('/admin/api/vip/revoke', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username })
        });
        var data = await res.json();
        if (data.success) {
          showToast('VIP olib tashlandi', 'ok');
          setTimeout(function() { location.reload(); }, 1000);
        } else {
          showToast('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        showToast('Xato: ' + e.message, 'err');
      }
    }

    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
  </script>
</body>
</html>
