        setMsg('fan-msg', `“${name}” mock fani saqlandi · ${questions.length} ta savol.`, 'ok');
        nameInput.value = '';
        fanPendingQs = null;
        setZoneState('fan', 'idle');
        await loadFans();
      } catch (error) {
        setMsg('fan-msg', error?.message || 'Mock fanni saqlashda xatolik yuz berdi.', 'err');
      } finally {
        button.removeAttribute('aria-busy');
        button.innerHTML = originalLabel;
        button.disabled = !fanPendingQs?.length;
      }
    }

