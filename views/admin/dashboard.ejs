<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css?v=nv6">
  <link rel="stylesheet" href="/design/admin-command.css?v=admin-shell-20261101-r2">
  <link rel="stylesheet" href="/css/admin-dashboard.css?v=20261102-practice-results-r1">
  <script src="/js/vendor/xlsx.full.min.js?v=0.18.5"></script>
</head>
<body class="admin-dashboard-page">
  <a href="#main" class="skip-link">Skip to content →</a>
  <nav class="admin-navbar">
    <div class="admin-nav-left">
      <button type="button" class="admin-nav-hamburger" aria-label="Menyu" aria-expanded="false" aria-controls="admin-sidebar"><span></span><span></span><span></span></button>
      <a href="/admin/dashboard" class="admin-nav-brand">
        <span class="admin-nav-logo"><img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto"></span>
        <span class="admin-nav-badge">ADMIN</span>
      </a>
    </div>
    <div class="flex items-center gap-8">
      <button type="button" class="admin-nav-btn" data-dashboard-action="refresh-current"><%- icon('refresh', 14) %> Yangilash</button>
      <%- include('../partials/theme-control') %>
      <a href="/admin/profile" class="admin-nav-btn"><%- icon('user', 14) %> Profilim</a>
      <a href="/admin/logout" class="admin-nav-btn"><%- icon('logOut', 14) %> <%= (adminCopy.logout || 'Chiqish') %></a>
    </div>
  </nav>

  <div class="admin-layout">
    <%- include('../partials/admin-sidebar', { activePath: '/admin/dashboard', activeTab }) %>

    <!-- Panel -->
    <main class="admin-panel admin-dashboard" id="main">
      <h1 class="sr-only">Admin panel</h1>
      <!-- Stats Row — S33.07: actionable (click'da tegishli bo'lim ochiladi) -->
      <div class="admin-stats-row" id="stats-row">
        <a class="stat-card" href="/admin/users" style="text-decoration:none"><div class="stat-ico"><%- icon('users', 20) %></div><div><div class="stat-num" id="s-users" ><%= stats.usersCount %></div><div class="stat-lbl"><%= (adminCopy.kpiUsers || 'Foydalanuvchilar') %></div></div></a>
        <button type="button" class="stat-card" data-go="results"><div class="stat-ico"><%- icon('gamepad', 20) %></div><div><div class="stat-num" id="s-games" ><%= stats.gamesCount %></div><div class="stat-lbl"><%= (adminCopy.kpiGames || 'O\'yinlar') %></div></div></button>
        <button type="button" class="stat-card" data-go="pre"><div class="stat-ico"><%- icon('layers', 20) %></div><div><div class="stat-num" id="s-tests"><%= stats.testsCount %></div><div class="stat-lbl">Subtestlar</div></div></button>
        <button type="button" class="stat-card" data-go="fans"><div class="stat-ico"><%- icon('book', 20) %></div><div><div class="stat-num" id="s-fans"><%= stats.fansCount %></div><div class="stat-lbl">Mock fanlar</div></div></button>
      </div>

      <!-- Power BI uslubidagi bosh sahifa: avval umumiy holat va tezkor yo'llar -->
      <section class="admin-tab-pane <%= activeTab === 'overview' ? 'active' : '' %>" id="pane-overview" aria-labelledby="admin-overview-title">
        <div class="admin-overview-head">
          <div>
            <h2 id="admin-overview-title">Umumiy ko‘rinish</h2>
            <p>Asosiy ko‘rsatkichlar yuqorida. Kerakli ishni quyidagi aniq bo‘limlardan tanlang.</p>
          </div>
          <a class="admin-overview-catalog" href="/admin/index"><%- icon('grid', 15) %> Barcha funksiyalar</a>
        </div>
        <div class="admin-overview-grid">
          <a href="/admin/users" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('users', 17) %></span><span><strong>Foydalanuvchilar</strong><small>Qidirish, rol va holat boshqaruvi</small></span><%- icon('arrowRight', 14) %></a>
          <a href="/admin/teachers" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('bookOpen', 17) %></span><span><strong>O‘qituvchi arizalari</strong><small>Arizalarni ko‘rish va qaror qilish</small></span><%- icon('arrowRight', 14) %></a>
          <a href="/admin/vip" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('shield', 17) %></span><span><strong>VIP boshqaruvi</strong><small>VIP huquqlarini boshqarish</small></span><%- icon('arrowRight', 14) %></a>
          <a href="/admin/dashboard?tab=fans" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('book', 17) %></span><span><strong>Mock fanlar</strong><small>Fanlar va Excel importi</small></span><%- icon('arrowRight', 14) %></a>
          <a href="/admin/dashboard?tab=pre" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('layers', 17) %></span><span><strong>Subtestlar</strong><small>Subtest to‘plamlarini boshqarish</small></span><%- icon('arrowRight', 14) %></a>
          <a href="/admin/dashboard?tab=results" class="admin-overview-link"><span class="admin-overview-icon"><%- icon('trophy', 17) %></span><span><strong>Natijalar</strong><small>O‘yin natijalarini ko‘rish</small></span><%- icon('arrowRight', 14) %></a>
        </div>
      </section>

      <!-- TAB: Tezkor foydalanuvchilar -->
      <div class="admin-tab-pane <%= activeTab === 'danger' ? 'active' : '' %>" id="pane-danger">
        <div class="admin-sec-hd">
        <div class="admin-sec-title"><%- icon('users', 18) %> Tezkor foydalanuvchi boshqaruvi <span class="badge badge-accent">TEZKOR AMALLAR</span></div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <a href="/admin/users" class="dashboard-action-btn dashboard-action-btn--secondary">To‘liq ro‘yxat</a>
          <button type="button" class="admin-refresh-btn" data-dashboard-action="refresh-users" aria-label="Foydalanuvchilarni yangilash"><%- icon('refresh', 12) %></button>
        </div>
      </div>
        <div class="table-wrap dt-wrap is-reflow"><table class="dt" data-density="default"><thead><tr>
          <th scope="col">#</th>
          <th scope="col" data-sort="name">Login</th>
          <th scope="col" class="dt-ts" data-sort="created">Ro'yxatdan o'tgan</th>
          <th scope="col" class="dt-num" data-sort="tests">Testlar</th>
          <th scope="col">VIP</th>
          <th scope="col" class="dt-actions">Boshqarish</th>
        </tr></thead><tbody id="users-tbody">
          <% if (users.length === 0) { %><tr><td colspan="6"><div class="admin-empty">Foydalanuvchilar yo'q</div></td></tr><% } else { %>
            <% users.forEach((u, i) => { %>                <tr class="dt-row" data-name="<%= String(u.username||'').toLowerCase() %>" data-created="<%= u.created_at || 0 %>" data-tests="<%= u.tests || 0 %>">
                <td><%= i + 1 %></td>
                <td class="dt-cell-main"><span class="font-bold"><%= u.username %></span></td>
                <td class="text-muted dt-ts" style="font-size:.76rem"><%= u.created_at ? new Date(u.created_at).toLocaleString('uz-UZ') : '—' %></td>
                <td class="dt-num"><span class="badge badge-accent"><%= u.tests %> ta test</span></td>
                <td>
                  <% if (u.isVip) { %>
                    <button type="button" class="dashboard-action-btn dashboard-action-btn--secondary" data-dashboard-action="vip-revoke" data-username="<%= u.username %>" title="VIP ni olib tashlash"><%- icon('shield', 11) %> VIP</button>
                  <% } else { %>
                    <button type="button" class="dashboard-action-btn dashboard-action-btn--secondary" data-dashboard-action="vip-grant" data-username="<%= u.username %>"><%- icon('shield', 11) %> VIP</button>
                  <% } %>
                </td>
                <td><button type="button" class="dashboard-action-btn dashboard-action-btn--danger" data-dashboard-action="user-manage-delete" data-key="<%= u.key %>" data-name="<%= u.username %>"><%- icon('trash', 12) %> O‘chirish…</button></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody></table></div>
      </div>

      <!-- TAB: Mock fanlar -->
      <div class="admin-tab-pane <%= activeTab === 'fans' ? 'active' : '' %>" id="pane-fans">
        <div class="admin-sec-hd">
          <div class="admin-sec-title"><%- icon('book', 18) %> Mock fanlar <span class="dashboard-section-pill">Tasodifiy 25 savol</span></div>
          <button type="button" class="admin-refresh-btn" data-dashboard-action="fans-refresh" aria-label="Mock fanlar ro‘yxatini yangilash"><%- icon('refresh', 12) %></button>
        </div>
        <section class="dashboard-import-card" aria-labelledby="fan-import-title">
          <div class="dashboard-import-heading">
            <div>
              <h3 id="fan-import-title">Mock fan qo‘shish</h3>
              <p>Excel fayldan savollarni yuklang, ko‘rib chiqing va saqlang.</p>
            </div>
            <span class="dashboard-required-note">* Majburiy maydonlar</span>
          </div>
          <div class="dashboard-import-grid">
            <div class="dashboard-field">
              <label for="fan-name">Mock fan nomi <span aria-hidden="true">*</span></label>
              <input class="inp dashboard-text-input" id="fan-name" name="fanName" maxlength="100" autocomplete="off" placeholder="Masalan: Matematika, 7-sinf" aria-describedby="fan-name-help" required>
              <p class="dashboard-field-help" id="fan-name-help">Fan nomini tushunarli va qisqa kiriting.</p>
            </div>
            <div class="dashboard-field">
              <span class="dashboard-field-label">Excel savollar fayli <span aria-hidden="true">*</span></span>
              <div class="dashboard-dropzone" id="fan-drop-zone" role="button" tabindex="0" aria-label="Mock fan uchun Excel fayl tanlash yoki shu yerga tashlash" aria-describedby="fan-drop-help">
                <span class="dashboard-dropzone-icon"><%- icon('upload', 22) %></span>
                <span class="dashboard-dropzone-copy">
                  <strong>Faylni shu yerga tashlang</strong>
                  <span id="fan-excel-lbl">yoki bosib fayl tanlang</span>
                </span>
                <span class="dashboard-dropzone-status" id="fan-excel-status">Fayl tanlanmagan</span>
              </div>
              <p class="dashboard-field-help" id="fan-drop-help">XLS yoki XLSX · 10 MB gacha · namunaviy shablon mavjud</p>
            </div>
          </div>
          <div class="dashboard-import-actions">
            <button type="button" class="dashboard-btn dashboard-btn--quiet" data-dashboard-action="excel-template"><%- icon('download', 14) %> Excel shablonini yuklab olish</button>
            <button type="button" class="dashboard-btn dashboard-btn--primary" id="save-fan-btn" data-dashboard-action="fan-save" disabled><%- icon('save', 14) %> Mock fanni saqlash</button>
          </div>
          <div class="admin-msg" id="fan-msg" role="status" aria-live="polite"></div>
        </section>
        <input type="file" id="fan-excel-inp" accept=".xlsx,.xls,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="dashboard-file-input" tabindex="-1" aria-hidden="true">
        <div class="dashboard-list" id="fans-list"><div class="admin-empty" role="status">Yuklanmoqda...</div></div>
      </div>

      <!-- TAB: Subtestlar -->
      <div class="admin-tab-pane <%= activeTab === 'pre' ? 'active' : '' %>" id="pane-pre">
        <div class="admin-sec-hd">
          <div class="admin-sec-title"><%- icon('layers', 18) %> Subtestlar</div>
          <button type="button" class="admin-refresh-btn" data-dashboard-action="pre-refresh" aria-label="Subtestlar ro‘yxatini yangilash"><%- icon('refresh', 12) %></button>
        </div>
        <section class="dashboard-import-card" aria-labelledby="pre-import-title">
          <div class="dashboard-import-heading">
            <div>
              <h3 id="pre-import-title">Subtestlar to‘plamini yaratish</h3>
              <p>Excel fayldagi savollar 25 tadan subtestlarga ajratiladi.</p>
            </div>
            <span class="dashboard-required-note">* Majburiy maydonlar</span>
          </div>
          <div class="dashboard-import-grid dashboard-import-grid--subtests">
            <div class="dashboard-field">
              <label for="pre-title">To‘plam nomi <span aria-hidden="true">*</span></label>
              <input class="inp dashboard-text-input" id="pre-title" name="subtestGroupName" maxlength="120" autocomplete="off" placeholder="Masalan: Fizika — 2024" aria-describedby="pre-title-help" required>
              <p class="dashboard-field-help" id="pre-title-help">Bu nom ostida yaratilgan subtestlar birga saqlanadi.</p>
            </div>
            <div class="dashboard-field">
              <span class="dashboard-field-label">Excel savollar fayli <span aria-hidden="true">*</span></span>
              <div class="dashboard-dropzone" id="pre-drop-zone" role="button" tabindex="0" aria-label="Subtestlar uchun Excel fayl tanlash yoki shu yerga tashlash" aria-describedby="pre-drop-help">
                <span class="dashboard-dropzone-icon"><%- icon('upload', 22) %></span>
                <span class="dashboard-dropzone-copy">
                  <strong>Faylni shu yerga tashlang</strong>
                  <span id="pre-excel-lbl">yoki bosib fayl tanlang</span>
                </span>
                <span class="dashboard-dropzone-status" id="pre-excel-status">Fayl tanlanmagan</span>
              </div>
              <p class="dashboard-field-help" id="pre-drop-help">XLS yoki XLSX · 10 MB gacha · 25 savol = 1 subtest</p>
            </div>
          </div>
          <div class="dashboard-import-actions">
            <button type="button" class="dashboard-btn dashboard-btn--quiet" data-dashboard-action="excel-template"><%- icon('download', 14) %> Excel shablonini yuklab olish</button>
            <button type="button" class="dashboard-btn dashboard-btn--primary" id="save-pre-btn" data-dashboard-action="pre-save" disabled><%- icon('layers', 14) %> Subtestlarni saqlash</button>
          </div>
          <div class="dashboard-preview" id="pre-preview" hidden>
            <div class="dashboard-preview-heading">
              <strong id="pre-preview-title"></strong>
              <span>Tekshirib chiqing va so‘ng saqlang</span>
            </div>
            <div class="dashboard-subtest-list" id="pre-chunk-list"></div>
          </div>
          <div class="dashboard-saving" id="pre-saving" hidden><span class="dashboard-spinner" aria-hidden="true"></span><span>Subtestlar saqlanmoqda...</span></div>
          <div class="dashboard-progress" id="pre-prog-bar" hidden><span id="pre-prog-fill"></span></div>
          <div class="admin-msg" id="pre-msg" role="status" aria-live="polite"></div>
        </section>
        <input type="file" id="pre-excel-inp" accept=".xlsx,.xls,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="dashboard-file-input" tabindex="-1" aria-hidden="true">
        <div class="dashboard-list" id="pre-list"><div class="admin-empty" role="status">Yuklanmoqda...</div></div>
      </div>

      <!-- TAB: Results -->
      <div class="admin-tab-pane <%= activeTab === 'results' ? 'active' : '' %>" id="pane-results">
        <div class="admin-sec-hd"><div class="admin-sec-title"><%- icon('trophy', 18) %> O'yin Natijalari <span class="badge badge-gold">SHOXSUPA</span></div><button type="button" class="admin-refresh-btn" data-dashboard-action="results-refresh"><%- icon('refresh', 12) %></button></div>
        <div id="results-wrap"><div class="admin-empty">Yuklanmoqda...</div></div>
      </div>

      <!-- TAB: Stats -->
      <div class="admin-tab-pane <%= activeTab === 'stats' ? 'active' : '' %>" id="pane-stats">
        <div class="admin-sec-hd"><div class="admin-sec-title"><%- icon('barChart', 18) %> Statistika</div><button type="button" class="admin-refresh-btn" data-dashboard-action="stats-refresh"><%- icon('refresh', 12) %></button></div>
        <div id="stats-content"><div class="admin-empty">Yuklanmoqda...</div></div>
      </div>

      <!-- TAB: VIP -->
      <div class="admin-tab-pane <%= activeTab === 'vip' ? 'active' : '' %>" id="pane-vip">
        <div class="admin-sec-hd">
          <div class="admin-sec-title"><%- icon('shield', 18) %> VIP Foydalanuvchilar <span class="badge badge-gold">MAXFIY</span></div>
          <button type="button" class="admin-refresh-btn" data-dashboard-action="vip-refresh"><%- icon('refresh', 12) %></button>
        </div>

        <!-- Grant Form -->
        <div style="background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-subtle);border-radius:14px;padding:16px;margin-bottom:14px">
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
          <div style="flex:1;min-width:200px">
            <label class="lbl" for="vip-username">Foydalanuvchi nomi</label>
            <!-- S33.09: searchable picker (datalist) -->
            <input class="inp" id="vip-username" list="vip-user-list" placeholder="Username izlash..." autocomplete="off" style="margin-bottom:0">
            <datalist id="vip-user-list">
              <% users.forEach(u => { %><option value="<%= u.username %>"><% }); %>
            </datalist>
          </div>
          <button type="button" id="grant-vip-btn" data-dashboard-action="vip-grant-manual" class="btn btn-warning"><%- icon('shield', 14) %> VIP qilish</button>
          </div>
          <div class="admin-msg" id="vip-msg"></div>
          <div id="vip-result" style="display:none;margin-top:10px;background:rgba(0,229,160,.08);border:1px solid rgba(0,229,160,.25);border-radius:10px;padding:12px 15px">
            <div style="font-size:.82rem;font-weight:600;color:var(--green);margin-bottom:4px">✅ VIP berildi!</div>
            <div id="vip-result-detail" style="font-size:.78rem;color:var(--deborah-semantic-color-text-secondary)"></div>
          </div>
        </div>

        <!-- Search filter -->
        <input class="inp" id="vip-search" placeholder="Qidirish..." data-dashboard-action="vip-search" style="margin-bottom:12px">

        <!-- VIP Users Table (dynamic) -->
        <div id="vip-table-wrap"><div class="admin-empty">Yuklanmoqda...</div></div>
      </div>

      <!-- TAB: Cast Governance -->
      <div class="admin-tab-pane <%= activeTab === 'governance' ? 'active' : '' %>" id="pane-governance">
        <div class="admin-sec-hd">
          <div class="admin-sec-title"><%- icon('shield', 18) %> Cast Governance <span class="badge badge-success">Institution</span></div>
          <button type="button" class="admin-refresh-btn" data-dashboard-action="gov-refresh"><%- icon('refresh', 12) %></button>
        </div>

        <!-- Create policy form -->
        <div style="background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-subtle);border-radius:14px;padding:16px;margin-bottom:14px">
          <div style="font-size:.85rem;font-weight:600;margin-bottom:10px">Yangi policy draft</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
            <div style="flex:2;min-width:220px">
              <label class="lbl">Nom</label>
              <input class="inp" id="gov-name" placeholder="school_12_cast_policy" style="margin-bottom:0">
            </div>
            <div style="flex:1;min-width:200px">
              <label class="lbl">Approved presets (vergul bilan)</label>
              <input class="inp" id="gov-presets" placeholder="responsive_accuracy, formative_check" style="margin-bottom:0">
            </div>
            <button type="button" data-dashboard-action="gov-create" class="dashboard-btn dashboard-btn--primary"><%- icon('shield', 14) %> Yaratish</button>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
            <div style="flex:1;min-width:260px">
              <label class="lbl">Locked fields (JSON) — masalan: {"moderation.publicChat":false}</label>
              <textarea class="inp" id="gov-locked" rows="2" style="font-family:monospace;font-size:.75rem;resize:vertical">{}</textarea>
            </div>
            <div style="flex:1;min-width:260px">
              <label class="lbl">Limits (JSON) — masalan: {"join.maxPlayers":500}</label>
              <textarea class="inp" id="gov-limits" rows="2" style="font-family:monospace;font-size:.75rem;resize:vertical">{}</textarea>
            </div>
          </div>
          <div class="admin-msg" id="gov-msg"></div>
        </div>

        <!-- Policy list (dynamic) -->
        <div id="gov-list-wrap"><div class="admin-empty">Yuklanmoqda...</div></div>
      </div>
    </main>
  </div>

  <!-- Hidden file inputs for Excel import -->
  <input type="file" id="fan-reset-inp" accept=".xlsx,.xls" class="dashboard-file-input" tabindex="-1" aria-hidden="true">

  <script>
    // AUTH D-10 §13: 4 til admin copy (AUTH_COPY[lang].admin) — fallback bilan
    window.__ADMIN_COPY__ = <%- JSON.stringify(adminCopy || {}) %>;
    let currentTab = '<%= activeTab %>';

    // S33.02: mobile drawer toggle — sidebar functionality yo'qolmaydi
    function toggleAdminDrawer() {
      const open = document.body.classList.toggle('admin-nav-open');
      const btn = document.querySelector('.admin-nav-hamburger');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // S33.07: stats card'lar actionable — click'da tegishli bo'lim ochiladi
    document.querySelectorAll('.stat-card[data-go]').forEach(card => {
      card.addEventListener('click', () => {
        const tab = card.getAttribute('data-go');
        if (document.getElementById('pane-' + tab)) switchTab(tab);
      });
    });

    function switchTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.admin-side-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.admin-tab-pane').forEach(p => p.classList.remove('active'));
      document.getElementById('pane-' + tab).classList.add('active');
      document.querySelector(`.admin-side-btn[data-admin-tab="${tab}"]`)?.classList.add('active');
      // S33.02: mobil drawer bo'lim tanlanganda yopiladi
      document.body.classList.remove('admin-nav-open');
      const hb = document.querySelector('.admin-nav-hamburger');
      if (hb) hb.setAttribute('aria-expanded', 'false');
      refreshActiveTab();
    }

    function refreshActiveTab() {
      if (currentTab === 'fans') loadFans();
      else if (currentTab === 'pre') loadPreGroups();
      else if (currentTab === 'results') loadResults();
      else if (currentTab === 'stats') loadStats();
      else if (currentTab === 'vip') loadVip();
      else if (currentTab === 'governance') loadGovernance();
    }

    // ── S22 FIX (VIP tab yuklanmasligi): svgIcon 24 joyda ishlatilgan, lekin
    // HECH QAYERDA aniqlanmagan — har bir JS-render tab (VIP/fans/results...)
    // ReferenceError bilan 'Yuklab bo'lmadi'ga tushardi. esc ham xuddi shunday.
    const __DASH_ICONS = <%- JSON.stringify(Object.fromEntries(["shield","check","upload","save","layers","book","zap","gamepad","monitor","refresh","alertTriangle","x","plus","award","users","edit","trophy","trash","user"].map((n) => [n, icon(n, 13)]))).replace(/</g, '\\u003c') %>;
    function svgIcon(name, size) {
      const markup = __DASH_ICONS[name] || '';
      const dimension = Math.round(Number(size));
      if (!markup || !Number.isFinite(dimension) || dimension < 1) return markup;
      return markup.replace(/<svg\b([^>]*)>/, (tag, attributes) => {
        const clean = attributes.replace(/\s(?:width|height)="[^"]*"/g, '');
        return `<svg${clean} width="${dimension}" height="${dimension}">`;
      });
    }
    function esc(v) { return escHtml(v); }

    // ── Cast Governance (C4-08) ──
    function escHtml(v) {
      return String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function parseGovJson(id, def) {
      try { return JSON.parse(document.getElementById(id).value || def || '{}'); }
      catch { return null; }
    }

