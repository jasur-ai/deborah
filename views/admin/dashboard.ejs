    function practiceSummaryMarkup(summary) {
      const stats = summary || {};
      const attempts = Number(stats.attempts) || 0;
      if (!attempts) {
        return '<div class="dashboard-result-summary dashboard-result-summary--empty">Natija hali saqlanmagan</div>';
      }
      const participants = Number(stats.participants) || 0;
      const average = Number(stats.averagePercent) || 0;
      const best = Number(stats.bestPercent) || 0;
      return `<div class="dashboard-result-summary" aria-label="Mashq natijalari">
        <span><strong>${attempts}</strong> urinish</span>
        <span><strong>${participants}</strong> ishtirokchi</span>
        <span>O‘rtacha <strong>${average}%</strong></span>
        <span>Eng yaxshi <strong>${best}%</strong></span>
      </div>`;
    }

    async function loadFans() {
      const wrap = document.getElementById('fans-list');
      wrap.innerHTML = '<div class="admin-empty" role="status">Mock fanlar yuklanmoqda…</div>';
      try {
        const response = await fetch('/admin/api/fans');
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || `Yuklash muvaffaqiyatsiz (HTTP ${response.status}).`);
        const fans = Array.isArray(data.fans) ? data.fans : [];
        if (!fans.length) {
          wrap.innerHTML = '<div class="admin-empty" role="status">Hali mock fan qo‘shilmagan. Birinchi fanni Excel orqali yarating.</div>';
          return;
        }
        wrap.innerHTML = fans.map((fan) => {
          const key = escHtml(fan.key);
          const name = escHtml(fan.name);
          return `
            <article class="admin-fan-item">
              <div class="dashboard-item-copy">
                <div class="admin-fan-item-name">${svgIcon('book', 16)} <span>${name}</span></div>
                <div class="admin-fan-item-meta">${Number(fan.count) || 0} ta savol</div>
                ${practiceSummaryMarkup(fan.practiceResults)}
              </div>
              <div class="admin-fan-btns">
                <button type="button" class="dashboard-action-btn dashboard-action-btn--quiet" data-dashboard-action="fan-mock" data-key="${key}" data-name="${name}">${svgIcon('zap', 14)} Mock sinovi</button>
                <button type="button" class="dashboard-action-btn dashboard-action-btn--secondary" data-dashboard-action="fan-cast" data-key="${key}" data-name="${name}">${svgIcon('gamepad', 14)} Cast</button>
                <button type="button" class="dashboard-action-btn dashboard-action-btn--quiet" data-dashboard-action="fan-arena">${svgIcon('monitor', 14)} Arena</button>
                <button type="button" class="dashboard-action-btn dashboard-action-btn--quiet" data-dashboard-action="fan-reset" data-key="${key}" data-name="${name}">${svgIcon('refresh', 14)} Savollarni yangilash</button>
                <button type="button" class="dashboard-icon-btn dashboard-icon-btn--danger" data-dashboard-action="fan-delete" data-key="${key}" data-name="${name}" aria-label="${name} mock fanini o‘chirish" title="O‘chirish">${svgIcon('trash', 14)}</button>
              </div>
            </article>`;
        }).join('');
      } catch (error) {
        wrap.innerHTML = `<div class="admin-empty dashboard-empty--error" role="alert">Mock fanlarni yuklab bo‘lmadi: ${escHtml(error?.message || 'Tarmoq xatosi')}</div>`;
      }
    }

    function startFanMockup(key, name) {
      const query = new URLSearchParams({ source: 'mock', key: String(key || ''), testName: 'Mock: ' + String(name || '') });
      window.location.assign('/host?' + query.toString());
    }

    function startFanCast(key, name) {
      const query = new URLSearchParams({ source: 'mock', key: String(key || ''), testName: 'Mock: ' + String(name || '') });
      window.location.assign('/host?' + query.toString());
    }
    
    let resetFanKey = null;
    async function resetFan(key, name) {
      if (!(await showConfirm('Almashtirish', name + ' savollarini yangi Excel bilan almashtirasizmi?'))) return;
      resetFanKey = key;
      document.getElementById('fan-reset-inp').click();
    }
    
    document.getElementById('fan-reset-inp').addEventListener('change', async function(event) {
      const file = event.target.files?.[0];
      event.target.value = '';
      if (!file || !resetFanKey) return;
      const key = resetFanKey;
      resetFanKey = null;
      try {
        const workbook = await readExcelWorkbook(file);
        const questions = parseQuestionsFromWB(workbook);
        if (!questions.length) throw new Error('Excel faylda savollar topilmadi.');
        const response = await fetch('/admin/api/fans/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key,
            questions: questions.map((question) => ({
              num: question.num,
              text: question.text,
              correctLetter: question.correctLetter,
              correctText: question.correctText,
              options: question.options.map((option) => ({ ...option })),
            })),
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || `Yangilash muvaffaqiyatsiz (HTTP ${response.status}).`);
        showToast(`${questions.length} ta savol yangilandi.`, 'ok');
        await loadFans();
      } catch (error) {
        showToast(error?.message || 'Mock fan savollarini yangilashda xatolik yuz berdi.', 'err');
      }
    });

    async function deleteFan(key, name) {
      if (!(await showConfirm('Mock fanni o‘chirish', `“${name}” mock fanini va uning savollarini o‘chirishni tasdiqlaysizmi?`))) return;
      try {
        const response = await fetch('/admin/api/fans/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || `O‘chirish muvaffaqiyatsiz (HTTP ${response.status}).`);
        setMsg('fan-msg', `“${name}” mock fani o‘chirildi.`, 'ok');
        await loadFans();
      } catch (error) {
        setMsg('fan-msg', error?.message || 'Mock fanni o‘chirib bo‘lmadi.', 'err');
      }
    }

    async function loadPreGroups() {
      const wrap = document.getElementById('pre-list');
      wrap.innerHTML = '<div class="admin-empty" role="status">Subtestlar yuklanmoqda…</div>';
      try {
        const response = await fetch('/admin/api/pre-groups');
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || `Yuklash muvaffaqiyatsiz (HTTP ${response.status}).`);
        const groups = Array.isArray(data.groups) ? data.groups : [];
        if (!groups.length) {
          wrap.innerHTML = '<div class="admin-empty" role="status">Hali subtestlar to‘plami yo‘q. Excel fayl yuklab birinchi to‘plamni yarating.</div>';
          return;
        }
        wrap.innerHTML = groups.map((group) => {
          const key = escHtml(group.key);
          const title = escHtml(group.title);
          const chunkResults = Array.isArray(group.chunkResults) ? group.chunkResults : [];
          const chunkSummary = chunkResults.length ? `
            <details class="dashboard-subtest-results">
              <summary>Subtestlar kesimidagi natijalar</summary>
              <div class="dashboard-subtest-results-list">${chunkResults.map((chunk) => `
                <div class="dashboard-subtest-result">
                  <span>${escHtml(chunk.name || 'Subtest')}</span>
                  ${practiceSummaryMarkup(chunk.practiceResults)}
                </div>`).join('')}
              </div>
            </details>` : '';
          return `
            <article class="admin-pre-item">
              <div class="dashboard-item-copy">
                <div class="admin-pre-item-name">${svgIcon('layers', 16)} <span>${title}</span></div>
                <div class="admin-pre-item-meta">${Number(group.count) || 0} ta subtest · ${Number(group.total) || 0} ta savol</div>
                ${practiceSummaryMarkup(group.practiceResults)}
                ${chunkSummary}
              </div>
              <div class="admin-pre-btns">
                <button type="button" class="dashboard-action-btn dashboard-action-btn--quiet" data-dashboard-action="pre-edit" data-key="${key}" data-title="${title}">${svgIcon('edit', 14)} Tahrirlash</button>
                <button type="button" class="dashboard-action-btn dashboard-action-btn--danger" data-dashboard-action="pre-delete" data-key="${key}" data-title="${title}">${svgIcon('trash', 14)} O‘chirish</button>
              </div>
            </article>`;
        }).join('');
      } catch (error) {
        wrap.innerHTML = `<div class="admin-empty dashboard-empty--error" role="alert">Subtestlarni yuklab bo‘lmadi: ${escHtml(error?.message || 'Tarmoq xatosi')}</div>`;
      }
    }

    function editPreGroup(key, title) {
      editPreKey = key;
      document.getElementById('pre-title').value = title;
      document.getElementById('pre-title').focus();
      document.getElementById('pre-title').scrollIntoView({ behavior: 'smooth' });
      setMsg('pre-msg', 'Tahrirlash: ' + title + ' — yangi Excel yuklang va saqlang', 'ok');
    }

    async function deletePreGroup(key, title) {
      if (!(await showConfirm('Subtestlar to‘plamini o‘chirish', `“${title}” to‘plamini o‘chirishni tasdiqlaysizmi?`))) return;
      try {
        const response = await fetch('/admin/api/pre-groups/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || `O‘chirish muvaffaqiyatsiz (HTTP ${response.status}).`);
        setMsg('pre-msg', `“${title}” subtestlar to‘plami o‘chirildi.`, 'ok');
        await loadPreGroups();
      } catch (error) {
        setMsg('pre-msg', error?.message || 'Subtestlar to‘plamini o‘chirib bo‘lmadi.', 'err');
      }
    }

    // Dynamic list controls are delegated so newly loaded items always work.
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest('[data-dashboard-action]');
      if (!button || button.disabled) return;
      const { dashboardAction: action, key, name, title, username, code, policyId } = button.dataset;
      if (action === 'refresh-current') {
        if (currentTab === 'overview' || currentTab === 'danger') window.location.reload();
        else refreshActiveTab();
      } else if (action === 'refresh-users') window.location.reload();
      else if (action === 'fans-refresh') loadFans();
      else if (action === 'pre-refresh') loadPreGroups();
      else if (action === 'results-refresh') loadResults();
      else if (action === 'stats-refresh') loadStats();
      else if (action === 'vip-refresh') loadVip();
      else if (action === 'gov-refresh') loadGovernance();
      else if (action === 'excel-template') downloadFanTemplate();
      else if (action === 'fan-save') saveFanFromExcel();
      else if (action === 'pre-save') savePreFromExcel();
      else if (action === 'vip-grant-manual') grantVip();
      else if (action === 'gov-create') createGovernance();
      else if (action === 'fan-mock') startFanMockup(key, name || '');
      else if (action === 'fan-cast') startFanCast(key, name || '');
      else if (action === 'fan-arena') window.open('/arena', '_blank', 'noopener,noreferrer');
      else if (action === 'fan-reset') resetFan(key, name || '');
      else if (action === 'fan-delete') deleteFan(key, name || '');
      else if (action === 'pre-edit') editPreGroup(key, title || '');
      else if (action === 'pre-delete') deletePreGroup(key, title || '');
      else if (action === 'vip-grant') quickGrantVip(username || '');
      else if (action === 'vip-revoke') quickRevokeVip(username || '');
      else if (action === 'user-manage-delete') openSecureUserDelete(key || '', name || '');
      else if (action === 'result-delete') deleteResult(code || '');
      else if (action === 'gov-publish') publishGovernance(policyId || '');
      else if (action === 'gov-deprecate') deprecateGovernance(policyId || '');
      else if (action === 'gov-audit') auditGovernance(policyId || '');
    });
    document.addEventListener('input', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.matches('[data-dashboard-action="vip-search"]')) filterVip();
    });

    // ── VIP Management ──
    async function loadVip() {
      const wrap = document.getElementById('vip-table-wrap');
      try {
        const res = await fetch('/admin/api/users?excludeStaff=true');
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || `Foydalanuvchilarni yuklash muvaffaqiyatsiz (HTTP ${res.status}).`);
        const vipUsers = Array.isArray(data.users) ? data.users : [];
        if (!vipUsers.length) {
          wrap.innerHTML = '<div class="admin-empty">Foydalanuvchilar yo\'q</div>';
          return;
        }
        wrap.innerHTML = `
          <div class="vip-staff-note">ℹ️ O'qituvchilar bu yerda ko'rinmaydi — <a href="/admin/teachers?filter=approved">O'qituvchilar bo'limi</a>.</div>
          <div class="table-wrap"><table><thead><tr>
            <th>#</th><th>Username</th><th>VIP</th><th>Ro\'yxatdan o\'tgan</th><th>VIP berilgan</th><th>Admin</th><th>Amallar</th>
          </tr></thead><tbody>
            ${vipUsers.map((u, i) => `
              <tr class="vip-row">
                <td>${i + 1}</td>
                <td><span class="font-bold">${esc(u.username)}</span></td>
                <td><span class="badge ${u.isVip ? 'badge-success' : 'badge-accent'}">${u.isVip ? 'VIP' : 'Oddiy'}</span></td>
                <td class="text-muted" style="font-size:.76rem">${u.created_at ? new Date(u.created_at).toLocaleString('uz-UZ') : '—'}</td>
                <td style="font-size:.76rem">${u.vipGrantedAt ? new Date(u.vipGrantedAt).toLocaleString('uz-UZ') : '—'}</td>
                <td style="font-size:.76rem">${esc(u.vipGrantedBy || '—')}</td>
                <td>
                  <div class="admin-fan-btns" style="gap:4px">
                    ${u.isVip
                      ? `<button type="button" class="dashboard-action-btn dashboard-action-btn--danger" data-dashboard-action="vip-revoke" data-username="${escHtml(u.username)}">${svgIcon('shield', 12)} Olib tashlash</button>`
                      : `<button type="button" class="dashboard-action-btn dashboard-action-btn--secondary" data-dashboard-action="vip-grant" data-username="${escHtml(u.username)}">${svgIcon('shield', 12)} VIP qilish</button>`
                    }
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody></table></div>`;
      } catch(e) {
        wrap.innerHTML = `<div class="admin-empty dashboard-empty--error" role="alert">${escHtml(e?.message || 'VIP foydalanuvchilarini yuklab bo\'lmadi')}</div>`;
      }
    }

    function filterVip() {
      const q = document.getElementById('vip-search').value.toLowerCase();
      document.querySelectorAll('#pane-vip .vip-row').forEach(row => {
        const name = row.querySelector('.font-bold')?.textContent?.toLowerCase() || '';
        row.style.display = name.includes(q) ? '' : 'none';
      });
    }

    function setVipMsg(text, type) {
      const el = document.getElementById('vip-msg');
      // S33.08: status ranglar — err danger, ok info
      const tone = type === 'err' ? 'admin-status--danger' : 'admin-status--info';
      el.textContent = text;
      el.className = 'admin-msg active ' + tone;
    }

    async function grantVip() {
      const username = document.getElementById('vip-username').value.trim();
      if (!username) { setVipMsg('Username kiriting!', 'err'); return; }
      // S33.09: confirmation + pending state
      if (!(await showConfirm('VIP berish', username + ' foydalanuvchisiga VIP huquqi berilsinmi?'))) return;
      const btn = document.getElementById('grant-vip-btn');
      if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.textContent = 'Berilmoqda…'; }
      setVipMsg('VIP berilmoqda...', 'ok');
      document.getElementById('vip-result').style.display = 'none';
      try {
        const res = await fetch('/admin/api/vip/grant', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username })
        });
        const data = await res.json();
        if (data.success) {
          setVipMsg('', '');
          // STYLE S33.03: plain password UI'da ko'rsatilmaydi
          const detail = document.getElementById('vip-result-detail');
          detail.innerHTML = 'Foydalanuvchi: <strong>' + esc(data.username) + '</strong> — VIP huquqi berildi';
          document.getElementById('vip-result').style.display = 'block';
          document.getElementById('vip-username').value = '';
          setTimeout(() => loadVip(), 2000);
        } else {
          setVipMsg('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        setVipMsg('Xato: ' + e.message, 'err');
      } finally {
        if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); btn.innerHTML = '<%- icon('shield', 14) %> VIP qilish'; }
      }
    }

    async function quickGrantVip(username) {
      if (!(await showConfirm('VIP berish', username + ' foydalanuvchisiga VIP berilsinmi?'))) return;
      try {
        const res = await fetch('/admin/api/vip/grant', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username })
        });
        const data = await res.json();
        if (data.success) {
          // STYLE S33.03: parol toast'da ko'rsatilmaydi
          showToast('VIP berildi!', 'ok', 3000);
          if (currentTab === 'vip') { loadVip(); } else { location.reload(); }
        } else {
          showToast('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        showToast('Xato: ' + e.message, 'err');
      }
    }

    async function quickRevokeVip(username) {
      if (!(await showConfirm('VIP olib tashlash', username + ' foydalanuvchisidan VIP huquqini olib tashlashni tasdiqlaysizmi?'))) return;
      try {
        const res = await fetch('/admin/api/vip/revoke', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username })
        });
        const data = await res.json();
        if (data.success) {
          showToast('VIP olib tashlandi', 'ok');
          if (currentTab === 'vip') { loadVip(); } else { location.reload(); }
        } else {
          showToast('Xato: ' + (data.error || ''), 'err');
        }
      } catch(e) {
        showToast('Xato: ' + e.message, 'err');
      }
    }

    const MEDAL_ICONS = ['award', 'award', 'award'];

    async function loadResults() {
      const wrap = document.getElementById('results-wrap');
      try {
        const res = await fetch('/admin/api/results');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Natijalarni yuklash muvaffaqiyatsiz (HTTP ${res.status}).`);
        const results = Array.isArray(data.results) ? data.results : [];
        if (!results.length) {
          wrap.innerHTML = '<div class="admin-empty">Hali o\'yin natijalari yo\'q</div>';
          return;
        }
        wrap.innerHTML = results.map((result) => {
          const code = String(result.code ?? '');
          const codeText = escHtml(code);
          const encodedCode = encodeURIComponent(code);
          const testName = escHtml(result.testName || 'Test');
          const date = result.date ? new Date(result.date).toLocaleString('uz-UZ') : '—';
          const totalPlayers = Number(result.totalPlayers) || 0;
          const leaderboard = Array.isArray(result.leaderboard) ? result.leaderboard : [];
          return `
            <div class="admin-res-card">
              <div class="admin-res-head">
                <div>
                  <div class="admin-res-title">${svgIcon('trophy', 16)} ${testName}</div>
                  <div class="admin-res-meta">${escHtml(date)} &bull; ${totalPlayers} o\'yinchi &bull; Kod: <a href="/arena?code=${encodedCode}&amp;auto=1" target="_blank" rel="noopener noreferrer" class="arena-code-link">${codeText}</a></div>
                </div>
                <button type="button" class="dashboard-icon-btn dashboard-icon-btn--danger" data-dashboard-action="result-delete" data-code="${codeText}" aria-label="${codeText} natijasini o\'chirish" title="O\'chirish">${svgIcon('trash', 12)}</button>
              </div>
              <div class="admin-top3">
                ${leaderboard.slice(0, 3).map((player, index) => `
                  <span class="admin-top-chip"><span class="admin-rank-medal">${svgIcon(MEDAL_ICONS[index] || 'award', 14)} ${escHtml(player.name || '')} — ${Number(player.score) || 0} ball</span></span>
                `).join('')}
              </div>
            </div>`;
        }).join('');
      } catch(e) {
        wrap.innerHTML = `<div class="admin-empty dashboard-empty--error" role="alert">${escHtml(e?.message || 'O\'yin natijalarini yuklab bo\'lmadi')}</div>`;
      }
    }

    async function deleteResult(code) {
      if (!(await showConfirm('O\'chirish', 'Natijani o\'chirishni tasdiqlaysizmi?'))) return;
      try {
        const response = await fetch('/admin/api/results/delete', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.success === false) throw new Error(data.error || `O\'chirish muvaffaqiyatsiz (HTTP ${response.status}).`);
        await loadResults();
      } catch (error) {
        showToast(error?.message || 'Natijani o\'chirib bo\'lmadi.', 'err');
      }
    }

    async function loadStats() {
      const wrap = document.getElementById('stats-content');
      try {
        const res = await fetch('/admin/api/stats');
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || `Statistikani yuklash muvaffaqiyatsiz (HTTP ${res.status}).`);
        wrap.innerHTML = `
          <div class="admin-stats-row">
            <div class="stat-card"><div class="stat-ico">${svgIcon('users', 20)}</div><div><div class="stat-num" >${Number(data.userCount) || 0}</div><div class="stat-lbl">Foydalanuvchilar</div></div></div>
            <div class="stat-card"><div class="stat-ico">${svgIcon('edit', 20)}</div><div><div class="stat-num" >${Number(data.totalTests) || 0}</div><div class="stat-lbl">Testlar</div></div></div>
            <div class="stat-card"><div class="stat-ico">${svgIcon('gamepad', 20)}</div><div><div class="stat-num" >${Number(data.activeGames) || 0}</div><div class="stat-lbl">Faol o'yinlar</div></div></div>
            <div class="stat-card"><div class="stat-ico">${svgIcon('trophy', 20)}</div><div><div class="stat-num">${Number(data.resultsCount) || 0}</div><div class="stat-lbl">Natijalar</div></div></div>
            <div class="stat-card"><div class="stat-ico">${svgIcon('user', 20)}</div><div><div class="stat-num">${Number(data.totalPlayers) || 0}</div><div class="stat-lbl">Jami o'yinchilar</div></div></div>
          </div>
          ${(data.fanStats || []).map(f => `
            <div class="admin-fan-item">
              <div><div class="admin-fan-item-name">${svgIcon('book', 16)} ${escHtml(f.name || '')}</div><div class="admin-fan-item-meta">${Number(f.count) || 0} ta savol</div></div>
            </div>
          `).join('')}
        `;
      } catch(e) {
        wrap.innerHTML = `<div class="admin-empty dashboard-empty--error" role="alert">${escHtml(e?.message || 'Statistikani yuklab bo\'lmadi')}</div>`;
      }
    }

    refreshActiveTab();

    // S18: users jadvali — semantic sortable + search + density
    if (window.DataTable && document.getElementById('users-tbody')) {
      const wrap = document.querySelector('#pane-danger .dt-wrap');
      if (wrap) new window.DataTable(wrap.parentElement, {
        sortable: true, search: true, density: true, key: 'users'
      });
    }
  </script>
</body>
</html>
