      preview.hidden = false;
      const total = preChunks.reduce((sum, chunk) => sum + chunk.questions.length, 0);
      document.getElementById('pre-preview-title').textContent = `${preChunks.length} ta subtest · ${total} ta savol`;
      document.getElementById('pre-chunk-list').innerHTML = preChunks.map((chunk) => `
        <div class="dashboard-subtest-row">
          <span>${escHtml(chunk.name)}</span>
          <span>${chunk.questions.length} ta savol</span>
