    // ── Excel import: one parser and one upload path for both modules ──
    const MAX_EXCEL_BYTES = 10 * 1024 * 1024;
    const MAX_QUESTIONS_PER_FILE = 2000;
    let fanPendingQs = null;
    let preChunks = [];
    let editPreKey = null;

    function setMsg(id, text, type = 'info') {
      const el = document.getElementById(id);
      if (!el) return;
      const tone = type === 'err'
        ? 'admin-status--danger'
        : type === 'warn'
          ? 'admin-status--warn'
          : type === 'ok'
            ? 'dashboard-status--success'
            : 'admin-status--info';
      el.textContent = String(text || '');
      el.className = 'admin-msg active ' + tone;
      el.setAttribute('role', type === 'err' ? 'alert' : 'status');
      el.setAttribute('aria-live', type === 'err' ? 'assertive' : 'polite');
    }

    function setZoneState(kind, state, detail = '') {
      const zone = document.getElementById(`${kind}-drop-zone`);
      const label = document.getElementById(`${kind}-excel-lbl`);
      const status = document.getElementById(`${kind}-excel-status`);
      if (!zone || !label || !status) return;
      zone.dataset.state = state;
      if (state === 'loading') {
        zone.setAttribute('aria-busy', 'true');
        label.textContent = 'Fayl tekshirilmoqda…';
        status.textContent = detail || 'Biroz kuting';
      } else {
        zone.removeAttribute('aria-busy');
        label.textContent = state === 'loaded'
          ? 'Boshqa fayl tanlash yoki almashtirish uchun bosing'
          : 'yoki bosib fayl tanlang';
        status.textContent = detail || (state === 'error' ? 'Faylni qayta tanlang' : 'Fayl tanlanmagan');
      }
    }

    function getXlsx() {
      const lib = window.XLSX;
      if (!lib || typeof lib.read !== 'function' || !lib.utils) {
        throw new Error('Excel moduli yuklanmadi. Sahifani yangilang va qayta urinib ko‘ring.');
      }
      return lib;
    }

    function readFileAsArrayBuffer(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Faylni o‘qib bo‘lmadi. Boshqa XLS/XLSX faylni sinab ko‘ring.'));
        reader.onabort = () => reject(new Error('Faylni o‘qish bekor qilindi.'));
        reader.readAsArrayBuffer(file);
      });
    }

    function normalizeExcelCell(value) {
      return String(value == null ? '' : value)
        .replace(/[\u2018\u2019\u02bb\u02bc`]/g, "'")
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();
    }

    async function readExcelWorkbook(file) {
      if (!file) throw new Error('Excel fayl tanlanmadi.');
      if (!/\.(xlsx|xls)$/i.test(file.name || '')) {
        throw new Error('Faqat .xlsx yoki .xls formatidagi Excel fayl qabul qilinadi.');
      }
      if (file.size > MAX_EXCEL_BYTES) {
        throw new Error('Fayl hajmi 10 MB dan katta. Kichikroq Excel fayl tanlang.');
      }
      const data = await readFileAsArrayBuffer(file);
      const xlsx = getXlsx();
      const workbook = xlsx.read(data, { type: 'array' });
      if (!workbook.SheetNames || !workbook.SheetNames.length) {
        throw new Error('Excel faylda o‘qiladigan varaq topilmadi.');
      }
      return workbook;
    }

    function parseQuestionsFromWB(workbook) {
      const xlsx = getXlsx();
      const firstSheet = workbook?.SheetNames?.[0];
      const sheet = firstSheet && workbook.Sheets?.[firstSheet];
      if (!sheet) throw new Error('Excel faylning birinchi varag‘i bo‘sh yoki buzilgan.');
      const rows = xlsx.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
      const questions = [];
      const letters = ['A', 'B', 'C', 'D'];

      for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {
        const row = Array.isArray(rows[rowIndex]) ? rows[rowIndex] : [];
        const text = String(row[0] ?? '').trim();
        if (!text) continue;

        if (rowIndex === 0) {
          const firstCell = normalizeExcelCell(text);
          const headerCells = row.slice(1, 6).map(normalizeExcelCell);
          const isQuestionHeader = /^(savol|savol matni|question|question text|matn)$/i.test(firstCell);
          const hasOptionHeaders = headerCells.some((cell) => /variant|javob|answer|option|correct|to'g'ri|^[a-d][).:\-]?$/i.test(cell));
          if (isQuestionHeader && hasOptionHeaders) continue;
        }

        const options = row.slice(1, 5).map((value, index) => ({
          text: String(value ?? '').trim(),
          letter: letters[index],
          isCorrect: false,
        })).filter((option) => option.text);
        if (options.length < 2) continue;

        const answerCell = String(row[5] ?? '').trim();
        const normalizedAnswer = normalizeExcelCell(answerCell);
        const letterMatch = answerCell.match(/(?:^|[:=\-]\s*)([A-D])(?=$|[\s).:\-])/i);
        let correctLetter = letterMatch ? letterMatch[1].toUpperCase() : '';
        if (/^[1-4]$/.test(normalizedAnswer)) correctLetter = letters[Number(normalizedAnswer) - 1];
        let correctOption = options.find((option) => option.letter === correctLetter);
        if (!correctOption && normalizedAnswer) {
          correctOption = options.find((option) => normalizeExcelCell(option.text) === normalizedAnswer);
        }
        if (!correctOption && normalizedAnswer) {
          throw new Error(`To‘g‘ri javob ${rowIndex + 1}-qatorda A/B/C/D harfi yoki variant matni bo‘lishi kerak.`);
        }
        if (!correctOption) correctOption = options[0];
        correctOption.isCorrect = true;
        correctLetter = correctOption.letter;
        questions.push({
          num: questions.length + 1,
          text,
          correctLetter,
          correctText: correctOption.text,
          options,
        });
      }

      if (questions.length > MAX_QUESTIONS_PER_FILE) {
        throw new Error(`Bir faylda ${MAX_QUESTIONS_PER_FILE} tadan ko‘p savol yuklab bo‘lmaydi.`);
      }
      return questions;
    }

    function setExcelButtonState(kind, enabled) {
      const button = document.getElementById(kind === 'fan' ? 'save-fan-btn' : 'save-pre-btn');
      if (button) button.disabled = !enabled;
    }

    async function handleExcelFile(kind, file) {
      const messageId = kind === 'fan' ? 'fan-msg' : 'pre-msg';
      if (kind === 'fan') fanPendingQs = null;
      else preChunks = [];
      setExcelButtonState(kind, false);
      setZoneState(kind, 'loading', file?.name || 'Fayl o‘qilmoqda');
      setMsg(messageId, 'Excel fayl tekshirilmoqda…', 'info');

      try {
        const workbook = await readExcelWorkbook(file);
        const questions = parseQuestionsFromWB(workbook);
        if (!questions.length) {
          throw new Error('Savollar topilmadi. Shablondagi ustunlar tartibini tekshiring: Savol, A, B, C, D, to‘g‘ri javob.');
        }

        if (kind === 'fan') {
          fanPendingQs = questions;
          setZoneState('fan', 'loaded', `${file.name} · ${questions.length} ta savol`);
          setExcelButtonState('fan', true);
          setMsg('fan-msg', `${questions.length} ta savol tayyor. Mock fan nomini kiriting va saqlang.`, 'ok');
        } else {
          const chunkSize = 25;
          preChunks = [];
          for (let index = 0; index < questions.length; index += chunkSize) {
            const part = questions.slice(index, index + chunkSize);
            preChunks.push({
              id: `${Date.now().toString(36)}-${index}`,
              name: `Subtest ${preChunks.length + 1}`,
              questions: part,
            });
          }
          setZoneState('pre', 'loaded', `${file.name} · ${questions.length} ta savol`);
          setExcelButtonState('pre', true);
          showPrePreview();
          setMsg('pre-msg', `${questions.length} ta savol ${preChunks.length} ta subtestga ajratildi. Saqlashdan oldin tekshiring.`, 'ok');
        }
      } catch (error) {
        setZoneState(kind, 'error', 'Faylni qayta tanlang');
        setExcelButtonState(kind, false);
        setMsg(messageId, error?.message || 'Excel faylni o‘qib bo‘lmadi.', 'err');
      }
    }

    // Drag/drop and file-picker use the same handler (no DataTransfer assignment required).
    function setupDropZone(zoneId, inputId, kind) {
      const zone = document.getElementById(zoneId);
      const input = document.getElementById(inputId);
      if (!zone || !input) return;
      zone.addEventListener('click', () => {
        input.value = '';
        input.click();
      });
      zone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          input.value = '';
          input.click();
        }
      });
      zone.addEventListener('dragenter', (event) => {
        event.preventDefault();
        zone.classList.add('is-dragover');
      });
      zone.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
        zone.classList.add('is-dragover');
      });
      zone.addEventListener('dragleave', (event) => {
        if (!event.relatedTarget || !zone.contains(event.relatedTarget)) zone.classList.remove('is-dragover');
      });
      zone.addEventListener('drop', (event) => {
        event.preventDefault();
        zone.classList.remove('is-dragover');
        const files = Array.from(event.dataTransfer?.files || []);
        if (!files.length) return;
        if (files.length > 1) {
          if (kind === 'fan') fanPendingQs = null;
          else preChunks = [];
          setExcelButtonState(kind, false);
          setZoneState(kind, 'error', 'Bir vaqtda bitta fayl yuklang');
          if (kind === 'pre') showPrePreview();
          setMsg(kind === 'fan' ? 'fan-msg' : 'pre-msg', 'Bir vaqtda bitta Excel fayl yuklang.', 'warn');
          return;
        }
        handleExcelFile(kind, files[0]);
      });
      input.addEventListener('change', () => {
        const file = input.files?.[0];
        input.value = '';
        if (file) handleExcelFile(kind, file);
      });
    }
    setupDropZone('fan-drop-zone', 'fan-excel-inp', 'fan');
    setupDropZone('pre-drop-zone', 'pre-excel-inp', 'pre');

