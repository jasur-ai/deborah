<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--deborah-semantic-color-border-default);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:''Manrope'',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--deborah-semantic-color-text-primary);}
    .panel{max-width:1180px;margin:0 auto;padding:24px 20px 90px;position:relative;z-index:1;}
    .greeting{font-family:''Manrope'',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;margin-bottom:20px;}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px;}
    @media(max-width:860px){.stats{grid-template-columns:repeat(2,1fr);}}
    .stat{background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:14px;padding:14px 16px;animation:slideDown .3s ease;transition:background .3s,border-color .3s,transform .2s;}
    .stat:hover{transform:translateY(-2px);}
    .stat b{display:block;font-size:1.4rem;font-family:''Manrope'',cursive;}
    .stat span{font-size:.68rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
    .stat.ok b{color:var(--green);}
    .stat.warn b{color:var(--gold);}
    .stat.crit b{color:var(--deborah-semantic-color-action-primary);}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
    @media(max-width:900px){.grid{grid-template-columns:1fr;}}
    .card{background:var(--deborah-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--deborah-semantic-color-border-default);margin-bottom:14px;animation:slideDown .3s ease;transition:background .3s,border-color .3s;}
    .card-h{font-family:''Manrope'',cursive;font-size:.95rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .card-h small{font-family:'Source Sans 3',sans-serif;font-size:.66rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-left:auto;}
    .field{margin-bottom:11px;}
    .field label{display:block;font-size:.72rem;font-weight:700;color:var(--deborah-semantic-color-text-muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
    .inp{width:100%;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:9px 12px;color:var(--deborah-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.82rem;font-weight:600;outline:none;transition:border-color .3s;}
    .inp:focus{border-color:var(--deborah-semantic-color-action-primary);}
    select.inp{appearance:none;-webkit-appearance:none;}
    .btn{border-radius:10px;border:none;padding:10px 16px;cursor:pointer;transition:color .3s ease,background-color .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s ease,opacity .3s ease;font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:.8rem;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),#1d4ed8);color:#fff;display:inline-flex;align-items:center;gap:6px;}
    .btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .btn.ghost{background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);border:1px solid var(--deborah-semantic-color-border-default);}
    .btn.ghost:hover{color:var(--deborah-semantic-color-text-primary);background:var(--bg-elevated);}
    .btn.green{background:linear-gradient(135deg,#00e5a0,#00b37e);color:#04120c;}
    .btn.warn{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#1a1204;}
    .btn.danger{background:linear-gradient(135deg,#f87171,#dc2626);color:#fff;}
    .table{width:100%;border-collapse:collapse;font-size:.76rem;}
    .table th{text-align:left;font-size:.66rem;text-transform:uppercase;letter-spacing:.4px;color:var(--deborah-semantic-color-text-muted);padding:7px 9px;border-bottom:1px solid var(--deborah-semantic-color-border-default);font-weight:700;}
    .table td{padding:8px 9px;border-bottom:1px solid var(--deborah-semantic-color-border-default);color:var(--deborah-semantic-color-text-primary);font-weight:700;}
    .table tr:hover td{background:var(--deborah-semantic-color-surface-input);}
    .chip{display:inline-flex;align-items:center;gap:5px;font-size:.66rem;font-weight:700;border-radius:7px;padding:3px 9px;text-transform:uppercase;letter-spacing:.3px;}
    .chip.sev-critical{background:rgba(248,113,113,.12);color:var(--deborah-semantic-color-action-primary);border:1px solid rgba(248,113,113,.35);}
    .chip.sev-high{background:rgba(251,191,36,.12);color:var(--gold);border:1px solid rgba(251,191,36,.3);}
    .chip.sev-medium{background:rgba(56,189,248,.12);color:var(--cyan,#38bdf8);border:1px solid rgba(56,189,248,.3);}
    .chip.sev-low{background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);}
    .chip.st-open{background:rgba(248,113,113,.12);color:var(--deborah-semantic-color-action-primary);border:1px solid rgba(248,113,113,.35);}
    .chip.st-investigating{background:rgba(251,191,36,.12);color:var(--gold);border:1px solid rgba(251,191,36,.3);}
    .chip.st-mitigated{background:rgba(56,189,248,.12);color:var(--cyan,#38bdf8);border:1px solid rgba(56,189,248,.3);}
    .chip.st-resolved,.chip.st-closed{background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);}
    .chip.ns-pending{background:rgba(251,191,36,.12);color:var(--gold);border:1px solid rgba(251,191,36,.3);}
    .chip.ns-delivered{background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);}
    .chip.ns-failed{background:rgba(248,113,113,.12);color:var(--deborah-semantic-color-action-primary);border:1px solid rgba(248,113,113,.35);}
    .mini-btn{font-size:.68rem;font-weight:700;border-radius:8px;padding:5px 10px;border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;font-family:'Source Sans 3',sans-serif;margin-right:5px;}
    .mini-btn:hover{color:var(--deborah-semantic-color-text-primary);background:var(--bg-elevated);transform:translateY(-1px);}
    .room-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;}
    .room-tile{background:var(--deborah-semantic-color-surface-input);border:1px solid var(--deborah-semantic-color-border-default);border-radius:12px;padding:11px 13px;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;}
    .room-tile:hover{transform:translateY(-2px);border-color:var(--deborah-semantic-color-action-primary);}
    .room-tile b{display:block;font-size:.82rem;}
    .room-tile span{font-size:.66rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;}
    .room-tile .rt-check{color:var(--green);font-weight:700;font-size:.7rem;}
    .room-tile .rt-warn{color:var(--gold);font-weight:700;font-size:.7rem;}
    .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:12px;padding:11px 18px;font-size:.8rem;font-weight:600;z-index:999;opacity:0;pointer-events:none;transition:color .35s ease,background-color .35s ease,border-color .35s ease,box-shadow .35s ease,transform .35s ease,opacity .35s ease;box-shadow:var(--shadow-lg);}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .empty{text-align:center;padding:24px;color:var(--deborah-semantic-color-text-muted);font-weight:700;font-size:.78rem;background:var(--deborah-semantic-color-surface-input);border-radius:12px;border:1px dashed var(--deborah-semantic-color-border-default);}
    .loading{text-align:center;padding:26px;color:var(--deborah-semantic-color-text-muted);font-weight:600;font-size:.8rem;}
    .kv{display:flex;justify-content:space-between;font-size:.72rem;font-weight:700;color:var(--deborah-semantic-color-text-muted);padding:4px 0;border-bottom:1px dashed var(--deborah-semantic-color-border-default);}
    .kv b{color:var(--deborah-semantic-color-text-primary);font-weight:700;}
    .tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
    .tab{padding:7px 14px;border-radius:9px;font-size:.74rem;font-weight:700;cursor:pointer;background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);border:1px solid var(--deborah-semantic-color-border-default);transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;font-family:'Source Sans 3',sans-serif;}
    .tab.active{background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),#1d4ed8);color:#fff;border-color:transparent;}
    .tab-view{display:none;}
    .tab-view.active{display:block;animation:slideDown .25s ease;}
    .mono{font-family:monospace;font-size:.7rem;color:var(--deborah-semantic-color-text-muted);background:var(--deborah-semantic-color-surface-default);border:1px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:10px;white-space:pre-wrap;overflow:auto;max-height:200px;line-height:1.6;}
    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px;}
    .modal-overlay.show{display:flex;}
    .modal{background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:16px;padding:20px;width:100%;max-width:380px;box-shadow:var(--shadow-lg);animation:slideDown .25s ease;}
    .modal h3{font-family:''Manrope'',cursive;font-size:1rem;margin:0 0 6px;}
    .modal p{font-size:.74rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;margin:0 0 12px;}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo">Deborah</a>
    <div class="nav-right">
      <a href="/admin/dashboard" class="nav-btn">Panel</a>
      <a href="/admin/logout" class="nav-btn">Chiqish</a>
    </div>
  </nav>

  <div class="panel">
    <div class="greeting">Imtihon boshqaruv markazi</div>
    <div class="greeting-sub">Exam-day health, attendance va incidentlar — yagona auditable markaz (Prompt 41)</div>

    <!-- Snapshot stats -->
    <div class="stats" id="stats">
      <div class="stat"><span>Xonalar</span><b id="s-rooms">—</b></div>
      <div class="stat"><span>Kelganlar</span><b id="s-checked">—</b></div>
      <div class="stat warn"><span>Kutilayotgan</span><b id="s-expected">—</b></div>
      <div class="stat crit"><span>Ochiq incident</span><b id="s-open">—</b></div>
    </div>

    <div class="tabs" id="tabs">
      <div class="tab active" data-tab="rooms">Xonalar</div>
      <div class="tab" data-tab="incidents">Incidentlar</div>
      <div class="tab" data-tab="notifications">Bildirishnomalar</div>
      <div class="tab" data-tab="postmortems">Postmortem</div>
    </div>

    <!-- Rooms view -->
    <div class="tab-view active" id="view-rooms">
      <div class="card">
        <div class="card-h">Xona holati <small>jonli snapshot</small></div>
        <div class="room-grid" id="roomGrid"><div class="loading">Yuklanmoqda...</div></div>
      </div>
    </div>

    <!-- Incidents view -->
    <div class="tab-view" id="view-incidents">
      <div class="grid">
        <div class="card">
          <div class="card-h">Yangi incident yaratish</div>
          <div class="field"><label>Tur</label><select class="inp" id="inc-type"></select></div>
          <div class="field"><label>Jiddiylik</label><select class="inp" id="inc-severity"></select></div>
          <div class="field"><label>Xulosa</label><input class="inp" id="inc-summary" placeholder="Qisqa tavsif (3–500)" /></div>
          <div class="field"><label>Xona ID</label><input class="inp" id="inc-room" type="number" placeholder="ixtiyoriy" /></div>
          <div class="field"><label>Owner user ID</label><input class="inp" id="inc-owner" type="number" placeholder="ixtiyoriy" /></div>
          <div class="field"><label>external_key (idempotency)</label><input class="inp" id="inc-extkey" placeholder="ixtiyoriy — takroriy yaratishni bloklaydi" /></div>
          <button class="btn" id="btn-create-incident">Yaratish</button>
        </div>
        <div class="card">
          <div class="card-h">Incidentlar ro'yxati <small id="incCount"></small></div>
          <div id="incidentList"><div class="loading">Yuklanmoqda...</div></div>
        </div>
      </div>
    </div>

    <!-- Notifications view -->
    <div class="tab-view" id="view-notifications">
      <div class="grid">
        <div class="card">
          <div class="card-h">Ommaviy bildirishnoma</div>
          <div class="field"><label>Kanal</label><select class="inp" id="notif-channel"></select></div>
          <div class="field"><label>Qamrov</label><select class="inp" id="notif-scope"></select></div>
          <div class="field"><label>Template</label><select class="inp" id="notif-template"></select></div>
          <div class="field"><label>batchKey (idempotency)</label><input class="inp" id="notif-batch" placeholder="masalan evac:run12:roomB204" /></div>
          <div class="field"><label>Eski jadvalni bekor qilish</label>
            <label style="display:flex;gap:8px;align-items:center;font-size:.74rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);">
              <input type="checkbox" id="notif-supersede" style="accent-color:var(--deborah-semantic-color-action-primary);" /> supersedeOld
            </label>
          </div>
          <button class="btn" id="btn-queue-notif">Navbatga qo'shish</button>
        </div>
        <div class="card">
          <div class="card-h">Outbox <small>sanitized preview</small></div>
          <div id="notifList"><div class="loading">Yuklanmoqda...</div></div>
        </div>
      </div>
    </div>

    <!-- Postmortem view -->
    <div class="tab-view" id="view-postmortems">
      <div class="grid">
        <div class="card">
          <div class="card-h">Postmortem yaratish</div>
          <div class="field"><label>Incident ID</label><input class="inp" id="pm-incident" type="number" /></div>
          <div class="field"><label>Xulosa</label><input class="inp" id="pm-summary" /></div>
          <div class="field"><label>Asosiy sabab</label><input class="inp" id="pm-root" /></div>
          <button class="btn" id="btn-create-pm">Yaratish</button>
        </div>
        <div class="card">
          <div class="card-h">Action item qo'shish</div>
          <div class="field"><label>Postmortem ID</label><input class="inp" id="ai-pm" type="number" /></div>
          <div class="field"><label>Tavsif</label><input class="inp" id="ai-desc" /></div>
          <button class="btn" id="btn-add-ai">Qo'shish</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <!-- Inline modal (no browser prompt/alert — project guideline) -->
  <div class="modal-overlay" id="closeModal">
    <div class="modal">
      <h3>Incidentni yopish</h3>
      <p>Yopish sababi majburiy (owner + action + reason kerak).</p>
      <div class="field"><label>Sabab</label><input class="inp" id="closeReason" placeholder="masalan: tarmoq tiklandi, talabalar ko'chirildi" /></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="btn ghost" id="btn-close-cancel">Bekor qilish</button>
        <button class="btn" id="btn-close-confirm">Yopish</button>
      </div>
    </div>
  </div>

  <script>
    const CSRF = window.__CSRF_TOKEN || '';
    const $ = (id) => document.getElementById(id);

    function toast(msg, ok = true) {
      const t = $('toast');
      t.textContent = msg;
      t.style.background = ok ? 'var(--deborah-semantic-color-surface-raised)' : 'linear-gradient(135deg,#f87171,#dc2626)';
      t.style.color = ok ? 'var(--deborah-semantic-color-text-primary)' : '#fff';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2600);
    }

    async function api(path, opts = {}) {
      const headers = { 'Content-Type': 'application/json' };
      if (CSRF) headers['x-csrf-token'] = CSRF;
      const r = await fetch(path, { ...opts, headers });
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
      return data;
    }

    const META = {};

    async function loadMeta() {
      const d = await api('/api/admin/command-center/meta');
      Object.assign(META, d);
      fillSelect('inc-type', d.incidentTypes);
      fillSelect('inc-severity', d.incidentSeverities);
      fillSelect('notif-channel', d.notificationChannels);
      fillSelect('notif-scope', d.recipientScopes);
      fillSelect('notif-template', d.templates);
    }

    function fillSelect(id, items) {
      const el = $(id);
      el.innerHTML = items.map((x) => `<option value="${x}">${x}</option>`).join('');
    }

    function chip(text, cls) {
      return `<span class="chip ${cls}">${text}</span>`;
    }

    async function loadSnapshot() {
      try {
        const d = await api('/api/admin/command-center/snapshot');
        const s = d.snapshot || {};
        $('s-rooms').textContent = (s.rooms || []).length;
        $('s-checked').textContent = s.attendance ? s.attendance.checkedIn : 0;
        $('s-expected').textContent = s.attendance ? s.attendance.expected : 0;
        $('s-open').textContent = (s.openIncidents || []).length;
        renderRooms(s.rooms || []);
      } catch (e) {
        $('roomGrid').innerHTML = `<div class="empty">${e.message}</div>`;
      }
    }

    function renderRooms(rooms) {
      if (!rooms.length) {
        $('roomGrid').innerHTML = `<div class="empty">Xonalar topilmadi (PostgreSQL kerak)</div>`;
        return;
      }
      $('roomGrid').innerHTML = rooms.map((r) => `
        <div class="room-tile">
          <b>${r.roomName || ('Xona #' + r.roomId)}</b>
          <span>${r.building || ''} · sig'imi ${r.capacity}</span><br>
          <span class="${r.ready ? 'rt-check' : 'rt-warn'}">
            ${r.ready ? 'TAYYOR' : 'DIQQAT'} · ${r.checkedIn}/${r.expected} keldi
          </span><br>
          <span>incident: ${r.openIncidents}</span>
        </div>`).join('');
    }

    async function loadIncidents() {
      try {
        const d = await api('/api/admin/incidents');
        const list = d.incidents || [];
        $('incCount').textContent = list.length + ' ta';
        if (!list.length) {
          $('incidentList').innerHTML = `<div class="empty">Incident yo'q</div>`;
          return;
        }
        $('incidentList').innerHTML = list.map((i) => `
          <div class="card" style="margin-bottom:10px;padding:12px;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:6px;">
              ${chip(i.severity, 'sev-' + i.severity)}
              ${chip(i.status, 'st-' + i.status)}
              <span style="font-size:.7rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;">#${i.id} · ${i.type}</span>
            </div>
            <div style="font-size:.8rem;font-weight:600;margin-bottom:4px;">${i.summary}</div>
            <div class="kv"><span>Xona</span><b>${i.room_id || '—'}</b></div>
            <div class="kv"><span>Owner</span><b>${i.owner_user_id || 'Tayinlanmagan'}</b></div>
            <div class="kv"><span>Ta'sirlanganlar</span><b>${i.affected_candidate_ids ? i.affected_candidate_ids.length : 0}</b></div>
            <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;">
              <button class="mini-btn" onclick="transitionInc(${i.id},'investigating')">Tekshiruv</button>
              <button class="mini-btn" onclick="transitionInc(${i.id},'mitigated')">Yumshatildi</button>
              <button class="mini-btn" onclick="transitionInc(${i.id},'resolved')">Hal qilindi</button>
              <button class="mini-btn" onclick="closeInc(${i.id})">Yopish</button>
            </div>
          </div>`).join('');
      } catch (e) {
        $('incidentList').innerHTML = `<div class="empty">${e.message}</div>`;
      }
    }

    async function transitionInc(id, to) {
      try {
        await api('/api/admin/incidents/' + id + '/transition', {
          method: 'POST',
          body: JSON.stringify({ to, reason: 'operator action' }),
        });
        toast('Holat o\'zgardi → ' + to);
        loadIncidents();
        loadSnapshot();
      } catch (e) { toast(e.message, false); }
    }

    let pendingCloseId = null;

    function openCloseModal(id) {
      pendingCloseId = id;
      $('closeReason').value = '';
      $('closeModal').classList.add('show');
      setTimeout(() => $('closeReason').focus(), 50);
    }

    $('btn-close-cancel').addEventListener('click', () => {
      $('closeModal').classList.remove('show');
      pendingCloseId = null;
    });

    $('btn-close-confirm').addEventListener('click', async () => {
      const reason = $('closeReason').value.trim();
      if (!reason) { toast('Sabab kiritilmadi', false); return; }
      try {
        await api('/api/admin/incidents/' + pendingCloseId + '/transition', {
          method: 'POST',
          body: JSON.stringify({ to: 'closed', reason }),
        });
        $('closeModal').classList.remove('show');
        pendingCloseId = null;
        toast('Incident yopildi');
        loadIncidents();
        loadSnapshot();
      } catch (e) { toast(e.message, false); }
    });

    async function closeInc(id) {
      openCloseModal(id);
    }

    async function loadNotifications() {
      try {
        const d = await api('/api/admin/notifications');
        const list = d.notifications || [];
        if (!list.length) {
          $('notifList').innerHTML = `<div class="empty">Bildirishnomalar yo'q</div>`;
          return;
        }
        $('notifList').innerHTML = list.map((n) => `
          <div class="card" style="margin-bottom:10px;padding:12px;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:6px;">
              ${chip(n.channel, 'ns-' + n.channel)}
              ${chip(n.status, 'ns-' + n.status)}
              <span style="font-size:.7rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;">${n.template_key} · ${n.recipient_scope}</span>
            </div>
            <div class="mono">${JSON.stringify(n.payload || {}, null, 2)}</div>
            <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;">
              <button class="mini-btn" onclick="setNotifStatus(${n.id},'sent')">Yuborildi</button>
              <button class="mini-btn" onclick="setNotifStatus(${n.id},'delivered')">Yetkazildi</button>
              <button class="mini-btn" onclick="setNotifStatus(${n.id},'failed')">Muvaffaqiyatsiz</button>
            </div>
          </div>`).join('');
      } catch (e) {
        $('notifList').innerHTML = `<div class="empty">${e.message}</div>`;
      }
    }

    async function setNotifStatus(id, status) {
      try {
        await api('/api/admin/notifications/' + id + '/status', {
          method: 'POST',
          body: JSON.stringify({ status }),
        });
        toast('Status → ' + status);
        loadNotifications();
      } catch (e) { toast(e.message, false); }
    }

    // ── Event bindings ──
    document.querySelectorAll('#tabs .tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#tabs .tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        document.querySelectorAll('.tab-view').forEach((v) => v.classList.remove('active'));
        $('view-' + tab.dataset.tab).classList.add('active');
        if (tab.dataset.tab === 'incidents') loadIncidents();
        if (tab.dataset.tab === 'notifications') loadNotifications();
      });
    });

    $('btn-create-incident').addEventListener('click', async () => {
      try {
        await api('/api/admin/incidents', {
          method: 'POST',
          body: JSON.stringify({
            type: $('inc-type').value,
            severity: $('inc-severity').value,
            summary: $('inc-summary').value,
            room_id: $('inc-room').value ? Number($('inc-room').value) : null,
            owner_user_id: $('inc-owner').value ? Number($('inc-owner').value) : null,
            external_key: $('inc-extkey').value || null,
          }),
        });
        toast('Incident yaratildi');
        $('inc-summary').value = '';
        loadIncidents();
        loadSnapshot();
      } catch (e) { toast(e.message, false); }
    });

    $('btn-queue-notif').addEventListener('click', async () => {
      try {
        const r = await api('/api/admin/notifications', {
          method: 'POST',
          body: JSON.stringify({
            channel: $('notif-channel').value,
            recipientScope: $('notif-scope').value,
            templateKey: $('notif-template').value,
            batchKey: $('notif-batch').value,
            payload: { room_name: 'B204', period_name: '09:00', candidate_count: 25 },
            supersedeOld: $('notif-supersede').checked,
          }),
        });
        toast(`Navbatga qo'shildi: ${r.inserted} yangi, ${r.duplicates} dublikat, ${r.superseded} supersede`);
        loadNotifications();
      } catch (e) { toast(e.message, false); }
    });

    $('btn-create-pm').addEventListener('click', async () => {
      try {
        await api('/api/admin/postmortems', {
          method: 'POST',
          body: JSON.stringify({
            incident_id: Number($('pm-incident').value),
            summary: $('pm-summary').value,
            root_cause: $('pm-root').value,
          }),
        });
        toast('Postmortem yaratildi');
      } catch (e) { toast(e.message, false); }
    });

    $('btn-add-ai').addEventListener('click', async () => {
      try {
        await api('/api/admin/action-items', {
          method: 'POST',
          body: JSON.stringify({
            postmortem_id: Number($('ai-pm').value),
            description: $('ai-desc').value,
          }),
        });
        toast('Action item qo\'shildi');
        $('ai-desc').value = '';
      } catch (e) { toast(e.message, false); }
    });

    // ── Init ──
    (async () => {
      try {
        await loadMeta();
        await loadSnapshot();
        await loadIncidents();
        await loadNotifications();
      } catch (e) {
        console.error(e);
      }
    })();
  </script>
</body>
</html>
