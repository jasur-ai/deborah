<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <a href="#main" class="skip-link">Skip to content →</a>
  <nav class="admin-navbar">
    <div class="admin-nav-left">
      <button type="button" class="admin-nav-hamburger" aria-label="Menyu" aria-expanded="false" aria-controls="admin-sidebar" onclick="toggleAdminDrawer()"><span></span><span></span><span></span></button>
      <a href="/" class="admin-nav-brand">
        <span class="admin-nav-logo"><img src="/images/logo-icon.svg" alt="Edikit" class="logo-img" style="height:28px;width:auto"></span>
        <span class="admin-nav-badge">ADMIN</span>
      </a>
    </div>
    <div class="flex items-center gap-8">
      <a href="/admin/dashboard" class="admin-nav-btn"><%- icon('arrowLeft', 14) %> Dashboard</a>
      <%- include('../partials/theme-control') %>
      <a href="/admin/logout" class="admin-nav-btn"><%- icon('logOut', 14) %> Chiqish</a>
    </div>
  </nav>

  <div class="admin-layout">
    <div class="admin-drawer-overlay" id="admin-drawer-overlay" onclick="toggleAdminDrawer()"></div>
    <div class="admin-sidebar" id="admin-sidebar">
      <div class="admin-side-label">Bo'limlar</div>
      <a href="/admin/users" class="admin-side-btn"><span class="admin-side-ico"><%- icon('users', 16) %></span>Foydalanuvchilar</a>
      <a href="/admin/audit" class="admin-side-btn"><span class="admin-side-ico"><%- icon('shield', 16) %></span>Audit jurnali</a>
      <a href="/admin/email-cost" class="admin-side-btn active" style="--c:var(--edikit-semantic-color-action-primary);--cbg:rgba(37,99,235,.14)"><span class="admin-side-ico"><%- icon('mail', 16) %></span>Email xarajat</a>
      <a href="/admin/dashboard#pane-fans" class="admin-side-btn"><span class="admin-side-ico"><%- icon('book', 16) %></span>Mock Fanlar</a>
      <a href="/admin/dashboard#pane-pre" class="admin-side-btn" style="--c:var(--accent-glow);--cbg:rgba(100,116,139,.14)"><span class="admin-side-ico"><%- icon('layers', 16) %></span>PRE Testlar</a>
      <a href="/admin/dashboard#pane-results" class="admin-side-btn"><span class="admin-side-ico"><%- icon('trophy', 16) %></span>Natijalar</a>
      <a href="/admin/vip" class="admin-side-btn" style="--c:#f59e0b;--cbg:rgba(245,158,11,.14)"><span class="admin-side-ico"><%- icon('shield', 16) %></span>VIP</a>
    </div>

    <main class="admin-main" id="main">
      <div class="admin-page-head">
        <div>
          <h1 class="admin-page-title"><%- icon('mail', 20) %> Email xarajat</h1>
          <p class="admin-page-sub">Provider failover xarajati + oylik budget nazorati (AUTH D-32 §25-§27)</p>
        </div>
      </div>

      <!-- Stat kartalar -->
      <div class="admin-stat-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px">
        <div class="stat-card"><div class="stat-num">$<%= (monthCost || 0).toFixed(2) %></div><div class="stat-lbl">Joriy oy (<%= month %>)</div></div>
        <div class="stat-card"><div class="stat-num">$<%= (totalCost || 0).toFixed(2) %></div><div class="stat-lbl">Jami xarajat</div></div>
        <div class="stat-card"><div class="stat-num"><%= totalCount || 0 %></div><div class="stat-lbl">Jami email</div></div>
        <div class="stat-card"><div class="stat-num"><%= budget > 0 ? '$' + budget.toFixed(2) : 'Cheklanmagan' %></div><div class="stat-lbl">Oylik budget</div></div>
        <div class="stat-card" style="<%= level === 'exceeded' ? 'background:rgba(220,38,38,.12)' : level === 'warn' ? 'background:rgba(245,158,11,.12)' : '' %>">
          <div class="stat-num" style="<%= level === 'exceeded' ? 'color:#dc2626' : level === 'warn' ? 'color:#d97706' : 'color:#16a34a' %>"><%= overBudget ? '⚠ Limit oshdi' : level === 'warn' ? '⚠ Eslatma' : 'OK' %></div>
          <div class="stat-lbl">Budget holati (<%= pct %>%)</div>
        </div>
      </div>

      <% if (budgetMsg === 'saved') { %>
        <div style="background:rgba(22,163,74,.1);border:1px solid #16a34a33;color:#15803d;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px">✓ Budget saqlandi (kuchga kirdi)</div>
      <% } else if (budgetMsg === 'invalid') { %>
        <div style="background:rgba(220,38,38,.1);border:1px solid #dc262633;color:#b91c1c;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px">✗ Qiymat noto'g'ri — 1..100000 USD oralig'ida kiriting</div>
      <% } %>

      <% if (level === 'warn' || level === 'exceeded') { %>
        <div style="background:<%= level === 'exceeded' ? 'rgba(220,38,38,.1)' : 'rgba(245,158,11,.12)' %>;border:1px solid <%= level === 'exceeded' ? '#dc262633' : '#f59e0b44' %>;color:<%= level === 'exceeded' ? '#b91c1c' : '#92400e' %>;padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
          <span><strong><%= level === 'exceeded' ? '⚠ Oylik budget limiti oshdi' : '⚠ Oylik budget 80% ga yaqinlashdi' %></strong> — joriy oy $<%= monthCost.toFixed(2) %> / $<%= budget.toFixed(2) %> (<%= pct %>%). Audit'da <code>email:budget:alert</code> qayd etildi.</span>
          <a href="/admin/email-cost/report.csv" class="admin-btn" style="padding:6px 12px;font-size:12px;border-radius:8px;background:var(--accent-glow,#2563eb);color:#fff;text-decoration:none">⬇ CSV hisobot</a>
        </div>
      <% } %>

      <!-- Budget config (E-07) -->
      <div class="admin-card" style="border:1px solid var(--border,#e2e8f0);border-radius:12px;padding:16px;background:var(--card-bg,#fff);margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px">
          <h2 style="font-size:15px;margin:0">Oylik budget sozlash</h2>
          <span style="font-size:12px;color:var(--muted,#64748b)">Manba: <%= budgetSource === 'db' ? 'Admin panel (DB)' : 'Env (default)' %></span>
        </div>
        <form method="POST" action="/admin/email-cost/budget" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="number" name="amount" min="1" max="100000" step="0.01" required value="<%= budget > 0 ? budget : '' %>"
                 placeholder="Masalan: 50" style="padding:8px 12px;border:1px solid var(--border,#e2e8f0);border-radius:8px;font-size:14px;max-width:180px">
          <span style="font-size:13px;color:var(--muted,#64748b)">USD / oy</span>
          <button type="submit" class="admin-btn" style="padding:8px 16px;border-radius:8px;background:var(--accent-glow,#2563eb);color:#fff;border:none;font-size:13px;cursor:pointer">Saqlash</button>
          <a href="/admin/email-cost/report.csv" class="admin-btn" style="padding:8px 16px;border-radius:8px;background:var(--border,#e2e8f0);color:var(--text,#0f172a);text-decoration:none;font-size:13px">⬇ CSV hisobot</a>
        </form>
        <p style="font-size:12px;color:var(--muted,#64748b);margin:8px 0 0">80% da <code>email:budget:alert</code> (warn), 100% da <code>exceeded</code> — oyiga bir martadan (idempotent). CSV barcha oylarni qamraydi.</p>
      </div>

      <!-- Jadval -->
      <div class="admin-card" style="border:1px solid var(--border,#e2e8f0);border-radius:12px;padding:16px;background:var(--card-bg,#fff)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <h2 style="font-size:15px;margin:0">Xarajat tarixi</h2>
          <span style="font-size:12px;color:var(--muted,#64748b)"><%= rows.length %> yozuv</span>
        </div>
        <% if (rows.length === 0) { %>
          <p style="color:var(--muted,#64748b);font-size:13px">Hali xarajat yozuvlari yo'q — email yuborilgach <code>email_cost/{YYYY-MM}/{provider}</code> da to'planadi.</p>
        <% } else { %>
          <div style="overflow-x:auto">
            <table class="admin-table" style="width:100%;border-collapse:collapse;font-size:13px">
              <thead>
                <tr style="text-align:left;border-bottom:2px solid var(--border,#e2e8f0)">
                  <th style="padding:8px 10px">Oy</th>
                  <th style="padding:8px 10px">Provider</th>
                  <th style="padding:8px 10px;text-align:right">Count</th>
                  <th style="padding:8px 10px;text-align:right">Xarajat ($)</th>
                  <th style="padding:8px 10px;text-align:right">So'nggi yangilanish</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (r) { %>
                  <tr style="border-bottom:1px solid var(--border,#eef2f7)">
                    <td style="padding:8px 10px"><%= r.month %></td>
                    <td style="padding:8px 10px"><code><%= r.provider %></code></td>
                    <td style="padding:8px 10px;text-align:right"><%= r.count %></td>
                    <td style="padding:8px 10px;text-align:right">$<%= r.cost.toFixed(2) %></td>
                    <td style="padding:8px 10px;text-align:right"><%= r.updatedAt ? new Date(r.updatedAt).toLocaleString('uz-UZ') : '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <script>
    window.__ADMIN_COPY__ = <%- JSON.stringify(adminCopy || {}) %>;
  </script>
  <script src="/js/admin/common.js"></script>
</body>
</html>
