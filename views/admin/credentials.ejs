<% const current = user || {}; %>
<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="adm-body">
  <div class="adm-shell">
    <aside class="adm-sidebar">
      <div class="adm-brand">
        <img src="/images/logo-icon.svg" alt="Deborah" class="logo-img" style="height:28px;width:auto">
        <span>Deborah</span>
      </div>
      <nav class="adm-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/ai-checkpoint">AI Checkpoint</a>
        <a href="/admin/credentials" class="active">Credentials</a>
        <a href="/admin/vip">VIP</a>
      </nav>
      <div class="adm-side-foot">
        <a href="/admin/logout">Chiqish</a>
      </div>
    </aside>

    <main class="adm-main">
      <header class="adm-topbar">
        <h1>Verifiable Credentials</h1>
        <span class="adm-chip" id="statusChip">Tayyor</span>
      </header>

      <section class="adm-card">
        <h2>Credential Definition yaratish</h2>
        <p class="adm-hint">Issuer authority + criteria (competency, required evidence, min grade, expiry). Definition PUBLISHED bo'lgandagina issue mumkin (issuer authorization guard).</p>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Nomi</label><input class="input" id="fName" placeholder="Masalan: DTM Matematika — Imtiyozli sertifikat"></div>
            <div class="field"><label>Version</label><input class="input" id="fVersion" value="v1" style="width:90px"></div>
            <div class="field"><label>Issuer authority</label><input class="input" id="fIssuer" value="admin" style="width:120px"></div>
          </div>
          <div class="adm-row">
            <div class="field"><label>Min grade (scaled)</label><input class="input" id="fMinGrade" type="number" value="7000" style="width:130px"></div>
            <div class="field"><label>Expiry (kun)</label><input class="input" id="fExpiry" type="number" value="365" style="width:100px"></div>
            <div class="field"><label>Competency IDs (vergul bilan)</label><input class="input" id="fComps" placeholder="1,2,3" style="width:220px"></div>
            <div class="field"><label>Required evidence kinds</label><input class="input" id="fEvid" placeholder="final,reflection" style="width:220px"></div>
          </div>
          <div class="adm-row">
            <button class="btn btn-primary" id="btnCreateDef">Yaratish</button>
            <span class="adm-hint" id="defHint"></span>
          </div>
        </div>
      </section>

      <section class="adm-card">
        <h2>Definitions</h2>
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead><tr><th>ID</th><th>Nomi</th><th>Version</th><th>Status</th><th>Issuer</th><th></th></tr></thead>
            <tbody id="defsBody"><tr><td colspan="6" class="adm-muted">Yuklanmoqda…</td></tr></tbody>
          </table>
        </div>
      </section>

      <section class="adm-card">
        <h2>Credential issue</h2>
        <p class="adm-hint">LLM hech qachon credential bermaydi — faqat ratified evidence + teacher/admin sign-off. Idempotent: bir xil evidence qayta issue bo'lmaydi.</p>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Definition ID</label><input class="input" id="fDefId" type="number" style="width:100px"></div>
            <div class="field"><label>User ID</label><input class="input" id="fUserId" type="number" style="width:100px"></div>
            <div class="field"><label>Recipient (email)</label><input class="input" id="fRecipient" style="width:220px"></div>
            <div class="field"><label>Grade (scaled)</label><input class="input" id="fGrade" type="number" value="8000" style="width:110px"></div>
          </div>
          <div class="adm-row">
            <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="fRatified" checked> Evidence ratified</label>
            <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="fApproved" checked> Teacher approved</label>
            <button class="btn btn-primary" id="btnIssue">Issue</button>
            <span class="adm-hint" id="issueHint"></span>
          </div>
        </div>
      </section>

      <section class="adm-card">
        <h2>Revoke / Renew</h2>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Credential ID</label><input class="input" id="fCredId" type="number" style="width:100px"></div>
            <div class="field"><label>Sabab</label><input class="input" id="fReason" style="width:260px" placeholder="Revoke sababi"></div>
            <button class="btn btn-danger" id="btnRevoke">Revoke</button>
            <button class="btn" id="btnRenew">Renew</button>
            <span class="adm-hint" id="credHint"></span>
          </div>
        </div>
      </section>
    </main>
  </div>

<script>
(function () {
  const CSRF = '<%= csrfToken || "" %>';
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  async function api(path, opts = {}) {
    const res = await fetch(path, {
      method: opts.method || 'GET',
      headers: { 'content-type': 'application/json', 'x-csrf-token': CSRF },
      body: opts.body ? JSON.stringify(opts.body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
    return data;
  }

  async function loadDefs() {
    try {
      const { definitions } = await api('/api/admin/credential-definitions');
      $('defsBody').innerHTML = (definitions || []).map((d) => `
        <tr>
          <td>#${d.id}</td>
          <td>${esc(d.name)}</td>
          <td>${esc(d.version)}</td>
          <td><span class="chip chip-${d.status === 'published' ? 'ok' : 'warn'}">${esc(d.status)}</span></td>
          <td>${esc(d.issuer_authority || '')}</td>
          <td>${d.status === 'draft'
            ? '<button class="btn btn-sm" onclick="pubDef(' + d.id + ')">Publish</button>'
            : '<span class="adm-muted">—</span>'}</td>
        </tr>`).join('') || '<tr><td colspan="6" class="adm-muted">Definition yo\'q</td></tr>';
    } catch (e) { $('defsBody').innerHTML = '<tr><td colspan="6" class="adm-muted">' + esc(e.message) + '</td></tr>'; }
  }

  window.pubDef = async function (id) {
    try { await api('/api/admin/credential-definitions/' + id + '/publish', { method: 'POST' }); loadDefs(); }
    catch (e) { alert(e.message); }
  };

  $('btnCreateDef').addEventListener('click', async () => {
    try {
      const comps = $('fComps').value.split(',').map((s) => Number(s.trim())).filter((n) => Number.isFinite(n));
      const kinds = $('fEvid').value.split(',').map((s) => s.trim()).filter(Boolean);
      const r = await api('/api/admin/credential-definitions', {
        method: 'POST',
        body: {
          name: $('fName').value,
          version: $('fVersion').value,
          issuerAuthority: $('fIssuer').value,
          criteria: {
            competencyIds: comps,
            requiredEvidenceKinds: kinds,
            minGradeScaled: Number($('fMinGrade').value) || 0,
            expiresInDays: Number($('fExpiry').value) || 0,
            description: $('fName').value,
          },
        },
      });
      $('defHint').textContent = 'Yaratildi #' + r.definitionId + ' — endi Publish qiling';
      loadDefs();
    } catch (e) { $('defHint').textContent = '✗ ' + e.message; }
  });

  $('btnIssue').addEventListener('click', async () => {
    $('issueHint').textContent = '';
    try {
      const r = await api('/api/admin/credentials/issue', {
        method: 'POST',
        body: {
          definitionId: Number($('fDefId').value),
          userId: Number($('fUserId').value),
          recipient: $('fRecipient').value,
          evidence: {
            competencyIds: [],
            ratifiedKinds: ['final', 'reflection'],
            gradeScaled: Number($('fGrade').value) || 0,
          },
          evidenceRatified: $('fRatified').checked,
          teacherApproved: $('fApproved').checked,
        },
      });
      $('issueHint').textContent = (r.cached ? 'Cached — ' : 'Issued — ') + 'digest ' + String(r.credential && r.credential.vcDigest ? r.credential.vcDigest : '').slice(0, 16) + '…';
    } catch (e) { $('issueHint').textContent = '✗ ' + e.message; }
  });

  $('btnRevoke').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/credentials/' + Number($('fCredId').value) + '/revoke', { method: 'POST', body: { reason: $('fReason').value } });
      $('credHint').textContent = 'Revoked ✓';
    } catch (e) { $('credHint').textContent = '✗ ' + e.message; }
  });

  $('btnRenew').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/credentials/' + Number($('fCredId').value) + '/renew', {
        method: 'POST',
        body: { criteria: { expiresInDays: 365 }, evidence: { ratifiedKinds: ['final', 'reflection'], gradeScaled: 8000 } },
      });
      $('credHint').textContent = 'Renewed ✓';
    } catch (e) { $('credHint').textContent = '✗ ' + e.message; }
  });

  loadDefs();
})();
</script>
</body>
</html>
