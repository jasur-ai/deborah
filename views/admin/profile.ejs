<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah Admin</title>
  <link rel="stylesheet" href="/css/admin.css?v=nv4">
  <style>
    /* ═══ S34e — PROFIL KOMANDA MARKAZI (neon texnik) ═══ */
    body{background:
      radial-gradient(1100px 520px at 12% -8%, rgba(34,211,238,.10), transparent 60%),
      radial-gradient(900px 500px at 88% 0%, rgba(232,121,249,.09), transparent 55%),
      #04060f;min-height:100vh}
    body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
      background-image:linear-gradient(rgba(148,163,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,255,.05) 1px,transparent 1px);
      background-size:44px 44px;
      -webkit-mask-image:radial-gradient(ellipse at 50% 0%,black 30%,transparent 78%)}
    .pf{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:24px 18px 70px}
    .pf-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:18px}
    .pf-avatar{width:58px;height:58px;border-radius:14px;display:flex;align-items:center;justify-content:center;
      font-weight:900;font-size:1.5rem;color:#04060f;background:linear-gradient(120deg,#22d3ee,#818cf8 48%,#e879f9);
      box-shadow:0 0 26px rgba(99,140,255,.45)}
    .pf-title{font-size:1.25rem;font-weight:900;letter-spacing:.02em}
    .pf-sub{font-size:.75rem;color:#7c8bb8;margin-top:2px}
    .pf-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:18px 0 16px}
    .pf-tab{padding:9px 15px;border-radius:10px;border:1px solid rgba(148,163,255,.2);background:rgba(255,255,255,.03);
      color:#aab4dd;font-size:.74rem;font-weight:800;cursor:pointer;letter-spacing:.04em;transition:all .16s}
    .pf-tab:hover{border-color:rgba(34,211,238,.5);color:#e0f2fe}
    .pf-tab.on{background:linear-gradient(120deg,rgba(34,211,238,.16),rgba(232,121,249,.16));border-color:rgba(129,140,248,.55);color:#f1f5ff;box-shadow:0 0 16px rgba(99,140,255,.2)}
    .pf-pane{display:none}
    .pf-pane.on{display:block;animation:nFade .3s ease}
    @keyframes nFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    .card{position:relative;background:linear-gradient(180deg,rgba(13,18,40,.72),rgba(9,13,29,.5));border:1px solid rgba(148,163,255,.18);
      border-radius:14px;padding:20px;margin-bottom:14px;box-shadow:0 18px 50px rgba(3,5,15,.45)}
    .card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:14px 14px 0 0;
      background:linear-gradient(120deg,#22d3ee,#818cf8 48%,#e879f9);opacity:.85;filter:drop-shadow(0 0 8px rgba(99,140,255,.4))}
    .card h3{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:#c7d2fe;margin-bottom:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
    .item{border:1px solid rgba(148,163,255,.14);border-radius:10px;padding:11px 13px;background:rgba(4,6,15,.35)}
    .item b{display:block;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:#7c8bb8;margin-bottom:3px}
    .item span{font-size:.9rem;font-weight:700;color:#e2e8ff;word-break:break-all}
    .badge{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 11px;font-size:.7rem;font-weight:800}
    .badge.ok{background:rgba(52,211,153,.12);color:#6ee7b7;border:1px solid rgba(52,211,153,.35)}
    .badge.warn{background:rgba(251,191,36,.12);color:#fde68a;border:1px solid rgba(251,191,36,.35)}
    .badge.err{background:rgba(232,121,249,.12);color:#f5d0fe;border:1px solid rgba(232,121,249,.35)}
    .btn{padding:9px 15px;border-radius:9px;font-size:.74rem;font-weight:900;cursor:pointer;letter-spacing:.03em;transition:all .16s;border:none}
    .btn-g{background:linear-gradient(120deg,#22d3ee,#818cf8 48%,#e879f9);color:#04060f;box-shadow:0 4px 16px rgba(99,140,255,.35)}
    .btn-g:hover{filter:brightness(1.15);transform:translateY(-1px);box-shadow:0 6px 24px rgba(99,140,255,.5)}
    .btn-c{background:rgba(34,211,238,.08);border:1px solid rgba(34,211,238,.4);color:#a5f3fc}
    .btn-c:hover{box-shadow:0 0 14px rgba(34,211,238,.3)}
    .btn-m{background:rgba(232,121,249,.08);border:1px solid rgba(232,121,249,.35);color:#f5d0fe}
    .btn-m:hover{box-shadow:0 0 14px rgba(232,121,249,.3)}
    .btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}
    .row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid rgba(148,163,255,.1)}
    .row:last-child{border-bottom:none}
    .row .nm{font-size:.86rem;font-weight:800;color:#e2e8ff}
    .row .meta{font-size:.68rem;color:#8b97c9;margin-top:2px;word-break:break-all}
    table{width:100%;border-collapse:collapse;font-size:.8rem}
    th{text-align:left;padding:8px 10px;font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;color:#c7d2fe;
      background:linear-gradient(180deg,rgba(34,211,238,.10),rgba(129,140,248,.06));border-bottom:1px solid rgba(148,163,255,.25)}
    td{padding:8px 10px;border-bottom:1px solid rgba(148,163,255,.09);color:#c9d3f5}
    tr:hover td{background:rgba(34,211,238,.05)}
    .inp{width:100%;background:rgba(4,6,15,.6);border:1px solid rgba(148,163,255,.24);color:#e2e8ff;border-radius:9px;padding:10px 13px;font-size:.9rem}
    .inp:focus{outline:none;border-color:rgba(34,211,238,.65);box-shadow:0 0 0 3px rgba(34,211,238,.14)}
    .hint{font-size:.72rem;color:#8b97c9;line-height:1.5}
    .msg{display:none;margin-top:10px;padding:11px 14px;border-radius:10px;font-size:.8rem;font-weight:700}
    .msg.show{display:block}
    .msg.ok{background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.4);color:#6ee7b7}
    .msg.err{background:rgba(232,121,249,.08);border:1px solid rgba(232,121,249,.4);color:#f5d0fe}
    .key-box{margin-top:12px;padding:14px;border-radius:10px;background:rgba(52,211,153,.06);border:1px dashed rgba(52,211,153,.45)}
    .key-box code{display:block;font-family:ui-monospace,monospace;font-size:.82rem;color:#6ee7b7;word-break:break-all;margin:8px 0}
    .topbar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:12px 20px;
      background:linear-gradient(180deg,rgba(7,10,25,.94),rgba(6,8,20,.88));border-bottom:1px solid rgba(148,163,255,.16)}
    .topbar::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:linear-gradient(120deg,#22d3ee,#818cf8 48%,#e879f9)}
    .topbar .brand{display:flex;align-items:center;gap:10px;font-weight:900;color:#e2e8ff;font-size:.9rem}
    .topbar a{color:#aab4dd;font-size:.74rem;font-weight:800;text-decoration:none;padding:7px 12px;border:1px solid rgba(148,163,255,.22);border-radius:9px}
    .topbar a:hover{border-color:rgba(34,211,238,.5);color:#e0f2fe}
    @media(max-width:600px){.pf{padding:16px 10px 50px}.card{padding:16px 13px}}
  </style>
</head>
<body>
  <%
    const fmt = (ts) => ts ? new Date(ts).toLocaleString('uz-UZ') : '—';
  %>
  <div class="topbar">
    <span class="brand">◈ Deborah — Admin Profili</span>
    <a href="/admin/dashboard">← Panelga qaytish</a>
  </div>
  <main class="pf" id="main">
    <div class="pf-head">
      <div class="pf-avatar"><%= (profile.username || 'A').charAt(0).toUpperCase() %></div>
      <div>
        <div class="pf-title"><%= profile.username %> <span class="badge ok" style="vertical-align:middle;margin-left:6px">◈ ADMIN</span></div>
        <div class="pf-sub">Kirish: <%= fmt(profile.loginAt) %> · IP: <%= profile.loginIp || '—' %> · Sessiya tugashi: <%= fmt(profile.sessionExpires) %></div>
      </div>
    </div>

    <div class="pf-tabs" role="tablist">
      <button class="pf-tab on" data-pane="general">Umumiy</button>
      <button class="pf-tab" data-pane="passkeys">🔐 Passkeylar <span id="pk-count"></span></button>
      <button class="pf-tab" data-pane="mfa">🛡 MFA kalitlar</button>
      <button class="pf-tab" data-pane="apikeys">🔑 API kalitlar</button>
      <button class="pf-tab" data-pane="sessions">💻 Sessiyalar</button>
      <button class="pf-tab" data-pane="logs">📜 Loglar</button>
    </div>

    <!-- UMUMIY -->
    <div class="pf-pane on" id="pane-general">
      <div class="card">
        <h3>Hisob holati</h3>
        <div class="grid">
          <div class="item"><b>Login</b><span><%= profile.username %></span></div>
          <div class="item"><b>MFA holati</b><span id="mfaBadge">…</span></div>
          <div class="item"><b>Kirish vaqti</b><span><%= fmt(profile.loginAt) %></span></div>
          <div class="item"><b>Kirish IP</b><span><%= profile.loginIp || '—' %></span></div>
          <div class="item"><b>Sessiya tugashi</b><span><%= fmt(profile.sessionExpires) %></span></div>
        </div>
      </div>
      <div class="card">
        <h3>Oxirgi amallar (audit)</h3>
        <div id="recentLogs" class="hint">Yuklanmoqda…</div>
      </div>
    </div>

    <!-- PASSKEYLAR -->
    <div class="pf-pane" id="pane-passkeys">
      <div class="card">
        <h3>🔐 Passkeylar — biometrik / security key</h3>
        <p class="hint" style="margin-bottom:12px">Passkey bilan parolsiz kirish (Touch ID / Face ID / Windows Hello / USB kalit). MFA bilan bir xil xavfsizlik darajasi — maxfiy kalit qurilmada qoladi.</p>
        <button class="btn btn-g" id="pkAdd">+ Passkey qo'shish</button>
        <div id="pkErr" class="msg err"></div>
        <div id="pkList" style="margin-top:8px" class="hint">Yuklanmoqda…</div>
      </div>
    </div>

    <!-- MFA -->
    <div class="pf-pane" id="pane-mfa">
      <div class="card">
        <h3>🛡 MFA (2FA) kalitlar</h3>
        <div class="grid">
          <div class="item"><b>Holat</b><span id="mfaBadge2">…</span></div>
          <div class="item"><b>Yoqilgan</b><span id="mfaSince">—</span></div>
          <div class="item"><b>Oxirgi tasdiq</b><span id="mfaLast">—</span></div>
        </div>
        <p class="hint" style="margin-top:12px">Backup kodlar (kalitlar) TOTP sozlamalari ichida boshqariladi — har kod bir marta ishlaydi. Kodlar tugagan bo'lsa yangi ro'yxat oling.</p>
        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-c" href="/admin/mfa" style="text-decoration:none">MFA sozlamalari →</a>
        </div>
      </div>
    </div>

    <!-- API KALITLAR -->
    <div class="pf-pane" id="pane-apikeys">
      <div class="card">
        <h3>🔑 API kalitlar</h3>
        <p class="hint" style="margin-bottom:12px">Tashqi integratsiyalar uchun. Kalit sha256 hash holda saqlanadi — to'liq qiymati FAQAT yaratish paytida ko'rsatiladi.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <input class="inp" id="akName" placeholder="Kalit nomi (masalan: n8n-integratsiya)" maxlength="60" style="flex:1;min-width:200px">
          <button class="btn btn-g" id="akCreate">+ Kalit yaratish</button>
        </div>
        <div id="akKeyBox" class="key-box" style="display:none">
          <b style="color:#6ee7b7;font-size:.74rem">⚠ YANGI KALIT — faqat hozir ko'rsatiladi:</b>
          <code id="akKeyValue"></code>
          <button class="btn btn-c" id="akCopy">Nusxa olish</button>
        </div>
        <div id="akErr" class="msg err"></div>
        <div id="akList" style="margin-top:8px" class="hint">Yuklanmoqda…</div>
      </div>
    </div>

    <!-- SESIYALAR -->
    <div class="pf-pane" id="pane-sessions">
      <div class="card">
        <h3>💻 Faol admin sessiyalar</h3>
        <p class="hint" style="margin-bottom:12px">Revoke qilingan sessiya ≤60s ichida o'chadi (keyingi so'rovda). Joriy sessiya belgilangan.</p>
        <button class="btn btn-m" id="sessRevokeAll">Boshqa barcha sessiyalarni yopish</button>
        <div id="sessErr" class="msg err"></div>
        <div id="sessList" style="margin-top:8px" class="hint">Yuklanmoqda…</div>
      </div>
    </div>

    <!-- LOGLAR -->
    <div class="pf-pane" id="pane-logs">
      <div class="card">
        <h3>📜 O'z audit loglaringiz</h3>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          <a class="btn btn-c" href="/api/admin/profile/logs?format=csv" download>⬇ CSV eksport</a>
          <a class="btn btn-c" href="/api/admin/profile/logs?format=json" download>⬇ JSON eksport</a>
        </div>
        <div class="table-wrap" style="overflow-x:auto">
          <table>
            <thead><tr><th>Vaqt</th><th>Amal</th><th>Holat</th><th>IP</th></tr></thead>
            <tbody id="logsBody"><tr><td colspan="4" class="hint">Yuklanmoqda…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- REAUTH MODAL -->
    <div id="reauthBox" style="display:none;position:fixed;inset:0;z-index:50;background:rgba(3,5,14,.7);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:20px">
      <div class="card" style="max-width:400px;width:100%;margin:0">
        <h3>🔒 Qayta tasdiqlash</h3>
        <p class="hint" style="margin-bottom:10px">Xavfsizlik uchun admin parolini kiriting.</p>
        <input class="inp" type="password" id="reauthPw" placeholder="Admin paroli" autocomplete="current-password">
        <div id="reauthErr" class="msg err"></div>
        <div style="display:flex;gap:8px;margin-top:12px">
          <button class="btn btn-g" id="reauthGo" style="flex:1">Tasdiqlash</button>
          <button class="btn btn-c" id="reauthCancel">Bekor</button>
        </div>
      </div>
    </div>

    <p style="text-align:center;margin-top:24px"><a href="/admin/dashboard" style="color:#8b97c9;font-size:.8rem;font-weight:700;text-decoration:none">← Boshqaruv paneliga qaytish</a></p>
  </main>

<script>
(function () {
  'use strict';
  var CSRF = '<%= csrfToken %>';
  var $ = function (id) { return document.getElementById(id); };

  /* ── Tabs ── */
  document.querySelectorAll('.pf-tab').forEach(function (t) {
    t.addEventListener('click', function () {
      document.querySelectorAll('.pf-tab').forEach(function (x) { x.classList.remove('on'); });
      document.querySelectorAll('.pf-pane').forEach(function (x) { x.classList.remove('on'); });
      t.classList.add('on');
      $('pane-' + t.getAttribute('data-pane')).classList.add('on');
    });
  });

  /* ── API helper: 403 reauth_required → reauth modal → retry ── */
  var retryAfterReauth = null;
  function showReauth(cb) {
    retryAfterReauth = cb;
    $('reauthBox').style.display = 'flex';
    setTimeout(function () { $('reauthPw').focus(); }, 60);
  }
  $('reauthCancel').addEventListener('click', function () { $('reauthBox').style.display = 'none'; });
  $('reauthGo').addEventListener('click', function () {
    var pw = $('reauthPw').value;
    if (!pw) return;
    fetch('/api/admin/reauth', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': CSRF },
      body: JSON.stringify({ password: pw })
    }).then(function (r) { return r.json().then(function (d) { return { status: r.status, d: d }; }); })
      .then(function (r) {
        if (r.status === 200 && r.d.ok) {
          $('reauthBox').style.display = 'none';
          $('reauthPw').value = ''; $('reauthErr').classList.remove('show');
          var cb = retryAfterReauth; retryAfterReauth = null;
          if (cb) cb();
        } else {
          $('reauthErr').textContent = r.d.error === 'wrong-password' ? "Parol noto'g'ri." : 'Xatolik: ' + (r.d.error || r.status);
          $('reauthErr').classList.add('show');
        }
      }).catch(function () {
        $('reauthErr').textContent = 'Tarmoq xatosi';
        $('reauthErr').classList.add('show');
      });
  });
  function api(method, url, body, cb) {
    fetch(url, {
      method: method, credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': CSRF },
      body: body ? JSON.stringify(body) : undefined
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) { cb(r.status, d); });
    }).catch(function () { cb(0, {}); });
  }
  function handle403(status, d, retry) {
    if (status === 403 && d && d.error === 'reauth_required') { showReauth(retry); return true; }
    return false;
  }
  function esc(s) { var d = document.createElement('div'); d.textContent = String(s == null ? '' : s); return d.innerHTML; }
  function fmt(ts) { return ts ? new Date(ts).toLocaleString('uz-UZ') : '—'; }

  /* ── MFA holati ── */
  api('GET', '/api/admin/profile/mfa', null, function (st, d) {
    if (!d.ok) return;
    var active = d.mfa && d.mfa.status === 'active';
    var badge = '<span class="badge ' + (active ? 'ok' : 'warn') + '">' + (active ? 'MFA yoqilgan' : "MFA yo'q") + '</span>';
    var b1 = $('mfaBadge'); if (b1) b1.innerHTML = badge;
    var b2 = $('mfaBadge2'); if (b2) b2.innerHTML = badge;
    var s1 = $('mfaSince'); if (s1) s1.textContent = fmt(d.mfa && d.mfa.enabledAt);
    var s2 = $('mfaLast'); if (s2) s2.textContent = fmt(d.mfa && d.mfa.lastUsedAt);
  });

  /* ── Oxirgi amallar (umumiy tab) ── */
  fetch('/api/admin/profile/logs?format=json&limit=10', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      var el = $('recentLogs');
      if (!d.ok || !d.entries || !d.entries.length) { el.textContent = "Hozircha audit yozuvlari yo'q."; return; }
      el.innerHTML = '<table><thead><tr><th>Vaqt</th><th>Amal</th><th>Holat</th></tr></thead><tbody>' +
        d.entries.map(function (e) {
          return '<tr><td>' + esc(fmt(e.at)) + '</td><td>' + esc(e.action) + '</td><td>' + esc(e.outcome) + '</td></tr>';
        }).join('') + '</tbody></table>';
    }).catch(function () { $('recentLogs').textContent = "Yuklab bo'lmadi."; });

  /* ── LOGS tab (to'liq jadval) ── */
  function loadLogs() {
    fetch('/api/admin/profile/logs?format=json&limit=100', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var tb = $('logsBody');
        if (!d.ok || !d.entries || !d.entries.length) { tb.innerHTML = '<tr><td colspan="4" class="hint">Yozuv yo\'q</td></tr>'; return; }
        tb.innerHTML = d.entries.map(function (e) {
          return '<tr><td>' + esc(fmt(e.at)) + '</td><td>' + esc(e.action) + '</td><td>' + esc(e.outcome) + '</td><td>' + esc(e.ip) + '</td></tr>';
        }).join('');
      });
  }

  /* ═══ PASSKEYLAR ═══ */
  function b64ToBuf(s) { var b = s.replace(/-/g, '+').replace(/_/g, '/'); while (b.length % 4) b += '='; var bin = atob(b); var u = new Uint8Array(bin.length); for (var i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i); return u.buffer; }
  function bufToB64(buf) { var u = new Uint8Array(buf), s = ''; for (var i = 0; i < u.length; i++) s += String.fromCharCode(u[i]); return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); }
  function pkErr(m) { var e = $('pkErr'); e.textContent = m || ''; e.classList.toggle('show', !!m); }

  function loadPasskeys() {
    api('GET', '/api/admin/profile/passkeys', null, function (st, d) {
      if (!d.ok) { $('pkList').textContent = "Yuklab bo'lmadi."; return; }
      $('pk-count').textContent = d.count ? '(' + d.count + ')' : '';
      var el = $('pkList');
      if (!d.passkeys.length) { el.textContent = "Hozircha passkey yo'q — qo'shish uchun tugmani bosing."; return; }
      el.innerHTML = d.passkeys.map(function (p) {
        return '<div class="row"><div><div class="nm">' + esc(p.deviceName || 'Qurilma') + '</div>' +
          '<div class="meta">Oxirgi: ' + esc(fmt(p.lastUsedAt)) + (p.backedUp ? ' · ☁ zaxira' : '') + '</div></div>' +
          '<button class="btn btn-m" data-pk="' + esc(p.id) + '">O\'chirish</button></div>';
      }).join('');
      el.querySelectorAll('button[data-pk]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!confirm('Bu passkeyni o\'chirasizmi?')) return;
          api('POST', '/api/admin/profile/passkey/remove', { credentialId: btn.getAttribute('data-pk') }, function (st, d2) {
            if (handle403(st, d2, function () { btn.click(); })) return;
            if (!d2.ok) { pkErr("O'chirib bo'lmadi: " + (d2.error || st)); return; }
            pkErr(''); loadPasskeys();
          });
        });
      });
    });
  }
  $('pkAdd').addEventListener('click', function () {
    pkErr('');
    if (!window.PublicKeyCredential) { pkErr("Bu brauzer WebAuthn'ni qo'llab-quvvatlamaydi."); return; }
    var btn = $('pkAdd'); btn.disabled = true;
    api('POST', '/api/admin/profile/passkey/options', {}, function (st, d) {
      if (handle403(st, d, function () { $('pkAdd').click(); })) { btn.disabled = false; return; }
      if (!d.ok || !d.options) { pkErr('Xatolik: ' + (d.error || st)); btn.disabled = false; return; }
      var opts = d.options;
      opts.challenge = b64ToBuf(opts.challenge);
      opts.user.id = b64ToBuf(opts.user.id);
      if (opts.excludeCredentials) opts.excludeCredentials.forEach(function (c) { c.id = b64ToBuf(c.id); });
      navigator.credentials.create({ publicKey: opts }).then(function (cred) {
        var transports = [];
        try { transports = cred.response.getTransports ? cred.response.getTransports() : []; } catch (_) {}
        api('POST', '/api/admin/profile/passkey/verify', {
          id: cred.id, rawId: bufToB64(cred.rawId), type: cred.type,
          response: { clientDataJSON: bufToB64(cred.response.clientDataJSON), attestationObject: bufToB64(cred.response.attestationObject), transports: transports },
          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {}
        }, function (st2, d2) {
          if (handle403(st2, d2, function () { $('pkAdd').click(); })) { btn.disabled = false; return; }
          btn.disabled = false;
          if (!d2.ok) { pkErr("Tasdiqlashda xatolik: " + (d2.error || st2)); return; }
          loadPasskeys();
        });
      }).catch(function (e) {
        btn.disabled = false;
        if (!(e && (e.name === 'NotAllowedError' || e.name === 'AbortError'))) pkErr('Bekor qilindi yoki xatolik: ' + (e.message || e.name));
      });
    });
  });

  /* ═══ API KALITLAR ═══ */
  function akErr(m) { var e = $('akErr'); e.textContent = m || ''; e.classList.toggle('show', !!m); }
  function loadKeys() {
    api('GET', '/api/admin/profile/api-keys', null, function (st, d) {
      if (!d.ok) { $('akList').textContent = "Yuklab bo'lmadi."; return; }
      var el = $('akList');
      if (!d.keys.length) { el.textContent = 'Kalitlar yo\'q.'; return; }
      el.innerHTML = d.keys.map(function (k) {
        return '<div class="row"><div><div class="nm">' + esc(k.name) + ' <span class="hint" style="margin-left:6px">' + esc(k.prefix) + '…</span></div>' +
          '<div class="meta">Yaratilgan: ' + esc(fmt(k.createdAt)) + (k.lastUsedAt ? ' · ishlatilgan: ' + esc(fmt(k.lastUsedAt)) : '') + '</div></div>' +
          (k.revoked ? '<span class="badge err">bekor</span>' : '<button class="btn btn-m" data-ak="' + esc(k.id) + '">Bekor qilish</button>') + '</div>';
      }).join('');
      el.querySelectorAll('button[data-ak]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!confirm('Bu kalitni bekor qilasizmi? Integratsiyalar ishlamay qoladi.')) return;
          api('POST', '/api/admin/profile/api-keys/revoke', { id: btn.getAttribute('data-ak') }, function (st, d2) {
            if (handle403(st, d2, function () { btn.click(); })) return;
            loadKeys();
          });
        });
      });
    });
  }
  $('akCreate').addEventListener('click', function () {
    akErr('');
    var name = $('akName').value.trim();
    if (!name) { akErr('Kalit nomini kiriting.'); return; }
    var btn = $('akCreate'); btn.disabled = true;
    api('POST', '/api/admin/profile/api-keys', { name: name }, function (st, d) {
      btn.disabled = false;
      if (handle403(st, d, function () { $('akCreate').click(); })) return;
      if (!d.ok) { akErr('Xatolik: ' + (d.error || st)); return; }
      $('akKeyBox').style.display = 'block';
      $('akKeyValue').textContent = d.key;
      $('akName').value = '';
      loadKeys();
    });
  });
  $('akCopy').addEventListener('click', function () {
    navigator.clipboard.writeText($('akKeyValue').textContent).then(function () {
      $('akCopy').textContent = '✓ Nusxalandi';
      setTimeout(function () { $('akCopy').textContent = 'Nusxa olish'; }, 1500);
    });
  });

  /* ═══ SESIYALAR ═══ */
  function sessErr(m) { var e = $('sessErr'); e.textContent = m || ''; e.classList.toggle('show', !!m); }
  function loadSessions() {
    api('GET', '/api/admin/profile/sessions', null, function (st, d) {
      if (!d.ok) { $('sessList').textContent = "Yuklab bo'lmadi."; return; }
      var el = $('sessList');
      if (!d.sessions.length) { el.textContent = 'Yozuv yo\'q (eski sessiyalar kirishdan oldingi).'; return; }
      el.innerHTML = d.sessions.map(function (s) {
        var ua = String(s.userAgent || '—');
        var br = /Firefox/.test(ua) ? 'Firefox' : /Edg/.test(ua) ? 'Edge' : /Chrome/.test(ua) ? 'Chrome' : /Safari/.test(ua) ? 'Safari' : 'Brauzer';
        return '<div class="row"><div><div class="nm">' + br + (s.current ? ' <span class="badge ok">joriy</span>' : '') + (s.revoked ? ' <span class="badge err">bekor qilingan</span>' : '') + '</div>' +
          '<div class="meta">IP: ' + esc(s.ip) + ' · Kirish: ' + esc(fmt(s.loginAt)) + ' · Oxirgi: ' + esc(fmt(s.lastSeen)) + '</div></div>' +
          (!s.current && !s.revoked ? '<button class="btn btn-m" data-sess="' + esc(s.sid) + '">Yopish</button>' : '') + '</div>';
      }).join('');
      el.querySelectorAll('button[data-sess]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          api('POST', '/api/admin/profile/sessions/revoke', { sid: btn.getAttribute('data-sess') }, function (st, d2) {
            if (!d2.ok) { sessErr('Xatolik: ' + (d2.error || st)); return; }
            sessErr(''); loadSessions();
          });
        });
      });
    });
  }
  $('sessRevokeAll').addEventListener('click', function () {
    if (!confirm('Boshqa BARCHA sessiyalar yopiladi. Davom etasizmi?')) return;
    api('POST', '/api/admin/profile/sessions/revoke', { all: true }, function (st, d) {
      if (!d.ok) { sessErr('Xatolik: ' + (d.error || st)); return; }
      sessErr(d.revoked + ' sessiya yopildi.');
      loadSessions();
    });
  });

  /* ── init: tab almashtirilganda lazy-load ── */
  loadPasskeys(); loadKeys(); loadSessions(); loadLogs();
})();
</script>
</body>
</html>
