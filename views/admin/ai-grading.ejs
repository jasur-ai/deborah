<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="dark">
<head>
  <%- include('../partials/head', { title, user }) %>
  <style>
    .ag-grid { display: grid; grid-template-columns: 300px 1fr; gap: 18px; }
    .ag-panel { background: var(--edikit-semantic-color-surface-raised); border: 1px solid var(--edikit-semantic-color-border-default); border-radius: 12px; padding: 16px; }
    .ag-panel h3 { margin: 0 0 12px; font-size: 14px; letter-spacing: .04em; color: var(--edikit-semantic-color-text-muted); text-transform: uppercase; }
    .ag-job { padding: 10px 12px; border: 1px solid var(--edikit-semantic-color-border-default); border-radius: 8px; margin-bottom: 8px; cursor: pointer; transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s; }
    .ag-job:hover { border-color: var(--edikit-semantic-color-action-primary); }
    .ag-job.active { border-color: var(--edikit-semantic-color-action-primary); background: color-mix(in srgb, var(--edikit-semantic-color-action-primary) 8%, transparent); }
    .ag-job .jname { font-weight: 600; }
    .ag-job .jmeta { font-size: 12px; color: var(--edikit-semantic-color-text-muted); }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .badge.queued { background: rgba(148,163,184,.15); color: #94a3b8; }
    .badge.completed { background: rgba(0,229,160,.15); color: #00e5a0; }
    .badge.failed { background: rgba(248,113,113,.15); color: #f87171; }
    .badge.auto_draft { background: rgba(0,229,160,.15); color: #00e5a0; }
    .badge.grading_queue { background: rgba(251,191,36,.15); color: #fbbf24; }
    .badge.human_review { background: rgba(248,113,113,.15); color: #f87171; }
    .run-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--edikit-semantic-color-border-default); }
    .run-row:last-child { border-bottom: none; }
    .btn { padding: 6px 14px; border-radius: 8px; border: 1px solid var(--edikit-semantic-color-border-default); background: var(--edikit-semantic-color-surface-raised); color: var(--edikit-semantic-color-text-primary); cursor: pointer; font-size: 13px; transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s; }
    .btn:hover { border-color: var(--edikit-semantic-color-action-primary); }
    .btn.primary { background: var(--edikit-semantic-color-action-primary); border-color: var(--edikit-semantic-color-action-primary); color: #fff; }
    .btn.sm { padding: 4px 10px; font-size: 12px; }
    .input, textarea.input { width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--edikit-semantic-color-border-default); background: var(--edikit-semantic-color-surface-raised); color: var(--edikit-semantic-color-text-primary); font-size: 13px; box-sizing: border-box; }
    textarea.input { min-height: 80px; resize: vertical; }
    .field { margin-bottom: 12px; }
    .field label { display: block; font-size: 12px; color: var(--edikit-semantic-color-text-muted); margin-bottom: 4px; }
    .toast { position: fixed; top: 16px; right: 16px; z-index: 50; padding: 10px 16px; border-radius: 10px; background: var(--edikit-semantic-color-surface-raised); border: 1px solid var(--edikit-semantic-color-border-default); box-shadow: 0 8px 24px rgba(0,0,0,.3); opacity: 0; transform: translateY(-8px); transition:color .25s,background-color .25s,border-color .25s,box-shadow .25s,transform .25s,opacity .25s; font-size: 13px; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.err { border-color: rgba(248,113,113,.5); }
    .toast.ok { border-color: rgba(0,229,160,.5); }
    .span-block { border-left: 3px solid var(--edikit-semantic-color-action-primary); padding-left: 10px; margin: 6px 0; font-size: 13px; }
    .metric { display: inline-block; margin-right: 16px; font-size: 13px; }
    .metric b { font-size: 18px; }
    .muted { color: var(--edikit-semantic-color-text-muted); }
    @media (max-width: 860px) { .ag-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { active: 'ai-grading', user }) %>
  <main class="main">
    <div class="topbar">
      <h1>AI Grading — Shadow Mode</h1>
      <div class="topbar-right">
        <button class="btn primary" onclick="openCreateJob()">+ Yangi job</button>
      </div>
    </div>

    <div class="ag-grid">
      <div>
        <div class="ag-panel">
          <h3>Grading job'lar</h3>
          <div id="jobList"><span class="muted">Yuklanmoqda…</span></div>
          <div style="margin-top:14px">
            <button class="btn" style="width:100%" onclick="loadJobs()">Yangilash</button>
          </div>
        </div>
      </div>

      <div>
        <div class="ag-panel">
          <h3 id="jobTitle">Job tanlang</h3>
          <div id="runList"><span class="muted">Yuklanmoqda…</span></div>
        </div>

        <div class="ag-panel" style="margin-top:14px">
          <h3>Shadow run sinovi</h3>
          <div class="field"><label>Pseudonym</label><input class="input" id="runPseudonym" placeholder="S-1A2B3C4D"></div>
          <div class="field"><label>Student javobi (PII avtomatik redact qilinadi)</label><textarea class="input" id="runResponse" placeholder="Fotosintez — yorug'lik energiyasi CO2 va suv bilan glyukoza hosil qiladi…"></textarea></div>
          <div class="field"><label>Criterion (rubric)</label><textarea class="input" id="runCriterion" style="min-height:140px">{&quot;name&quot;:&quot;Fotosintez mexanizmi&quot;,&quot;max_points&quot;:4,&quot;required_concepts&quot;:[{&quot;concept&quot;:&quot;yorug'lik energiyasi&quot;},{&quot;concept&quot;:&quot;CO2 va suv&quot;},{&quot;concept&quot;:&quot;glyukoza&quot;}],&quot;contradictions&quot;:[&quot;kislorod reaktant sifatida&quot;],&quot;levels&quot;:[{&quot;points&quot;:4,&quot;descriptor&quot;:&quot;to'liq&quot;},{&quot;points&quot;:3,&quot;descriptor&quot;:&quot;asosiy to'g'ri&quot;},{&quot;points&quot;:2,&quot;descriptor&quot;:&quot;qisman&quot;},{&quot;points&quot;:1,&quot;descriptor&quot;:&quot;terminlar&quot;},{&quot;points&quot;:0,&quot;descriptor&quot;:&quot;noto'g'ri&quot;}]}</textarea></div>
          <div class="field"><label>Provider output (JSON — CI simulyatsiya)</label><textarea class="input" id="runProvider">{&quot;criterion_score&quot;:4,&quot;level&quot;:0,&quot;evidence_spans&quot;:[{&quot;concept&quot;:&quot;yorug'lik energiyasi&quot;,&quot;start&quot;:0,&quot;end&quot;:18,&quot;text&quot;:&quot;Fotosintez — yorug'lik&quot;}],&quot;missing_concepts&quot;:[],&quot;contradictions_found&quot;:[],&quot;confidence&quot;:0.93,&quot;feedback&quot;:&quot;To'liq va sababli javob&quot;}</textarea></div>
          <label style="display:block;font-size:12px;color:var(--edikit-semantic-color-text-muted);margin-bottom:8px"><input type="checkbox" id="runSummative"> Summative (teacher approval shart)</label>
          <button class="btn primary" onclick="runShadow()">Shadow run ishga tushirish</button>
        </div>
      </div>
    </div>
  </main>

  <div id="toast" class="toast"></div>

  <div id="createJobModal" style="display:none">
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:40" onclick="closeCreateJob()"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--edikit-semantic-color-surface-raised);border:1px solid var(--edikit-semantic-color-border-default);border-radius:14px;padding:22px;width:min(440px,90vw);z-index:41">
      <h3 style="margin:0 0 14px">Yangi AI grading job</h3>
      <div class="field"><label>Nomi</label><input class="input" id="jName" placeholder="DTM 2026 — Biologiya shadow"></div>
      <div class="field"><label>Model</label><input class="input" id="jModel" value="claude-sonnet"></div>
      <div class="field"><label>Model versiya (exact pin — stop condition)</label><input class="input" id="jModelVersion" value="2026-07-01"></div>
      <div class="field"><label>Rubric version ID (ixtiyoriy)</label><input class="input" id="jRubricId" placeholder="1"></div>
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button class="btn" onclick="closeCreateJob()">Bekor qilish</button>
        <button class="btn primary" onclick="createJob()">Saqlash</button>
      </div>
    </div>
  </div>

  <script>
    let currentJob = null;
    const API = (p, m = 'GET', b) => fetch(p, { method: m, headers: { 'Content-Type': 'application/json', 'x-csrf-token': window.__CSRF_TOKEN || '' }, body: b ? JSON.stringify(b) : undefined }).then(r => r.json());

    function toast(msg, ok = true) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast show ' + (ok ? 'ok' : 'err');
      setTimeout(() => t.className = 'toast', 2600);
    }
    function badge(s) { return '<span class="badge ' + s + '">' + s + '</span>'; }

    async function loadJobs() {
      const r = await API('/api/admin/ai-grading/jobs');
      const el = document.getElementById('jobList');
      if (!r.ok || !r.jobs.length) { el.innerHTML = '<span class="muted">Job yo&rsquo;q — yarating</span>'; return; }
      el.innerHTML = r.jobs.map(j =>
        '<div class="ag-job' + (currentJob && currentJob.id === j.id ? ' active' : '') + '" onclick="selectJob(' + j.id + ')">' +
        '<div class="jname">' + esc(j.name) + '</div>' +
        '<div class="jmeta">' + esc(j.model) + ' @' + esc(j.model_version) + ' &middot; ' + badge(j.status) + ' &middot; ' + (j.run_count || 0) + ' run</div></div>'
      ).join('');
    }

    async function selectJob(id) {
      const r = await API('/api/admin/ai-grading/jobs/' + id);
      if (!r.ok || !r.job) return;
      currentJob = r.job;
      document.getElementById('jobTitle').textContent = currentJob.name + ' ' + badge(currentJob.status);
      loadJobs();
      loadRuns();
    }

    async function loadRuns() {
      if (!currentJob) return;
      const r = await API('/api/admin/ai-grading/runs?jobId=' + currentJob.id);
      const el = document.getElementById('runList');
      if (!r.ok || !r.runs.length) { el.innerHTML = '<span class="muted">Run yo&rsquo;q — pastdagi formadan sinab ko&rsquo;ring</span>'; return; }
      el.innerHTML = r.runs.map(run =>
        '<div class="run-row"><div>' +
        '<div class="jname">' + esc(run.pseudonym) + ' &middot; ' + badge(run.routing_decision || 'queued') + '</div>' +
        '<div class="jmeta">score ' + (run.total_score ?? '-') + ' &middot; conf ' + (run.confidence ?? '-') + ' &middot; ' + badge(run.status) + (run.pii_redacted ? ' &middot; PII redacted' : '') + '</div>' +
        '</div><div style="display:flex;gap:6px">' +
        '<button class="btn sm" onclick="viewRun(' + run.id + ')">Ko&rsquo;rish</button>' +
        '<button class="btn sm" onclick="override(' + run.id + ')">Override</button>' +
        '</div></div>'
      ).join('');
    }

    function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

    async function runShadow() {
      if (!currentJob) return toast('Avval job tanlang', false);
      let criterion;
      try { criterion = JSON.parse(document.getElementById('runCriterion').value); } catch (_) { return toast('Criterion JSON noto&rsquo;g&rsquo;ri', false); }
      let providerOutput = null;
      const pv = document.getElementById('runProvider').value.trim();
      if (pv) { try { providerOutput = JSON.parse(pv); } catch (_) { return toast('Provider JSON noto&rsquo;g&rsquo;ri', false); } }
      const r = await API('/api/admin/ai-grading/jobs/' + currentJob.id + '/run', 'POST', {
        pseudonym: document.getElementById('runPseudonym').value || 'S-TEST0001',
        responseText: document.getElementById('runResponse').value,
        criterion,
        providerOutput,
        summative: document.getElementById('runSummative').checked,
      });
      if (!r.ok) return toast('Shadow: ' + r.error, false);
      toast('Shadow: score ' + r.totalScore + ' · ' + r.routing + (r.redactedCount ? ' · PII ' + r.redactedCount + ' ta redact' : '') + (r.dryRun ? ' · dry-run (PG yo&rsquo;q)' : ''));
      loadRuns();
    }

    async function viewRun(id) {
      const r = await API('/api/admin/ai-grading/runs/' + id);
      if (!r.ok || !r.run) return;
      const run = r.run;
      const crit = (run.criterionResults || []).map(c =>
        '<div style="margin-top:8px"><b>' + esc(c.criterion_name) + '</b>: ' + c.score + ' (conf ' + c.confidence + ')' +
        (c.missing_concepts && c.missing_concepts.length ? '<div class="muted">missing: ' + esc(c.missing_concepts.join(', ')) + '</div>' : '') +
        (c.contradictions_found && c.contradictions_found.length ? '<div style="color:#f87171">contradiction: ' + esc(c.contradictions_found.join(', ')) + '</div>' : '') +
        (c.feedback ? '<div class="muted">' + esc(c.feedback) + '</div>' : '') +
        '</div>'
      ).join('');
      const spans = (run.evidenceSpans || []).map(s => '<div class="span-block">' + esc(s.concept) + ' [' + s.span_start + ',' + s.span_end + '): ' + esc(s.span_text) + '</div>').join('');
      document.getElementById('runList').innerHTML =
        '<div style="margin-bottom:10px"><b>' + esc(run.pseudonym) + '</b> ' + badge(run.routing_decision) + ' · score ' + run.total_score + ' · conf ' + run.confidence + '</div>' +
        (crit || '<span class="muted">Criterion result yo&rsquo;q</span>') +
        '<h4 style="margin:14px 0 4px">Evidence spans</h4>' + (spans || '<span class="muted">Span yo&rsquo;q</span>') +
        '<div style="margin-top:12px"><button class="btn sm" onclick="loadRuns()">Orqaga</button></div>';
    }

    async function override(id) {
      const score = prompt('Overridden score (teacher final — shadow advisory):');
      if (score === null || score === '') return;
      const reason = prompt('Sabab (ixtiyoriy):') || '';
      const r = await API('/api/admin/ai-grading/runs/' + id + '/override', 'POST', {
        workItemId: null, aiTotalScore: Number(score), overriddenScore: Number(score), reason, teacherId: 1,
      });
      toast(r.ok ? 'Override saqlandi (shadow final'ni o'zgartirmaydi)' : r.error, r.ok);
    }

    function openCreateJob() { document.getElementById('createJobModal').style.display = 'block'; }
    function closeCreateJob() { document.getElementById('createJobModal').style.display = 'none'; }
    async function createJob() {
      const r = await API('/api/admin/ai-grading/jobs', 'POST', {
        name: document.getElementById('jName').value,
        model: document.getElementById('jModel').value,
        modelVersion: document.getElementById('jModelVersion').value,
        rubricVersionId: document.getElementById('jRubricId').value || null,
      });
      toast(r.ok ? 'Job yaratildi' : r.error, r.ok);
      closeCreateJob();
      loadJobs();
    }

    loadJobs();
  </script>
</body>
</html>
