<% const current = user || {}; %>
<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css?v=nv4">
  <link rel="stylesheet" href="/design/admin-command.css">
  <%- include('../partials/critical-mobile-css') %>
<style>
/* Parol ko'rsatish tugmasi (universal pw-toggle) */
.pw-wrap{position:relative}
.pw-wrap>input{padding-right:52px !important;box-sizing:border-box;width:100%}
.pw-toggle{position:absolute;right:4px;top:50%;transform:translateY(-50%);min-width:44px;min-height:44px;border:0;background:transparent;cursor:pointer;font-size:1.05rem;line-height:1;color:inherit;opacity:.7;border-radius:10px}
.pw-toggle:hover{opacity:1}
</style>
</head>
<body class="adm-body">
  <div class="adm-shell">
    <aside class="adm-sidebar">
      <div class="adm-brand">
        <img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto">
        <span>Deborah</span>
      </div>
      <nav class="adm-nav">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/provider">Provider Adapters</a>
        <a href="/admin/canva" class="active">Canva</a>
        <a href="/admin/google-slides">Google Slides</a>
        <a href="/admin/deck-export">Deck Export</a>
        <a href="/admin/quiz-deck">Quiz from Deck</a>
        <a href="/admin/claude">Claude Adapter</a>
        <a href="/admin/vip">VIP</a>
      </nav>
      <div class="adm-side-foot">
        <a href="/admin/logout">Chiqish</a>
      </div>
    </aside>

    <main class="adm-main">
      <header class="adm-topbar">
        <h1>Canva Adapter</h1>
        <span class="adm-chip" id="connStatus">Tekshirilmoqda…</span>
      </header>

      <section class="adm-card">
        <h2>Kalitlarni qanday to‘ldirish (3 qadam)</h2>
        <ol class="adm-hint" style="line-height:1.9;padding-left:20px">
          <li><b>canva.com/developer</b> → «Create an app» → <b>Connect APIs (Canva Connect)</b> yoki <b>Canva Button</b> turini tanlang.</li>
          <li>App sozlamasida <b>Redirect URI</b> ni qo‘ying: <code>https://deborah-ncj.onrender.com/api/admin/canva/callback</code> (localhost: <code>http://localhost:3000/api/admin/canva/callback</code>).</li>
          <li>Appning <b>Client ID</b> va <b>Client Secret</b>ini serveringiz <b>.env</b> fayliga qo‘ying:
            <pre class="adm-env-pre">CANVA_CLIENT_ID=…
CANVA_CLIENT_SECRET=…
CANVA_REDIRECT_URI=https://deborah-ncj.onrender.com/api/admin/canva/callback</pre>
            So‘ng serverni qayta ishga tushiring — bu sahifada «Configured ✓» chiqadi va «Link Canva (OAuth)» ishlay boshlaydi.
          </li>
        </ol>
      </section>
      <section class="adm-card">
        <h2>Kalitlarni shu yerdan kiritish (server .env shart emas)</h2>
        <p class="adm-hint">Canva Connect app'dan olingan qiymatlarni kiriting — ular serverda <b>shifrlangan</b> holda saqlanadi (AES-256-GCM) va darhol ishlaydi. Maydonlarni bo'sh qoldirsangiz — mavjud qiymat saqlanib qoladi.</p>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Client ID</label><input class="input" id="cred-client-id" placeholder="OC-…" autocomplete="off"></div>
<div class="field"><label>Client Secret</label><div class="pw-wrap"><input class="input" id="cred-client-secret" type="password" placeholder="•••••••" autocomplete="new-password"><button type="button" class="pw-toggle" data-pw-toggle="cred-client-secret" aria-label="Parolni ko'rsatish" aria-pressed="false"><span data-pw-toggle-label>👁</span></button></div></div>
          </div>
          <div class="adm-row">
            <div class="field" style="flex:2"><label>Redirect URI</label><input class="input" id="cred-redirect-uri" placeholder="https://SIZNING-DOMAIN/api/admin/canva/callback"></div>
            <button class="btn btn-primary" id="btnSaveCreds">Saqlash</button>
          </div>
          <span class="adm-hint" id="credStatus"></span>
        </div>
      </section>
      <section class="adm-card">
        <h2>Canva Button / Connect</h2>
        <p class="adm-hint">Modal (Button) create/edit + Connect OAuth (PKCE). Minimal scopes: design:content:read, design:content:write, design:meta:read — full account scope yo'q. Token vault encrypted.</p>
        <div class="adm-row">
          <button class="btn btn-primary" id="btnLink">Link Canva (OAuth)</button>
          <button class="btn" id="btnUnlink">Unlink + Revoke</button>
          <span class="adm-hint" id="linkStatus"></span>
        </div>
      </section>



      <section class="adm-card">
        <h2>Button Callback</h2>
        <p class="adm-hint">onDesignOpen / onDesignPublish callback'larini simulyatsiya qilish (design → artifact version mapping).</p>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Callback type</label>
              <select class="input" id="fCbType">
                <option value="onDesignPublish">onDesignPublish</option>
                <option value="onDesignOpen">onDesignOpen</option>
              </select>
            </div>
            <div class="field"><label>Design ID</label><input class="input" id="fDesignId" placeholder="DAbc123..."></div>
            <div class="field" style="flex:2"><label>Design URL</label><input class="input" id="fDesignUrl" placeholder="https://www.canva.com/design/..."></div>
          </div>
          <div class="adm-row">
            <button class="btn" id="btnCallback">Send Callback</button>
            <span class="adm-hint" id="cbStatus"></span>
          </div>
        </div>
      </section>

      <section class="adm-card">
        <h2>Connect Design Flows</h2>
        <div class="adm-form">
          <div class="adm-row">
            <div class="field"><label>Design ID (create/import/export uchun)</label><input class="input" id="fOpDesignId" placeholder="DAbc123..."></div>
            <button class="btn" id="btnCreate">Create Design</button>
            <button class="btn" id="btnImport">Import PPTX</button>
            <button class="btn" id="btnExport">Export PDF</button>
          </div>
          <span class="adm-hint" id="opStatus"></span>
        </div>
      </section>
    </main>
  </div>

<script>
(function () {
  const CSRF = '<%= csrfToken || "" %>';
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // ── C4-10 rev.4: kalitlarni shu yerdan saqlash ──
  async function loadCredStatus() {
    try {
      const r = await api('/api/admin/canva/status');
      const c = r.credentials || {};
      if ($('cred-client-id')) $('cred-client-id').placeholder = c.clientIdMasked || 'OC-…';
      if ($('cred-redirect-uri') && c.redirectUri) $('cred-redirect-uri').value = c.redirectUri;
      if ($('credStatus')) $('credStatus').textContent = c.configured
        ? `Sozlangan ✓ (manba: ${c.source === 'env' ? 'server env' : 'admin panel'})`
        : 'Hozircha sozlanmagan — Client ID va Secret kiriting.';
    } catch (_) { /* jim */ }
  }

  document.getElementById('btnSaveCreds')?.addEventListener('click', async () => {
    const btn = $('btnSaveCreds');
    btn.disabled = true;
    try {
      const r = await api('/api/admin/canva/credentials', {
        method: 'POST',
        body: {
          clientId: $('cred-client-id').value.trim(),
          clientSecret: $('cred-client-secret').value,
          redirectUri: $('cred-redirect-uri').value.trim(),
        },
      });
      $('credStatus').textContent = 'Saqlandi ✓ — endi «Link Canva (OAuth)» ishlaydi.';
      $('cred-client-secret').value = '';
      loadCredStatus();
    } catch (e) {
      $('credStatus').textContent = 'Xato: ' + (e.message || e);
    } finally { btn.disabled = false; }
  });
  loadCredStatus();

  async function api(path, opts = {}) {
    const res = await fetch(path, {
      method: opts.method || 'GET',
      headers: { 'content-type': 'application/json', 'X-CSRF-Token': CSRF },
      body: opts.body ? JSON.stringify(opts.body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
    return data;
  }

  async function loadStatus() {
    try {
      const s = await api('/api/admin/canva/status');
      $('connStatus').textContent = s.configured ? 'Configured ✓ (minimal scopes)' : 'Not configured (env)';
      $('connStatus').className = 'adm-chip ' + (s.configured ? 'chip-ok' : 'chip-warn');
    } catch (e) { /* ignore */ }
  }

  $('btnLink').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/canva/link', { method: 'POST', body: {} });
      $('linkStatus').textContent = 'OAuth URL ochilmoqda…';
      window.open(r.url, '_blank');
    } catch (e) { $('linkStatus').textContent = '✗ ' + e.message; }
  });

  $('btnUnlink').addEventListener('click', async () => {
    try {
      await api('/api/admin/canva/unlink', { method: 'POST', body: {} });
      $('linkStatus').textContent = 'Unlinked + revoked ✓';
    } catch (e) { $('linkStatus').textContent = '✗ ' + e.message; }
  });

  $('btnCallback').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/canva/button', { method: 'POST', body: { type: $('fCbType').value, designId: $('fDesignId').value, designUrl: $('fDesignUrl').value } });
      $('cbStatus').textContent = `Mapped: ${esc(r.type)} → design ${esc(r.designId)} ✓`;
    } catch (e) { $('cbStatus').textContent = '✗ ' + e.message; }
  });

  $('btnCreate').addEventListener('click', async () => {
    try {
      const r = await api('/api/admin/canva/design', { method: 'POST', body: { title: 'Deborah deck' } });
      $('opStatus').textContent = 'Design: ' + esc(r.designId);
    } catch (e) { $('opStatus').textContent = '✗ ' + e.message; }
  });

  $('btnImport').addEventListener('click', async () => {
    try {
      const r = await api(`/api/admin/canva/design/${encodeURIComponent($('fOpDesignId').value)}/import`, { method: 'POST', body: { fileType: 'pptx', fileBase64: 'sample' } });
      $('opStatus').textContent = r.imported ? 'Imported ✓' : 'Failed';
    } catch (e) { $('opStatus').textContent = '✗ ' + e.message; }
  });

  $('btnExport').addEventListener('click', async () => {
    try {
      const r = await api(`/api/admin/canva/design/${encodeURIComponent($('fOpDesignId').value)}/export`, { method: 'POST', body: { exportType: 'pdf' } });
      $('opStatus').textContent = 'Export queued ✓ (' + esc(r.exportType) + ')';
    } catch (e) { $('opStatus').textContent = '✗ ' + e.message; }
  });

  loadStatus();
})();
</script>
<script>
/* Universal parol ko'rsatish/yashirish (auth.js yuklanmagan sahifalar uchun) */
(function(){
  if (window.__pwToggleInit) return; window.__pwToggleInit = true;
  function bind(scope){
    (scope || document).querySelectorAll('[data-pw-toggle]').forEach(function(btn){
      if (btn.__pwBound) return;
      var input = document.getElementById(btn.getAttribute('data-pw-toggle'));
      if (!input) return;
      btn.__pwBound = true;
      btn.addEventListener('click', function(){
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        var l = btn.querySelector('[data-pw-toggle-label]');
        if (l) l.textContent = show ? '\uD83D\uDE48' : '\uD83D\uDC41';
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ bind(); });
  else bind();
})();
</script>

</body>
</html>
