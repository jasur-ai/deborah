<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--bg-primary);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:'Righteous',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--border);background:var(--bg-surface);color:var(--muted);font-family:'Nunito',sans-serif;font-size:.78rem;font-weight:800;cursor:pointer;text-decoration:none;transition:all .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--text);}
    .panel{max-width:1060px;margin:0 auto;padding:24px 20px 90px;position:relative;z-index:1;}
    .greeting{font-family:'Righteous',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--muted);font-weight:700;margin-bottom:20px;}
    .grid{display:grid;grid-template-columns:340px 1fr;gap:16px;align-items:start;}
    @media(max-width:820px){.grid{grid-template-columns:1fr;}}
    .card{background:var(--card);border-radius:16px;padding:18px;border:1px solid var(--border);margin-bottom:14px;animation:slideDown .3s ease;transition:background .3s,border-color .3s;}
    .card-h{font-family:'Righteous',cursive;font-size:.95rem;display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .card-h small{font-family:'Nunito',sans-serif;font-size:.66rem;color:var(--muted);font-weight:800;margin-left:auto;}
    .field{margin-bottom:11px;}
    .field label{display:block;font-size:.72rem;font-weight:900;color:var(--muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
    .inp{width:100%;background:var(--bg-surface);border:2px solid var(--border);border-radius:10px;padding:9px 12px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.82rem;font-weight:800;outline:none;transition:border-color .3s;}
    .inp:focus{border-color:var(--accent);}
    .w-row{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
    .w-row span{flex:1;font-size:.74rem;font-weight:800;color:var(--muted);}
    .w-row output{width:44px;text-align:right;font-size:.74rem;font-weight:900;color:var(--text);font-family:'Nunito',sans-serif;}
    input[type=range]{flex:0 0 130px;-webkit-appearance:none;appearance:none;height:6px;border-radius:99px;background:var(--bg-surface);border:1px solid var(--border);outline:none;}
    input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:16px;height:16px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#1d4ed8);cursor:pointer;border:2px solid var(--bg-primary);box-shadow:var(--shadow-sm);}
    .btn{border-radius:10px;border:none;padding:10px 16px;cursor:pointer;transition:all .3s ease;font-family:'Nunito',sans-serif;font-weight:900;font-size:.8rem;background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;display:inline-flex;align-items:center;gap:6px;}
    .btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .btn.ghost{background:var(--bg-surface);color:var(--muted);border:1px solid var(--border);}
    .btn.ghost:hover{color:var(--text);background:var(--bg-elevated);}
    .btn.green{background:linear-gradient(135deg,#00e5a0,#00b37e);color:#04120c;}
    .btn.warn{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#1a1204;}
    .run-preview{font-size:.72rem;color:var(--muted);font-weight:700;background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;padding:9px 12px;margin-bottom:11px;white-space:pre-wrap;line-height:1.5;max-height:190px;overflow:auto;}
    .run-preview.ok{color:var(--green);border-color:rgba(0,229,160,.3);}
    .run-preview.err{color:var(--accent);border-color:rgba(248,113,113,.3);}
    .table{width:100%;border-collapse:collapse;font-size:.76rem;}
    .table th{text-align:left;font-size:.66rem;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);padding:7px 9px;border-bottom:1px solid var(--border);font-weight:900;}
    .table td{padding:8px 9px;border-bottom:1px solid var(--border);color:var(--text);font-weight:700;}
    .table tr:hover td{background:var(--bg-surface);}
    .chip{display:inline-flex;align-items:center;gap:5px;font-size:.66rem;font-weight:900;border-radius:7px;padding:3px 9px;text-transform:uppercase;letter-spacing:.3px;}
    .chip.draft{background:rgba(255,255,255,.06);color:var(--muted);border:1px solid var(--border);}
    .chip.approved{background:rgba(251,191,36,.12);color:var(--gold);border:1px solid rgba(251,191,36,.3);}
    .chip.published{background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);}
    .chip.archived{background:rgba(255,255,255,.04);color:var(--muted);border:1px solid var(--border);}
    .mini-btn{font-size:.68rem;font-weight:900;border-radius:8px;padding:5px 10px;border:1px solid var(--border);background:var(--bg-surface);color:var(--muted);cursor:pointer;transition:all .2s;font-family:'Nunito',sans-serif;margin-right:5px;}
    .mini-btn:hover{color:var(--text);background:var(--bg-elevated);transform:translateY(-1px);}
    .metric-row{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:12px;}
    .metric{flex:1;min-width:120px;background:var(--bg-surface);border:1px solid var(--border);border-radius:12px;padding:10px 13px;}
    .metric b{font-family:'Righteous',cursive;font-size:1.15rem;display:block;}
    .metric span{font-size:.66rem;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.4px;}
    .metric.good b{color:var(--green);}
    .metric.bad b{color:var(--accent);}
    .assign-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:12px;padding:11px 13px;margin-bottom:9px;}
    .assign-card h4{margin:0 0 4px;font-size:.8rem;font-weight:900;}
    .assign-card .meta{font-size:.68rem;color:var(--muted);font-weight:700;display:flex;gap:10px;flex-wrap:wrap;margin-bottom:5px;}
    .pen-item{font-size:.66rem;color:var(--muted);font-weight:700;background:var(--bg-primary);border:1px solid var(--border);border-radius:6px;padding:2px 7px;display:inline-block;margin:2px 3px 0 0;}
    .whatif{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:9px;}
    .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--card);border:1px solid var(--border);border-radius:12px;padding:11px 18px;font-size:.8rem;font-weight:800;z-index:999;opacity:0;pointer-events:none;transition:all .35s ease;box-shadow:var(--shadow-lg);}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .viol{font-size:.72rem;font-weight:800;background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.25);color:var(--accent);border-radius:9px;padding:8px 11px;margin-bottom:7px;}
    .empty{text-align:center;padding:24px;color:var(--muted);font-weight:700;font-size:.78rem;background:var(--bg-surface);border-radius:12px;border:1px dashed var(--border);}
    .loading{text-align:center;padding:26px;color:var(--muted);font-weight:800;font-size:.8rem;}
    .tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
    .tab{padding:7px 14px;border-radius:9px;font-size:.74rem;font-weight:900;cursor:pointer;background:var(--bg-surface);color:var(--muted);border:1px solid var(--border);transition:all .2s;font-family:'Nunito',sans-serif;}
    .tab.active{background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;border-color:transparent;}
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo">Edikit</a>
    <div class="nav-right">
      <a href="/admin/dashboard" class="nav-btn">Dashboard</a>
      <a href="/admin/scheduler" class="nav-btn">Imtihon jadvali</a>
      <form action="/admin/logout" method="post" style="margin:0">
        <button class="nav-btn" type="submit">Chiqish</button>
      </form>
    </div>
  </nav>

  <div class="panel">
    <div class="greeting">Imtihon jadvali</div>
    <div class="greeting-sub">Explainable exam scheduling — period, room, student va proctor constraintlari (Prompt 39)</div>

    <div class="tabs">
      <button class="tab active" data-tab="run">Solver</button>
      <button class="tab" data-tab="versions">Versiyalar</button>
      <button class="tab" data-tab="rooms">Xonalar</button>
      <button class="tab" data-tab="periods">Davrlar</button>
      <button class="tab" data-tab="weights">Og'irliklar</button>
    </div>

    <div class="grid">
      <!-- ── LEFT: controls ── -->
      <div>
        <div class="card" id="tab-run">
          <div class="card-h">Solver ishga tushirish <small>deterministic seed</small></div>
          <div class="field"><label>Run nomi</label><input class="inp" id="runTitle" placeholder="Masalan: DTM 2025 — 2-bosqich"></div>
          <div class="field"><label>Term ID</label><input class="inp" id="termId" type="number" placeholder="Ixtiyoriy"></div>
          <div class="field"><label>Seed (determinizm)</label><input class="inp" id="seed" type="number" value="1"></div>
          <div class="field">
            <label>Input</label>
            <textarea class="inp" id="examInput" rows="9" style="font-family:monospace;font-size:.72rem">[
  { "id": 1, "title": "Matematika", "studentIds": [101,102,103,104,105,106,107,108,109,110], "requiredFeatures": [] },
  { "id": 2, "title": "Fizika", "studentIds": [101,102,111,112,113,114,115,116], "requiredFeatures": ["computers"] }
]</textarea>
          </div>
          <button class="btn" id="btnRun">Yechimni hisoblash</button>
          <div id="runOutput" style="margin-top:12px"></div>
        </div>

        <div class="card" id="tab-weights" style="display:none">
          <div class="card-h">Soft og'irliklar <small>admin sozlamalari</small></div>
          <div id="weightRows"></div>
          <div class="field" style="margin-top:10px"><label>Seed</label><input class="inp" id="wSeed" type="number" value="1"></div>
          <button class="btn" id="btnSaveWeights">Saqlash</button>
        </div>

        <div class="card" id="tab-rooms" style="display:none">
          <div class="card-h">Xona inventarizatsiyasi</div>
          <div class="field"><label>Xona nomi</label><input class="inp" id="roomName" placeholder="101-A auditoriya"></div>
          <div class="field"><label>Bino</label><input class="inp" id="roomBuilding" placeholder="Asosiy bino"></div>
          <div class="field"><label>Sig'imi</label><input class="inp" id="roomCapacity" type="number" value="30"></div>
          <div class="field"><label>Xususiyatlar (vergul bilan)</label><input class="inp" id="roomFeatures" placeholder="computers, power"></div>
          <label style="display:flex;align-items:center;gap:8px;font-size:.76rem;font-weight:800;color:var(--muted);margin:8px 0"><input type="checkbox" id="roomIsolated"> Izolyatsiya (separate-room)</label>
          <button class="btn" id="btnAddRoom">Xona qo'shish</button>
          <div id="roomList" style="margin-top:12px"></div>
        </div>

        <div class="card" id="tab-periods" style="display:none">
          <div class="card-h">Imtihon davrlari</div>
          <div class="field"><label>Nomi</label><input class="inp" id="periodName" placeholder="1-smena"></div>
          <div class="field"><label>Boshlanishi (ISO)</label><input class="inp" id="periodStart" placeholder="2025-06-02T09:00:00Z"></div>
          <div class="field"><label>Tugashi (ISO)</label><input class="inp" id="periodEnd" placeholder="2025-06-02T11:00:00Z"></div>
          <button class="btn" id="btnAddPeriod">Davr qo'shish</button>
          <div id="periodList" style="margin-top:12px"></div>
        </div>
      </div>

      <!-- ── RIGHT: run detail / versions ── -->
      <div>
        <div class="card" id="tab-versions">
          <div class="card-h">Schedule versiyalari</div>
          <div id="versionsList"><div class="loading">Yuklanmoqda...</div></div>
        </div>
        <div class="card" id="runDetail" style="display:none">
          <div class="card-h" id="detailTitle">Run</div>
          <div id="detailBody"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/js/scheduler.js"></script>
</body>
</html>
