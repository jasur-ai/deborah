<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    .go-gold{color:var(--deborah-semantic-color-status-warning,var(--gold));}
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;}
    .live-banner{display:flex;align-items:center;gap:10px;background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:14px;padding:14px 16px;margin-bottom:18px;}
    .pulse-dot{width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(0,229,160,.6);animation:pulse 1.8s infinite;}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(0,229,160,.6)}70%{box-shadow:0 0 0 10px rgba(0,229,160,0)}100%{box-shadow:0 0 0 0 rgba(0,229,160,0)}}
    .quick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;}
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { active, role, user }) %>
  <main class="main" id="main-content" tabindex="-1">
    <div class="topbar">
      <h1>Proktor — jonli monitoring</h1>
      <div class="topbar-right">
        <a href="/user/profile" class="btn btn-quiet"><%- icon('user', 14) %> Profilim</a>
        <span style="font-size:.74rem;font-weight:600;color:var(--deborah-semantic-color-text-muted)">Salom, <span style="color:var(--deborah-semantic-color-text-primary)"><%= username %></span></span>
      </div>
    </div>

    <div class="live-banner" role="status">
      <span class="pulse-dot" aria-hidden="true"></span>
      <div>
        <div style="font-weight:700;font-size:.9rem">Monitoring rejimi</div>
        <div style="font-size:.74rem;color:var(--deborah-semantic-color-text-muted);font-weight:700">Jonli sessionlar va kamera signalari shu yerda ko'rinadi</div>
      </div>
    </div>

    <div class="quick-grid">
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(37,99,235,.14);color:var(--deborah-semantic-color-action-primary)"><%- icon('monitor', 20) %></div>
        <div class="rc-title">Jonli sessionlar</div>
        <div class="rc-sub">Aktiv attemptlar, start/pause/terminate</div>
        <span style="display:inline-block;margin-top:12px;color:var(--deborah-semantic-color-text-muted);font-weight:600;font-size:.74rem"><%- icon('info', 12) %> Bo'sh — hozircha session yo'q</span>
      </div>
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(0,229,160,.12);color:var(--green)"><%- icon('camera', 20) %></div>
        <div class="rc-title">Camera review</div>
        <div class="rc-sub">Rule-based signal tahlili</div>
        <a href="/admin/camera-review" style="display:inline-block;margin-top:12px;text-decoration:none;color:var(--green);font-weight:700;font-size:.8rem"><%- icon('arrowRight', 13) %> O'tish</a>
        <a href="/user/profile" class="go-gold" style="display:inline-block;margin-top:12px;text-decoration:none;font-weight:700;font-size:.8rem"><%- icon('user', 13) %> Profilim</a>
      </div>
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(245,158,11,.14);color:var(--gold)"><%- icon('zap', 20) %></div>
        <div class="rc-title">Command Center</div>
        <div class="rc-sub">Imtihon operatsiyalari markazi</div>
        <a href="/admin/command-center" class="go-gold" style="display:inline-block;margin-top:12px;text-decoration:none;font-weight:700;font-size:.8rem"><%- icon('arrowRight', 13) %> O'tish</a>
      </div>
    </div>

    <% if (canTerminate) { %>
      <div style="margin-top:16px">
        <%- include('../partials/states', { state: 'job', iconName: 'shield', title: 'Terminate huquqi aktiv', sub: "Favqulodda to'xtatish operatsiyalari uchun" }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
