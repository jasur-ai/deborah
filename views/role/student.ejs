<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    body{background:var(--edikit-semantic-color-surface-default);min-height:100vh;}
    .quick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;}
    .next-up{background:var(--edikit-semantic-color-surface-raised);border:1px solid var(--edikit-semantic-color-border-default);border-radius:14px;padding:16px;margin-bottom:18px;display:flex;align-items:center;gap:14px;transition:color .25s,background-color .25s,border-color .25s,box-shadow .25s,transform .25s,opacity .25s;}
    .next-up:hover{border-color:var(--green);}
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { active, role, user }) %>
  <main class="main" id="main-content" tabindex="-1">
    <div class="topbar">
      <h1>Talaba ish maydoni</h1>
      <div class="topbar-right">
        <span style="font-size:.74rem;font-weight:600;color:var(--edikit-semantic-color-text-muted)">Salom, <span style="color:var(--edikit-semantic-color-text-primary)"><%= username %></span></span>
      </div>
    </div>

    <div class="role-tabs" role="tablist" aria-label="Bo'limlar">
      <a href="/student" class="role-tab <%= tab === 'calendar' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'calendar' %>"><%- icon('calendar', 14) %> Kalendar</a>
      <a href="/student?tab=assignments" class="role-tab <%= tab === 'assignments' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'assignments' %>"><%- icon('fileText', 14) %> Topshiriqlar</a>
    </div>

    <div class="next-up">
      <div class="rc-ico" style="width:44px;height:44px;border-radius:11px;background:rgba(0,229,160,.12);color:var(--green);display:flex;align-items:center;justify-content:center;flex-shrink:0"><%- icon('zap', 20) %></div>
      <div style="flex:1">
        <div style="font-weight:700;font-size:.92rem">Yaqinlashib kelayotgan topshiriq</div>
        <div style="font-size:.76rem;color:var(--edikit-semantic-color-text-muted);font-weight:700">Kalendar va topshiriqlar shu yerda ko'rinadi</div>
      </div>
      <a href="/user/panel" class="role-tab" style="text-decoration:none"><%- icon('arrowRight', 13) %> Panelim</a>
    </div>

    <div class="quick-grid">
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(37,99,235,.14);color:var(--edikit-semantic-color-action-primary)"><%- icon('grid', 20) %></div>
        <div class="rc-title">Panelim</div>
        <div class="rc-sub">Testlar, natijalar va ishtirok</div>
        <a href="/user/panel" style="display:inline-block;margin-top:12px;text-decoration:none;color:var(--edikit-semantic-color-action-primary);font-weight:700;font-size:.8rem"><%- icon('arrowRight', 13) %> O'tish</a>
      </div>
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(245,158,11,.14);color:var(--gold)"><%- icon('award', 20) %></div>
        <div class="rc-title">Portfolio</div>
        <div class="rc-sub">Evidence portfolio va yutuqlar</div>
        <a href="/user/portfolio" style="display:inline-block;margin-top:12px;text-decoration:none;color:var(--gold);font-weight:700;font-size:.8rem"><%- icon('arrowRight', 13) %> O'tish</a>
      </div>
      <div class="role-card">
        <div class="rc-ico" style="background:rgba(0,229,160,.12);color:var(--green)"><%- icon('shieldCheck', 20) %></div>
        <div class="rc-title">Xavfsizlik profili</div>
        <div class="rc-sub">Passkey, session va ulangan hisoblar</div>
        <a href="/user/security-profile" style="display:inline-block;margin-top:12px;text-decoration:none;color:var(--green);font-weight:700;font-size:.8rem"><%- icon('arrowRight', 13) %> O'tish</a>
      </div>
    </div>

    <% if (!canAttempt) { %>
      <div style="margin-top:16px">
        <%- include('../partials/states', { state: 'offline', iconName: 'shield', title: 'Attempt yaratish cheklangan', sub: "Topshiriq tayinlanmagan yoki ruxsat yo'q" }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
