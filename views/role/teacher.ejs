<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    .go-gold{color:var(--deborah-semantic-color-status-warning,var(--gold));}
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;}
    .ov-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px;}
    .ov-stat{background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:14px;padding:14px 16px;transition:color .25s,background-color .25s,border-color .25s,box-shadow .25s,transform .25s,opacity .25s;}
    .ov-stat:hover{transform:translateY(-2px);border-color:var(--deborah-semantic-color-action-primary);}
    .ov-stat .n{font-family:''Manrope'',cursive;font-size:1.5rem;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .ov-stat .l{font-size:.72rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);}
    .quick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;}
    /* S24 S37.05: inline visual style'lar → classlar (design-lint hard error fix) */
    .rc-ico--primary{background:rgba(37,99,235,.14);color:var(--deborah-semantic-color-action-primary);}
    .rc-ico--sky{background:rgba(56,189,248,.14);color:#0ea5e9;}
    .rc-ico--mint{background:rgba(0,229,160,.12);color:#059669;}
    .rc-ico--amber{background:rgba(245,158,11,.14);color:#b45309;}
    .rc-ico--violet{background:rgba(139,92,246,.14);color:#7c3aed;}
    .rc-link{display:inline-block;margin-top:12px;text-decoration:none;font-weight:700;font-size:.8rem;color:var(--deborah-semantic-color-action-primary);}
    .rc-link--sky{color:#0ea5e9;} .rc-link--mint{color:#059669;} .rc-link--violet{color:#7c3aed;} .rc-link--amber{color:#b45309;}
    .rc-link--sm{margin-top:10px;font-size:.78rem;}
    .rc-code{font-size:.7rem;color:var(--deborah-semantic-color-text-muted);}
    .hi-sub{font-size:.74rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);}
    .hi-name{color:var(--deborah-semantic-color-text-primary);}
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { active, role, user }) %>
  <main class="main" id="main-content" tabindex="-1">
    <div class="topbar">
      <h1>O'qituvchi ish maydoni</h1>
      <div class="topbar-right">
        <a href="/user/profile" class="btn btn-quiet"><%- icon('user', 14) %> Profilim</a>
        <span class="hi-sub">Salom, <span class="hi-name"><%= username %></span></span>
      </div>
    </div>

    <div class="role-tabs" role="tablist" aria-label="Bo'limlar">
      <a href="/teacher" class="role-tab <%= tab === 'overview' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'overview' %>"><%- icon('grid', 14) %> Umumiy ko'rinish</a>
      <a href="/teacher?tab=courses" class="role-tab <%= tab === 'courses' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'courses' %>"><%- icon('bookOpen', 14) %> Kurslar</a>
      <a href="/teacher?tab=assessments" class="role-tab <%= tab === 'assessments' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'assessments' %>"><%- icon('target', 14) %> Baholashlar</a>
      <a href="/teacher?tab=grading" class="role-tab <%= tab === 'grading' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'grading' %>"><%- icon('clipboard', 14) %> Baholash navbati</a>
      <a href="/teacher?tab=environments" class="role-tab <%= tab === 'environments' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'environments' %>"><%- icon('monitor', 14) %> Muhitlarim</a>
      <a href="/teacher?tab=ai" class="role-tab <%= tab === 'ai' ? 'active' : '' %>" role="tab" aria-selected="<%= tab === 'ai' %>"><%- icon('sparkles', 14) %> AI &amp; Taqdimot</a>
    </div>

    <% if (tab === 'overview') { %>
      <div class="ov-stats">
        <div class="ov-stat"><div class="n"><%= myTests.length %></div><div class="l">Mening testlarim</div></div>
        <div class="ov-stat"><div class="n"><%= mySessions.length %></div><div class="l">Mening Cast sessiyalarim</div></div>
        <div class="ov-stat"><div class="n"><%= mySessions.filter(s => s.status === 'active' || s.status === 'waiting').length %></div><div class="l">Aktiv/kutayotgan sessiya</div></div>
        <div class="ov-stat"><div class="n"><%= practiceCount %></div><div class="l">Yakka mashqlar (kuzatuv)</div></div>
      </div>
      <div class="quick-grid">
        <div class="role-card">
          <div class="rc-ico rc-ico--primary"><%- icon('plus', 20) %></div>
          <div class="rc-title">Yangi test yaratish</div>
          <div class="rc-sub">Savollar bankidan yoki Excel import orqali</div>
          <a href="/user/create-test" class="rc-link"><%- icon('arrowRight', 13) %> Boshlash</a>
          <a href="/user/profile" style="display:inline-block;margin-top:6px;text-decoration:none;font-weight:700;font-size:.8rem"><%- icon('user', 13) %> Profilim</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--sky"><%- icon('target', 20) %></div>
          <div class="rc-title">Baholashlar</div>
          <div class="rc-sub">Assessment builder &amp; blueprint</div>
          <a href="/teacher?tab=assessments" class="rc-link rc-link--sky"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--mint"><%- icon('clipboard', 20) %></div>
          <div class="rc-title">Baholash navbati</div>
          <div class="rc-sub">AI first-pass + teacher final model</div>
          <a href="/teacher?tab=grading" class="rc-link rc-link--mint"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--amber"><%- icon('users', 20) %></div>
          <div class="rc-title">Kurslar &amp; guruhlar</div>
          <div class="rc-sub">Groups / Cohorts / Students</div>
          <a href="/teacher?tab=courses" class="rc-link rc-link--amber"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--violet"><%- icon('monitor', 20) %></div>
          <div class="rc-title">Muhitlarim — monitoring</div>
          <div class="rc-sub">Faqat o'zingiz yaratgan Cast sessiyalari ustidan nazorat</div>
          <a href="/teacher?tab=environments" class="rc-link rc-link--violet"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--primary"><%- icon('sparkles', 20) %></div>
          <div class="rc-title">AI Studiya</div>
          <div class="rc-sub">Savol/slayd generator, OCR → xlsx/pptx/eksport</div>
          <a href="/user/ai-studio" class="rc-link"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
      </div>
    <% } else if (tab === 'courses') { %>
      <div class="page-head" style="margin-bottom:14px"><div><h1 style="font-size:1.1rem;margin:0">Mening guruhlarim</h1><p class="sub" style="margin:4px 0 0">Faqat sizga biriktirilgan guruhlar. O‘quvchi ma’lumotlari va ichki grade journal HEMIS-ga sinq qilinmaydi.</p></div></div>
      <div id="courses-msg" class="muted" style="margin-bottom:10px"></div>
      <div class="card" id="courses-list"></div>
      <div id="courses-detail" style="display:none;margin-top:14px"></div>
      <script>
(function(){
  const listEl=document.getElementById('courses-list');
  const msgEl=document.getElementById('courses-msg');
  const detailEl=document.getElementById('courses-detail');
  async function loadGroups(){ msgEl.textContent='Yuklanmoqda…'; try{ const r=await fetch('/api/teacher/classrooms/groups'); const d=await r.json(); listEl.innerHTML=''; if(!d.ok){ msgEl.textContent=d.error||'Xatolik'; return; } const groups=d.groups||[]; msgEl.textContent=groups.length?groups.length+' ta guruh topildi':'Guruh yo‘q'; if(groups.length===0){ listEl.innerHTML='<div class="empty">Sizga hali biriktirilgan guruh yo‘q. Admin sizga guruh tayinlaydi.</div>'; return; } groups.forEach(g=>{ const card=document.createElement('div'); card.className='role-card'; card.innerHTML='<div class="rc-ico rc-ico--groups">👥</div><div><div class="rc-title">'+escapeHtml(g.name||g.id)+'</div><div class="rc-sub">'+escapeHtml(g.code||g.id)+' · '+g.memberCount+' o‘quvchi</div></div><button class="btn btn--primary btn-sm" style="margin-left:auto" onclick="openGroup(\''+escapeJs(g.id)+'\', \"'+escapeJs(g.name||g.id)+'\")">Tarkib</button></div>'; listEl.appendChild(card); }); }catch(e){ msgEl.textContent='Yuklashda xatolik'; } }
  async function openGroup(id,name){ detailEl.style.display='block'; detailEl.innerHTML='<div class="card"><div style="display:flex;align-items:center;gap:10px;margin-bottom:10px"><button class="btn" onclick="document.getElementById(\'courses-detail\').style.display=\'none\'">← Orqaga</button><h2 style="font-size:1rem;margin:0">'+escapeHtml(name)+'</h2><span class="badge" style="margin-left:auto">'+escapeHtml(id)+'</span></div><div id="detail-msg" class="muted"></div><div id="detail-table-wrap"></div></div>'; const wrap=document.getElementById('detail-table-wrap'); const dmsg=document.getElementById('detail-msg'); dmsg.textContent='Yuklanmoqda…'; try{ const r=await fetch('/api/teacher/classrooms/groups/'+encodeURIComponent(id)+'/students'); const d=await r.json(); if(!d.ok){ dmsg.textContent=d.error||'Xatolik'; return; } const students=d.students||[]; dmsg.textContent=students.length+' ta o‘quvchi'; const tbl=document.createElement('table'); tbl.style.width='100%'; tbl.innerHTML='<thead><tr><th style="text-align:left">Ism, familiya</th><th style="text-align:left">HEMIS ID</th><th style="text-align:center">Baholash</th></tr></thead><tbody></tbody>'; const tb=tbl.querySelector('tbody'); students.forEach(s=>{ const tr=document.createElement('tr'); const disp=s.displayName||((s.firstName||'')+' '+(s.lastName||'')).trim(); tr.innerHTML='<td><strong>'+escapeHtml(disp)+'</strong><div class="muted" style="font-size:.75rem">'+escapeHtml(s.userId)+'</div></td><td>'+escapeHtml(s.hemisId||'—')+'</td><td style="text-align:center"><button class="btn btn-sm" style="background:var(--deborah-semantic-color-surface-raised);border-color:var(--deborah-semantic-color-border-default)" onclick="openGrade(\''+escapeJs(id)+'\', \"'+escapeJs(s.userId)+'\", \"'+escapeHtml(disp)+'\")">Journal</button></td></tr>'; tb.appendChild(tr); }); wrap.innerHTML=''; wrap.appendChild(tbl); }catch(e){ dmsg.textContent='Yuklashda xatolik'; } }
  async function openGrade(groupId,userId,displayName){ const answers=prompt(displayName+' uchun to‘g‘ri javoblar sonini kiriting (masalan: 24) va savollar sonini vergul bilan: 24,30'); if(!answers) return; const parts=answers.split(',').map(x=>Number(x.trim())).filter(x=>Number.isFinite(x)); if(parts.length<2){ alert('Ikkita son kiriting: to‘g‘ri, jami'); return; } const correct=parts[0], total=parts[1]; const answerRecords=[]; for(let i=0;i<total;i++) answerRecords.push({ questionId:'q'+i, isCorrect: i<correct, score: 100 }); const r=await fetch('/api/teacher/classrooms/groups/'+encodeURIComponent(groupId)+'/students/'+encodeURIComponent(userId)+'/grade?questionCount='+encodeURIComponent(total)+'&answers='+encodeURIComponent(JSON.stringify(answerRecords))); const d=await r.json(); if(!d.ok){ alert(d.error||'Xatolik'); return; } alert(displayName+': daraja '+d.grade.grade+' (aniklik '+d.grade.accuracyPercent+'%, ball '+d.grade.scorePercent+'%)'); }
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }
  function escapeJs(s){ return String(s||'').replace(/\\\\/g,'\\\\\\\\').replace(/'/g,"\\\\'").replace(/\\\n/g,'\\\\n'); }
  loadGroups();
})();
      </script>
    <% } else if (tab === 'assessments') { %>
      <%- include('../partials/states', { state: 'empty', iconName: 'target', title: 'Baholashlar', sub: 'Assessment builder, blueprint va monitoring' }) %>
    <% } else if (tab === 'grading') { %>
      <%- include('../partials/states', { state: 'job', iconName: 'cpu', title: "Baholash navbati bo'sh", sub: canOverride ? 'Model override huquqiga egasiz' : "Faqat o'qish rejimi" }) %>
    <% } else if (tab === 'environments') { %>
      <div class="ov-stats">
        <div class="ov-stat"><div class="n"><%= mySessions.length %></div><div class="l">Jami sessiyalarim</div></div>
        <div class="ov-stat"><div class="n"><%= mySessions.reduce((a, s) => a + s.players, 0) %></div><div class="l">Jami ishtirokchilar</div></div>
        <div class="ov-stat"><div class="n"><%= myTests.length %></div><div class="l">Testlarim</div></div>
      </div>
      <div class="quick-grid" style="margin-bottom:20px">
        <% if (mySessions.length === 0) { %>
          <%- include('../partials/states', { state: 'empty', iconName: 'monitor', title: 'Hali sessiya yo\u2018q', sub: "Panel'dagi 'Cast' tugmasi bilan muhit yarating — shu yerda ko\u2018rinadi" }) %>
        <% } else { %>
          <% mySessions.forEach(s => { %>
            <div class="role-card">
              <div class="rc-ico rc-ico--violet"><%- icon('gamepad', 18) %></div>
              <div class="rc-title"><%= s.testName %> <span class="rc-code">#<%= s.code %></span></div>
              <div class="rc-sub"><%= s.players %> ishtirokchi · <%= s.status === 'waiting' ? 'Kutish' : s.status === 'active' ? 'Aktiv' : 'Yakunlangan' %> · <%= new Date(s.createdAt).toLocaleDateString('uz-UZ') %></div>
              <a href="/host/<%= s.code %>" class="rc-link rc-link--violet rc-link--sm"><%- icon('monitor', 13) %> Boshqaruv paneli</a>
            </div>
          <% }); %>
        <% } %>
      </div>
    <% } else if (tab === 'ai') { %>
      <div class="quick-grid">
        <div class="role-card">
          <div class="rc-ico rc-ico--primary"><%- icon('sparkles', 20) %></div>
          <div class="rc-title">AI Studiya</div>
          <div class="rc-sub">Mavzudan savollar/slaydlar, OCR: fayl → savol/slayd, xlsx/pptx eksport</div>
          <a href="/user/ai-studio" class="rc-link"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--sky"><%- icon('book', 20) %></div>
          <div class="rc-title">Mening testlarim</div>
          <div class="rc-sub">O'zingiz yaratgan testlar — Cast/mashq muhitlari shu yerdan</div>
          <a href="/user/panel" class="rc-link rc-link--sky"><%- icon('arrowRight', 13) %> O'tish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--mint"><%- icon('play', 20) %></div>
          <div class="rc-title">Taqdimot vositalari</div>
          <div class="rc-sub">Google Slides, Gamma, Canva, Manus, Claude — tashqi platformalar</div>
          <a href="/user/ai-studio?tab=e" class="rc-link rc-link--mint"><%- icon('arrowRight', 13) %> Ko'rish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--primary"><%- icon('bookOpen', 20) %></div>
          <div class="rc-title">Dars reja tayyorlash</div>
          <div class="rc-sub">Fan + mavzu + vaqt → AI to'liq reja (maqsadlar, bosqichlar, baholash) · PDF/Word</div>
          <a href="/user/ai-studio?tab=plan" class="rc-link"><%- icon('arrowRight', 13) %> Tuzish</a>
        </div>
        <div class="role-card">
          <div class="rc-ico rc-ico--sky"><%- icon('search', 20) %></div>
          <div class="rc-title">Maqola / material tavsiya</div>
          <div class="rc-sub">Mavzu bo'yicha o'qish ro'yxati + Scholar/Google/YouTube havolalari</div>
          <a href="/user/ai-studio?tab=materials" class="rc-link rc-link--sky"><%- icon('arrowRight', 13) %> Olish</a>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
