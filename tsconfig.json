{
  "compilerOptions": {
    /* ── Strictness ── */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* ── Module ── */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* ── Paths ── */
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,

    /* ── Skip lib check (legacy JS deps) ── */
    "skipLibCheck": true,

    /* ── Allow JS imports (treated as any for legacy modules) ── */
    "allowJs": true,
    "checkJs": false,

    /* ── Use relative imports for TS modules ── */
    "paths": {}
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "scripts",
    "public",
    "views",
    "characters",
    "routes",
    "middleware",
    "utils",
    "socket",
    "firebase",
    "migrations"
  ]
}
