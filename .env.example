# Deborah — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ═══════════════════════════════════════════════════════════════
# PRODUCTION (Render/other) — shu qiymatlar bo'lmasa server YOQILMAYDI:
#
#   NODE_ENV=production
#   SESSION_SECRET=<32+ random>        # openssl rand -base64 32
#   ADMIN_USER=<non-admin>
#   ADMIN_PASS=<strong>
#   COOKIE_SECURE=true                 # HTTPS session cookie
#   BASE_URL=https://deborah-ncj.onrender.com   # (yoki custom domain)
#   TURNSTILE_SECRET_KEY=<Cloudflare Turnstile secret>
#   TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key>
#
# Firebase real user'lar uchun (ixtiyoriy — bo'lmasa demo data/db.json):
#   FIREBASE_SERVICE_ACCOUNT=<service account JSON string>
#   FIREBASE_DATABASE_URL=https://sessiya-11767-default-rtdb.firebaseio.com
# ═══════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=development        # development | production | test
PORT=3000
HOST=0.0.0.0
SITE_URL=http://localhost:3000
# BASE_URL — production'da majburiy (domain allowlist, OIDC redirect, origin check)
# BASE_URL=https://deborah.uz

# ── Session ──
# Production: unique, random, >= 32 chars (D-01: 32B+; e.g. openssl rand -base64 32)
SESSION_SECRET=CHANGE_ME
# Cookie hardening (production'da COOKIE_SECURE=true majburiy — fail-fast)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax              # strict | lax | none

# ── Admin credentials ──
# Production: MUST NOT be "admin" (server refuses to start otherwise)
ADMIN_USER=deborah_admin
ADMIN_PASS=change-me-to-a-strong-password

# ── Firebase Realtime Database (sessiya-11767) ──
# Lokal: service account JSON fayl yo'li (Firebase Console > Project settings >
# Service accounts > Generate new private key. Faylni shu yo'lga qo'ying.)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Render/cloud (fayl yo'li yo'q muhitda): JSON string sifatida:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sessiya-11767",...}
FIREBASE_DATABASE_URL=https://sessiya-11767-default-rtdb.firebaseio.com
# FIREBASE_PROJECT_ID=sessiya-11767   # (optional — default sessiya-11767)

# ── Google OIDC (optional — o'chirilgan bo'lsa disabled) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_HD=

# ── Cloudflare Turnstile (AUTH B-08 — bot himoya) ──
# Production'da TURNSTILE_SECRET_KEY MAJBURIY (fail-fast).
# https://dash.cloudflare.com → Turnstile → Add site → Secret key.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ── Email (D-01) — mock | smtp | postmark | ses ──
# Production'da postmark/smtp credential'lar majburiy (fail-fast)
EMAIL_PROVIDER=mock
# AUTH D-32 §25: provider failover — primary 5x xato/1 daqiqa → secondary
# (auto-recovery 5 daqiqa cooldown). Qo'llab-quvvatlanadigan: mock|smtp|postmark|ses
# EMAIL_PROVIDER_PRIMARY=postmark
# EMAIL_PROVIDER_SECONDARY=smtp
# AUTH D-32 §27: webhook IP allowlist (vergul bilan) — spoof qarshi (Postmark/SES)
# EMAIL_WEBHOOK_IP_ALLOWLIST=1.2.3.4,5.6.7.8
# AUTH D-32 §26: oylik email budget (USD) — oshsa email:budget:alert auditi
# EMAIL_MONTHLY_BUDGET_USD=25
EMAIL_FROM=Deborah <no-reply@deborah.uz>
# EMAIL_SENDING_DOMAIN=mail.deborah.uz
# EMAIL_API_KEY=
# POSTMARK_SERVER_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── HIBP (AUTH A-22) — pwned passwords k-anonymity endpoint ──
# HIBP_API_URL=https://api.pwnedpasswords.com/range/

# ── Push notifications (B-23 Web Push / E-03 FCM) ──
# Web Push (PWA): VAPID juftligi (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@deborah.uz
# PUSH_ENABLED=true
# FCM (mobile): Firebase Cloud Messaging server key — Firebase Console >
# Cloud Messaging > Server key. FCM bo'lmasa faqat web push ishlaydi.
# FCM_ENABLED=true
# FCM_SERVER_KEY=

# ── MFA (D-01) ──
# MFA_ISSUER=Deborah           # TOTP QR label (otpauth issuer)
# MFA_ENCRYPTION_KEY=          # 32B base64; yo'q bo'lsa SESSION_SECRET sha256
# KMS_KEY_ARN=                 # prod'da MFA_ENCRYPTION_KEY o'rniga KMS
# AUTH E-06 — cloud KMS: KMS bilan shifrlangan 32-bayt master key (base64) +
# region (AWS'da UZ yo'q — xususiy cloud yoki me-central-1/eu-central-1)
# KMS_ENCRYPTED_MASTER_KEY=
# KMS_REGION=eu-central-1

# ── PostgreSQL (optional — bo'lmasa local-db fallback) ──
# DATABASE_URL=

# ── Redis session store (optional — bo'lmasa MemoryStore) ──
# Production tavsiya: Redis bilan ishlatish (session'lar restart'da saqlanadi)
# REDIS_URL=

# ── Realtime / Multi-node (C5-06) ──
# REALTIME_MODE=single          # single | redis_streams (multi-node uchun redis kerak)
# SOCKET_RECOVERY_MAX_MS=120000 # socket connection-state recovery oynasi
# CAST_NODE_ID=node-01          # har node'ga unique id (default: node-<pid>)
# CAST_MAX_TIER=XL              # S|M|L|XL|XXL — Redis unavailable bo'lsa XXL bloklanadi
# LB_STICKY_SESSIONS=true       # long-polling ishlatilsa load balancer sticky session
# WEBSOCKET_ONLY=false          # true bo'lsa old browser/network fallback policy

# ── Object Storage (optional, default: local) ──
# STORAGE_TYPE=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Logging ──
# LOG_LEVEL=info
# LOG_PRETTY=false
