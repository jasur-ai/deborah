# Edikit — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Server ──
NODE_ENV=development        # development | production | test
PORT=3000
HOST=0.0.0.0
SITE_URL=http://localhost:3000

# ── Session ──
# Production: unique, random, >= 16 chars (e.g. openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-secret

# ── Admin credentials ──
# Production: MUST NOT be "admin" (server refuses to start otherwise)
ADMIN_USER=edikit_admin
ADMIN_PASS=change-me-to-a-strong-password

# ── Firebase Realtime Database (sessiya-11767) ──
# Service account JSON fayl yo'li — Firebase Console > Project settings >
# Service accounts > Generate new private key. Faylni shu yo'lga qo'ying.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://sessiya-11767-default-rtdb.firebaseio.com
# FIREBASE_PROJECT_ID=sessiya-11767   # (optional — default sessiya-11767)

# ── Google OIDC (optional — o'chirilgan bo'lsa disabled) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_HD=

# ── PostgreSQL (optional — bo'lmasa local-db fallback) ──
# DATABASE_URL=

# ── Redis session store (optional — bo'lmasa MemoryStore) ──
# Production tavsiya: Redis bilan ishlatish (session'lar restart'da saqlanadi)
# REDIS_URL=

# ── Object Storage (optional, default: local) ──
# STORAGE_TYPE=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Logging ──
# LOG_LEVEL=info
# LOG_PRETTY=false
